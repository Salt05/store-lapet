---
// src/pages/gio-hang.astro
export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';

// Lấy thông tin xác thực từ middleware qua Astro.locals.auth
const auth = Astro.locals.auth;
const isAuthenticated = auth?.isAuthenticated === true;
const isDealer = auth?.isDealer === true;
---

<BaseLayout title="Giỏ hàng của bạn - LA PET Store">
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12"
    x-data={`{
      cart: [],
      isDealer: ${isDealer},
      isAuthenticated: ${isAuthenticated},
      isLoading: true,
      serverPromoResult: null,

      init() {
        this.loadCart();
        window.addEventListener('cart-updated', () => {
          this.loadCart();
        });
        window.addEventListener('auth-changed', () => {
          window.location.reload();
        });
      },

      loadCart() {
        try {
          const raw = JSON.parse(localStorage.getItem('cart') || '[]');
          if (!Array.isArray(raw)) {
            this.cart = [];
          } else {
            // Strictly preserve integer odoo_id
            this.cart = raw.map(item => {
              const rawOdooId = item.odoo_id !== undefined && item.odoo_id !== null ? item.odoo_id : item.id;
              const odooId = parseInt(rawOdooId, 10);
              const validOdooId = !isNaN(odooId) && odooId > 0 ? odooId : (Number(item.id) || 101);
              const price = Number(item.price || item.retail_price || 0);
              const wholesalePrice = item.wholesale_price ? Number(item.wholesale_price) : Math.round(price * 0.78);
              const quantity = Math.max(1, parseInt(item.quantity || item.qty || 1, 10));

              return {
                ...item,
                id: item.id || validOdooId,
                odoo_id: validOdooId,
                sku: item.sku || ('SKU-' + validOdooId),
                name: item.name || 'Sản phẩm La Pet',
                image: item.image || '/images/placeholder-product.svg',
                price: price,
                retail_price: price,
                wholesale_price: wholesalePrice,
                quantity: quantity
              };
            });
          }
        } catch (e) {
          this.cart = [];
        }
        this.isLoading = false;
        if (this.isDealer && this.cart.length > 0) {
          this.syncServerPricing();
        }
      },

      saveCart() {
        localStorage.setItem('cart', JSON.stringify(this.cart));
        window.dispatchEvent(new Event('cart-updated'));
        window.dispatchEvent(new CustomEvent('cart-updated'));
        if (this.isDealer && this.cart.length > 0) {
          this.syncServerPricing();
        }
      },

      async syncServerPricing() {
        try {
          const payloadItems = this.cart.map(item => ({
            odoo_id: Number(item.odoo_id),
            id: Number(item.odoo_id),
            sku: item.sku,
            qty: Number(item.quantity)
          }));

          const res = await fetch('/api/products/calculate-price', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: payloadItems })
          });

          if (res.ok) {
            const data = await res.json();
            this.serverPromoResult = data;
          }
        } catch (err) {
          console.warn('[Cart Pricing Sync Fallback to local]:', err);
        }
      },

      getItemUnitPrice(item) {
        if (this.isDealer) {
          return item.wholesale_price || Math.round(item.price * 0.78);
        }
        return item.price;
      },

      get rawSubtotal() {
        return this.cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
      },

      get wholesaleDiscount() {
        if (!this.isDealer) return 0;
        if (this.serverPromoResult && typeof this.serverPromoResult.discount_amount === 'number') {
          return this.serverPromoResult.discount_amount;
        }
        return this.cart.reduce((sum, item) => {
          const unitDisc = Math.max(0, item.price - (item.wholesale_price || Math.round(item.price * 0.78)));
          return sum + (unitDisc * item.quantity);
        }, 0);
      },

      get finalTotal() {
        if (this.isDealer && this.serverPromoResult && typeof this.serverPromoResult.total === 'number') {
          return this.serverPromoResult.total;
        }
        return Math.max(0, this.rawSubtotal - this.wholesaleDiscount);
      },

      get shippingFee() {
        // Free shipping for orders over 500,000 VND or B2B dealer orders
        if (this.isDealer || this.finalTotal >= 500000 || this.finalTotal === 0) {
          return 0;
        }
        return 30000;
      },

      get grandTotal() {
        return this.finalTotal + this.shippingFee;
      },

      updateQuantity(index, val) {
        let q = parseInt(val, 10);
        if (isNaN(q) || q < 1) q = 1;
        if (q > 9999) q = 9999;
        this.cart[index].quantity = q;
        this.saveCart();
      },

      increment(index) {
        if (this.cart[index].quantity < 9999) {
          this.cart[index].quantity++;
          this.saveCart();
        }
      },

      decrement(index) {
        if (this.cart[index].quantity > 1) {
          this.cart[index].quantity--;
          this.saveCart();
        } else {
          if (confirm('Xóa sản phẩm ' + this.cart[index].name + ' khỏi giỏ hàng?')) {
            this.removeItem(index);
          }
        }
      },

      removeItem(index) {
        this.cart.splice(index, 1);
        this.saveCart();
      },

      clearCart() {
        if (confirm('Quý khách có chắc chắn muốn xóa tất cả sản phẩm khỏi giỏ hàng?')) {
          this.cart = [];
          this.serverPromoResult = null;
          this.saveCart();
        }
      },

      formatVND(num) {
        return (Number(num) || 0).toLocaleString('vi-VN') + 'đ';
      },

      // Milestone progress calculation for B2B Dealers (Monotonic Tiered Progress)
      get milestoneProgress() {
        const tiers = [
          { amount: 5000000, percent: 2.0 },
          { amount: 10000000, percent: 3.5 },
          { amount: 20000000, percent: 5.0 },
          { amount: 50000000, percent: 7.0 }
        ];

        const total = this.rawSubtotal;
        const reached = tiers.filter(t => total >= t.amount);
        const next = tiers.find(t => total < t.amount);

        let percent = 0;
        if (reached.length === 0) {
          percent = Math.min(100, (total / tiers[0].amount) * (100 / tiers.length));
        } else if (reached.length === tiers.length) {
          percent = 100;
        } else {
          const idx = reached.length - 1;
          const prevAmt = tiers[idx].amount;
          const nextAmt = tiers[idx + 1].amount;
          const segProgress = (total - prevAmt) / (nextAmt - prevAmt);
          const segWidth = 100 / (tiers.length - 1);
          percent = (idx * segWidth) + (segProgress * segWidth);
        }

        return {
          fillPercent: Math.min(100, Math.max(0, percent)),
          nextTier: next,
          currentTier: reached.length > 0 ? reached[reached.length - 1] : null,
          needed: next ? next.amount - total : 0,
          tiers: tiers.map((t, idx) => ({
            ...t,
            isReached: total >= t.amount,
            label: (t.amount / 1000000) + 'Tr'
          }))
        };
      }
    }`}
  >
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs font-semibold text-brand-muted mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-brand-primary transition">Trang chủ</a>
      <span>/</span>
      <span class="text-brand-dark">Giỏ hàng</span>
    </nav>

    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-brand-border/60 mb-8">
      <div>
        <h1 class="text-2xl sm:text-3xl font-black text-brand-dark tracking-tight flex items-center gap-2">
          <span>Giỏ hàng của bạn</span>
          <span
            x-show="cart.length > 0"
            x-text="'(' + cart.reduce((t, i) => t + i.quantity, 0) + ')'"
            class="text-sm font-bold text-brand-primary bg-brand-primary/10 px-2.5 py-0.5 rounded-full"
          ></span>
        </h1>
        <p class="text-xs sm:text-sm text-brand-muted mt-1">
          Kiểm tra danh sách sản phẩm, số lượng và thông tin chiết khấu đại lý.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/san-pham"
          class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-primary hover:text-brand-primary/80 transition"
        >
          <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          <span>Tiếp tục chọn sản phẩm</span>
        </a>
      </div>
    </div>

    <!-- B2B Dealer Wholesale Milestone Banner -->
    <template x-if="isDealer && cart.length > 0">
      <div class="mb-8 p-5 rounded-2xl bg-brand-sand/70 border border-brand-border shadow-soft space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs sm:text-sm">
          <div class="flex items-center gap-2">
            <div class="w-7 h-7 rounded-lg bg-brand-primary text-white flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <span class="font-bold text-brand-dark">
              Chương trình Chiết khấu Doanh số B2B
            </span>
            <span class="px-2 py-0.5 rounded-md bg-brand-primary/10 text-brand-primary text-xs font-extrabold">
              Đại lý chính thức
            </span>
          </div>

          <div class="font-bold text-brand-dark text-right sm:text-left">
            <template x-if="milestoneProgress.nextTier">
              <span>
                Mua thêm <strong class="text-brand-primary font-black" x-text="formatVND(milestoneProgress.needed)"></strong>
                để đạt mức chiết khấu bậc thang <strong class="text-brand-primary font-black" x-text="'+' + milestoneProgress.nextTier.percent + '%'"></strong>!
              </span>
            </template>
            <template x-if="!milestoneProgress.nextTier">
              <span class="text-emerald-700 font-extrabold">
                ✓ Đã đạt mức chiết khấu bậc thang tối đa (+7%)!
              </span>
            </template>
          </div>
        </div>

        <!-- Progress bar -->
        <div class="relative my-6 px-3 sm:px-6">
          <div class="absolute top-1/2 left-0 w-full h-2.5 bg-brand-border/70 -translate-y-1/2 rounded-full"></div>
          <div
            class="absolute top-1/2 left-0 h-2.5 bg-brand-primary -translate-y-1/2 rounded-full transition-all duration-500"
            :style="'width: ' + milestoneProgress.fillPercent + '%'"
          ></div>

          <div class="relative flex justify-between items-center w-full">
            <template x-for="(tier, idx) in milestoneProgress.tiers" :key="idx">
              <div class="flex flex-col items-center relative">
                <div
                  :class="tier.isReached
                    ? 'w-6 h-6 sm:w-7 sm:h-7 rounded-full flex items-center justify-center text-[10px] sm:text-xs font-bold transition-all border-2 z-10 bg-brand-primary border-white text-white shadow-soft scale-110'
                    : 'w-6 h-6 sm:w-7 sm:h-7 rounded-full flex items-center justify-center text-[10px] sm:text-xs font-bold transition-all border-2 z-10 bg-white border-brand-border text-brand-muted'"
                  x-text="tier.isReached ? '✓' : tier.percent + '%'"
                ></div>

                <div class="absolute -bottom-7 flex flex-col items-center w-12 text-center pointer-events-none">
                  <span class="text-[10px] font-bold text-brand-dark" x-text="tier.label"></span>
                  <span class="text-[9px] font-bold text-brand-primary" x-text="'-' + tier.percent + '%'"></span>
                </div>
              </div>
            </template>
          </div>
        </div>
        <div class="h-4"></div>
      </div>
    </template>

    <!-- LOADING STATE -->
    <div x-show="isLoading" class="py-16 text-center text-brand-muted text-sm space-y-3">
      <div class="w-8 h-8 rounded-full border-3 border-brand-primary border-t-transparent animate-spin mx-auto"></div>
      <p>Đang tải giỏ hàng của bạn...</p>
    </div>

    <!-- EMPTY CART STATE -->
    <div x-show="!isLoading && cart.length === 0" x-cloak class="py-16 sm:py-24 text-center max-w-md mx-auto space-y-6">
      <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl bg-brand-sand text-brand-primary flex items-center justify-center mx-auto shadow-soft">
        <svg class="w-10 h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
      </div>
      <div class="space-y-2">
        <h2 class="text-xl sm:text-2xl font-black text-brand-dark">Giỏ hàng của bạn đang trống</h2>
        <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
          Hiện tại bạn chưa chọn sản phẩm nào. Hãy khám phá danh mục bánh thưởng, cát vệ sinh và que gặm chất lượng cao tại LA PET!
        </p>
      </div>

      <a
        href="/san-pham"
        class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl bg-brand-primary hover:bg-brand-primary/90 text-white font-bold text-xs uppercase tracking-wider transition shadow-soft"
      >
        <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
        </svg>
        <span>Khám phá sản phẩm ngay</span>
      </a>
    </div>

    <!-- MAIN CART CONTENT -->
    <div x-show="!isLoading && cart.length > 0" x-cloak class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- CART LINE ITEMS (LEFT COLUMN 8 COLS) -->
      <div class="lg:col-span-8 bg-white rounded-2xl border border-brand-border shadow-soft overflow-hidden">
        
        <!-- Table Header (Desktop) -->
        <div class="hidden sm:grid grid-cols-12 gap-4 px-6 py-3.5 bg-brand-sand/50 border-b border-brand-border text-xs font-bold uppercase tracking-wider text-brand-muted">
          <div class="col-span-6">Sản phẩm</div>
          <div class="col-span-2 text-center">Đơn giá</div>
          <div class="col-span-2 text-center">Số lượng</div>
          <div class="col-span-2 text-right">Tạm tính</div>
        </div>

        <!-- Line Items List -->
        <div class="divide-y divide-brand-border/60">
          <template x-for="(item, index) in cart" :key="item.odoo_id || index">
            <div class="p-4 sm:px-6 sm:py-5 flex flex-col sm:grid sm:grid-cols-12 gap-4 items-center">
              
              <!-- Product info & Thumbnail -->
              <div class="col-span-6 w-full flex items-center gap-4">
                <img
                  :src="item.image || '/images/placeholder-product.svg'"
                  :alt="item.name"
                  class="w-16 h-16 sm:w-20 sm:h-20 rounded-xl object-contain bg-brand-surface border border-brand-border p-1 shrink-0"
                  onerror="this.onerror=null; this.src='/images/placeholder-product.svg';"
                />
                <div class="min-w-0 flex-1 space-y-1">
                  <h3 class="font-bold text-sm sm:text-base text-brand-dark line-clamp-2 leading-snug" x-text="item.name"></h3>
                  <div class="flex items-center gap-2 text-2xs text-brand-muted">
                    <span class="font-mono" x-text="'Mã: #' + item.odoo_id"></span>
                    <span x-show="item.sku" x-text="'• ' + item.sku"></span>
                  </div>
                  
                  <!-- Mobile Price View -->
                  <div class="sm:hidden flex items-center gap-2 pt-0.5">
                    <div class="flex items-center gap-2">
                      <span class="font-extrabold text-sm text-brand-primary" x-text="formatVND(getItemUnitPrice(item))"></span>
                      <template x-if="isDealer && item.price > getItemUnitPrice(item)">
                        <del class="text-xs text-brand-muted" x-text="formatVND(item.price)"></del>
                      </template>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Desktop Unit Price -->
              <div class="hidden sm:block col-span-2 text-center">
                <div>
                  <span class="font-bold text-sm text-brand-dark block" x-text="formatVND(getItemUnitPrice(item))"></span>
                  <template x-if="isDealer && item.price > getItemUnitPrice(item)">
                    <div class="flex flex-col items-center">
                      <del class="text-xs text-brand-muted" x-text="formatVND(item.price)"></del>
                      <span class="inline-block mt-0.5 text-[10px] font-extrabold text-emerald-700 bg-emerald-50 px-1.5 py-0.2 rounded border border-emerald-200">
                        -22% Sỉ
                      </span>
                    </div>
                  </template>
                </div>
              </div>

              <!-- Quantity Selector -->
              <div class="col-span-2 w-full sm:w-auto flex items-center justify-between sm:justify-center gap-3">
                <span class="sm:hidden text-xs font-bold text-brand-muted">Số lượng:</span>
                <div class="inline-flex items-center rounded-xl border border-brand-border bg-brand-sand/50 p-1">
                  <button
                    type="button"
                    @click="decrement(index)"
                    class="w-7 h-7 rounded-lg bg-white border border-brand-border flex items-center justify-center font-bold text-brand-dark hover:bg-brand-sand transition cursor-pointer select-none text-sm"
                  >
                    −
                  </button>
                  <input
                    type="number"
                    min="1"
                    max="9999"
                    :value="item.quantity"
                    @change="updateQuantity(index, $event.target.value)"
                    class="w-12 text-center font-extrabold text-sm text-brand-dark bg-transparent focus:outline-none p-0"
                  />
                  <button
                    type="button"
                    @click="increment(index)"
                    class="w-7 h-7 rounded-lg bg-white border border-brand-border flex items-center justify-center font-bold text-brand-dark hover:bg-brand-sand transition cursor-pointer select-none text-sm"
                  >
                    +
                  </button>
                </div>
              </div>

              <!-- Line Total & Remove -->
              <div class="col-span-2 w-full sm:w-auto flex items-center justify-between sm:justify-end gap-3 pt-2 sm:pt-0 border-t sm:border-0 border-brand-border/40">
                <span class="sm:hidden text-xs font-bold text-brand-muted">Tổng cộng:</span>
                <div class="flex items-center gap-2">
                  <span class="font-black text-sm sm:text-base text-brand-dark" x-text="formatVND(getItemUnitPrice(item) * item.quantity)"></span>
                  <button
                    type="button"
                    @click="removeItem(index)"
                    class="text-brand-muted hover:text-rose-600 p-1.5 rounded-lg hover:bg-rose-50 transition cursor-pointer"
                    title="Xóa sản phẩm"
                  >
                    <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                    </svg>
                  </button>
                </div>
              </div>

            </div>
          </template>
        </div>

        <!-- Card Footer Actions -->
        <div class="p-4 sm:px-6 bg-brand-surface border-t border-brand-border flex flex-wrap items-center justify-between gap-3">
          <button
            type="button"
            @click="clearCart()"
            class="px-4 py-2 rounded-xl border border-brand-border bg-white hover:bg-brand-sand text-brand-muted hover:text-brand-dark text-xs font-bold uppercase tracking-wider transition cursor-pointer"
          >
            Xóa tất cả
          </button>

          <a
            href="/san-pham"
            class="px-4 py-2 rounded-xl text-xs font-bold text-brand-primary hover:underline transition"
          >
            ← Tiếp tục mua sắm
          </a>
        </div>

      </div>

      <!-- ORDER SUMMARY (RIGHT COLUMN 4 COLS) -->
      <aside class="lg:col-span-4 lg:sticky lg:top-8 space-y-4">
        <div class="bg-white rounded-2xl border border-brand-border p-6 shadow-soft space-y-5">
          <h2 class="text-base font-extrabold text-brand-dark pb-3 border-b border-brand-border/60">
            Tóm tắt đơn hàng
          </h2>

          <div class="space-y-3 text-sm">
            <div class="flex justify-between items-center text-brand-muted">
              <span>Tổng tiền niêm yết:</span>
              <span class="font-bold text-brand-dark" x-text="formatVND(rawSubtotal)"></span>
            </div>

            <template x-if="isDealer && wholesaleDiscount > 0">
              <div class="flex justify-between items-center text-emerald-700 bg-emerald-50 px-2.5 py-1.5 rounded-lg border border-emerald-200">
                <span class="font-semibold text-xs">Chiết khấu B2B Đại lý:</span>
                <span class="font-black text-xs" x-text="'-' + formatVND(wholesaleDiscount)"></span>
              </div>
            </template>

            <div class="flex justify-between items-center text-brand-muted">
              <span>Phí vận chuyển:</span>
              <span class="font-bold" :class="shippingFee === 0 ? 'text-emerald-600' : 'text-brand-dark'">
                <span x-text="shippingFee === 0 ? 'Miễn phí' : formatVND(shippingFee)"></span>
              </span>
            </div>

            <div class="pt-3 border-t border-brand-border/80 flex justify-between items-baseline">
              <div>
                <span class="text-base font-black text-brand-dark block">Tổng thanh toán:</span>
                <span class="text-2xs text-brand-muted block">(Đã bao gồm VAT)</span>
              </div>
              <span class="text-2xl font-black text-brand-primary" x-text="formatVND(grandTotal)"></span>
            </div>
          </div>

          <!-- Checkout CTA -->
          <a
            href="/thanh-toan"
            class="w-full py-4 px-4 rounded-xl bg-brand-primary hover:bg-brand-primary/90 text-white font-black text-sm uppercase tracking-wider shadow-soft transition text-center flex items-center justify-center gap-2 group cursor-pointer"
          >
            <span>Tiến hành thanh toán</span>
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>

          <!-- Guarantees badge -->
          <div class="pt-3 border-t border-brand-border/60 text-2xs text-brand-muted space-y-1.5">
            <div class="flex items-center gap-2">
              <span class="text-emerald-600 font-bold">✓</span>
              <span>Hàng chính hãng 100% kèm hóa đơn GTGT</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-600 font-bold">✓</span>
              <span>Giao hàng hỏa tốc trong 24-48 giờ</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-600 font-bold">✓</span>
              <span>Đổi trả miễn phí nếu phát sinh lỗi do nhà sản xuất</span>
            </div>
          </div>
        </div>
      </aside>

    </div>

    <!-- STICKY FLOATING PILL DISCOUNT BAR -->
    <template x-if="isDealer && cart.length > 0">
      <div class="fixed bottom-6 left-1/2 -translate-x-1/2 z-30 max-w-lg w-[92%] sm:w-auto transition-all">
        <div class="flex items-center gap-3 px-4 py-2.5 rounded-full bg-brand-dark/95 backdrop-blur-md text-white shadow-modal border border-brand-accent/30 text-xs">
          <span class="w-2 h-2 rounded-full bg-brand-accent animate-pulse shrink-0"></span>
          <div class="truncate">
            <template x-if="milestoneProgress.nextTier">
              <span>
                Đơn hàng: <strong class="text-brand-accent font-bold" x-text="formatVND(rawSubtotal)"></strong>. Mua thêm <strong class="text-brand-accent font-bold" x-text="formatVND(milestoneProgress.needed)"></strong> nhận thêm <strong class="text-white font-extrabold" x-text="'+' + milestoneProgress.nextTier.percent + '%'"></strong> chiết khấu bậc thang!
              </span>
            </template>
            <template x-if="!milestoneProgress.nextTier">
              <span class="text-emerald-400 font-bold">
                ✓ Đã đạt mức chiết khấu bậc thang tối đa (+7%)!
              </span>
            </template>
          </div>
          <a href="/san-pham" class="hidden sm:inline-flex items-center gap-1 px-3 py-1 rounded-full bg-brand-accent text-brand-dark font-extrabold text-[11px] hover:bg-white transition shrink-0">
            Mua thêm &rarr;
          </a>
        </div>
      </div>
    </template>

  </div>
</BaseLayout>


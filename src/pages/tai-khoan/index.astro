---
// src/pages/tai-khoan/index.astro
export const prerender = false;

import AccountLayout from '@/layouts/AccountLayout.astro';
import { customerService } from '@/services/customer.service';

const auth = (Astro.locals as any)?.auth;

// 1. Kiểm tra xác thực phía server: Chuyển hướng về trang đăng nhập nếu chưa đăng nhập
if (!auth?.isAuthenticated && !auth?.user) {
  return Astro.redirect('/auth/login?redirect=/tai-khoan');
}

// Kiểm tra quyền đại lý hợp lệ
if (!auth?.isDealer || !auth?.partnerId) {
  return Astro.redirect('/auth/login?redirect=/tai-khoan');
}

const partnerId = Number(auth.partnerId);

// 2. Tải thông tin hồ sơ đại lý từ Odoo / customerService
let partner = await customerService.getPartnerById(partnerId);
if (!partner) {
  partner = customerService.getFallbackPartner(partnerId);
}

// Chuẩn hóa dữ liệu hiển thị hồ sơ đại lý
const dealerName = partner.name || auth.partnerName || 'Đại lý LA PET';
const dealerRef = partner.ref || `DL-${partnerId}`;
const dealerPhone = partner.phone || auth.partnerPhone || 'Chưa cập nhật';
const dealerEmail = partner.email || 'Chưa cập nhật';
const dealerAddress = partner.shipping_address || 'Địa chỉ kho chính LA PET';
const dealerPricelist = partner.pricelist || 'Bảng giá Đại lý Tiêu chuẩn';
const deliveryAddresses = partner.delivery_addresses || [];
const isDealerActive = partner.active !== false;
const hasPassword = Boolean(partner.has_password || partner.password_hash);
---

<AccountLayout title="Tài khoản Đại lý - LA PET B2B" activeTab="profile">
  <div class="space-y-8" id="account-portal-container">
    
    <!-- 1. HEADER: XIN CHÀO & THAO TÁC NHANH -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-brand-border/60">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200/60 mb-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>{isDealerActive ? 'Đại lý B2B Chính Thức' : 'Tài khoản đang kiểm tra'}</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-black text-brand-dark tracking-tight">
          Xin chào, {dealerName}
        </h1>
        <p class="text-xs sm:text-sm text-brand-muted mt-1">
          Quản lý thông tin hồ sơ đại lý, lịch sử đơn hàng và theo dõi chính sách thưởng doanh số B2B.
        </p>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <a
          href="/dat-hang-nhanh"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-brand-primary hover:bg-brand-primary/90 text-white text-xs sm:text-sm font-bold shadow-soft transition"
        >
          <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path>
          </svg>
          <span>Đặt hàng nhanh</span>
        </a>
        <button
          type="button"
          id="btn-logout"
          class="inline-flex items-center gap-1.5 px-3 py-2.5 rounded-xl border border-rose-200 text-rose-600 hover:bg-rose-50 text-xs sm:text-sm font-bold transition cursor-pointer"
          title="Đăng xuất khỏi tài khoản"
        >
          <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
          </svg>
          <span class="hidden sm:inline">Đăng xuất</span>
        </button>
      </div>
    </div>

    <!-- 2. HỒ SƠ ĐẠI LÝ (DEALER PROFILE) -->
    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-bold text-brand-dark flex items-center gap-2">
          <svg class="w-5 h-5 text-brand-primary fill-none stroke-current stroke-2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
          </svg>
          <span>Thông tin Hồ sơ Đại lý</span>
        </h2>
        <span class="text-xs text-brand-muted font-medium">Đồng bộ từ hệ thống B2B LA PET</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Card Thông tin Định danh Đại lý -->
        <div class="p-5 rounded-2xl bg-brand-sand/50 border border-brand-border/60 space-y-3.5 shadow-soft">
          <div class="flex justify-between items-center pb-2.5 border-b border-brand-border/60">
            <span class="text-xs font-bold uppercase tracking-wider text-brand-muted">Tên cửa hàng / Đại lý</span>
            <span class="text-sm font-extrabold text-brand-dark text-right">{dealerName}</span>
          </div>

          <div class="flex justify-between items-center pb-2.5 border-b border-brand-border/60">
            <span class="text-xs font-bold uppercase tracking-wider text-brand-muted">Mã đại lý (Ref)</span>
            <div class="flex items-center gap-2">
              <span class="font-mono text-sm font-black text-brand-primary bg-brand-primary/10 px-2 py-0.5 rounded border border-brand-primary/20" id="dealer-ref-badge">
                {dealerRef}
              </span>
              <button
                type="button"
                id="btn-copy-ref"
                data-ref={dealerRef}
                class="text-xs text-brand-muted hover:text-brand-dark cursor-pointer p-1 rounded hover:bg-brand-sand transition"
                title="Sao chép mã đại lý"
              >
                <svg class="w-3.5 h-3.5 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                </svg>
              </button>
            </div>
          </div>

          <div class="flex justify-between items-center pb-2.5 border-b border-brand-border/60">
            <span class="text-xs font-bold uppercase tracking-wider text-brand-muted">Số điện thoại</span>
            <span class="text-sm font-bold text-brand-text">{dealerPhone}</span>
          </div>

          <div class="flex justify-between items-center">
            <span class="text-xs font-bold uppercase tracking-wider text-brand-muted">Email liên hệ</span>
            <span class="text-sm font-bold text-brand-text truncate max-w-[200px]" title={dealerEmail}>{dealerEmail}</span>
          </div>
        </div>

        <!-- Card Bảng giá & Kho giao hàng -->
        <div class="p-5 rounded-2xl bg-brand-sand/50 border border-brand-border/60 space-y-3.5 shadow-soft">
          <div class="flex justify-between items-center pb-2.5 border-b border-brand-border/60">
            <span class="text-xs font-bold uppercase tracking-wider text-brand-muted">Bảng giá áp dụng</span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-extrabold bg-brand-dark text-white">
              <svg class="w-3 h-3 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
              </svg>
              <span>{dealerPricelist}</span>
            </span>
          </div>

          <div class="pb-2.5 border-b border-brand-border/60">
            <span class="text-xs font-bold uppercase tracking-wider text-brand-muted block mb-1">Kho nhận hàng chính</span>
            <p class="text-sm font-semibold text-brand-dark leading-snug">
              {dealerAddress}
            </p>
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <span class="text-xs font-bold uppercase tracking-wider text-brand-muted">Địa chỉ / Chi nhánh phụ</span>
              <span class="text-2xs font-bold text-brand-muted">{deliveryAddresses.length} địa chỉ</span>
            </div>
            {deliveryAddresses.length > 0 ? (
              <ul class="space-y-1.5 max-h-36 overflow-y-auto pr-1 text-xs text-brand-text" id="delivery-addresses-list">
                {deliveryAddresses.map((addr: any) => (
                  <li id={`addr-item-${addr.id}`} class="p-2 rounded-lg bg-white border border-brand-border/80 flex items-center justify-between gap-2 shadow-2xs group">
                    <div class="min-w-0 flex-1">
                      <div class="font-medium truncate">{addr.name}: {addr.street}</div>
                      {addr.phone && <div class="text-2xs text-brand-muted">{addr.phone}</div>}
                    </div>
                    <button
                      type="button"
                      data-id={addr.id}
                      class="btn-delete-sub-address p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition cursor-pointer shrink-0"
                      title="Xóa địa chỉ giao hàng này"
                    >
                      <svg class="w-3.5 h-3.5 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                    </button>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-xs text-brand-muted italic" id="empty-addresses-notice">Chưa đăng ký địa chỉ giao hàng phụ</p>
            )}
          </div>
        </div>
      </div>
    </section>

    <!-- 2.5 BẢO MẬT & ĐỔI MẬT KHẨU ĐẠI LÝ -->
    <section 
      class="p-5 rounded-2xl bg-white border border-brand-border/60 shadow-soft space-y-4"
      x-data={`{
        hasPassword: ${hasPassword},
        showForm: false,
        oldPassword: '',
        newPassword: '',
        confirmPassword: '',
        submitting: false,
        msg: '',
        isError: false,

        async submitChange() {
          this.msg = '';
          this.isError = false;
          if (this.newPassword.length < 6) {
            this.msg = 'Mật khẩu mới phải từ 6 ký tự trở lên.';
            this.isError = true;
            return;
          }
          if (this.newPassword !== this.confirmPassword) {
            this.msg = 'Xác nhận mật khẩu mới không khớp.';
            this.isError = true;
            return;
          }

          this.submitting = true;
          try {
            const res = await fetch('/api/customers/change-password', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                oldPassword: this.oldPassword,
                newPassword: this.newPassword,
                confirmPassword: this.confirmPassword,
              })
            });
            const data = await res.json();
            if (res.ok && data.success) {
              this.msg = '✓ ' + (data.message || 'Cập nhật mật khẩu thành công!');
              this.hasPassword = true;
              this.oldPassword = '';
              this.newPassword = '';
              this.confirmPassword = '';
              setTimeout(() => { this.showForm = false; }, 2000);
            } else {
              this.msg = data.error || 'Đổi mật khẩu thất bại.';
              this.isError = true;
            }
          } catch {
            this.msg = 'Không thể kết nối đến máy chủ.';
            this.isError = true;
          } finally {
            this.submitting = false;
          }
        }
      }`}
    >
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-brand-primary/10 text-brand-primary flex items-center justify-center text-lg shrink-0">
            🔐
          </div>
          <div>
            <h2 class="text-base font-bold text-brand-dark">Bảo mật tài khoản & Mật khẩu</h2>
            <p class="text-xs text-brand-muted mt-0.5">
              <span x-show="hasPassword" class="text-emerald-600 font-semibold">● Đã thiết lập mật khẩu đăng nhập</span>
              <span x-show="!hasPassword" class="text-amber-600 font-semibold">● Chưa thiết lập mật khẩu (chỉ đăng nhập bằng mã OTP)</span>
            </p>
          </div>
        </div>

        <button
          type="button"
          @click="showForm = !showForm; msg = '';"
          class="px-4 py-2 rounded-xl text-xs font-bold border transition cursor-pointer"
          :class="showForm ? 'bg-slate-100 text-slate-700 border-slate-300' : 'bg-brand-primary text-white border-brand-primary hover:bg-brand-primary/90'"
          x-text="showForm ? 'Hủy' : (hasPassword ? 'Đổi mật khẩu' : 'Thiết lập mật khẩu mới')"
        ></button>
      </div>

      <!-- FORM ĐỔI / THIẾT LẬP MẬT KHẨU -->
      <div x-show="showForm" x-cloak class="pt-4 border-t border-brand-border/60">
        <form @submit.prevent="submitChange()" class="space-y-4 max-w-lg">
          <div 
            x-show="msg" 
            x-text="msg" 
            :class="isError ? 'bg-rose-50 text-rose-600 border-rose-200' : 'bg-emerald-50 text-emerald-700 border-emerald-200'"
            class="p-3 text-xs font-semibold rounded-xl border"
          ></div>

          <template x-if="hasPassword">
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-brand-muted mb-1">
                Mật khẩu hiện tại
              </label>
              <input
                type="password"
                x-model="oldPassword"
                required
                placeholder="••••••••"
                class="w-full px-3.5 py-2.5 rounded-xl border border-brand-border bg-brand-surface/50 text-sm text-brand-dark focus:outline-none focus:border-brand-primary"
              />
            </div>
          </template>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-brand-muted mb-1">
              Mật khẩu mới (tối thiểu 6 ký tự)
            </label>
            <input
              type="password"
              x-model="newPassword"
              required
              minlength="6"
              placeholder="••••••••"
              class="w-full px-3.5 py-2.5 rounded-xl border border-brand-border bg-brand-surface/50 text-sm text-brand-dark focus:outline-none focus:border-brand-primary"
            />
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-brand-muted mb-1">
              Xác nhận mật khẩu mới
            </label>
            <input
              type="password"
              x-model="confirmPassword"
              required
              minlength="6"
              placeholder="••••••••"
              class="w-full px-3.5 py-2.5 rounded-xl border border-brand-border bg-brand-surface/50 text-sm text-brand-dark focus:outline-none focus:border-brand-primary"
            />
          </div>

          <div class="flex items-center gap-3 pt-2">
            <button
              type="submit"
              :disabled="submitting"
              class="px-5 py-2.5 rounded-xl bg-brand-primary hover:bg-brand-primary/90 text-white text-xs font-bold uppercase tracking-wider shadow-soft transition cursor-pointer disabled:opacity-50"
            >
              <span x-text="submitting ? 'ĐANG LƯU...' : 'LƯU MẬT KHẨU'"></span>
            </button>
            <button
              type="button"
              @click="showForm = false"
              class="px-4 py-2.5 rounded-xl border border-brand-border text-xs font-bold text-brand-muted hover:bg-slate-50 transition cursor-pointer"
            >
              Đóng
            </button>
          </div>
        </form>
      </div>
    </section>

    <!-- 3. BANNER B2B: CHÍNH SÁCH THƯỞNG DOANH SỐ QUÝ & NĂM -> /hoan-tat -->
    <section class="rounded-2xl p-6 sm:p-7 bg-gradient-to-br from-brand-dark via-brand-dark to-brand-primary text-white shadow-soft relative overflow-hidden">
      <!-- Background pattern decoration -->
      <div class="absolute -right-12 -bottom-12 w-48 h-48 bg-white/5 rounded-full blur-2xl pointer-events-none"></div>
      <div class="absolute right-8 top-6 opacity-10 text-white pointer-events-none">
        <svg class="w-32 h-32" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
        </svg>
      </div>

      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="space-y-2 max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-white/10 text-emerald-200 backdrop-blur-xs border border-white/10">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>
            <span>Chương trình Đối tác Chiến lược 2026</span>
          </div>
          <h3 class="text-xl sm:text-2xl font-black tracking-tight leading-snug">
            Chính sách Thưởng Doanh Số Quý & Năm
          </h3>
          <p class="text-xs sm:text-sm text-emerald-50/90 leading-relaxed">
            Theo dõi tiến độ tích lũy doanh số và bậc thưởng đại lý tại LA PET. Nhận chiết khấu thưởng bậc thang từ <strong class="text-white font-extrabold">1.0% đến 5.0%</strong> khi đạt mốc doanh số định kỳ.
          </p>
          <div class="flex flex-wrap gap-2 pt-1 text-2xs font-semibold text-white/80">
            <span class="bg-white/10 px-2.5 py-1 rounded-lg">Mốc Quý: Thưởng lên đến 2.5%</span>
            <span class="bg-white/10 px-2.5 py-1 rounded-lg">Mốc Năm: Thưởng lên đến 5.0%</span>
            <span class="bg-white/10 px-2.5 py-1 rounded-lg">Cập nhật tự động theo đơn hàng</span>
          </div>
        </div>

        <div class="shrink-0">
          <a
            href="/hoan-tat"
            class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-2xl bg-white text-brand-dark hover:bg-emerald-50 text-xs sm:text-sm font-black shadow-md transition duration-200 group"
          >
            <span>Xem tiến độ tích lũy & thưởng</span>
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- 4. BẢNG LỊCH SỬ ĐƠN HÀNG (ORDER HISTORY & RE-ORDER) -->
    <section class="space-y-4" id="order-history-section">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-2 border-b border-brand-border/60">
        <div>
          <h2 class="text-lg font-bold text-brand-dark flex items-center gap-2">
            <svg class="w-5 h-5 text-brand-primary fill-none stroke-current stroke-2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
            </svg>
            <span>Lịch sử Đơn hàng Gần đây</span>
          </h2>
          <p class="text-xs text-brand-muted mt-0.5">
            Xem lại các đơn hàng đã đặt, theo dõi trạng thái xử lý và đặt lại đơn nhanh chóng.
          </p>
        </div>

        <div class="flex items-center gap-2 text-xs font-semibold">
          <a
            href="/tai-khoan/don-hang"
            class="inline-flex items-center gap-1 text-brand-primary hover:underline font-bold"
          >
            <span>Xem toàn bộ lịch sử</span>
            <span>→</span>
          </a>
          <span id="order-total-count" class="bg-brand-sand px-2.5 py-1 rounded-lg text-brand-muted">Đang tải...</span>
        </div>
      </div>

      <!-- DESKTOP VIEW: BẢNG LỊCH SỬ ĐƠN HÀNG -->
      <div class="hidden sm:block overflow-x-auto rounded-2xl border border-brand-border bg-white shadow-soft">
        <table class="w-full text-left text-sm border-collapse">
          <thead>
            <tr class="bg-brand-sand/60 border-b border-brand-border text-brand-muted text-xs font-bold uppercase tracking-wider">
              <th class="py-3 px-4">Mã đơn hàng</th>
              <th class="py-3 px-4">Ngày đặt</th>
              <th class="py-3 px-4">Số lượng</th>
              <th class="py-3 px-4 text-right">Tổng tiền</th>
              <th class="py-3 px-4 text-center">Trạng thái</th>
              <th class="py-3 px-4 text-center">Thao tác</th>
            </tr>
          </thead>
          <tbody id="orders-tbody-desktop" class="divide-y divide-brand-border/60 text-brand-text">
            <tr>
              <td colspan="6" class="py-12 text-center text-brand-muted text-xs">
                <div class="inline-flex items-center gap-2">
                  <span class="w-3 h-3 rounded-full bg-brand-primary animate-ping"></span>
                  <span>Đang tải lịch sử đơn hàng từ hệ thống...</span>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- MOBILE VIEW: CARDS GỌN GÀNG (390px RESPONSIVE) -->
      <div id="orders-cards-mobile" class="sm:hidden space-y-3">
        <div class="py-8 text-center text-brand-muted text-xs">
          <div class="inline-flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-brand-primary animate-ping"></span>
            <span>Đang tải lịch sử đơn hàng...</span>
          </div>
        </div>
      </div>

      <!-- PHÂN TRANG -->
      <div id="orders-pagination" class="pt-2"></div>
    </section>

    <!-- TOAST THÔNG BÁO TÁC VỤ RE-ORDER -->
    <div
      id="portal-toast"
      class="fixed bottom-6 right-6 max-w-md bg-white rounded-2xl shadow-modal border border-brand-border p-4 transform translate-y-32 opacity-0 transition-all duration-300 z-50 pointer-events-none"
    >
      <div class="flex items-start gap-3">
        <div id="toast-icon-wrapper" class="w-8 h-8 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-sm shrink-0">
          ✓
        </div>
        <div class="flex-1 space-y-1">
          <p id="toast-title" class="font-bold text-brand-dark text-xs sm:text-sm">Đã thêm vào giỏ hàng</p>
          <p id="toast-desc" class="text-brand-muted text-2xs sm:text-xs">Sản phẩm từ đơn cũ đã được đồng bộ vào giỏ.</p>
          <div class="pt-2 flex items-center gap-2">
            <a
              href="/gio-hang"
              class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-brand-primary text-white text-xs font-bold hover:bg-brand-primary/90 transition shadow-xs"
            >
              <span>Xem giỏ hàng</span>
              <span>→</span>
            </a>
            <button
              type="button"
              id="btn-close-toast"
              class="px-2.5 py-1.5 rounded-lg border border-brand-border text-brand-muted text-xs font-semibold hover:bg-brand-sand cursor-pointer"
            >
              Đóng
            </button>
          </div>
        </div>
      </div>
    </div>

  </div>
</AccountLayout>

<script>
// Logic chạy phía Client: Tải danh sách đơn hàng & Xử lý Re-Order
function initAccountPortal() {
  const STATUS_MAP: Record<string, { label: string; color: string }> = {
    draft: { label: 'Đơn nháp', color: 'bg-sky-50 text-sky-700 border-sky-200' },
    sent: { label: 'Đơn nháp', color: 'bg-sky-50 text-sky-700 border-sky-200' },
    confirmed: { label: 'Đơn bán hàng', color: 'bg-blue-50 text-blue-700 border-blue-200' },
    sale: { label: 'Đơn bán hàng', color: 'bg-blue-50 text-blue-700 border-blue-200' },
    delivered: { label: 'Đã giao', color: 'bg-teal-50 text-teal-700 border-teal-200' },
    shipping: { label: 'Đã giao', color: 'bg-teal-50 text-teal-700 border-teal-200' },
    completed: { label: 'Đã hoàn tất', color: 'bg-emerald-50 text-emerald-700 border-emerald-200' },
    done: { label: 'Đã hoàn tất', color: 'bg-emerald-50 text-emerald-700 border-emerald-200' },
    cancelled: { label: 'Đã hủy', color: 'bg-rose-50 text-rose-600 border-rose-200' },
    cancel: { label: 'Đã hủy', color: 'bg-rose-50 text-rose-600 border-rose-200' },
  };

  let ordersList: any[] = [];
  let currentPage = 1;
  const ITEMS_PER_PAGE = 5;

  const desktopTbody = document.getElementById('orders-tbody-desktop');
  const mobileCardsContainer = document.getElementById('orders-cards-mobile');
  const countBadge = document.getElementById('order-total-count');
  const paginationContainer = document.getElementById('orders-pagination');
  const toastEl = document.getElementById('portal-toast');
  const btnCloseToast = document.getElementById('btn-close-toast');
  const btnLogout = document.getElementById('btn-logout');
  const btnCopyRef = document.getElementById('btn-copy-ref');

  let toastTimer: any = null;

  function showToast(title: string, desc: string, isError = false) {
    if (!toastEl) return;
    const titleEl = document.getElementById('toast-title');
    const descEl = document.getElementById('toast-desc');
    const iconEl = document.getElementById('toast-icon-wrapper');

    if (titleEl) titleEl.textContent = title;
    if (descEl) descEl.textContent = desc;
    if (iconEl) {
      iconEl.className = isError
        ? 'w-8 h-8 rounded-full bg-rose-100 text-rose-700 flex items-center justify-center font-bold text-sm shrink-0'
        : 'w-8 h-8 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-sm shrink-0';
      iconEl.textContent = isError ? '!' : '✓';
    }

    toastEl.classList.remove('translate-y-32', 'opacity-0', 'pointer-events-none');
    toastEl.classList.add('translate-y-0', 'opacity-100');

    if (toastTimer) clearTimeout(toastTimer);
    toastTimer = setTimeout(() => {
      closeToast();
    }, 6000);
  }

  function closeToast() {
    if (!toastEl) return;
    toastEl.classList.remove('translate-y-0', 'opacity-100');
    toastEl.classList.add('translate-y-32', 'opacity-0', 'pointer-events-none');
  }

  btnCloseToast?.addEventListener('click', closeToast);

  // Xử lý nút Sao chép mã đại lý
  btnCopyRef?.addEventListener('click', () => {
    const ref = btnCopyRef.getAttribute('data-ref') || '';
    if (ref) {
      navigator.clipboard.writeText(ref).then(() => {
        showToast('Đã sao chép mã đại lý', `Mã đại lý: ${ref}`);
      }).catch(() => {
        showToast('Mã đại lý', ref);
      });
    }
  });

  // Xử lý Đăng xuất
  btnLogout?.addEventListener('click', async () => {
    if (!confirm('Quý khách có chắc chắn muốn đăng xuất khỏi tài khoản Đại lý?')) {
      return;
    }

    try {
      btnLogout.setAttribute('disabled', 'true');
      btnLogout.classList.add('opacity-50');

      await fetch('/api/auth/logout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
      });

      localStorage.removeItem('auth_token');
      localStorage.removeItem('user_info');
      localStorage.removeItem('user');

      window.dispatchEvent(new CustomEvent('auth-changed'));
      window.location.href = '/auth/login';
    } catch (err) {
      console.error('Lỗi đăng xuất:', err);
      window.location.href = '/auth/login';
    }
  });

  // Tải danh sách đơn hàng
  async function loadOrderHistory() {
    try {
      const response = await fetch('/api/orders/history', { credentials: 'include' });
      if (!response.ok) {
        throw new Error('Không thể tải lịch sử đơn hàng từ máy chủ');
      }

      const data = await response.json();
      ordersList = Array.isArray(data) ? data : [];

      if (countBadge) {
        countBadge.textContent = `Tổng: ${ordersList.length} đơn hàng`;
      }

      renderOrdersTable();
    } catch (error: any) {
      console.warn('[Account Portal] Lỗi tải lịch sử đơn:', error);
      if (desktopTbody) {
        desktopTbody.innerHTML = `
          <tr>
            <td colspan="6" class="py-8 text-center text-rose-500 text-xs">
              Lỗi kết nối tải lịch sử đơn hàng: ${error?.message || 'Vui lòng thử lại sau.'}
            </td>
          </tr>
        `;
      }
      if (mobileCardsContainer) {
        mobileCardsContainer.innerHTML = `
          <div class="py-6 text-center text-rose-500 text-xs">
            Lỗi kết nối tải lịch sử đơn hàng.
          </div>
        `;
      }
      if (countBadge) {
        countBadge.textContent = '0 đơn hàng';
      }
    }
  }

  function escapeHtml(str: any): string {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function renderOrdersTable() {
    if (ordersList.length === 0) {
      const emptyHtml = `
        <div class="py-12 text-center space-y-3">
          <div class="w-12 h-12 rounded-full bg-brand-sand text-brand-primary flex items-center justify-center mx-auto">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m7.5 4.27 9 5.15M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5M12 22V12"/></svg>
          </div>
          <p class="text-sm font-bold text-brand-dark">Chưa có đơn hàng nào được ghi nhận</p>
          <p class="text-xs text-brand-muted max-w-sm mx-auto">
            Quý đại lý có thể khởi tạo đơn hàng nhanh để bắt đầu tích lũy doanh số và hưởng mức chiết khấu tốt nhất.
          </p>
          <a
            href="/dat-hang-nhanh"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-brand-primary text-white text-xs font-bold hover:bg-brand-primary/90 transition shadow-soft"
          >
            + Đặt hàng ngay
          </a>
        </div>
      `;

      if (desktopTbody) {
        desktopTbody.innerHTML = `<tr><td colspan="6">${emptyHtml}</td></tr>`;
      }
      if (mobileCardsContainer) {
        mobileCardsContainer.innerHTML = emptyHtml;
      }
      if (paginationContainer) {
        paginationContainer.innerHTML = '';
      }
      return;
    }

    const totalItems = ordersList.length;
    const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE);

    if (currentPage > totalPages) currentPage = totalPages;
    if (currentPage < 1) currentPage = 1;

    const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
    const endIndex = Math.min(startIndex + ITEMS_PER_PAGE, totalItems);
    const pagedOrders = ordersList.slice(startIndex, endIndex);

    // Desktop render
    if (desktopTbody) {
      desktopTbody.innerHTML = pagedOrders
        .map((ord) => {
          const orderState = ord.status || ord.state || 'draft';
          const st = STATUS_MAP[orderState] || {
            label: orderState === 'draft' ? 'Đơn nháp' : orderState,
            color: 'bg-brand-sand text-brand-dark border-brand-border',
          };
          const orderCode = ord.id || ord.raw_id || '--';

          return `
            <tr class="hover:bg-brand-surface/80 transition border-b border-brand-border/60 last:border-b-0">
              <td class="py-3 px-4 font-mono font-bold text-brand-dark">
                #${escapeHtml(orderCode)}
              </td>
              <td class="py-3 px-4 text-xs text-brand-muted font-medium">
                ${escapeHtml(ord.date) || '--'}
              </td>
              <td class="py-3 px-4 text-xs font-semibold text-brand-dark text-center">
                ${ord.items_count || 0} SP
              </td>
              <td class="py-3 px-4 text-right font-extrabold text-brand-dark">
                ${(ord.amount_total || 0).toLocaleString('vi-VN')}đ
              </td>
              <td class="py-3 px-4 text-center">
                <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-bold border ${st.color}">
                  ${escapeHtml(st.label)}
                </span>
              </td>
              <td class="py-3 px-4 text-center">
                <div class="inline-flex items-center gap-1.5 justify-center">
                  <a
                    href="/hoan-tat?order_id=${encodeURIComponent(orderCode)}"
                    class="px-2.5 py-1 rounded-lg text-xs font-bold border border-brand-border text-brand-dark hover:bg-brand-sand transition"
                    title="Xem chi tiết đơn hàng"
                  >
                    Xem
                  </a>
                  <button
                    type="button"
                    class="btn-reorder px-2.5 py-1 rounded-lg text-xs font-bold bg-brand-primary/10 text-brand-primary border border-brand-primary/20 hover:bg-brand-primary hover:text-white transition flex items-center gap-1 cursor-pointer"
                    data-order-id="${escapeHtml(orderCode)}"
                    data-raw-id="${escapeHtml(ord.raw_id || '')}"
                    title="Thêm các sản phẩm của đơn này vào giỏ hàng"
                  >
                    <svg class="w-3.5 h-3.5 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                    </svg>
                    <span>Đặt lại</span>
                  </button>
                </div>
              </td>
            </tr>
          `;
        })
        .join('');
    }

    // Mobile render (390px responsive)
    if (mobileCardsContainer) {
      mobileCardsContainer.innerHTML = pagedOrders
        .map((ord) => {
          const orderState = ord.status || ord.state || 'draft';
          const st = STATUS_MAP[orderState] || {
            label: orderState === 'draft' ? 'Đơn nháp' : orderState,
            color: 'bg-brand-sand text-brand-dark border-brand-border',
          };
          const orderCode = ord.id || ord.raw_id || '--';

          return `
            <div class="p-4 rounded-2xl border border-brand-border bg-white shadow-soft space-y-3">
              <div class="flex justify-between items-start">
                <div>
                  <span class="font-mono font-black text-sm text-brand-dark block">#${escapeHtml(orderCode)}</span>
                  <span class="text-2xs text-brand-muted block font-medium mt-0.5">
                    ${escapeHtml(ord.date) || '--'} • ${ord.items_count || 0} sản phẩm
                  </span>
                </div>
                <span class="inline-block px-2.5 py-0.5 rounded-full text-2xs font-bold border ${st.color}">
                  ${escapeHtml(st.label)}
                </span>
              </div>

              <div class="flex justify-between items-center pt-2 border-t border-brand-border/60">
                <div>
                  <span class="text-3xs text-brand-muted block uppercase font-bold tracking-wider">Tổng tiền</span>
                  <span class="font-black text-sm text-brand-dark">${(ord.amount_total || 0).toLocaleString('vi-VN')}đ</span>
                </div>

                <div class="flex items-center gap-1.5">
                  <a
                    href="/hoan-tat?order_id=${encodeURIComponent(orderCode)}"
                    class="px-2.5 py-1.5 rounded-xl border border-brand-border text-brand-dark text-xs font-bold hover:bg-brand-sand transition"
                  >
                    Chi tiết
                  </a>
                  <button
                    type="button"
                    class="btn-reorder px-3 py-1.5 rounded-xl bg-brand-primary text-white text-xs font-bold hover:bg-brand-primary/90 transition flex items-center gap-1 cursor-pointer shadow-xs"
                    data-order-id="${escapeHtml(orderCode)}"
                    data-raw-id="${escapeHtml(ord.raw_id || '')}"
                  >
                    <svg class="w-3.5 h-3.5 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                    </svg>
                    <span>Đặt lại</span>
                  </button>
                </div>
              </div>
            </div>
          `;
        })
        .join('');
    }

    attachReorderEvents();
    renderPagination(totalItems, totalPages);
  }

  function renderPagination(totalItems: number, totalPages: number) {
    if (!paginationContainer) return;
    if (totalPages <= 1) {
      paginationContainer.innerHTML = '';
      return;
    }

    const startIndex = (currentPage - 1) * ITEMS_PER_PAGE + 1;
    const endIndex = Math.min(currentPage * ITEMS_PER_PAGE, totalItems);

    let buttons = '';
    for (let i = 1; i <= totalPages; i++) {
      const isCurrent = i === currentPage;
      buttons += `
        <button
          type="button"
          data-page="${i}"
          class="btn-page px-2.5 py-1 rounded-lg text-xs font-bold transition cursor-pointer ${
            isCurrent ? 'bg-brand-primary text-white' : 'bg-brand-sand text-brand-muted hover:bg-brand-sand-hover'
          }"
        >
          ${i}
        </button>
      `;
    }

    paginationContainer.innerHTML = `
      <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-xs pt-3 border-t border-brand-border/60">
        <span class="text-brand-muted font-medium">
          Hiển thị <strong class="text-brand-dark">${startIndex} - ${endIndex}</strong> trên <strong class="text-brand-dark">${totalItems}</strong> đơn hàng
        </span>
        <div class="flex items-center gap-1">
          <button
            type="button"
            id="btn-prev-orders"
            ${currentPage === 1 ? 'disabled' : ''}
            class="px-2 py-1 rounded-lg border border-brand-border text-brand-muted hover:bg-brand-sand disabled:opacity-30 disabled:cursor-not-allowed font-bold text-xs cursor-pointer"
          >
            ‹
          </button>
          ${buttons}
          <button
            type="button"
            id="btn-next-orders"
            ${currentPage === totalPages ? 'disabled' : ''}
            class="px-2 py-1 rounded-lg border border-brand-border text-brand-muted hover:bg-brand-sand disabled:opacity-30 disabled:cursor-not-allowed font-bold text-xs cursor-pointer"
          >
            ›
          </button>
        </div>
      </div>
    `;

    document.getElementById('btn-prev-orders')?.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        renderOrdersTable();
      }
    });

    document.getElementById('btn-next-orders')?.addEventListener('click', () => {
      if (currentPage < totalPages) {
        currentPage++;
        renderOrdersTable();
      }
    });

    paginationContainer.querySelectorAll('.btn-page').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const page = Number((e.currentTarget as HTMLElement).getAttribute('data-page'));
        if (page && page !== currentPage) {
          currentPage = page;
          renderOrdersTable();
        }
      });
    });
  }

  function attachReorderEvents() {
    document.querySelectorAll('.btn-reorder').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const button = e.currentTarget as HTMLButtonElement;
        const orderId = button.getAttribute('data-order-id') || '';
        const rawId = button.getAttribute('data-raw-id') || '';

        if (!orderId && !rawId) return;

        const originalText = button.innerHTML;
        button.setAttribute('disabled', 'true');
        button.innerHTML = `
          <span class="w-3 h-3 rounded-full border-2 border-current border-t-transparent animate-spin inline-block"></span>
          <span>Đang nạp...</span>
        `;

        try {
          let orderDetails: any = null;
          let fetchRes = await fetch(`/api/orders/${encodeURIComponent(orderId)}`);

          if (fetchRes.ok) {
            orderDetails = await fetchRes.json();
          } else if (rawId && rawId !== orderId) {
            fetchRes = await fetch(`/api/orders/${encodeURIComponent(rawId)}`);
            if (fetchRes.ok) {
              orderDetails = await fetchRes.json();
            }
          }

          if (!orderDetails || !Array.isArray(orderDetails.items) || orderDetails.items.length === 0) {
            throw new Error('Đơn hàng này không có danh sách sản phẩm hợp lệ để đặt lại.');
          }

          let currentCart: any[] = [];
          try {
            currentCart = JSON.parse(localStorage.getItem('cart') || '[]');
            if (!Array.isArray(currentCart)) currentCart = [];
          } catch {
            currentCart = [];
          }

          let addedCount = 0;

          orderDetails.items.forEach((item: any) => {
            const itemQty = Number(item.qty || item.quantity || 1);
            const itemId = String(item.id || item.odoo_id || '');
            const itemPrice = Number(item.price || item.price_unit || 0);

            const existingItem = currentCart.find(
              (c: any) =>
                (c.odoo_id && String(c.odoo_id) === itemId) ||
                (c.id && String(c.id) === itemId) ||
                (c.name && c.name.trim().toLowerCase() === String(item.name).trim().toLowerCase())
            );

            if (existingItem) {
              existingItem.quantity = (Number(existingItem.quantity) || 1) + itemQty;
            } else {
              currentCart.push({
                id: itemId,
                odoo_id: !isNaN(Number(itemId)) ? Number(itemId) : null,
                name: item.name || 'Sản phẩm LA PET',
                price: itemPrice,
                retail_price: itemPrice,
                wholesale_price: itemPrice,
                quantity: itemQty,
                image: '/images/placeholder-product.svg',
              });
            }

            addedCount += itemQty;
          });

          localStorage.setItem('cart', JSON.stringify(currentCart));
          window.dispatchEvent(new Event('cart-updated'));
          window.dispatchEvent(new CustomEvent('cart-updated'));

          showToast(
            'Đặt lại đơn hàng thành công!',
            `Đã đưa ${addedCount} sản phẩm từ đơn #${orderId} vào giỏ hàng.`
          );
        } catch (err: any) {
          console.error('[Re-order Error]:', err);
          showToast(
            'Không thể đặt lại đơn hàng',
            err?.message || 'Có lỗi khi lấy danh sách sản phẩm của đơn hàng.',
            true
          );
        } finally {
          button.removeAttribute('disabled');
          button.innerHTML = originalText;
        }
      });
    });
  }

  // Gắn sự kiện xóa địa chỉ phụ
  document.querySelectorAll('.btn-delete-sub-address').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      const targetBtn = e.currentTarget as HTMLElement;
      const id = targetBtn?.getAttribute('data-id');
      if (!id || !confirm('Quý khách có chắc chắn muốn xóa địa chỉ phụ này?')) return;

      try {
        const res = await fetch(`/api/customers/addresses?id=${encodeURIComponent(id)}`, {
          method: 'DELETE',
        });
        const data = await res.json();
        if (data.success) {
          document.getElementById(`addr-item-${id}`)?.remove();
          const list = document.getElementById('delivery-addresses-list');
          if (list && list.children.length === 0) {
            list.parentElement?.insertAdjacentHTML('beforeend', '<p class="text-xs text-brand-muted italic" id="empty-addresses-notice">Chưa đăng ký địa chỉ giao hàng phụ</p>');
            list.remove();
          }
          showToast('Đã xóa địa chỉ', 'Địa chỉ giao hàng phụ đã được xóa thành công.');
        } else {
          showToast('Không thể xóa địa chỉ', data.error || 'Có lỗi xảy ra', true);
        }
      } catch (err: any) {
        showToast('Lỗi kết nối', err?.message || 'Không thể kết nối đến máy chủ', true);
      }
    });
  });

  loadOrderHistory();
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initAccountPortal, { once: true });
} else {
  initAccountPortal();
}

document.addEventListener('astro:page-load', initAccountPortal);
</script>

    price: 28000,
    wholesale_price: 21840,
    image: '/c10.webp',
    sold_quantity: 9100,
  }
];

// Chuẩn hóa danh sách sản phẩm hiển thị
const allProducts = rawShowcaseProducts.length > 0
  ? rawShowcaseProducts.map((p) => {
      const retail = p.price || 20000;
      const wholesale = p.wholesale_price && p.wholesale_price < retail
        ? p.wholesale_price
        : Math.round(retail * 0.78);
      const skuLower = (p.sku || '').toLowerCase();
      const localFallback = skuLower ? `/${skuLower}.webp` : '/images/placeholder-product.svg';
      const img = p.imageIds?.[0]
        ? assetUrl(p.imageIds[0], { width: 400, height: 500, fit: 'contain', quality: 85, format: 'webp' })
        : localFallback;
      return {
        id: p.id,
        odoo_id: p.odoo_id || p.id,
        sku: p.sku || 'LAPET',
        name: p.name,
        slug: p.slug,
        price: retail,
        wholesale_price: wholesale,
        image: img,
        sold_quantity: p.sold_quantity || 0,
      };
    })
  : fallbackProducts;

// Phân chia các danh mục sản phẩm trên trang chủ (mỗi hàng 4 sản phẩm)
const trendingList = allProducts.slice(0, 4);
const bestSellerList = allProducts.length >= 8 ? allProducts.slice(4, 8) : allProducts.slice(0, 4);
const lowestPriceList = allProducts.length >= 12 ? allProducts.slice(8, 12) : fallbackProducts.slice(8, 12);

// Danh mục thực tế với 8 icon độc quyền từ LA PET và 8 ô màu pastel chuẩn PawZone
const defaultCategoryList = [
  { 
    name: 'Nhóm không quấn gà', 
    slug: 'nhom-khong-quan-ga', 
    icon: '/pawzone_assets/cat_icon_khong_quan_ga.png',
    bgColor: '#FDF6E4' 
  },
  { 
    name: 'Nhóm quấn gà', 
    slug: 'nhom-quan-ga', 
    icon: '/pawzone_assets/cat_icon_quan_ga.png',
    bgColor: '#E3F3F9' 
  },
  { 
    name: 'Nhóm da bò', 
    slug: 'nhom-da-bo', 
    icon: '/pawzone_assets/cat_icon_da_bo.png',
    bgColor: '#FEE7EC' 
  },
  { 
    name: 'Nhóm keo nhai', 
    slug: 'nhom-keo-nhai', 
    icon: '/pawzone_assets/cat_icon_keo_nhai.png',
    bgColor: '#E9F7EF' 
  },
  { 
    name: 'Nhóm thịt sấy', 
    slug: 'nhom-thit-say', 
    icon: '/pawzone_assets/cat_icon_thit_say.png',
    bgColor: '#E9F9EE' 
  },
  { 
    name: 'Nhóm que gặm tổng hợp', 
    slug: 'nhom-que-gam-tong-hop', 
    icon: '/pawzone_assets/cat_icon_tong_hop.png',
    bgColor: '#FEF4E8' 
  },
  { 
    name: 'Tã cho thú cưng', 
    slug: 'ta-cho-thu-cung', 
    icon: '/pawzone_assets/cat_icon_ta.png',
    bgColor: '#E3F1FB' 
  },
  { 
    name: 'Cát vệ sinh cho mèo', 
    slug: 'cat-ve-sinh-meo', 
    icon: '/pawzone_assets/cat_icon_cat.png',
    bgColor: '#FEE8EC' 
  },
];

const displayCategories = defaultCategoryList.map((item) => {
  const matched = rawProductGroups.find(g => g.slug === item.slug);
  return {
    name: matched?.name || item.name,
    slug: matched?.slug || item.slug,
    bgColor: item.bgColor,
    icon: item.icon,
  };
});

// Cam kết dịch vụ
const valueProps = [
  {
    icon: 'M13 10V3L4 14h7v7l9-11h-7z',
    title: 'Giao Hàng Hỏa Tốc',
    desc: 'Nội thành chỉ trong 2 giờ, hỗ trợ chành xe toàn quốc'
  },
  {
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
    title: 'Hàng Chính Hãng 100%',
    desc: 'Đầy đủ chứng nhận kiểm định & hóa đơn VAT'
  },
  {
    icon: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15',
    title: 'Đổi Trả Trong 7 Ngày',
    desc: 'Bảo hành chất lượng, đổi mới sản phẩm lỗi do nhà sản xuất'
  },
  {
    icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
    title: 'Chiết Khấu Đại Lý Tới 22%',
    desc: 'Bảng giá sỉ B2B minh bạch cùng thưởng doanh số theo quý'
  }
];

const pageTitle = "LA PET - Cổng Đặt Hàng B2B Đại Lý Phụ Kiện & Thức Ăn Thú Cưng";
const pageDescription = "Cổng phân phối sỉ bánh thưởng, que gặm, tã lót và cát vệ sinh thú cưng cao cấp LA PET. Chiết khấu đại lý tới 22%, hỗ trợ giao hàng hỏa tốc toàn quốc.";
---

<BaseLayout title={pageTitle} description={pageDescription}>

  <div class="max-w-[1140px] mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-10 sm:space-y-12">

    <!-- ================= 1. HERO BENTO GRID (3 Cards chuẩn phong cách PawZone) ================= -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-stretch">
      
      <!-- Big Left Card: Chiết khấu lên tới 22% OFF (#9CD0EA) -->
      <div class="lg:col-span-8 bg-[#9CD0EA] rounded-[28px] p-6 sm:p-10 relative overflow-hidden flex flex-col justify-between min-h-[380px] sm:min-h-[420px] lg:min-h-[460px] shadow-sm">
        
        <!-- Full-cover background image: White cat reaching toward food bowl -->
        <img 
          src="/pawzone_assets/hero_big_cat_bowl.png" 
          alt="Dinh dưỡng thú cưng LA PET" 
          class="absolute inset-0 w-full h-full object-cover object-center pointer-events-none select-none"
        />

        <!-- Text Area (on left side) -->
        <div class="max-w-xs sm:max-w-sm space-y-2 relative z-10">
          <p class="text-xs sm:text-sm font-bold text-[#07394D] uppercase tracking-wider">Chiết khấu đại lý lên tới</p>
          
          <div class="relative inline-block pb-1">
            <h1 class="text-4xl sm:text-5xl font-black text-[#07394D] tracking-tight leading-none">
              22% OFF
            </h1>
            <!-- The signature yellow underline under 22% OFF -->
            <div class="w-full h-1.5 bg-[#F8DE59] mt-1.5 rounded-full"></div>
          </div>

          <p class="text-xs sm:text-sm font-semibold text-[#07394D] pt-1">
            Hàng ngàn sản phẩm thú cưng cao cấp cho đại lý &amp; nhà phân phối toàn quốc
          </p>

          <div class="pt-4 flex flex-wrap items-center gap-3">
            <a 
              href="/san-pham" 
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#07394D] hover:bg-[#052937] text-white text-xs sm:text-sm font-bold shadow-sm transition-transform hover:-translate-y-0.5 cursor-pointer"
            >
              <span>Xem Bảng Giá Sỉ</span>
              <span>&gt;</span>
            </a>
            <a 
              href="/dat-hang-nhanh" 
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white/90 hover:bg-white text-[#07394D] text-xs sm:text-sm font-bold shadow-sm transition-transform hover:-translate-y-0.5 cursor-pointer"
            >
              <span>Đặt Hàng Nhanh</span>
            </a>
          </div>
        </div>

        <!-- Bottom slider indicator -->
        <div class="relative z-10 pt-6 flex items-center gap-1.5 text-[11px] font-bold text-[#07394D]">
          <span class="inline-block w-5 h-1 bg-[#07394D] rounded-full"></span>
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-[#07394D]"></span>
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-[#07394D]/50"></span>
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-[#07394D]/50"></span>
        </div>

      </div>

      <!-- Right Stacked 2 Cards -->
      <div class="lg:col-span-4 flex flex-col gap-5">
        
        <!-- Top Right Card: Dành Cho Mèo (#015D7F) -->
        <div class="flex-1 bg-[#015D7F] rounded-[28px] p-5 sm:p-6 relative overflow-hidden flex items-center justify-between min-h-[180px] lg:min-h-[215px] shadow-sm">
          <!-- Full-cover background image: Fluffy Cat with Sunglasses -->
          <img 
            src="/pawzone_assets/hero_cat_glasses.png" 
            alt="Mèo đeo kính sành điệu" 
            class="absolute inset-0 w-full h-full object-cover object-center pointer-events-none select-none"
          />

          <div class="space-y-3 relative z-10 max-w-[140px]">
            <h3 class="text-white text-base sm:text-lg font-bold leading-tight">
              Dành Cho<br/>Mèo Cưng???
            </h3>
            <a 
              href="/san-pham?category=cat-ve-sinh-meo" 
              class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg border border-white/80 hover:bg-white hover:text-[#015D7F] text-white text-[11px] font-semibold transition-colors cursor-pointer"
            >
              <span>Xem ngay</span>
              <span>&gt;</span>
            </a>
          </div>
        </div>

        <!-- Bottom Right Card: Dành Cho Chó (#67BADE) -->
        <div class="flex-1 bg-[#67BADE] rounded-[28px] p-5 sm:p-6 relative overflow-hidden flex items-center justify-between min-h-[180px] lg:min-h-[215px] shadow-sm">
          <!-- Full-cover background image: Dog in yellow hoodie -->
          <img 
            src="/pawzone_assets/hero_dog_hoodie.png" 
            alt="Cún mặc áo hoodie vàng" 
            class="absolute inset-0 w-full h-full object-cover object-center pointer-events-none select-none"
          />

          <div class="relative z-10 ml-auto space-y-3 max-w-[140px] text-right">
            <h3 class="text-white text-base sm:text-lg font-bold leading-tight">
              Dành Cho<br/>Cún Yêu???
            </h3>
            <a 
              href="/san-pham?category=nhom-que-gam-tong-hop" 
              class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg border border-white/80 hover:bg-white hover:text-[#07394D] text-white text-[11px] font-semibold transition-colors cursor-pointer"
            >
              <span>Xem ngay</span>
              <span>&gt;</span>
            </a>
          </div>
        </div>

      </div>

    </section>


    <!-- ================= 2. TOP CATEGORIES (8 ô danh mục Pastel chuẩn PawZone) ================= -->
    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-lg sm:text-xl font-bold text-[#07394D]">Danh Mục Nổi Bật</h2>
          <p class="text-xs text-slate-500">Các nhóm sản phẩm phân phối sỉ chủ lực</p>
        </div>
        <div class="flex items-center gap-2">
          <a href="/san-pham" class="text-xs font-semibold text-slate-500 hover:text-[#07394D] transition-colors">Xem tất cả &gt;</a>
        </div>
      </div>

      <div class="grid grid-cols-4 sm:grid-cols-8 gap-3 sm:gap-4 items-stretch">
        {displayCategories.map((cat) => (
          <a 
            href={`/san-pham?category=${cat.slug}`} 
            class="flex flex-col items-center justify-between h-full group text-center"
          >
            <!-- Fixed aspect-square icon box with white background -->
            <div 
              class="w-full aspect-square rounded-2xl flex items-center justify-center p-3 sm:p-3.5 bg-white border border-slate-100 group-hover:border-slate-200 group-hover:-translate-y-1 transition-all duration-200 shadow-2xs group-hover:shadow-card overflow-hidden"
            >
              <img 
                src={cat.icon} 
                alt={cat.name} 
                class="max-h-full max-w-full object-contain group-hover:scale-110 transition-transform duration-200 drop-shadow-2xs"
                onerror="this.onerror=null; this.src='/pawzone_assets/cat_1.png';"
              />
            </div>

            <!-- Fixed min-height label box ensuring all 8 cards are exactly equal -->
            <div class="mt-2 flex items-center justify-center min-h-[38px] w-full px-0.5">
              <span class="text-[11px] font-semibold text-gray-700 group-hover:text-[#07394D] leading-tight line-clamp-2 transition-colors">
                {cat.name}
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>


    <!-- ================= 3. SẢN PHẨM MỚI & NỔI BẬT (New & Trending) ================= -->
    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-base sm:text-lg font-bold text-[#07394D]">Sản Phẩm Mới &amp; Nổi Bật</h2>
          <p class="text-xs text-slate-500">Dòng sản phẩm vừa ra mắt và được ưa chuộng</p>
        </div>
        <a href="/san-pham" class="text-xs font-semibold text-slate-500 hover:text-[#07394D] transition-colors">Xem tất cả &gt;</a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 sm:gap-5">
        {trendingList.map((item) => (
          <ProductCard product={item} />
        ))}
      </div>
    </section>


    <!-- ================= 4. SẢN PHẨM BÁN CHẠY CHO ĐẠI LÝ (Popular Items) ================= -->
    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-base sm:text-lg font-bold text-[#07394D]">Sản Phẩm Bán Chạy Cho Đại Lý</h2>
          <p class="text-xs text-slate-500">Sản lượng tiêu thụ cao nhất tại hệ thống kho trung tâm</p>
        </div>
        <a href="/san-pham" class="text-xs font-semibold text-slate-500 hover:text-[#07394D] transition-colors">Xem tất cả &gt;</a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 sm:gap-5">
        {bestSellerList.map((item) => (
          <ProductCard product={item} />
        ))}
      </div>
    </section>


    <!-- ================= 5. GIÁ SỈ TỐT NHẤT HÔM NAY (Today's Lowest Prices) ================= -->
    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-base sm:text-lg font-bold text-[#07394D]">Giá Sỉ Tốt Nhất Hôm Nay</h2>
          <p class="text-xs text-slate-500">Mức chiết khấu đại lý tốt nhất trong tuần</p>
        </div>
        <a href="/san-pham" class="text-xs font-semibold text-slate-500 hover:text-[#07394D] transition-colors">Xem tất cả &gt;</a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 sm:gap-5">
        {lowestPriceList.map((item) => (
          <ProductCard product={item} />
        ))}
      </div>
    </section>


    <!-- ================= 7. BANNER ĐĂNG KÝ ĐẠI LÝ B2B ================= -->

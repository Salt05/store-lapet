---
// src/pages/index.astro
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/product/ProductCard.astro';
import { getProductGroups, getShowcaseProducts, assetUrl, formatVnd } from '../lib/catalog';

// 1. Tải danh mục và sản phẩm từ Directus
const [rawProductGroups, rawShowcaseProducts] = await Promise.all([

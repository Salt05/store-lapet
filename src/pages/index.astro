          Chiết khấu đại lý lên tới 22%, hỗ trợ chành xe 63 tỉnh thành &amp; cập nhật danh mục bánh thưởng, que gặm mới nhất từ LA PET.
        </p>

        <!-- Subscription / Registration Input Box matching user's component reference -->
        <form id="hero-partner-form" class="w-full max-w-md pt-1.5">
          <div class="flex items-center bg-white rounded-full p-1.5 pl-4 shadow-md border border-slate-200/80 focus-within:border-[#07394D] transition-all">
            <!-- Envelope Icon -->
            <svg class="w-5 h-5 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <input 
              type="email" 
              id="partner-reg-email-input" 
              name="email" 
              placeholder="Nhập địa chỉ email của bạn..." 
              required 
              class="flex-1 px-3 text-xs sm:text-sm text-slate-800 placeholder-slate-400 bg-transparent focus:outline-none"
            />
            <button 
              type="submit" 
              class="px-5 sm:px-6 py-2.5 sm:py-3 rounded-full bg-[#07394D] hover:bg-[#052937] text-white text-xs sm:text-sm font-bold shadow-sm transition-all shrink-0 cursor-pointer"
            >
              Đăng Ký Đại Lý
            </button>
          </div>
          <p class="text-[11px] text-[#07394D]/75 mt-2 pl-2 flex items-center gap-1 font-medium">
            <span>🔒 Cam kết bảo mật thông tin đối tác đại lý.</span>
          </p>
        </form>

      </div>
    </section>

    <!-- Script điều hướng sang trang Đăng Ký Đại Lý kèm email điền sẵn -->
    <script is:inline>
      (() => {
        const form = document.getElementById('hero-partner-form');
        const input = document.getElementById('partner-reg-email-input');
        if (!form || !input) return;

        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const email = input.value.trim();
          if (!email) return;
          try {
            sessionStorage.setItem('dealer_reg_email', email);
          } catch(err) {}
          window.location.href = `/lien-he?email=${encodeURIComponent(email)}#partner-registration`;
        });
      })();
    </script>


    <!-- ================= 8. CAM KẾT DỊCH VỤ ================= -->
    <section class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-xs">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {valueProps.map((item) => (
          <div class="flex items-start gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-[#07394D]/10 text-[#07394D] flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d={item.icon}></path>
              </svg>
            </div>
            <div>
              <h4 class="text-sm font-bold text-[#07394D] leading-snug">{item.title}</h4>
              <p class="text-xs text-slate-500 mt-0.5 leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

  </div>

</BaseLayout>
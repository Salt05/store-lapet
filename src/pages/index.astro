---
// src/pages/index.astro
export const prerender = false;

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

// 1. IN TEST P0 AUTH STATE RA TERMINAL
console.log('=== P0 AUTH STATE ===', Astro.locals.auth);

// Lấy thông tin từ P0 Auth State chuẩn (KHÔNG dùng Astro.cookies nữa)
const { isAuthenticated, isDealer, partnerId } = Astro.locals.auth;

// 2. Sử dụng biến môi trường Directus
const DIRECTUS_URL =
  import.meta.env.PUBLIC_DIRECTUS_URL ||
  "http://192.168.1.110:8055";

// 3. Tải dữ liệu an toàn từ Directus
let allProducts = [];
try {
  const res = await fetch(
    `${DIRECTUS_URL}/items/products?fields=*,odoo_id,sku,wholesale_price,price,category.name,category.slug,group.name,group.slug,images.*,images.directus_files_id.*`
  );
  if (res.ok) {
    const json = await res.json();
    allProducts = json.data || [];
  } else {
    console.error(`⚠️ Directus trả về lỗi HTTP: ${res.status}`);
  }
} catch (error) {
  console.error("❌ Lỗi kết nối Directus:", error);
}

// 4. Hàm lấy URL ảnh sản phẩm
function getProductImage(product) {
  if (!product.images || product.images.length === 0) {
    return 'https://placehold.co/400x400/fef3df/083a3c?text=LA+PET';
  }

  const firstImg = product.images[0];
  let fileId = null;

  if (typeof firstImg.directus_files_id === 'string') {
    fileId = firstImg.directus_files_id;
  } else if (firstImg.directus_files_id?.id) {
    fileId = firstImg.directus_files_id.id;
  } else if (typeof firstImg === 'string') {
    fileId = firstImg;
  }

  if (!fileId) return 'https://placehold.co/400x400/fef3df/083a3c?text=LA+PET';
  
  return `${DIRECTUS_URL}/assets/${fileId}?width=400&height=400&quality=80&fit=cover`;
}

// 5. Định dạng tiền tệ VND
function formatPrice(price) {
  if (typeof price !== 'number' || isNaN(price)) return '0đ';
  return price.toLocaleString('vi-VN') + 'đ';
}

// 6. Lọc danh sách Sản phẩm bán chạy
const bestSellers = allProducts.slice(0, 8);

// 7. Nhóm sản phẩm theo Danh mục (Category)
const categoriesMap = new Map();
allProducts.forEach((product) => {
  const catName = product.category?.name || 'Sản phẩm khác';
  const catSlug = product.category?.slug || 'san-pham-khac';

  if (!categoriesMap.has(catSlug)) {
    categoriesMap.set(catSlug, {
      id: catSlug,
      title: catName,
      subtext: `Thức ăn & phụ kiện ${catName.toLowerCase()} chính hãng, chất lượng cao`,
      products: []
    });
  }

  if (categoriesMap.get(catSlug).products.length < 4) {
    categoriesMap.get(catSlug).products.push(product);
  }
});

const categoriesData = Array.from(categoriesMap.values());

// Cam kết thương hiệu
const features = [
  { icon: 'M5 13l4 4L19 7', title: 'Hàng Chính Hãng 100%', desc: 'Đảm bảo nguồn gốc rõ ràng' },
  { icon: 'M13 10V3L4 14h7v7l9-11h-7z', title: 'Giao Hàng Siêu Tốc', desc: 'Nội thành chỉ trong 2 giờ' },
  { icon: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15', title: 'Đổi Trả Dễ Dàng', desc: 'Hỗ trợ đổi trả trong 7 ngày' },
  { icon: 'M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z', title: 'Hỗ Trợ 24/7', desc: 'Tư vấn nhiệt tình, chu đáo' },
];

// Khai báo hàm formatQuantity trong phần Frontmatter
function formatQuantity(qty: number) {
  if (typeof qty !== 'number' || isNaN(qty)) return '0';
  return qty.toLocaleString('vi-VN');
}

// Nếu trang của bạn chưa có hàm formatPrice, bạn cũng có thể định nghĩa thêm:
function formatPrice(price: number) {
  if (typeof price !== 'number' || isNaN(price)) return '0đ';
  return price.toLocaleString('vi-VN') + 'đ';
}

---

<!DOCTYPE html>
<html lang="vi" class="scroll-smooth">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LA PET - Cửa Hàng Thức Ăn & Phụ Kiện Thú Cưng Cao Cấp</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <style>
      body { font-family: 'Plus Jakarta Sans', sans-serif; }
    </style>
</head>
<body class="bg-[#faf9f6] text-[#083a3c] flex flex-col min-h-screen antialiased">

    <!-- Header Component -->
    <Header />

    <main class="flex-grow space-y-12 md:space-y-16 pb-20">
        
      <!-- ================= 1. HERO BANNER SLIDER ================= -->
      <section 
        x-data="{
          activeSlide: 0,
          banners: [
            '/hinh1.webp',
            '/hinh2.webp',
            '/hinh3.webp',
            '/hinh4.webp'
          ],
          timer: null,
          init() {
            this.startTimer();
          },
          startTimer() {
            this.timer = setInterval(() => { this.next() }, 5000);
          },
          resetTimer() {
            clearInterval(this.timer);
            this.startTimer();
          },
          next() {
            this.activeSlide = (this.activeSlide + 1) % this.banners.length;
          },
          prev() {
            this.activeSlide = (this.activeSlide - 1 + this.banners.length) % this.banners.length;
          }
        }"
        class="relative w-full overflow-hidden bg-[#083a3c] group"
      >
        <div class="relative w-full h-[280px] sm:h-[420px] md:h-[500px] lg:h-[600px]">
          <template x-for="(banner, index) in banners" :key="index">
            <div 
              x-show="activeSlide === index"
              x-transition:enter="transition ease-out duration-700 transform"
              x-transition:enter-start="opacity-0 scale-105"
              x-transition:enter-end="opacity-100 scale-100"
              x-transition:leave="transition ease-in duration-500 transform"
              x-transition:leave-start="opacity-100 scale-100"
              x-transition:leave-end="opacity-0 scale-95"
              class="absolute inset-0 w-full h-full"
            >
              <img 
                :src="banner" 
                :alt="'LA PET Banner ' + (index + 1)"
                :loading="index === 0 ? 'eager' : 'lazy'"
                :fetchpriority="index === 0 ? 'high' : 'auto'"
                class="w-full h-full object-cover object-center"
                onerror="this.onerror=null; this.src='https://placehold.co/1920x650/083a3c/23c1c6?text=LA+PET+Banner';"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
            </div>
          </template>
        </div>

        <button 
          @click="prev(); resetTimer();"
          class="absolute left-3 md:left-6 top-1/2 -translate-y-1/2 w-10 h-10 md:w-12 md:h-12 rounded-full bg-white/80 hover:bg-white text-[#083a3c] shadow-xl flex items-center justify-center transition-all opacity-0 group-hover:opacity-100 hover:scale-110 z-10 backdrop-blur-sm cursor-pointer"
          aria-label="Previous Banner"
        >
          <svg class="w-5 h-5 stroke-current fill-none stroke-[2.5]" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <button 
          @click="next(); resetTimer();"
          class="absolute right-3 md:right-6 top-1/2 -translate-y-1/2 w-10 h-10 md:w-12 md:h-12 rounded-full bg-white/80 hover:bg-white text-[#083a3c] shadow-xl flex items-center justify-center transition-all opacity-0 group-hover:opacity-100 hover:scale-110 z-10 backdrop-blur-sm cursor-pointer"
          aria-label="Next Banner"
        >
          <svg class="w-5 h-5 stroke-current fill-none stroke-[2.5]" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>

        <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex items-center gap-2.5 z-10 bg-black/30 backdrop-blur-md px-3.5 py-1.5 rounded-full">
          <template x-for="(banner, index) in banners" :key="index">
            <button 
              @click="activeSlide = index; resetTimer();"
              :class="activeSlide === index ? 'w-7 bg-[#23c1c6]' : 'w-2 bg-white/60 hover:bg-white'"
              class="h-2 rounded-full transition-all duration-300 cursor-pointer"
              :aria-label="'Go to slide ' + (index + 1)"
            ></button>
          </template>
        </div>
      </section>

      <!-- ================= 2. MỤC CAM KẾT ================= -->
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-6 relative z-20">
        <div class="bg-white rounded-2xl p-4 sm:p-6 shadow-lg border border-slate-100 grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
          {features.map((item) => (
            <div class="flex items-center gap-3 group">
              <div class="w-10 h-10 md:w-12 md:h-12 rounded-xl bg-[#fef3df] text-[#083a3c] flex items-center justify-center group-hover:bg-[#23c1c6] group-hover:text-white transition-all duration-300 shrink-0">
                <svg class="w-5 h-5 md:w-6 md:h-6 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
                </svg>
              </div>
              <div>
                <h4 class="font-bold text-xs sm:text-sm md:text-base text-[#083a3c] leading-tight">{item.title}</h4>
                <p class="text-[11px] sm:text-xs text-slate-500 mt-0.5">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- ================= 3. MỤC ƯU ĐÃI ================= -->
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
          <a href="/khuyen-mai/deal-ngay" class="group relative rounded-2xl overflow-hidden bg-gradient-to-br from-[#23c1c6] via-[#16a1a6] to-[#083a3c] p-6 text-white min-h-[190px] flex flex-col justify-between shadow-md hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
            <div class="absolute -right-6 -bottom-6 w-36 h-36 bg-white/10 rounded-full blur-2xl group-hover:scale-150 transition-transform"></div>
            <div class="relative z-10 max-w-xs sm:max-w-sm">
              <span class="bg-white text-[#083a3c] font-extrabold text-[10px] sm:text-[11px] tracking-wider px-2.5 py-1 rounded-full uppercase shadow-xs">
                🔥 Deal Hot Tuần Này
              </span>
              <h3 class="text-xl sm:text-2xl font-black mt-3 leading-snug">Giảm Đến 40% Tất Cả Bánh Thưởng</h3>
              <p class="text-xs text-white/90 mt-1.5 font-medium">Thưởng siêu ngon cho bé ngoan - Số lượng có hạn!</p>
            </div>
            <div class="relative z-10 mt-4 inline-flex items-center gap-1.5 font-bold text-xs sm:text-sm bg-white/20 backdrop-blur-md text-white px-4 py-2 rounded-full w-fit group-hover:bg-white group-hover:text-[#083a3c] transition-all">
              <span>Mua Ngay</span>
              <svg class="w-4 h-4 stroke-current fill-none stroke-2 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </div>
          </a>

          <a href="/khuyen-mai/combo-ve-sinh" class="group relative rounded-2xl overflow-hidden bg-gradient-to-br from-[#fef3df] via-[#fce4bd] to-[#23c1c6]/30 border border-[#23c1c6]/20 p-6 text-[#083a3c] min-h-[190px] flex flex-col justify-between shadow-md hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
            <div class="absolute -right-6 -bottom-6 w-36 h-36 bg-[#23c1c6]/10 rounded-full blur-2xl group-hover:scale-150 transition-transform"></div>
            <div class="relative z-10 max-w-xs sm:max-w-sm">
              <span class="bg-[#083a3c] text-white font-extrabold text-[10px] sm:text-[11px] tracking-wider px-2.5 py-1 rounded-full uppercase shadow-xs">
                🎁 Combo Tiết Kiệm
              </span>
              <h3 class="text-xl sm:text-2xl font-black mt-3 leading-snug text-[#083a3c]">Cát Vệ Sinh & Tả Lót Mua 2 Tặng 1</h3>
              <p class="text-xs text-slate-700 mt-1.5 font-medium">Giải pháp giữ vệ sinh nhà cửa luôn sạch thơm</p>
            </div>
            <div class="relative z-10 mt-4 inline-flex items-center gap-1.5 font-bold text-xs sm:text-sm bg-[#083a3c] text-white px-4 py-2 rounded-full w-fit group-hover:bg-[#23c1c6] group-hover:text-[#083a3c] transition-all">
              <span>Khám Phá Ngay</span>
              <svg class="w-4 h-4 stroke-current fill-none stroke-2 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </div>
          </a>
        </div>
      </section>

      <!-- ================= 4. MỤC SẢN PHẨM BÁN CHẠY ================= -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="flex items-end justify-between mb-6 pb-3 border-b border-slate-200/80 gap-4">
    <div>
      <div class="flex items-center gap-1.5 text-[#23c1c6] font-bold text-[11px] uppercase tracking-widest mb-0.5">
        <span class="w-2 h-2 rounded-full bg-[#23c1c6]"></span> Best Sellers
      </div>
      <h2 class="text-xl sm:text-2xl font-black text-[#083a3c]">Sản Phẩm Bán Chạy</h2>
    </div>
    <a href="/san-pham?sort=sold-desc" class="group inline-flex items-center gap-1 font-bold text-xs sm:text-sm text-[#083a3c] hover:text-[#23c1c6] transition-colors">
      <span>Xem tất cả</span>
      <svg class="w-4 h-4 stroke-current fill-none stroke-2 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </a>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-5">
    {
      /* Lấy 8 sản phẩm có lượt bán cao nhất */
      bestSellers
        .sort((a, b) => (Number(b.sold_quantity) || 0) - (Number(a.sold_quantity) || 0))
        .slice(0, 8)
        .map((product) => {
          const productImage = getProductImage(product);
          const soldQuantity = Number(product.sold_quantity) || 0;
          
          const retailPrice = Number(product.price) || 0;
          const wholesalePrice = Number(product.wholesale_price) || 0;
          const activePrice = isDealer && wholesalePrice > 0 ? wholesalePrice : retailPrice;

          let parsedOdooId = null;
          if (product.odoo_id !== null && product.odoo_id !== undefined && product.odoo_id !== 'null' && product.odoo_id !== '') {
            const num = parseInt(String(product.odoo_id), 10);
            if (!isNaN(num)) parsedOdooId = num;
          }

          return (
            <div
              class="bg-white rounded-2xl border border-slate-100 p-3 sm:p-4 flex flex-col justify-between shadow-xs hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group relative"
              data-product-id={product.id}
              data-odoo-id={parsedOdooId ?? ''}
              data-sku={product.sku || ''}
              data-name={product.name}
              data-wholesale-price={wholesalePrice}
              data-retail-price={retailPrice}
              data-effective-price={activePrice}
              data-image={productImage}
            >
              <button class="absolute top-5 right-5 z-10 w-8 h-8 rounded-full bg-white/80 backdrop-blur-md flex items-center justify-center text-slate-400 hover:text-red-500 hover:bg-white shadow-xs transition-all cursor-pointer">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                </svg>
              </button>

              <div>
                <!-- BADGE HIỂN THỊ LƯỢT BÁN VÀ NGỌN LỬA -->
                <div class="mb-2 flex items-center">
                  {
                    soldQuantity < 5000 ? (
                      /* Dưới 5.000: 1 ngọn lửa */
                      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200/60 shadow-2xs">
                        <svg class="w-3 h-3 fill-amber-500 shrink-0" viewBox="0 0 20 20">
                          <path d="M12.395 2.553a1 1 0 00-1.45-1.348c-1.38 1.488-2.528 3.015-3.088 4.29-1.045 2.378-.453 4.238.256 5.372a6 6 0 002.321 2.213 1 1 0 001.317-1.42 4 4 0 01-.735-1.523c.334.053.672.083 1.014.083 2.923 0 5.02-2.181 5.02-5.181 0-1.782-.821-3.328-2.227-4.486a1 1 0 00-1.428 1.002c.162.723.111 1.421-.12 2.052a1 1 0 01-1.89-1.054c.381-1.037.49-2.214.01-3.238z" />
                        </svg>
                        Đã bán {formatQuantity(soldQuantity)}
                      </span>
                    ) : soldQuantity <= 20000 ? (
                      /* Từ 5.000 - 20.000: 2 ngọn lửa */
                      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-orange-50 text-orange-700 border border-orange-200/60 shadow-2xs">
                        <div class="flex -space-x-1">
                          <svg class="w-3 h-3 fill-orange-500 shrink-0" viewBox="0 0 20 20">
                            <path d="M12.395 2.553a1 1 0 00-1.45-1.348c-1.38 1.488-2.528 3.015-3.088 4.29-1.045 2.378-.453 4.238.256 5.372a6 6 0 002.321 2.213 1 1 0 001.317-1.42 4 4 0 01-.735-1.523c.334.053.672.083 1.014.083 2.923 0 5.02-2.181 5.02-5.181 0-1.782-.821-3.328-2.227-4.486a1 1 0 00-1.428 1.002c.162.723.111 1.421-.12 2.052a1 1 0 01-1.89-1.054c.381-1.037.49-2.214.01-3.238z" />
                          </svg>
                          <svg class="w-3 h-3 fill-orange-500 shrink-0" viewBox="0 0 20 20">
                            <path d="M12.395 2.553a1 1 0 00-1.45-1.348c-1.38 1.488-2.528 3.015-3.088 4.29-1.045 2.378-.453 4.238.256 5.372a6 6 0 002.321 2.213 1 1 0 001.317-1.42 4 4 0 01-.735-1.523c.334.053.672.083 1.014.083 2.923 0 5.02-2.181 5.02-5.181 0-1.782-.821-3.328-2.227-4.486a1 1 0 00-1.428 1.002c.162.723.111 1.421-.12 2.052a1 1 0 01-1.89-1.054c.381-1.037.49-2.214.01-3.238z" />
                          </svg>
                        </div>
                        Đã bán {formatQuantity(soldQuantity)}
                      </span>
                    ) : (
                      /* Trên 20.000: 3 ngọn lửa */
                      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-50 text-rose-700 border border-rose-200/60 shadow-2xs">
                        <div class="flex -space-x-1">
                          <svg class="w-3 h-3 fill-rose-500 shrink-0" viewBox="0 0 20 20">
                            <path d="M12.395 2.553a1 1 0 00-1.45-1.348c-1.38 1.488-2.528 3.015-3.088 4.29-1.045 2.378-.453 4.238.256 5.372a6 6 0 002.321 2.213 1 1 0 001.317-1.42 4 4 0 01-.735-1.523c.334.053.672.083 1.014.083 2.923 0 5.02-2.181 5.02-5.181 0-1.782-.821-3.328-2.227-4.486a1 1 0 00-1.428 1.002c.162.723.111 1.421-.12 2.052a1 1 0 01-1.89-1.054c.381-1.037.49-2.214.01-3.238z" />
                          </svg>
                          <svg class="w-3 h-3 fill-rose-500 shrink-0" viewBox="0 0 20 20">
                            <path d="M12.395 2.553a1 1 0 00-1.45-1.348c-1.38 1.488-2.528 3.015-3.088 4.29-1.045 2.378-.453 4.238.256 5.372a6 6 0 002.321 2.213 1 1 0 001.317-1.42 4 4 0 01-.735-1.523c.334.053.672.083 1.014.083 2.923 0 5.02-2.181 5.02-5.181 0-1.782-.821-3.328-2.227-4.486a1 1 0 00-1.428 1.002c.162.723.111 1.421-.12 2.052a1 1 0 01-1.89-1.054c.381-1.037.49-2.214.01-3.238z" />
                          </svg>
                          <svg class="w-3 h-3 fill-rose-500 shrink-0" viewBox="0 0 20 20">
                            <path d="M12.395 2.553a1 1 0 00-1.45-1.348c-1.38 1.488-2.528 3.015-3.088 4.29-1.045 2.378-.453 4.238.256 5.372a6 6 0 002.321 2.213 1 1 0 001.317-1.42 4 4 0 01-.735-1.523c.334.053.672.083 1.014.083 2.923 0 5.02-2.181 5.02-5.181 0-1.782-.821-3.328-2.227-4.486a1 1 0 00-1.428 1.002c.162.723.111 1.421-.12 2.052a1 1 0 01-1.89-1.054c.381-1.037.49-2.214.01-3.238z" />
                          </svg>
                        </div>
                        Đã bán {formatQuantity(soldQuantity)}
                      </span>
                    )
                  }
                </div>

                <a href={`/san-pham/${product.slug}`} class="block relative aspect-square rounded-xl overflow-hidden bg-[#fef3df]/30 mb-3">
                  <img
                    src={productImage}
                    alt={product.name}
                    loading="lazy"
                    decoding="async"

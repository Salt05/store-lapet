<script type="module">
  document.addEventListener("DOMContentLoaded", () => {
    // ================= XỬ LÝ THÊM VÀO GIỎ HÀNG =================
    const getCart = () => {
      try { return JSON.parse(localStorage.getItem("cart") || "[]"); } catch { return []; }
    };

    const saveCart = (cart) => {
      localStorage.setItem("cart", JSON.stringify(cart));
      window.dispatchEvent(new Event("cart-updated"));
    };

    const cartButtons = document.querySelectorAll(".add-to-cart-btn");

    cartButtons.forEach(btn => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        const container = btn.closest("[data-product-id]");
        if (!container) return;

        const id = container.dataset.productId;
        const name = container.dataset.name || "";
        const image = container.dataset.image || "";
        const sku = container.dataset.sku || "";
        const rawOdoo = container.dataset.odooId;
        
        let parsedOdooId = null;
        if (rawOdoo !== undefined && rawOdoo !== null && rawOdoo !== '' && rawOdoo !== 'null') {
          const num = parseInt(rawOdoo, 10);
          if (!isNaN(num)) parsedOdooId = num;
        }

        const wholesalePrice = parseFloat(container.dataset.wholesalePrice || "0");
        const retailPrice = parseFloat(container.dataset.retailPrice || "0");
        const activePrice = parseFloat(container.dataset.effectivePrice || "0"); 

        const cart = getCart();
        const target = cart.find(x => x.id === id);

        if (target) {
          target.quantity = (target.quantity || 1) + 1;
          target.price = activePrice;
          target.wholesale_price = wholesalePrice;
          target.retail_price = retailPrice;
          if (target.odoo_id === undefined) target.odoo_id = parsedOdooId;
          if (!target.sku) target.sku = sku;
        } else {
          cart.push({
            id,
            odoo_id: parsedOdooId,
            sku: sku,
            name,
            price: activePrice,
            wholesale_price: wholesalePrice,
            retail_price: retailPrice,
            image,
            quantity: 1
          });
        }

        saveCart(cart);

        btn.classList.add("scale-90", "bg-[#d82a72]", "text-white");
        setTimeout(() => {
          btn.classList.remove("scale-90", "bg-[#d82a72]", "text-white");
        }, 200);
      });
    });
  });
</script>

---
// src/pages/lien-he.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const title = "Liên hệ & Đăng ký Đại lý - LA PET VIỆT NAM";
const description = "Trở thành đại lý chính thức của LA PET để nhận chính sách chiết khấu, thưởng doanh số hấp dẫn và nguồn hàng chất lượng cao.";
---

<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-slate-50 text-slate-800 flex flex-col min-h-screen">
    
    <!-- 1. HEADER -->
    <Header />

    <!-- 2. NỘI DUNG CHÍNH CỦA TRANG -->
    <main class="flex-grow">
      <!-- SECTION ĐĂNG KÝ HỢP TÁC & LÝ DO ĐỒNG HÀNH -->
      <section id="partner-registration" class="relative w-full py-12 md:py-20 bg-slate-900">
        
        <!-- Layer 1: Hình nền nhamay9.webp -->
        <div 
          class="absolute inset-0 bg-cover bg-center filter blur-[1px] scale-105 pointer-events-none" 
          style="background-image: url('/nhamay9.webp');"
        ></div>

        <!-- Layer 2: Lớp phủ tối -->
        <div class="absolute inset-0 bg-black/30"></div>

        <!-- Layer 3: Container chính (Được căn giữa và giới hạn max-width) -->
        <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          
          <!-- TIÊU ĐỀ CHÍNH -->
          <div class="max-w-5xl mx-auto mb-12 p-8 sm:p-12 rounded-3xl bg-gradient-to-r from-[#23c1c6] to-[#1da4a8] border-2 border-white/30 shadow-2xl text-center space-y-4 relative overflow-hidden">
  
  <!-- Tiêu đề nổi bật, kích thước to hơn -->
  <h2 class="text-3xl sm:text-5xl font-black text-[#fcce58] leading-tight drop-shadow-lg tracking-wide">
    Vì sao nên hợp tác cùng <span class="text-white"> LA PET </span> ?
  </h2>
  
  <!-- Nội dung rút gọn, súc tích -->
  <p class="text-white text-base sm:text-xl font-medium leading-relaxed max-w-3xl mx-auto drop-shadow-sm">
    LA PET đồng hành cùng đại lý bằng danh mục bánh thưởng, snack và xương gặm dễ kinh doanh, rõ nguồn gốc và phù hợp với nhu cầu ngày càng tăng của người nuôi thú cưng hiện nay.
  </p>

</div>

          <!-- KHU VỰC 2 CỘT: 6 Ô LÝ DO (TRÁI) & FORM (PHẢI) -->
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            <!-- CỘT TRÁI (7 Cột trên màn hình lớn): 6 Ô LÝ DO -->
            <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4 w-full">
              
              <!-- Card 1 -->
              <div class="bg-white/95 backdrop-blur-md p-5 rounded-2xl border border-white/40 shadow-lg flex flex-col justify-between">
                <div>
                  <div class="flex items-center gap-3 mb-2">
                    <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-[#23c1c6] text-white font-bold text-sm shrink-0 shadow-sm">01</span>
                    <h3 class="font-bold text-gray-900 text-base">Sản phẩm rõ nguồn gốc</h3>
                  </div>
                  <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
                    Thông tin rõ ràng về thành phần, quy cách và tiêu chuẩn, giúp đại lý tự tin hơn khi tư vấn.
                  </p>
                </div>
              </div>

              <!-- Card 2 -->
              <div class="bg-white/95 backdrop-blur-md p-5 rounded-2xl border border-white/40 shadow-lg flex flex-col justify-between">
                <div>
                  <div class="flex items-center gap-3 mb-2">
                    <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-[#23c1c6] text-white font-bold text-sm shrink-0 shadow-sm">02</span>
                    <h3 class="font-bold text-gray-900 text-base">Danh mục dễ bán</h3>
                  </div>
                  <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
                    Phù hợp cho pet shop, spa thú cưng, phòng khám thú y, nhà bán online & sàn TMĐT.
                  </p>
                </div>
              </div>

              <!-- Card 3 -->
              <div class="bg-white/95 backdrop-blur-md p-5 rounded-2xl border border-white/40 shadow-lg flex flex-col justify-between">
                <div>
                  <div class="flex items-center gap-3 mb-2">
                    <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-[#23c1c6] text-white font-bold text-sm shrink-0 shadow-sm">03</span>
                    <h3 class="font-bold text-gray-900 text-base">Định vị khác biệt</h3>
                  </div>
                  <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
                    An tâm trong từng miếng thưởng, xây dựng niềm tin bằng sự minh bạch và an toàn.
                  </p>
                </div>
              </div>

              <!-- Card 4 -->
              <div class="bg-white/95 backdrop-blur-md p-5 rounded-2xl border border-white/40 shadow-lg flex flex-col justify-between">
                <div>
                  <div class="flex items-center gap-3 mb-2">
                    <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-[#23c1c6] text-white font-bold text-sm shrink-0 shadow-sm">04</span>
                    <h3 class="font-bold text-gray-900 text-base">Chính sách hỗ trợ đại lý</h3>
                  </div>
                  <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
                    Mức chiết khấu hấp dẫn, vô vàn các chương trình ưu đãi cho đại lý. Có mức thưởng theo từng quý và từng năm cho các mốc doanh thu.
                  </p>
                </div>
              </div>

              <!-- Card 5 -->
              <div class="bg-white/95 backdrop-blur-md p-5 rounded-2xl border border-white/40 shadow-lg flex flex-col justify-between">
                <div>
                  <div class="flex items-center gap-3 mb-2">
                    <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-[#23c1c6] text-white font-bold text-sm shrink-0 shadow-sm">05</span>
                    <h3 class="font-bold text-gray-900 text-base">Hỗ trợ truyền thông</h3>
                  </div>
                  <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
                    Cung cấp hình ảnh, nội dung, tài liệu và chương trình bán hàng đa kênh hiệu quả.
                  </p>
                </div>
              </div>

              <!-- Card 6 -->
              <div class="bg-white/95 backdrop-blur-md p-5 rounded-2xl border border-white/40 shadow-lg flex flex-col justify-between">
                <div>
                  <div class="flex items-center gap-3 mb-2">
                    <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-[#23c1c6] text-white font-bold text-sm shrink-0 shadow-sm">06</span>
                    <h3 class="font-bold text-gray-900 text-base">Đặt hàng B2B 24/7</h3>
                  </div>
                  <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
                    Tài khoản Đại lý cập nhật bảng giá sỉ & ưu đãi trực tiếp qua OTP điện thoại.
                  </p>
                </div>
              </div>

            </div>

            <!-- CỘT PHẢI (5 Cột trên màn hình lớn): FORM ĐĂNG KÝ HỢP TÁC -->
            <div class="lg:col-span-5 w-full">
              <div class="bg-white/95 backdrop-blur-md p-6 sm:p-8 rounded-3xl shadow-2xl border border-white/20 space-y-4">
                
                <div class="text-center space-y-1">
                  <h3 class="text-2xl font-extrabold text-gray-950">Đăng Ký Hợp Tác</h3>
                  <p class="text-gray-600 text-xs sm:text-sm">Điền thông tin bên dưới để nhận chính sách đại lý tốt nhất.</p>
                </div>

                <form 
                  id="partner-form"
                  action="https://formsubmit.co/lapetvietnam.vn@gmail.com" 
                  method="POST" 
                  class="space-y-3"
                >
                  <input type="hidden" name="_subject" value="[LA PET Website] Đăng ký đại lý mới!">
                  <input type="hidden" name="_captcha" value="false">
                  <input type="hidden" name="_template" value="table">
                  <input type="hidden" name="_next" value="https://lapetvietnam.com/?sent=1#partner-registration">
                  <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off">

                  <div class="space-y-1">
                    <label class="block text-xs font-bold text-gray-600 uppercase">Họ và Tên đại diện (*)</label>
                    <input 
                      type="text" 
                      name="Họ và tên" 
                      placeholder="" 
                      class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3.5 py-2.5 text-sm text-gray-900 focus:outline-none focus:border-[#23c1c6] focus:bg-white transition" 
                      required 
                    />
                  </div>

                  <div class="space-y-1">
                    <label class="block text-xs font-bold text-gray-600 uppercase">Số điện thoại (*)</label>
                    <input 
                      type="tel" 
                      name="Số điện thoại" 
                      placeholder="" 
                      class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3.5 py-2.5 text-sm text-gray-900 focus:outline-none focus:border-[#23c1c6] focus:bg-white transition" 
                      required 
                    />
                  </div>

                  <div class="space-y-1">
                    <label class="block text-xs font-bold text-gray-600 uppercase">Tên Cửa Hàng / Spa / Phòng Khám</label>
                    <input 
                      type="text" 
                      name="Tên cửa hàng" 
                      placeholder="" 
                      class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3.5 py-2.5 text-sm text-gray-900 focus:outline-none focus:border-[#23c1c6] focus:bg-white transition" 
                     
                    />
                  </div>

                  <div class="space-y-1">
                    <label class="block text-xs font-bold text-gray-600 uppercase">Mô hình kinh doanh (*)</label>
                    <select 
                      name="Mô hình kinh doanh" 
                      class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3.5 py-2.5 text-sm text-gray-900 focus:outline-none focus:border-[#23c1c6] focus:bg-white transition"
                      required
                    >
                      <option value="" disabled selected>-- Chọn mô hình --</option>
                      <option value="Pet Shop / Cửa hàng thú cưng">Pet Shop / Cửa hàng thú cưng</option>
                      <option value="Phòng khám thú y / Bệnh viện thú y">Phòng khám thú y / Bệnh viện thú y</option>
                      <option value="Spa Grooming">Spa Grooming</option>
                      <option value="Nhà bán lẻ Online / TMĐT">Nhà bán lẻ Online / TMĐT</option>
                      <option value="Khác / Nhà phân phối">Khác / Nhà phân phối</option>
                    </select>
                  </div>

                  <div class="space-y-1">
                    <label class="block text-xs font-bold text-gray-600 uppercase">Khu vực / Tỉnh Thành</label>
                    <input 
                      type="text" 
                      name="Địa chỉ Tỉnh/Thành" 
                      placeholder="VD: Quận 1, TP. Hồ Chí Minh" 
                      class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3.5 py-2.5 text-sm text-gray-900 focus:outline-none focus:border-[#23c1c6] focus:bg-white transition" 
     
                    />
                  </div>

                  <button 
                    id="partner-submit"
                    type="submit" 
                    class="w-full text-white py-3.5 rounded-xl font-bold transition duration-300 hover:opacity-95 shadow-lg shadow-[#23c1c6]/25 bg-[#23c1c6] cursor-pointer mt-2"
                  >
                    Gửi yêu cầu ngay
                  </button>
                  <p id="partner-form-status" class="hidden rounded-xl px-4 py-3 text-center text-sm font-semibold" role="status" aria-live="polite"></p>
                </form>

                <script is:inline>
                  (() => {
                    const form = document.getElementById('partner-form');
                    const submitButton = document.getElementById('partner-submit');
                    const status = document.getElementById('partner-form-status');
                    if (!form || !submitButton || !status) return;

                    form.addEventListener('submit', async (event) => {
                      event.preventDefault();
                      if (!form.reportValidity()) return;

                      const originalLabel = submitButton.textContent;
                      submitButton.disabled = true;
                      submitButton.textContent = 'Đang gửi...';
                      submitButton.classList.add('opacity-70', 'cursor-wait');
                      status.className = 'hidden';

                      try {
                        const formData = new FormData(form);
                        const payload = Object.fromEntries(formData.entries());
                        const response = await fetch('https://formsubmit.co/ajax/lapetvietnam.vn@gmail.com', {
                          method: 'POST',
                          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                          body: JSON.stringify(payload)
                        });
                        if (!response.ok) throw new Error('Không thể gửi biểu mẫu');

                        form.reset();
                        status.textContent = 'Đã gửi yêu cầu thành công! LA PET sẽ liên hệ trong 24h.';
                        status.className = 'block rounded-xl bg-emerald-50 px-4 py-3 text-center text-sm font-semibold text-emerald-700';
                      } catch (error) {
                        status.textContent = 'Chưa gửi được yêu cầu. Vui lòng thử lại hoặc gọi Hotline: 0909 203 166.';
                        status.className = 'block rounded-xl bg-red-50 px-4 py-3 text-center text-sm font-semibold text-red-700';
                      } finally {
                        submitButton.disabled = false;
                        submitButton.textContent = originalLabel;
                        submitButton.classList.remove('opacity-70', 'cursor-wait');
                      }
                    });
                  })();
                </script>
              </div>
            </div>

          </div>

        </div>
      </section>
    </main>

    <!-- 3. FOOTER -->
    <Footer />

  </body>
</html>
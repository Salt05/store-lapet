---
// src/pages/lien-he.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Badge from '../components/common/Badge.astro';
import { configService } from '@/services/config.service';

const allConfigs = await configService.getAllConfigs();
const companyInfo = allConfigs.get('company_info') || {};
const hotline = companyInfo.hotline || '0909 203 166';
const contactEmail = companyInfo.email || 'contact@lapet.vn';

const title = "Liên hệ & Đăng ký Đại lý B2B - LA PET VIỆT NAM";
const description = "Trở thành đối tác đại lý chính thức của LA PET để nhận chính sách chiết khấu tới 22%, thưởng doanh số hấp dẫn và nguồn hàng bánh thưởng, phụ kiện thú cưng chất lượng cao.";

const reasons = [
  {
    num: '01',
    title: 'Sản phẩm rõ nguồn gốc',
    desc: 'Thông tin rõ ràng về thành phần, quy cách và tiêu chuẩn, giúp đại lý tự tin hơn khi tư vấn cho khách hàng.'
  },
  {
    num: '02',
    title: 'Danh mục dễ bán & đa dạng',
    desc: 'Phù hợp cho pet shop, spa thú cưng, phòng khám thú y, nhà bán lẻ online và các kênh sàn TMĐT.'
  },
  {
    num: '03',
    title: 'Định vị khác biệt cao cấp',
    desc: 'An tâm trong từng miếng thưởng, xây dựng niềm tin dài hạn bằng sự minh bạch và tiêu chuẩn an toàn.'
  },
  {
    num: '04',
    title: 'Chính sách chiết khấu tốt',
    desc: 'Mức chiết khấu đại lý hấp dẫn tới 22%, thưởng định kỳ theo từng quý và năm cho các mốc doanh số.'
  },
  {
    num: '05',
    title: 'Hỗ trợ truyền thông & hình ảnh',
    desc: 'Cung cấp trọn bộ ảnh sản phẩm độ phân giải cao, video tư liệu, bài viết và banner hỗ trợ bán hàng đa kênh.'
  },
  {
    num: '06',
    title: 'Cổng đặt hàng B2B 24/7',
    desc: 'Tài khoản đại lý cập nhật bảng giá sỉ & tồn kho tự động, đặt hàng nhanh chóng tiện lợi qua điện thoại.'
  }
];
---

<BaseLayout title={title} description={description}>
  <!-- SECTION ĐĂNG KÝ HỢP TÁC & LÝ DO ĐỒNG HÀNH -->
  <section id="partner-registration" class="relative w-full py-10 sm:py-16 bg-brand-surface scroll-mt-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- TIÊU ĐỀ CHÍNH -->
      <div class="max-w-4xl mx-auto mb-10 sm:mb-12 p-6 sm:p-10 rounded-2xl bg-brand-dark text-white text-center shadow-card border border-brand-primary/30 space-y-3">
        <Badge variant="accent" pill>Hợp Tác B2B</Badge>
        <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black text-white leading-tight">
          Vì sao nên hợp tác cùng <span class="text-brand-accent">LA PET</span>?
        </h1>
        <p class="text-white/80 text-xs sm:text-base font-normal max-w-2xl mx-auto leading-relaxed">
          LA PET đồng hành cùng đại lý bằng danh mục bánh thưởng, snack, tã lót và cát vệ sinh dễ kinh doanh, nguồn gốc minh bạch và hỗ trợ bán hàng chu đáo.
        </p>
      </div>

      <!-- KHU VỰC 2 CỘT: 6 Ô LÝ DO (TRÁI) & FORM (PHẢI) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- CỘT TRÁI (7 Cột): 6 Ô LÝ DO -->
        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4 w-full">
          {reasons.map((item) => (
            <div class="bg-white p-5 rounded-xl border border-brand-border shadow-soft flex flex-col justify-between hover:shadow-card transition-shadow">
              <div>
                <div class="flex items-center gap-3 mb-2">
                  <span class="flex items-center justify-center w-7 h-7 rounded-lg bg-brand-primary/10 text-brand-primary font-black text-xs shrink-0">
                    {item.num}
                  </span>
                  <h3 class="font-bold text-brand-dark text-sm sm:text-base leading-snug">{item.title}</h3>
                </div>
                <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
                  {item.desc}
                </p>
              </div>
            </div>
          ))}

          <!-- THÔNG TIN LIÊN HỆ BỔ SUNG -->
          <div class="sm:col-span-2 p-5 rounded-xl bg-brand-sand border border-brand-border flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-brand-primary">Hỗ trợ đối tác trực tiếp</p>
              <p class="text-sm font-bold text-brand-dark mt-0.5">Hotline: {hotline} | {contactEmail}</p>
            </div>
            <a 
              href={`tel:${hotline.replace(/\s+/g, '')}`} 
              class="px-4 py-2 rounded-xl bg-brand-dark text-white font-bold text-xs uppercase tracking-wider hover:bg-brand-primary transition-colors shrink-0"
            >
              Gọi ngay
            </a>
          </div>
        </div>

        <!-- CỘT PHẢI (5 Cột): FORM ĐĂNG KÝ HỢP TÁC -->
        <div class="lg:col-span-5 w-full">
          <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-card border border-brand-border space-y-4">
            
            <div class="text-center space-y-1">
              <h2 class="text-xl sm:text-2xl font-extrabold text-brand-dark">Đăng Ký Đại Lý B2B</h2>
              <p class="text-brand-muted text-xs sm:text-sm">Điền thông tin bên dưới để nhận chính sách đại lý tốt nhất.</p>
            </div>

            <form 
              id="partner-form"
              action="/api/dealers/register" 
              method="POST" 
              class="space-y-3.5"
            >
              <!-- Antispam Honeypot Field -->
              <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" />

              <div class="space-y-1">
                <label class="block text-xs font-bold text-brand-dark uppercase">Họ và Tên đại diện (*)</label>
                <input 
                  type="text" 
                  name="name" 
                  placeholder="Nguyễn Văn A" 
                  class="w-full bg-brand-surface border border-brand-border rounded-xl px-3.5 py-2.5 text-sm text-brand-text placeholder-brand-muted focus:outline-none focus:border-brand-primary focus:bg-white focus:ring-2 focus:ring-brand-primary/20 transition" 
                  required 
                />
              </div>

              <div class="space-y-1">
                <label class="block text-xs font-bold text-brand-dark uppercase">Số điện thoại (*)</label>
                <input 
                  type="tel" 
                  name="phone" 
                  placeholder="0909 203 166" 
                  class="w-full bg-brand-surface border border-brand-border rounded-xl px-3.5 py-2.5 text-sm text-brand-text placeholder-brand-muted focus:outline-none focus:border-brand-primary focus:bg-white focus:ring-2 focus:ring-brand-primary/20 transition" 
                  required 
                />
              </div>

              <div class="space-y-1">
                <label class="block text-xs font-bold text-brand-dark uppercase">Tên Cửa Hàng / Spa / Phòng Khám</label>
                <input 
                  type="text" 
                  name="store_name" 
                  placeholder="Pet Shop ABC" 
                  class="w-full bg-brand-surface border border-brand-border rounded-xl px-3.5 py-2.5 text-sm text-brand-text placeholder-brand-muted focus:outline-none focus:border-brand-primary focus:bg-white focus:ring-2 focus:ring-brand-primary/20 transition" 
                />
              </div>

              <div class="space-y-1">
                <label class="block text-xs font-bold text-brand-dark uppercase">Mô hình kinh doanh (*)</label>
                <select 
                  name="business_model" 
                  class="w-full bg-brand-surface border border-brand-border rounded-xl px-3.5 py-2.5 text-sm text-brand-text focus:outline-none focus:border-brand-primary focus:bg-white focus:ring-2 focus:ring-brand-primary/20 transition"
                  required
                >
                  <option value="" disabled selected>-- Chọn mô hình --</option>
                  <option value="Pet Shop / Cửa hàng thú cưng">Pet Shop / Cửa hàng thú cưng</option>
                  <option value="Phòng khám thú y / Bệnh viện thú y">Phòng khám thú y / Bệnh viện thú y</option>
                  <option value="Spa Grooming">Spa Grooming</option>
                  <option value="Nhà bán lẻ Online / TMĐT">Nhà bán lẻ Online / TMĐT</option>
                  <option value="Khác / Nhà phân phối">Khác / Nhà phân phối</option>
                </select>
              </div>

              <div class="space-y-1">
                <label class="block text-xs font-bold text-brand-dark uppercase">Khu vực / Tỉnh Thành</label>
                <input 
                  type="text" 
                  name="city" 
                  placeholder="VD: TP. Hồ Chí Minh, Hà Nội, Đà Nẵng..." 
                  class="w-full bg-brand-surface border border-brand-border rounded-xl px-3.5 py-2.5 text-sm text-brand-text placeholder-brand-muted focus:outline-none focus:border-brand-primary focus:bg-white focus:ring-2 focus:ring-brand-primary/20 transition" 
                />
              </div>

              <div class="space-y-1">
                <label class="block text-xs font-bold text-brand-dark uppercase">Email (tùy chọn)</label>
                <input 
                  type="email" 
                  name="email" 
                  placeholder="cuahang@gmail.com" 
                  class="w-full bg-brand-surface border border-brand-border rounded-xl px-3.5 py-2.5 text-sm text-brand-text placeholder-brand-muted focus:outline-none focus:border-brand-primary focus:bg-white focus:ring-2 focus:ring-brand-primary/20 transition" 
                />
              </div>

              <div class="space-y-1">
                <label class="block text-xs font-bold text-brand-dark uppercase">Mật khẩu khởi tạo (tùy chọn)</label>
                <input 
                  type="password" 
                  name="password" 
                  minlength="6"
                  placeholder="Tối thiểu 6 ký tự để đăng nhập B2B" 
                  class="w-full bg-brand-surface border border-brand-border rounded-xl px-3.5 py-2.5 text-sm text-brand-text placeholder-brand-muted focus:outline-none focus:border-brand-primary focus:bg-white focus:ring-2 focus:ring-brand-primary/20 transition" 
                />
              </div>

              <button 
                id="partner-submit"
                type="submit" 
                class="w-full text-white py-3.5 rounded-xl font-extrabold text-sm uppercase tracking-wider transition duration-200 bg-brand-primary hover:bg-brand-dark shadow-soft hover:shadow-card cursor-pointer mt-3"
              >
                Gửi thông tin đăng ký
              </button>
              <p id="partner-form-status" class="hidden rounded-xl px-4 py-3 text-center text-xs sm:text-sm font-semibold" role="status" aria-live="polite"></p>
            </form>

            <script is:inline>
              (() => {
                const form = document.getElementById('partner-form');
                const submitButton = document.getElementById('partner-submit');
                const status = document.getElementById('partner-form-status');
                if (!form || !submitButton || !status) return;

                // Tự động điền email nếu có từ URL param hoặc sessionStorage và cuộn tới form
                try {
                  const urlEmail = new URLSearchParams(window.location.search).get('email');
                  const sessionEmail = sessionStorage.getItem('dealer_reg_email');
                  const emailToSet = urlEmail || sessionEmail;
                  if (emailToSet) {
                    const emailInput = form.querySelector('input[name="email"]');
                    if (emailInput) {
                      emailInput.value = emailToSet;
                      emailInput.classList.add('ring-2', 'ring-brand-primary/50', 'bg-amber-50/50');
                    }
                  }

                  // Tự động cuộn mượt tới khu vực form đăng ký nếu URL có hash hoặc có email param
                  if (window.location.hash === '#partner-registration' || urlEmail) {
                    setTimeout(() => {
                      const target = document.getElementById('partner-registration') || form;
                      target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }, 120);
                  }
                } catch (e) {}

                form.addEventListener('submit', async (event) => {
                  event.preventDefault();
                  if (!form.reportValidity()) return;

                  const originalLabel = submitButton.textContent;
                  submitButton.disabled = true;
                  submitButton.textContent = 'Đang gửi...';
                  submitButton.classList.add('opacity-70', 'cursor-wait');
                  status.className = 'hidden';

                  try {
                    const formData = new FormData(form);
                    const payload = Object.fromEntries(formData.entries());
                    const response = await fetch('/api/dealers/register', {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                      body: JSON.stringify(payload)
                    });
                    const data = await response.json();
                    if (!response.ok || !data.success) {
                      throw new Error(data.message || data.error || 'Không thể gửi biểu mẫu');
                    }

                    form.reset();
                    status.textContent = data.message || 'Đăng ký đại lý thành công! Đội ngũ LA PET sẽ liên hệ trong 24h làm việc.';
                    status.className = 'block rounded-xl bg-emerald-50 px-4 py-3 text-center text-xs sm:text-sm font-semibold text-emerald-700 border border-emerald-200';
                  } catch (error) {
                    status.textContent = error.message || 'Chưa gửi được yêu cầu. Vui lòng thử lại hoặc gọi Hotline: 0909 203 166.';
                    status.className = 'block rounded-xl bg-rose-50 px-4 py-3 text-center text-xs sm:text-sm font-semibold text-rose-700 border border-rose-200';
                  } finally {
                    submitButton.disabled = false;
                    submitButton.textContent = originalLabel;
                    submitButton.classList.remove('opacity-70', 'cursor-wait');
                  }
                });
              })();
            </script>
          </div>
        </div>

      </div>

    </div>
  </section>
</BaseLayout>
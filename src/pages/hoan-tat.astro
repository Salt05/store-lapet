<script define:vars={{ LONGTERM_POLICY }}>
document.addEventListener("DOMContentLoaded", async () => {
  const YEAR_MILESTONES = LONGTERM_POLICY?.yearMilestones || [];
  const QUARTER_MILESTONES = LONGTERM_POLICY?.quarterMilestones || [];
  const POLICY_YEAR = LONGTERM_POLICY?.year || new Date().getFullYear();

  const urlParams = new URLSearchParams(window.location.search);
  let activeOrderId = urlParams.get("order_id");

  const partnerInput = document.getElementById("current-partner-id");
  const partnerId = partnerInput?.value || "";

  let allOrders = [];
  let currentPage = 1;
  const ITEMS_PER_PAGE = 5;
  let activeTab = 'year';
  let currentLoadedOrder = null;
  let cachedPaymentUrl = '';

  let calculatedSales = {
    yearTotal: 0,
    quarters: { q1: 0, q2: 0, q3: 0, q4: 0 }
  };

  const STATUS_MAP = {
    'draft': { label: 'Đơn nháp', color: 'bg-sky-50 text-sky-700 border-sky-200' },
    'confirmed': { label: 'Đơn bán hàng', color: 'bg-blue-50 text-blue-700 border-blue-200' },
    'delivered': { label: 'Đã giao', color: 'bg-amber-50 text-amber-700 border-amber-200' },
    'completed': { label: 'Hoàn tất', color: 'bg-emerald-50 text-emerald-700 border-emerald-200' },
    'cancelled': { label: 'Đã hủy', color: 'bg-rose-50 text-rose-600 border-rose-200' },
    // backward compat
    'sent': { label: 'Đơn nháp', color: 'bg-sky-50 text-sky-700 border-sky-200' },
    'sale': { label: 'Đơn bán hàng', color: 'bg-blue-50 text-blue-700 border-blue-200' },
    'shipping': { label: 'Đã giao', color: 'bg-amber-50 text-amber-700 border-amber-200' },
    'done': { label: 'Hoàn tất', color: 'bg-emerald-50 text-emerald-700 border-emerald-200' },
    'cancel': { label: 'Đã hủy', color: 'bg-rose-50 text-rose-600 border-rose-200' }
  };

  // Helper Escape HTML chống XSS
  function escapeHtml(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  // Helper Safe Date Parser hỗ trợ cross-browser (Safari/iOS)
  function parseOrderMonth(dateStr) {
    if (!dateStr) return new Date().getMonth() + 1;
    const formatted = String(dateStr).replace(" ", "T");
    const d = new Date(formatted);
    return isNaN(d.getTime()) ? (new Date().getMonth() + 1) : (d.getMonth() + 1);
  }

  // Đóng Drawer lịch sử
  function closeHistoryDrawer() {
    window.dispatchEvent(new CustomEvent('close-history-drawer'));
  }

  const btnYear = document.getElementById("tab-btn-year");
  const btnQuarter = document.getElementById("tab-btn-quarter");
  const quarterSelectWrapper = document.getElementById("quarter-select-wrapper");
  const salesPeriodLabel = document.getElementById("stat-sales-period-label");

  btnYear?.addEventListener("click", () => {
    activeTab = 'year';
    btnYear.className = "tab-btn active px-2 py-0.5 rounded-md font-bold transition-all duration-200 bg-[#083a3c] text-white shadow-2xs cursor-pointer";
    btnQuarter.className = "tab-btn px-2 py-0.5 rounded-md font-bold transition-all duration-200 text-slate-600 hover:text-slate-900 cursor-pointer";
    quarterSelectWrapper?.classList.add("hidden");
    quarterSelectWrapper?.classList.remove("inline-flex");
    if (salesPeriodLabel) salesPeriodLabel.textContent = `Tích lũy năm ${POLICY_YEAR}`;
    updateMilestoneUI();
  });

  btnQuarter?.addEventListener("click", () => {
    activeTab = 'quarter';
    btnQuarter.className = "tab-btn active px-2 py-0.5 rounded-md font-bold transition-all duration-200 bg-[#083a3c] text-white shadow-2xs cursor-pointer";
    btnYear.className = "tab-btn px-2 py-0.5 rounded-md font-bold transition-all duration-200 text-slate-600 hover:text-slate-900 cursor-pointer";
    quarterSelectWrapper?.classList.remove("hidden");
    quarterSelectWrapper?.classList.add("inline-flex");
    const selQ = document.getElementById("quarter-select")?.value || 'q1';
    if (salesPeriodLabel) salesPeriodLabel.textContent = `Tích lũy ${selQ.toUpperCase()}/${POLICY_YEAR}`;
    updateMilestoneUI();
  });

  document.getElementById("quarter-select")?.addEventListener("change", (e) => {
    if (activeTab === 'quarter') {
      const selQ = e.target.value || 'q1';
      if (salesPeriodLabel) salesPeriodLabel.textContent = `Tích lũy ${selQ.toUpperCase()}/${POLICY_YEAR}`;
      updateMilestoneUI();
    }
  });

  async function computeSalesFromOrders() {
    try {
      const summaryUrl = partnerId ? `/api/customers/sales-summary?customer_id=${encodeURIComponent(partnerId)}` : '/api/customers/sales-summary';
      const res = await fetch(summaryUrl);
      if (res.ok) {
        const data = await res.json();
        if (data && data.success && typeof data.total_sales === 'number') {
          calculatedSales.yearTotal = data.total_sales;
        }
      }
    } catch (e) {
      console.warn("Failed to fetch verified sales summary:", e);
    }

    let yearSum = calculatedSales.yearTotal || 0;
    const qSums = { q1: 0, q2: 0, q3: 0, q4: 0 };

    allOrders.forEach(ord => {
      if (ord.state === 'sale' || ord.state === 'done' || ord.state === 'confirmed' || ord.state === 'delivered' || ord.state === 'completed') {
        const amount = Number(ord.amount_total) || 0;
        const month = parseOrderMonth(ord.date);

        if (month >= 1 && month <= 3) qSums.q1 += amount;
        else if (month >= 4 && month <= 6) qSums.q2 += amount;
        else if (month >= 7 && month <= 9) qSums.q3 += amount;
        else if (month >= 10 && month <= 12) qSums.q4 += amount;
      }
    });

    if (!calculatedSales.yearTotal) {
      calculatedSales.yearTotal = (qSums.q1 + qSums.q2 + qSums.q3 + qSums.q4);
    }
    calculatedSales.quarters = qSums;

    const currentMonth = new Date().getMonth() + 1;
    const currentQ = currentMonth <= 3 ? 'q1' : currentMonth <= 6 ? 'q2' : currentMonth <= 9 ? 'q3' : 'q4';
    const selectEl = document.getElementById("quarter-select");
    if (selectEl) selectEl.value = currentQ;

    updateMilestoneUI();
  }

  function updateMilestoneUI() {
    if (activeTab === 'year') {
      renderSingleMilestone(
        calculatedSales.yearTotal, 
        YEAR_MILESTONES, 
        `Năm ${POLICY_YEAR}`
      );
    } else {
      const selectedQ = document.getElementById("quarter-select")?.value || 'q1';
      const currentSales = calculatedSales.quarters[selectedQ] || 0;
      const qText = selectedQ.toUpperCase();

      renderSingleMilestone(
        currentSales, 
        QUARTER_MILESTONES, 
        qText
      );
    }
  }

  function renderSingleMilestone(
    currentSales, 
    milestones,
    periodName
  ) {
    const salesEl = document.getElementById("stat-current-sales");
    const tierEl = document.getElementById("stat-current-tier");
    const bonusEl = document.getElementById("stat-current-bonus");
    const nextTargetEl = document.getElementById("stat-next-target");
    const remainingEl = document.getElementById("stat-remaining-amount");
    const progressSubEl = document.getElementById("stat-progress-sub");
    const fillEl = document.getElementById("stat-progress-fill");
    const container = document.getElementById("stat-milestones-container");
    const containerMobile = document.getElementById("stat-milestones-container-mobile");

    // 1. Doanh số tích lũy
    if (salesEl) salesEl.textContent = currentSales.toLocaleString("vi-VN") + "đ";

    let currentRate = 0;
    let nextMilestone = null;

    for (let i = 0; i < milestones.length; i++) {
      if (currentSales >= milestones[i].target) {
        currentRate = milestones[i].rate;
      } else {
        nextMilestone = milestones[i];
        break;
      }
    }

    // 2. Mức chiết khấu hiện tại
    if (tierEl) tierEl.textContent = `${currentRate.toFixed(1)}%`;

    // 3. Tiền thưởng dự kiến
    const bonusAmount = Math.round(currentSales * (currentRate / 100));
    if (bonusEl) bonusEl.textContent = bonusAmount.toLocaleString("vi-VN") + "đ";

    // 4. Mục tiêu tiếp theo & 5. Số tiền còn thiếu
    if (nextMilestone) {
      const remaining = nextMilestone.target - currentSales;
      if (nextTargetEl) nextTargetEl.textContent = nextMilestone.target.toLocaleString("vi-VN") + "đ";
      if (remainingEl) remainingEl.textContent = remaining.toLocaleString("vi-VN") + "đ";
    } else {
      if (nextTargetEl) nextTargetEl.textContent = "Đã đạt tối đa";
      if (remainingEl) remainingEl.textContent = "0đ";
    }

    const mainAlert = document.getElementById("alert-main-text");
    const subAlert = document.getElementById("alert-sub-text");

    if (nextMilestone) {
      const remaining = nextMilestone.target - currentSales;
      if (mainAlert) {
        mainAlert.innerHTML = `Thiếu <strong class="text-rose-600 font-bold">${remaining.toLocaleString("vi-VN")}đ</strong> để đạt mức thưởng <strong class="text-emerald-700 font-bold">${nextMilestone.rate.toFixed(1)}%</strong> (${escapeHtml(nextMilestone.label)})`;
      }
      if (subAlert) {
        subAlert.textContent = `Mốc mục tiêu kế tiếp: ${nextMilestone.target.toLocaleString("vi-VN")}đ (${escapeHtml(nextMilestone.label)})`;
      }
    } else {
      if (mainAlert) {
        mainAlert.innerHTML = `Chúc mừng! Đạt mốc thưởng ${escapeHtml(periodName)} cao nhất: <strong class="text-emerald-700 font-bold">${currentRate.toFixed(1)}%</strong>!`;
      }
      if (subAlert) {
        subAlert.textContent = `Cảm ơn sự hợp tác kinh doanh tuyệt vời cùng LA PET.`;
      }
    }

    let progressPercent = 0;
    const stepRatio = milestones.length > 1 ? 100 / (milestones.length - 1) : 100;
    let activeIndex = -1;

    for (let i = 0; i < milestones.length; i++) {
      if (currentSales >= milestones[i].target) {
        activeIndex = i;
      }
    }

    if (activeIndex === -1) {
      progressPercent = milestones.length > 0 ? (currentSales / milestones[0].target) * (stepRatio / 2) : 0;
    } else if (activeIndex === milestones.length - 1) {
      progressPercent = 100;
    } else {
      const baseProgress = activeIndex * stepRatio;
      const currentChunk = currentSales - milestones[activeIndex].target;
      const chunkTarget = milestones[activeIndex + 1].target - milestones[activeIndex].target;
      progressPercent = baseProgress + (currentChunk / chunkTarget) * stepRatio;
    }

    const clampedPercent = Math.min(Math.max(progressPercent, 0), 100);
    if (fillEl) fillEl.style.width = `${clampedPercent}%`;
    if (progressSubEl) progressSubEl.textContent = `Tiến độ: ${Math.round(clampedPercent)}%`;

    if (container) {
      container.innerHTML = milestones.map((m) => {
        const isReached = currentSales >= m.target;
        const isCurrentTarget = nextMilestone && nextMilestone.target === m.target;

        return `
          <div class="flex flex-col items-center group cursor-pointer relative">
            <div class="w-8 h-8 rounded-full flex items-center justify-center font-extrabold text-2xs transition-all duration-300 z-10 ${
              isReached 
                ? 'bg-[#083a3c] text-white shadow-2xs ring-4 ring-teal-100 scale-105' 
                : isCurrentTarget 
                  ? 'bg-white text-orange-600 border-2 border-orange-500 ring-4 ring-orange-100' 
                  : 'bg-white text-slate-400 border border-slate-200'
            }">
              ${isReached ? '✓' : `${m.rate}%`}
            </div>

            <div class="text-center mt-1.5">
              <span class="text-2xs font-extrabold block tracking-tight ${isReached ? 'text-[#083a3c]' : isCurrentTarget ? 'text-orange-600' : 'text-slate-600'}">
                ${escapeHtml(m.label)}
              </span>
              <span class="text-3xs text-slate-400 block">${(m.target / 1000000).toLocaleString('vi-VN')}Tr</span>
            </div>
          </div>
        `;
      }).join("");
    }

    if (containerMobile) {
      containerMobile.innerHTML = milestones.map((m, idx) => {
        const isReached = currentSales >= m.target;
        const isCurrentTarget = nextMilestone && nextMilestone.target === m.target;

        return `
          <div class="p-2 rounded-xl border flex items-center justify-between transition ${
            isReached 
              ? 'bg-teal-50/60 border-teal-200 text-teal-950' 
              : isCurrentTarget 
                ? 'bg-orange-50/50 border-orange-300 ring-1 ring-orange-200' 
                : 'bg-slate-50/50 border-slate-100 text-slate-400'
          }">
            <div class="flex items-center gap-2">
              <div class="w-5 h-5 rounded-full flex items-center justify-center font-extrabold text-3xs shrink-0 transition-all ${
                isReached 
                  ? 'bg-[#083a3c] text-white shadow-2xs' 
                  : isCurrentTarget 
                    ? 'bg-orange-600 text-white' 
                    : 'bg-slate-200 text-slate-500'
              }">
                ${isReached ? '✓' : (idx + 1)}
              </div>

              <div>
                <span class="text-2xs font-black block ${isReached ? 'text-[#083a3c]' : isCurrentTarget ? 'text-orange-600' : 'text-slate-700'}">
                  Thưởng ${m.rate}% (${escapeHtml(m.label)})
                </span>
                <span class="text-3xs text-slate-400 block font-medium">
                  Mốc ${m.target.toLocaleString('vi-VN')}đ
                </span>
              </div>
            </div>

            <div>
              ${isReached 
                ? '<span class="text-3xs font-extrabold text-teal-800 bg-teal-100/80 px-2 py-0.5 rounded-full">Đã đạt</span>' 
                : isCurrentTarget 
                  ? '<span class="text-3xs font-extrabold text-orange-700 bg-orange-100 px-2 py-0.5 rounded-full">Mục tiêu kế</span>' 
                  : '<span class="text-3xs font-medium text-slate-400">Chưa đạt</span>'
              }
            </div>
          </div>
        `;
      }).join("");
    }
  }

  async function loadOrderDetails(targetId) {
    if (!targetId) return;

    const currentOrderEl = document.getElementById("current-order-id");
    const dateEl = document.getElementById("current-order-date");
    const displayId = (targetId.startsWith('WEB-') || targetId.startsWith('ORD-'))
      ? 'Đang tải...'
      : `#${escapeHtml(targetId)}`;
    if (currentOrderEl) currentOrderEl.textContent = displayId;
    
    const itemsTable = document.getElementById("current-order-items-table");
    const statusTag = document.getElementById("current-order-status-tag");
    const subtotalEl = document.getElementById("current-order-subtotal");
    const sideTotalEl = document.getElementById("current-order-total-side");
    const qtyEl = document.getElementById("current-order-qty");

    if (itemsTable) {
      itemsTable.innerHTML = `
        <tr>
          <td colspan="4" class="text-xs text-slate-500 py-6 text-center">
            <div class="inline-flex items-center gap-2">
              <span class="inline-block w-2.5 h-2.5 rounded-full bg-teal-600 animate-ping"></span>
              <span>Đang đồng bộ thông tin đơn hàng với hệ thống...</span>
            </div>
          </td>
        </tr>
      `;
    }

    let order = null;
    let attempts = 0;
    const isWebRef = targetId.startsWith("WEB-") || targetId.startsWith("ORD-");
    const maxAttempts = isWebRef ? 8 : 2;
    const retryDelay = isWebRef ? 2000 : 1000;

    while (attempts < maxAttempts) {
      try {
        const res = await fetch(`/api/orders/${encodeURIComponent(targetId)}`);
        if (res.ok) {
          const data = await res.json();
          if (data && (data.id || data.order_code)) {
            order = data;
            break;
          }
        }
      } catch (e) {
        console.warn("Lần thử tải chi tiết đơn hàng:", e);
      }

      attempts++;
      if (attempts < maxAttempts) {
        if (itemsTable) {
          itemsTable.innerHTML = `
            <tr>
              <td colspan="4" class="text-xs text-slate-500 py-6 text-center">
                <div class="inline-flex items-center gap-2">
                  <span class="inline-block w-2.5 h-2.5 rounded-full bg-amber-500 animate-ping"></span>
                  <span>Đang đợi hệ thống xác nhận đơn hàng (lần ${attempts}/${maxAttempts})...</span>
                </div>
              </td>
            </tr>
          `;
        }
        await new Promise(r => setTimeout(r, retryDelay));
      }
    }

    if (!order) {
      if (allOrders.length > 0 && isWebRef) {
        order = allOrders[0];
      }

      if (!order) {
        if (itemsTable) {
          itemsTable.innerHTML = `<tr><td colspan="4" class="text-xs text-amber-600 py-4 text-center">Đơn hàng đang được xử lý. Vui lòng tải lại trang sau vài phút.</td></tr>`;
        }
        if (statusTag) {
          statusTag.className = "px-2.5 py-0.5 rounded-full text-2xs font-bold border bg-amber-50 text-amber-700 border-amber-200";
          statusTag.textContent = "Đang xử lý";
        }
        if (currentOrderEl) currentOrderEl.textContent = '--';
        return;
      }
    }

    const officialCode = order.order_code || order.id || targetId;
    if (currentOrderEl) currentOrderEl.textContent = `#${escapeHtml(officialCode)}`;
    if (dateEl) dateEl.textContent = order.date ? `Ngày đặt: ${escapeHtml(order.date)}` : '';

    const formattedTotal = (order.amount_total || 0).toLocaleString("vi-VN") + "đ";
    if (subtotalEl) subtotalEl.textContent = formattedTotal;
    if (sideTotalEl) sideTotalEl.textContent = formattedTotal;
    if (qtyEl) qtyEl.textContent = `${order.items?.length || 0} sản phẩm`;

    if (statusTag) {
      const st = STATUS_MAP[order.state] || {
        label: order.state === 'draft' ? 'Đơn nháp' : (order.state || 'Đang xử lý'),
        color: 'bg-sky-50 text-sky-700 border-sky-200'
      };
      statusTag.className = `px-2.5 py-0.5 rounded-full text-2xs font-bold border ${st.color}`;
      statusTag.textContent = st.label;
    }

    if (itemsTable && order.items && order.items.length > 0) {
      itemsTable.innerHTML = order.items.map((item) => `
        <tr class="hover:bg-slate-50/70 transition border-b border-slate-100 last:border-b-0 text-xs">
          <td class="py-2.5 px-3">
            <p class="font-bold text-slate-900 line-clamp-1">${escapeHtml(item.name)}</p>
            <p class="text-slate-400 font-mono text-3xs mt-0.5">SKU: ${escapeHtml(item.sku || item.product_id || '--')}</p>
          </td>
          <td class="py-2.5 px-3 text-right font-medium text-slate-600 whitespace-nowrap">${(item.price || 0).toLocaleString('vi-VN')}đ</td>
          <td class="py-2.5 px-3 text-center font-bold text-slate-800 whitespace-nowrap">${item.qty}</td>
          <td class="py-2.5 px-3 text-right font-extrabold text-slate-900 whitespace-nowrap">${((item.qty || 0) * (item.price || 0)).toLocaleString('vi-VN')}đ</td>
        </tr>
      `).join("");
    } else if (itemsTable) {
      itemsTable.innerHTML = `<tr><td colspan="4" class="text-xs text-slate-400 py-4 text-center">Không có danh sách sản phẩm.</td></tr>`;
    }

    currentLoadedOrder = order;
    updateOrderMetadataUI(order, officialCode);

    const matchedHistoryItem = allOrders.find(
      (o) => String(o.id) === String(officialCode) || String(o.raw_id) === String(order.id)
    );
    if (matchedHistoryItem && matchedHistoryItem.state !== order.state) {
      matchedHistoryItem.state = order.state;
      renderOrderTable();
    }

    if (officialCode && !officialCode.startsWith('WEB-') && !officialCode.startsWith('ORD-') && targetId !== officialCode) {
      history.replaceState(null, "", `/hoan-tat?order_id=${encodeURIComponent(officialCode)}`);
      activeOrderId = officialCode;
      setTimeout(() => loadOrderHistoryAndInit(false), 500);
    }
  }

  function renderOrderTable() {
    const desktopTbody = document.getElementById("order-history-tbody-desktop");
    const mobileCardsContainer = document.getElementById("order-history-cards-mobile");
    const badgeCountEl = document.getElementById("badge-recent-orders-count");

    const totalItems = allOrders.length;
    if (badgeCountEl) {
      badgeCountEl.textContent = totalItems > 0 ? totalItems : '0';
    }

    if (totalItems === 0) {
      if (desktopTbody) {
        desktopTbody.innerHTML = `
          <tr>
            <td colspan="5" class="py-6 text-center text-slate-400 text-2xs">
              Chưa có đơn hàng nào trong lịch sử.
            </td>
          </tr>
        `;
      }
      if (mobileCardsContainer) {
        mobileCardsContainer.innerHTML = `
          <div class="py-6 text-center text-slate-400 text-2xs">
            Chưa có đơn hàng nào trong lịch sử.
          </div>
        `;
      }
      renderPaginationControls(0);
      return;
    }

    const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
    const endIndex = startIndex + ITEMS_PER_PAGE;
    const pageOrders = allOrders.slice(startIndex, endIndex);

    if (desktopTbody) {
      desktopTbody.innerHTML = pageOrders.map((ord) => {
        const st = STATUS_MAP[ord.state] || { label: ord.state, color: 'bg-slate-100 text-slate-700 border-slate-200' };
        const isSelected = String(ord.id) === String(activeOrderId);

        return `
          <tr class="hover:bg-slate-50 transition border-b border-slate-100 last:border-b-0 ${isSelected ? 'bg-teal-50/60 font-semibold' : ''}">
            <td class="py-2.5 px-2.5 font-bold font-mono text-[#083a3c] text-2xs">
              #${escapeHtml(ord.id)}
              ${isSelected ? '<span class="ml-1 text-3xs font-extrabold bg-[#083a3c] text-white px-1 py-0.2 rounded">Xem</span>' : ''}
            </td>
            <td class="py-2.5 px-2 text-slate-500 text-3xs whitespace-nowrap">${escapeHtml(ord.date) || '--'}</td>
            <td class="py-2.5 px-2 text-right font-extrabold text-slate-900 text-2xs whitespace-nowrap">${(ord.amount_total || 0).toLocaleString("vi-VN")}đ</td>
            <td class="py-2.5 px-2 text-center whitespace-nowrap">
              <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-3xs font-bold border ${st.color}">
                ${escapeHtml(st.label)}
              </span>
            </td>
            <td class="py-2.5 px-2 text-center whitespace-nowrap">
              <button 
                data-id="${escapeHtml(ord.id)}" 
                class="btn-select-order px-2 py-1 rounded text-3xs font-bold border ${isSelected ? 'bg-[#083a3c] text-white border-[#083a3c]' : 'bg-white border-slate-200 text-slate-700 hover:bg-slate-50'} transition cursor-pointer"
              >
                ${isSelected ? 'Đang xem' : 'Chọn'}
              </button>
            </td>
          </tr>
        `;
      }).join("");
    }

    if (mobileCardsContainer) {
      mobileCardsContainer.innerHTML = pageOrders.map((ord) => {
        const st = STATUS_MAP[ord.state] || { label: ord.state, color: 'bg-slate-100 text-slate-700 border-slate-200' };
        const isSelected = String(ord.id) === String(activeOrderId);

        return `
          <div class="p-2.5 rounded-xl border transition ${isSelected ? 'bg-teal-50/70 border-teal-300 shadow-xs' : 'bg-white border-slate-200'}">
            <div class="flex justify-between items-start mb-1.5">
              <div>
                <span class="font-black text-xs text-[#083a3c] block font-mono">
                  #${escapeHtml(ord.id)}
                  ${isSelected ? '<span class="ml-1 text-3xs font-extrabold bg-[#083a3c] text-white px-1.5 py-0.5 rounded">Đang xem</span>' : ''}
                </span>
                <span class="text-3xs text-slate-400 block">${escapeHtml(ord.date) || '--'} • ${ord.items_count || 0} SP</span>
              </div>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-3xs font-bold border ${st.color}">
                ${escapeHtml(st.label)}
              </span>
            </div>

            <div class="flex justify-between items-center pt-1.5 border-t border-slate-100 mt-1.5">
              <div>
                <span class="text-3xs text-slate-400 block uppercase font-bold">Tổng thanh toán</span>
                <span class="font-black text-xs text-slate-900">${(ord.amount_total || 0).toLocaleString("vi-VN")}đ</span>
              </div>
              <button 
                data-id="${escapeHtml(ord.id)}" 
                class="btn-select-order px-2.5 py-1 rounded-lg text-2xs font-bold border ${isSelected ? 'bg-[#083a3c] text-white border-[#083a3c]' : 'bg-slate-50 border-slate-200 text-slate-700'} transition cursor-pointer"
              >
                ${isSelected ? 'Đang xem' : 'Xem đơn'}
              </button>
            </div>
          </div>
        `;
      }).join("");
    }

    document.querySelectorAll(".btn-select-order").forEach(btn => {
      btn.addEventListener("click", (e) => {
        const selectedId = e.currentTarget.getAttribute("data-id");
        if (selectedId) {
          history.pushState(null, "", `/hoan-tat?order_id=${selectedId}`);
          activeOrderId = selectedId;
          loadOrderDetails(activeOrderId);
          renderOrderTable();
          // Tự động đóng Drawer khi chọn đơn
          closeHistoryDrawer();
        }
      });
    });

    renderPaginationControls(totalItems);
  }

  function renderPaginationControls(totalItems) {
    const paginationContainer = document.getElementById("order-pagination-container");
    if (!paginationContainer) return;

    if (totalItems === 0) {
      paginationContainer.innerHTML = "";
      return;
    }

    const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE);
    const startIndex = (currentPage - 1) * ITEMS_PER_PAGE + 1;
    const endIndex = Math.min(currentPage * ITEMS_PER_PAGE, totalItems);

    let buttonsHtml = '';
    for (let i = 1; i <= totalPages; i++) {
      const isCurrent = i === currentPage;
      buttonsHtml += `
        <button 
          data-page="${i}"
          class="btn-page px-2 py-0.5 rounded text-2xs font-bold transition cursor-pointer ${isCurrent ? 'bg-[#083a3c] text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'}"
        >
          ${i}
        </button>
      `;
    }

    paginationContainer.innerHTML = `
      <div class="flex items-center justify-between gap-2 text-3xs text-slate-500">
        <div>
          <span>${startIndex}-${endIndex}</span>/<span>${totalItems}</span> đơn
        </div>
        <div class="flex items-center gap-1">
          <button 
            id="btn-prev-page" 
            ${currentPage === 1 ? 'disabled' : ''} 
            class="px-1.5 py-0.5 rounded border border-slate-200 text-slate-600 hover:bg-slate-100 disabled:opacity-30 disabled:cursor-not-allowed font-bold transition cursor-pointer"
          >
            ‹
          </button>
          ${buttonsHtml}
          <button 
            id="btn-next-page" 
            ${currentPage === totalPages ? 'disabled' : ''} 
            class="px-1.5 py-0.5 rounded border border-slate-200 text-slate-600 hover:bg-slate-100 disabled:opacity-30 disabled:cursor-not-allowed font-bold transition cursor-pointer"
          >
            ›
          </button>
        </div>
      </div>
    `;

    document.getElementById("btn-prev-page")?.addEventListener("click", () => {
      if (currentPage > 1) {
        currentPage--;
        renderOrderTable();
      }
    });

    document.getElementById("btn-next-page")?.addEventListener("click", () => {
      if (currentPage < totalPages) {
        currentPage++;
        renderOrderTable();
      }
    });

    document.querySelectorAll(".btn-page").forEach(btn => {
      btn.addEventListener("click", (e) => {
        const page = Number(e.currentTarget.getAttribute("data-page"));
        if (page) {
          currentPage = page;
          renderOrderTable();
        }
      });
    });
  }

  async function loadOrderHistoryAndInit(reloadDetails = true) {
    const desktopTbody = document.getElementById("order-history-tbody-desktop");
    try {
      const res = await fetch('/api/orders/history');
      if (!res.ok) throw new Error();
      allOrders = await res.json();

      if (allOrders.length > 0) {
        const isWebRef = activeOrderId && (activeOrderId.startsWith('WEB-') || activeOrderId.startsWith('ORD-'));
        if (!activeOrderId || isWebRef) {
          activeOrderId = allOrders[0].id;
        }

        renderOrderTable();
        await computeSalesFromOrders();
        if (reloadDetails && activeOrderId) {
          loadOrderDetails(activeOrderId);
        }

      } else {
        renderOrderTable();
        updateMilestoneUI();
        if (reloadDetails && activeOrderId) {
          loadOrderDetails(activeOrderId);
        }
      }
    } catch {
      if (desktopTbody) desktopTbody.innerHTML = `<tr><td colspan="5" class="py-6 text-center text-red-400 text-xs">Không thể tải danh sách đơn hàng.</td></tr>`;
      updateMilestoneUI();
      if (reloadDetails && activeOrderId) {
        loadOrderDetails(activeOrderId);
      }
    }
  }

  // ==========================================
  // XỬ LÝ METADATA GIAO HÀNG & PHƯƠNG THỨC TT
  // ==========================================
  function updateOrderMetadataUI(order, officialCode) {
    const nameEl = document.getElementById("current-recipient-name");
    const phoneEl = document.getElementById("current-recipient-phone");
    const addressEl = document.getElementById("current-shipping-address");
    const noteEl = document.getElementById("current-order-note");
    const badgeEl = document.getElementById("current-payment-badge");
    const descEl = document.getElementById("current-payment-desc");

    if (nameEl) nameEl.textContent = order.recipient_name || 'Đại lý La Pet';
    if (phoneEl) phoneEl.textContent = order.recipient_phone || 'Chưa cung cấp';
    if (addressEl) {
      addressEl.textContent = order.shipping_address || 'Địa chỉ kho đại lý mặc định';
      addressEl.title = order.shipping_address || '';
    }
    if (noteEl) noteEl.textContent = order.note || 'Không có';

    const isVnpay = order.payment_method === 'vnpay';
    const isOrderPaid = order.payment_status === 'paid' || order.state === 'completed' || order.state === 'done';
    const hintEl = document.getElementById("current-payment-status-hint");

    if (badgeEl) {
      if (isVnpay) {
        badgeEl.className = "inline-flex items-center gap-1 px-2 py-0.5 rounded text-3xs font-black bg-blue-50 text-blue-800 border border-blue-200";
        badgeEl.innerHTML = '<span>VNPAY</span>';
      } else {
        badgeEl.className = "inline-flex items-center gap-1 px-2 py-0.5 rounded text-3xs font-black bg-amber-50 text-amber-800 border border-amber-200";
        badgeEl.innerHTML = '<span>Tiền mặt (COD)</span>';
      }
    }

    if (hintEl) {
      if (isVnpay) {
        hintEl.innerHTML = isOrderPaid
          ? '<span class="px-2 py-0.5 rounded-full text-3xs font-extrabold bg-emerald-100 text-emerald-800">✓ Đã thanh toán</span>'
          : '<span class="px-2 py-0.5 rounded-full text-3xs font-extrabold bg-amber-100 text-amber-800">Chờ thanh toán</span>';
      } else {
        hintEl.innerHTML = '<span class="px-2 py-0.5 rounded-full text-3xs font-medium text-slate-500">Khi nhận hàng</span>';
      }
    }

    if (descEl) {
      descEl.textContent = isVnpay
        ? 'Cổng thanh toán điện tử VNPAY (Quét QR, thẻ, Mobile Banking).'
        : 'Thanh toán tiền mặt cho đối tác giao hàng.';
    }

    const actionsContainer = document.getElementById("quotation-actions-container");
    const isQuotation = order.can_edit_or_cancel || order.state === 'draft' || order.state === 'sent';

    if (actionsContainer) {
      if (isQuotation) {
        actionsContainer.classList.remove("hidden");

        const vnpayBox = document.getElementById("vnpay-action-box");
        const vnpayCodeDisplay = document.getElementById("vnpay-display-order-code");

        if (vnpayCodeDisplay) vnpayCodeDisplay.textContent = `#${officialCode}`;

        if (isVnpay) {
          vnpayBox?.classList.remove("hidden");
          fetchPaymentUrl(officialCode, order.amount_total);
        } else {
          vnpayBox?.classList.add("hidden");
        }
      } else {
        actionsContainer.classList.add("hidden");
      }
    }
  }

  async function fetchPaymentUrl(orderCode, amount) {
    const linkInput = document.getElementById("vnpay-link-input");
    if (!orderCode || !amount) return;
    try {
      if (linkInput) linkInput.placeholder = "Đang tạo link thanh toán...";
      const res = await fetch('/api/payment/vnpay-create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          order_code: orderCode,
          amount: amount,
          order_info: 'Thanh toan don hang ' + orderCode
        })
      });
      const data = await res.json();
      if (res.ok && data?.payment_url) {
        cachedPaymentUrl = data.payment_url;
        if (linkInput) linkInput.value = data.payment_url;
      }
    } catch (e) {
      console.warn("Không thể tạo trước link VNPAY:", e);
    }
  }

  // Nút bấm thanh toán ngay bằng VNPAY
  document.getElementById("btn-pay-vnpay")?.addEventListener("click", async () => {
    const btn = document.getElementById("btn-pay-vnpay");
    if (cachedPaymentUrl) {
      window.location.href = cachedPaymentUrl;
      return;
    }
    if (!currentLoadedOrder) return;
    try {
      if (btn) btn.innerHTML = '<span>Đang chuyển hướng...</span>';
      const orderCode = currentLoadedOrder.order_code || currentLoadedOrder.id || activeOrderId;
      const res = await fetch('/api/payment/vnpay-create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          order_code: orderCode,
          amount: currentLoadedOrder.amount_total,
          order_info: 'Thanh toan don hang ' + orderCode
        })
      });
      const data = await res.json();
      if (data?.payment_url) {
        window.location.href = data.payment_url;
      } else {
        alert(data?.error || 'Không thể tạo phiên thanh toán VNPAY');
        if (btn) btn.innerHTML = '<span>Thanh toán VNPAY</span><span>→</span>';
      }
    } catch (err) {
      alert('Lỗi kết nối cổng thanh toán VNPAY');
      if (btn) btn.innerHTML = '<span>Thanh toán VNPAY</span><span>→</span>';
    }
  });

  // Sao chép link thanh toán
  document.getElementById("btn-copy-payment-link")?.addEventListener("click", () => {
    const linkInput = document.getElementById("vnpay-link-input");
    if (linkInput && linkInput.value) {
      navigator.clipboard.writeText(linkInput.value);
      const copyBtn = document.getElementById("btn-copy-payment-link");
      if (copyBtn) {
        copyBtn.textContent = "Đã chép ✓";
        copyBtn.classList.add("bg-emerald-50", "text-emerald-700", "border-emerald-200");
        setTimeout(() => {
          copyBtn.textContent = "Sao chép";
          copyBtn.classList.remove("bg-emerald-50", "text-emerald-700", "border-emerald-200");
        }, 2000);
      }
    }
  });

  // ==========================================
  // XỬ LÝ MODAL THÊM SẢN PHẨM VÀO ĐƠN
  // ==========================================
  const modalAddProduct = document.getElementById("modal-add-product");
  const addProductListEl = document.getElementById("add-product-list");
  const searchAddProductInput = document.getElementById("search-add-product");
  let availableCatalogProducts = [];

  async function loadCatalogProducts() {
    if (availableCatalogProducts.length > 0) {
      renderCatalogProducts(searchAddProductInput?.value || "");
      return;
    }

    try {
      if (addProductListEl) {
        addProductListEl.innerHTML = `<div class="p-6 text-center text-xs text-slate-400">Đang tải danh mục sản phẩm...</div>`;
      }
      const res = await fetch('/api/products/list?limit=100');
      if (res.ok) {
        const data = await res.json();
        availableCatalogProducts = Array.isArray(data) ? data : (data.data || []);
        renderCatalogProducts(searchAddProductInput?.value || "");
      } else {
        addProductListEl.innerHTML = `<div class="p-6 text-center text-xs text-rose-500">Không thể tải danh mục sản phẩm.</div>`;
      }
    } catch (e) {
      if (addProductListEl) {
        addProductListEl.innerHTML = `<div class="p-6 text-center text-xs text-rose-500">Lỗi kết nối tải sản phẩm.</div>`;
      }
    }
  }

  function renderCatalogProducts(keyword = "") {
    if (!addProductListEl) return;
    const kw = keyword.toLowerCase().trim();
    const filtered = availableCatalogProducts.filter((p) => {
      if (!kw) return true;
      return (
        (p.name && p.name.toLowerCase().includes(kw)) ||
        (p.sku && p.sku.toLowerCase().includes(kw))
      );
    });

    if (filtered.length === 0) {
      addProductListEl.innerHTML = `
        <div class="p-6 text-center text-xs text-slate-400">
          Không tìm thấy sản phẩm phù hợp "${escapeHtml(keyword)}".
        </div>
      `;
      return;
    }

    addProductListEl.innerHTML = filtered.map((p) => {
      const priceVal = Number(p.wholesale_price || p.price || 0);
      const isAlreadyInOrder = editingItems.some(
        (it) => (it.product_id && String(it.product_id) === String(p.id)) || (it.sku && p.sku && it.sku.toLowerCase() === p.sku.toLowerCase())
      );
      const imgId = Array.isArray(p.images) && p.images.length > 0 ? (p.images[0].directus_files_id || p.images[0]) : null;
      const imgUrl = imgId ? `/api/directus/assets/${imgId}?width=80&height=80&fit=cover` : '/images/placeholder-product.svg';

      return `
        <div class="p-2.5 flex items-center justify-between gap-3 bg-white hover:bg-slate-50 transition">
          <div class="flex items-center gap-2.5 min-w-0 flex-1">
            <div class="w-10 h-10 rounded-lg bg-slate-100 border border-slate-200 overflow-hidden shrink-0 flex items-center justify-center">
              <img 
                src="${imgUrl}" 
                alt="${escapeHtml(p.name)}" 
                class="w-full h-full object-cover" 
                onerror="this.src='/images/placeholder-product.svg'"
              />
            </div>
            <div class="min-w-0 flex-1">
              <p class="font-bold text-slate-800 text-xs line-clamp-1">${escapeHtml(p.name)}</p>
              <div class="flex items-center gap-2 text-3xs text-slate-400 mt-0.5">
                <span>SKU: <strong class="font-mono text-slate-600">${escapeHtml(p.sku || '--')}</strong></span>
                <span>•</span>
                <span class="font-extrabold text-[#083a3c] text-2xs">${priceVal.toLocaleString('vi-VN')}đ</span>
              </div>
            </div>
          </div>

          <div class="shrink-0">
            ${
              isAlreadyInOrder
                ? `<span class="inline-flex items-center px-2 py-1 rounded text-3xs font-bold text-slate-400 bg-slate-100 border border-slate-200">Đã có trong đơn</span>`
                : `
                <button
                  type="button"
                  data-id="${p.id}"
                  data-sku="${escapeHtml(p.sku || '')}"
                  data-name="${escapeHtml(p.name)}"
                  data-price="${priceVal}"
                  class="btn-add-to-order-line px-2.5 py-1 rounded-lg bg-[#083a3c] hover:bg-[#062c2e] text-white text-2xs font-bold transition cursor-pointer shadow-2xs"
                >
                  + Thêm vào đơn
                </button>
              `
            }
          </div>
        </div>
      `;
    }).join("");

    addProductListEl.querySelectorAll(".btn-add-to-order-line").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const id = e.currentTarget.getAttribute("data-id");
        const sku = e.currentTarget.getAttribute("data-sku");
        const name = e.currentTarget.getAttribute("data-name");
        const price = Number(e.currentTarget.getAttribute("data-price")) || 0;

        editingItems.push({
          product_id: id ? Number(id) : null,
          sku: sku || '',
          name: name || 'Sản phẩm',
          price: price,
          qty: 1
        });

        renderEditingItems();
        renderCatalogProducts(searchAddProductInput?.value || "");
      });
    });
  }

  document.getElementById("btn-open-add-product")?.addEventListener("click", () => {
    modalAddProduct?.classList.remove("hidden");
    loadCatalogProducts();
    if (searchAddProductInput) {
      searchAddProductInput.value = "";
      searchAddProductInput.focus();
    }
  });

  function closeAddProductModal() {
    modalAddProduct?.classList.add("hidden");
  }

  document.getElementById("btn-close-add-product")?.addEventListener("click", closeAddProductModal);
  document.getElementById("btn-done-add-product")?.addEventListener("click", closeAddProductModal);

  searchAddProductInput?.addEventListener("input", (e) => {
    renderCatalogProducts(e.target.value);
  });

  // ==========================================
  // XỬ LÝ MODAL CHỈNH SỬA ĐƠN HÀNG
  // ==========================================
  const modalEdit = document.getElementById("modal-edit-order");
  const formEdit = document.getElementById("form-edit-order");
  const editErrorEl = document.getElementById("edit-order-error");
  let editingItems = [];

  function renderEditingItems() {
    const container = document.getElementById("edit-items-container");
    const previewTotalEl = document.getElementById("edit-total-preview");
    if (!container) return;

    if (editingItems.length === 0) {
      container.innerHTML = `
        <div class="py-6 px-4 text-center text-rose-500 font-semibold text-xs bg-rose-50/50">
          ⚠️ Đã xóa hết sản phẩm. Đơn hàng phải có ít nhất 1 sản phẩm.
        </div>
      `;
      if (previewTotalEl) previewTotalEl.textContent = '0đ';
      return;
    }

    container.innerHTML = editingItems.map((item, idx) => {
      const lineSubtotal = (Number(item.qty) || 0) * (Number(item.price) || 0);
      return `
        <div class="p-2.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 bg-white hover:bg-slate-50 transition">
          <div class="flex-1 min-w-0 pr-2">
            <p class="font-bold text-slate-800 line-clamp-1">${escapeHtml(item.name)}</p>
            <p class="text-slate-400 text-2xs">Đơn giá: ${(item.price || 0).toLocaleString('vi-VN')}đ</p>
          </div>

          <div class="flex items-center justify-between sm:justify-end gap-3 shrink-0">
            <div class="flex items-center gap-1">
              <button
                type="button"
                data-idx="${idx}"
                class="btn-edit-qty-minus w-6 h-6 rounded border border-slate-200 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold flex items-center justify-center cursor-pointer text-xs"
                title="Giảm 1"
              >-</button>
              <input
                type="number"
                min="1"
                data-idx="${idx}"
                value="${item.qty}"
                class="input-edit-qty w-12 h-6 text-center border border-slate-300 rounded font-bold text-slate-800 text-xs focus:outline-none"
              />
              <button
                type="button"
                data-idx="${idx}"
                class="btn-edit-qty-plus w-6 h-6 rounded border border-slate-200 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold flex items-center justify-center cursor-pointer text-xs"
                title="Tăng 1"
              >+</button>
            </div>

            <span class="font-black text-slate-900 text-xs shrink-0 min-w-16 text-right">
              ${lineSubtotal.toLocaleString('vi-VN')}đ
            </span>

            <button
              type="button"
              data-idx="${idx}"
              class="btn-edit-item-remove p-1 text-slate-400 hover:text-rose-600 transition cursor-pointer text-xs"
              title="Xóa mặt hàng này khỏi đơn"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2M10 11v6M14 11v6"/></svg>
            </button>
          </div>
        </div>
      `;
    }).join('');

    const totalPreview = editingItems.reduce((sum, it) => sum + ((Number(it.qty) || 0) * (Number(it.price) || 0)), 0);
    if (previewTotalEl) previewTotalEl.textContent = totalPreview.toLocaleString('vi-VN') + 'đ';

    container.querySelectorAll('.btn-edit-qty-minus').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = Number(e.currentTarget.getAttribute('data-idx'));
        if (editingItems[idx] && editingItems[idx].qty > 1) {
          editingItems[idx].qty--;
          renderEditingItems();
        }
      });
    });

    container.querySelectorAll('.btn-edit-qty-plus').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = Number(e.currentTarget.getAttribute('data-idx'));
        if (editingItems[idx]) {
          editingItems[idx].qty++;
          renderEditingItems();
        }
      });
    });

    container.querySelectorAll('.input-edit-qty').forEach(input => {
      input.addEventListener('change', (e) => {
        const idx = Number(e.currentTarget.getAttribute('data-idx'));
        const val = Math.max(1, parseInt(e.currentTarget.value) || 1);
        if (editingItems[idx]) {
          editingItems[idx].qty = val;
          renderEditingItems();
        }
      });
    });

    container.querySelectorAll('.btn-edit-item-remove').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = Number(e.currentTarget.getAttribute('data-idx'));
        if (confirm(`Bạn có chắc muốn xóa "${editingItems[idx]?.name}" khỏi đơn hàng?`)) {
          editingItems.splice(idx, 1);
          renderEditingItems();
        }
      });
    });
  }

  document.getElementById("btn-edit-order")?.addEventListener("click", () => {
    if (!currentLoadedOrder) return;
    const nameInput = document.getElementById("edit-recipient-name");
    const phoneInput = document.getElementById("edit-recipient-phone");
    const addressInput = document.getElementById("edit-shipping-address");
    const noteInput = document.getElementById("edit-order-note");

    if (nameInput) nameInput.value = currentLoadedOrder.recipient_name || '';
    if (phoneInput) phoneInput.value = currentLoadedOrder.recipient_phone || '';
    if (addressInput) addressInput.value = currentLoadedOrder.shipping_address || '';
    if (noteInput) noteInput.value = currentLoadedOrder.note || '';

    const pRadios = document.querySelectorAll('input[name="edit-payment-method"]');
    pRadios.forEach((r) => {
      r.checked = r.value === (currentLoadedOrder.payment_method || 'vnpay');
    });

    if (editErrorEl) {
      editErrorEl.textContent = '';
      editErrorEl.classList.add('hidden');
    }

    editingItems = (currentLoadedOrder.items || []).map(it => ({
      id: it.id,
      product_id: it.product_id,
      sku: it.sku,
      name: it.name,
      price: it.price,
      qty: it.qty,
    }));

    renderEditingItems();
    modalEdit?.classList.remove("hidden");
  });

  function closeEditModal() {
    modalEdit?.classList.add("hidden");
  }

  document.getElementById("btn-close-edit-modal")?.addEventListener("click", closeEditModal);
  document.getElementById("btn-cancel-edit-modal")?.addEventListener("click", closeEditModal);

  formEdit?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!currentLoadedOrder) return;

    const saveBtn = document.getElementById("btn-save-edit-order");
    const name = document.getElementById("edit-recipient-name")?.value?.trim();
    const phone = document.getElementById("edit-recipient-phone")?.value?.trim();
    const address = document.getElementById("edit-shipping-address")?.value?.trim();
    const note = document.getElementById("edit-order-note")?.value?.trim();
    const selectedMethod = document.querySelector('input[name="edit-payment-method"]:checked')?.value || 'vnpay';

    if (!name || !phone || !address) {
      if (editErrorEl) {
        editErrorEl.textContent = "Vui lòng nhập đầy đủ tên, số điện thoại và địa chỉ giao hàng.";
        editErrorEl.classList.remove('hidden');
      }
      return;
    }

    if (editingItems.length === 0) {
      if (editErrorEl) {
        editErrorEl.textContent = "Đơn hàng phải có ít nhất 1 sản phẩm. Vui lòng không xóa hết.";
        editErrorEl.classList.remove('hidden');
      }
      return;
    }

    try {
      if (saveBtn) saveBtn.innerHTML = '<span>Đang lưu...</span>';
      const orderCode = currentLoadedOrder.order_code || currentLoadedOrder.id || activeOrderId;

      const res = await fetch(`/api/orders/${encodeURIComponent(orderCode)}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          recipient_name: name,
          recipient_phone: phone,
          shipping_address: address,
          note: note,
          payment_method: selectedMethod,
          items: editingItems.map(it => ({
            id: it.id,
            product_id: it.product_id,
            sku: it.sku,
            name: it.name,
            price: Number(it.price) || 0,
            qty: Number(it.qty) || 1
          }))
        })
      });

      const data = await res.json();
      if (!res.ok || !data.success) {
        throw new Error(data?.error || 'Không thể cập nhật đơn hàng');
      }

      closeEditModal();
      await loadOrderDetails(orderCode);
      await loadOrderHistoryAndInit(false);
      if (saveBtn) saveBtn.innerHTML = '<span>Lưu thay đổi</span>';
    } catch (err) {
      if (editErrorEl) {
        editErrorEl.textContent = err.message || 'Lỗi khi cập nhật đơn hàng.';
        editErrorEl.classList.remove('hidden');
      }
      if (saveBtn) saveBtn.innerHTML = '<span>Lưu thay đổi</span>';
    }
  });

  // ==========================================
  // XỬ LÝ CHỐT ĐƠN & HỦY ĐƠN
  // ==========================================
  document.getElementById("btn-confirm-draft-order")?.addEventListener("click", async () => {
    if (!currentLoadedOrder) return;
    const orderCode = currentLoadedOrder.order_code || currentLoadedOrder.id || activeOrderId;
    if (!confirm(`Xác nhận chốt đơn hàng #${orderCode} thành Đơn bán hàng? Sau khi chốt, bạn sẽ không thể chỉnh sửa số lượng sản phẩm.`)) {
      return;
    }
    const btn = document.getElementById("btn-confirm-draft-order");
    try {
      if (btn) btn.innerHTML = '<span>Đang chốt...</span>';
      const res = await fetch(`/api/orders/${encodeURIComponent(orderCode)}/confirm`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      const data = await res.json();
      if (!res.ok || !data.success) {
        throw new Error(data?.error || 'Không thể chốt đơn hàng');
      }
      await loadOrderHistoryAndInit(true);
      if (btn) btn.innerHTML = '<span>✓</span><span>Chốt đơn bán hàng</span>';
    } catch (err) {
      alert(err.message || 'Lỗi khi chốt đơn hàng');
      if (btn) btn.innerHTML = '<span>✓</span><span>Chốt đơn bán hàng</span>';
    }
  });

  const modalCancel = document.getElementById("modal-cancel-order");
  const cancelErrorEl = document.getElementById("cancel-order-error");

  document.getElementById("btn-cancel-order")?.addEventListener("click", () => {
    if (cancelErrorEl) {
      cancelErrorEl.textContent = '';
      cancelErrorEl.classList.add('hidden');
    }
    modalCancel?.classList.remove("hidden");
  });

  function closeCancelModal() {
    modalCancel?.classList.add("hidden");
  }

  document.getElementById("btn-close-cancel-modal")?.addEventListener("click", closeCancelModal);

  document.getElementById("btn-confirm-cancel-order")?.addEventListener("click", async () => {
    if (!currentLoadedOrder) return;
    const confirmBtn = document.getElementById("btn-confirm-cancel-order");
    const orderCode = currentLoadedOrder.order_code || currentLoadedOrder.id || activeOrderId;

    try {
      if (confirmBtn) confirmBtn.innerHTML = '<span>Đang hủy...</span>';
      const res = await fetch(`/api/orders/${encodeURIComponent(orderCode)}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'cancel' })
      });

      const data = await res.json();
      if (!res.ok || !data.success) {
        throw new Error(data?.error || 'Không thể hủy đơn hàng');
      }

      closeCancelModal();
      await loadOrderHistoryAndInit(true);
      if (confirmBtn) confirmBtn.innerHTML = '<span>Xác nhận hủy</span>';
    } catch (err) {
      if (cancelErrorEl) {
        cancelErrorEl.textContent = err.message || 'Lỗi khi hủy đơn hàng.';
        cancelErrorEl.classList.remove('hidden');
      }
      if (confirmBtn) confirmBtn.innerHTML = '<span>Xác nhận hủy</span>';
    }
  });

  // Khởi động: Load lịch sử trước để lấy mã SO chính thức,
  // sau đó loadOrderDetails với mã đã được chuẩn hóa
  await loadOrderHistoryAndInit(true);
});
</script>

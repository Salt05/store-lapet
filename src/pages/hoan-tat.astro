---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { LONGTERM_POLICY } from '@/config/longterm-policy';

const auth = (Astro.locals as any)?.auth;
const currentPartnerId = auth?.partnerId || '';
---

<BaseLayout title="Trạng thái đơn hàng & Doanh số - LaPet">
  <input type="hidden" id="current-partner-id" value={currentPartnerId} />

  <!-- BẢO VỆ CHỐNG TRÀN VIỀN: max-w-full overflow-x-hidden -->
  <main class="bg-[#f7f8fa] min-h-screen py-4 sm:py-8 px-3 sm:px-4 font-sans max-w-full overflow-x-hidden">
    <div class="max-w-6xl mx-auto space-y-4 sm:space-y-8 w-full">
      
      <!-- KHỐI 1: DOANH SỐ TÍCH LŨY -->
      <section class="bg-white rounded-2xl sm:rounded-3xl border border-slate-200 p-3.5 sm:p-8 shadow-xs space-y-4 sm:space-y-6 w-full">
        
        <!-- HEADER TAB NAVIGATION -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-3 sm:pb-4">
          <div>
            <h2 class="text-base sm:text-xl font-black text-slate-800">Doanh Số Tích Lũy Đại Lý</h2>
            <p class="text-2xs sm:text-xs text-slate-500 mt-0.5">Theo dõi tiến độ đạt mốc thưởng chiết khấu ({LONGTERM_POLICY.year})</p>
          </div>

          <div class="inline-flex p-1 bg-slate-100 rounded-xl sm:rounded-2xl w-full sm:w-auto">
            <button 
              id="tab-btn-year" 
              class="tab-btn active flex-1 sm:flex-none text-center px-3 sm:px-4 py-2 rounded-lg sm:rounded-xl text-xs font-bold transition-all duration-200 bg-[#083a3c] text-white shadow-xs cursor-pointer"
            >
              Doanh số Năm
            </button>
            <button 
              id="tab-btn-quarter" 
              class="tab-btn flex-1 sm:flex-none text-center px-3 sm:px-4 py-2 rounded-lg sm:rounded-xl text-xs font-bold transition-all duration-200 text-slate-600 hover:text-slate-900 cursor-pointer"
            >
              Doanh số Quý
            </button>
          </div>
        </div>

        <!-- THÔNG BÁO TÍNH TOÁN TIẾN ĐỘ -->
        <div id="milestone-alert" class="p-3 sm:p-4 rounded-xl sm:rounded-2xl bg-gradient-to-r from-emerald-50 via-teal-50 to-sky-50 border border-emerald-200/80 flex items-start gap-2.5 sm:gap-3">
          <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-emerald-500 text-white flex items-center justify-center font-bold text-xs sm:text-sm shrink-0 mt-0.5">
            🎁
          </div>
          <div class="space-y-0.5 text-xs sm:text-sm">
            <p id="alert-main-text" class="font-bold text-emerald-950 leading-snug">
              Đang tính toán tiến độ doanh số...
            </p>
            <p id="alert-sub-text" class="text-emerald-700 text-2xs sm:text-xs">
              Vui lòng chờ trong giây lát.
            </p>
          </div>
        </div>

        <!-- TAB CONTENT 1: NĂM -->
        <div id="tab-content-year" class="space-y-4 sm:space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 sm:gap-4 bg-slate-50 p-3 sm:p-4 rounded-xl sm:rounded-2xl border border-slate-100">
            <div class="flex justify-between sm:block items-center">
              <span class="text-2xs sm:text-xs font-bold text-slate-400 block uppercase tracking-wider">Doanh Số Năm {LONGTERM_POLICY.year}</span>
              <span id="year-current-sales" class="text-sm sm:text-2xl font-black text-[#083a3c]">0đ</span>
            </div>
            <div class="flex justify-between sm:block items-center border-t sm:border-t-0 pt-2 sm:pt-0 border-slate-200/60">
              <span class="text-2xs sm:text-xs font-bold text-slate-400 block uppercase tracking-wider">Mức thưởng hiện tại</span>
              <span id="year-current-tier" class="text-sm sm:text-2xl font-black text-emerald-600">0.0%</span>
            </div>
            <div class="flex justify-between sm:block items-center border-t sm:border-t-0 pt-2 sm:pt-0 border-slate-200/60">
              <span class="text-2xs sm:text-xs font-bold text-slate-400 block uppercase tracking-wider">Thưởng doanh số (Dự kiến)</span>
              <span id="year-current-bonus" class="text-sm sm:text-2xl font-black text-[#d82a72]">0đ</span>
            </div>
          </div>

          <!-- MILESTONE DISPLAY -->
          <div class="pt-2">
            <!-- 1. GIAO DIỆN DESKTOP (Thanh Ngang) -->
            <div class="hidden sm:block relative py-6 px-1">
              <div class="absolute top-8 left-0 right-0 h-2.5 bg-slate-100 -translate-y-1/2 rounded-full z-0"></div>
              <div id="year-progress-fill" class="absolute top-8 left-0 h-2.5 bg-gradient-to-r from-emerald-500 to-[#083a3c] -translate-y-1/2 rounded-full z-0 transition-all duration-700" style="width: 0%;"></div>
              <div id="year-milestones-container" class="relative z-10 flex justify-between items-center"></div>
            </div>

            <!-- 2. GIAO DIỆN MOBILE (Dạng Danh Sách Tiến Độ Gọn Gàng) -->
            <div class="sm:hidden space-y-2">
              <span class="text-2xs font-extrabold text-slate-400 uppercase tracking-wider block mb-2">Lộ trình mốc thưởng</span>
              <div id="year-milestones-container-mobile" class="grid grid-cols-1 gap-2"></div>
            </div>
          </div>
        </div>

        <!-- TAB CONTENT 2: QUÝ -->
        <div id="tab-content-quarter" class="space-y-4 sm:space-y-6 hidden">
          <div class="bg-slate-50 p-3 sm:p-4 rounded-xl sm:rounded-2xl border border-slate-100 space-y-3">
            <div class="flex items-center justify-between sm:justify-start gap-2">
              <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Chọn Quý xem xét:</span>
              <select id="quarter-select" class="text-xs font-bold bg-white border border-slate-200 rounded-lg px-2 py-1 text-slate-700 focus:outline-none focus:border-[#083a3c] cursor-pointer">
                <option value="q1">Quý 1</option>
                <option value="q2">Quý 2</option>
                <option value="q3">Quý 3</option>
                <option value="q4">Quý 4</option>
              </select>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 sm:gap-4 pt-1 border-t border-slate-200/60">
              <div class="flex justify-between sm:block items-center">
                <span class="text-2xs sm:text-xs font-bold text-slate-400 block uppercase tracking-wider">Doanh số Quý Tích Lũy</span>
                <span id="quarter-current-sales" class="text-sm sm:text-2xl font-black text-[#083a3c]">0đ</span>
              </div>
              <div class="flex justify-between sm:block items-center border-t sm:border-t-0 pt-2 sm:pt-0 border-slate-200/60">
                <span class="text-2xs sm:text-xs font-bold text-slate-400 block uppercase tracking-wider">Mức thưởng Quý hiện tại</span>
                <span id="quarter-current-tier" class="text-sm sm:text-2xl font-black text-emerald-600">0.0%</span>
              </div>
              <div class="flex justify-between sm:block items-center border-t sm:border-t-0 pt-2 sm:pt-0 border-slate-200/60">
                <span class="text-2xs sm:text-xs font-bold text-slate-400 block uppercase tracking-wider">Thưởng doanh số Quý</span>
                <span id="quarter-current-bonus" class="text-sm sm:text-2xl font-black text-[#d82a72]">0đ</span>
              </div>
            </div>
          </div>

          <!-- MILESTONE DISPLAY -->
          <div class="pt-2">
            <!-- DESKTOP -->
            <div class="hidden sm:block relative py-6 px-1">
              <div class="absolute top-8 left-0 right-0 h-2.5 bg-slate-100 -translate-y-1/2 rounded-full z-0"></div>
              <div id="quarter-progress-fill" class="absolute top-8 left-0 h-2.5 bg-gradient-to-r from-teal-500 to-[#083a3c] -translate-y-1/2 rounded-full z-0 transition-all duration-700" style="width: 0%;"></div>
              <div id="quarter-milestones-container" class="relative z-10 flex justify-between items-center"></div>
            </div>

            <!-- MOBILE -->
            <div class="sm:hidden space-y-2">
              <span class="text-2xs font-extrabold text-slate-400 uppercase tracking-wider block mb-2">Lộ trình mốc thưởng</span>
              <div id="quarter-milestones-container-mobile" class="grid grid-cols-1 gap-2"></div>
            </div>
          </div>
        </div>

      </section>

      <!-- KHỐI 2: CHI TIẾT ĐƠN HÀNG ĐANG CHỌN -->
      <section id="current-order-section" class="bg-white rounded-2xl sm:rounded-3xl border border-slate-200 p-4 sm:p-8 shadow-xs space-y-4 sm:space-y-6 w-full">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-4">
          <div>
            <div class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-700 px-2.5 py-0.5 rounded-full text-2xs sm:text-xs font-bold mb-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> Chi tiết đơn hàng
            </div>
            
            <div class="flex flex-wrap items-center gap-2">
              <h1 class="text-lg sm:text-2xl font-black text-slate-800">
                Mã đơn: <span id="current-order-id" class="text-[#083a3c]">--</span>
              </h1>
              <span id="current-order-status-tag" class="px-2.5 py-0.5 rounded-full text-2xs sm:text-xs font-bold border bg-slate-100 text-slate-600 border-slate-200">
                Đang tải...
              </span>
            </div>
          </div>

          <div class="flex justify-between sm:block items-center bg-slate-50 sm:bg-transparent p-2.5 sm:p-0 rounded-xl">
            <span class="text-2xs sm:text-xs text-slate-400 block">Tổng thanh toán</span>
            <span id="current-order-total" class="text-base sm:text-2xl font-black text-[#d82a72]">0đ</span>
          </div>
        </div>

        <div class="bg-slate-50 rounded-xl sm:rounded-2xl p-3 sm:p-5 border border-slate-200/80 space-y-3">
          <div class="flex justify-between items-center text-xs sm:text-sm font-bold text-slate-700">
            <span>Danh sách sản phẩm</span>
            <span id="current-order-qty" class="text-slate-500 font-normal text-2xs sm:text-xs">0 sản phẩm</span>
          </div>
          
          <div id="current-order-items" class="divide-y divide-slate-200/60 max-h-64 overflow-y-auto pr-1">
            <div class="text-xs text-slate-400 py-2">Đang tải chi tiết đơn hàng...</div>
          </div>
        </div>
      </section>

      <!-- KHỐI 3: DANH SÁCH ĐƠN HÀNG -->
      <section class="bg-white rounded-2xl sm:rounded-3xl border border-slate-200 p-4 sm:p-6 shadow-xs space-y-4 w-full">
        <div class="flex justify-between items-center gap-2 border-b border-slate-100 pb-3">
          <h2 class="text-base sm:text-lg font-bold text-slate-800">
            Danh sách đơn hàng
          </h2>
          <a href="/dat-hang-nhanh" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg sm:rounded-xl bg-[#083a3c] text-white text-xs font-bold hover:bg-[#062c2e] transition shadow-xs">
            + Đặt mới
          </a>
        </div>

        <!-- 1. VIEW DESKTOP -->
        <div class="hidden sm:block overflow-x-auto rounded-xl border border-slate-100">
          <table class="w-full text-left text-sm border-collapse">
            <thead>
              <tr class="bg-slate-50 border-b border-slate-200 text-slate-500 text-xs font-bold uppercase tracking-wider">
                <th class="py-3 px-4">Số đơn</th>
                <th class="py-3 px-4">Ngày tạo</th>
                <th class="py-3 px-4">Số lượng</th>
                <th class="py-3 px-4 text-right">Tổng tiền</th>
                <th class="py-3 px-4 text-center">Trạng thái</th>
                <th class="py-3 px-4 text-center">Thao tác</th>
              </tr>
            </thead>
            <tbody id="order-history-tbody-desktop" class="divide-y divide-slate-100 text-slate-700">
              <tr>
                <td colspan="6" class="py-8 text-center text-slate-400 text-xs">
                  Đang tải danh sách đơn hàng...
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- 2. VIEW MOBILE -->
        <div id="order-history-cards-mobile" class="sm:hidden space-y-3">
          <div class="py-6 text-center text-slate-400 text-xs">
            Đang tải danh sách đơn hàng...
          </div>
        </div>

        <!-- PHÂN TRANG -->
        <div id="order-pagination-container" class="pt-2 border-t border-slate-100"></div>

      </section>

    </div>
  </main>
</BaseLayout>

<script define:vars={{ LONGTERM_POLICY }}>
document.addEventListener("DOMContentLoaded", async () => {
  const YEAR_MILESTONES = LONGTERM_POLICY?.yearMilestones || [];
  const QUARTER_MILESTONES = LONGTERM_POLICY?.quarterMilestones || [];
  const POLICY_YEAR = LONGTERM_POLICY?.year || new Date().getFullYear();

  const urlParams = new URLSearchParams(window.location.search);
  let activeOrderId = urlParams.get("order_id");

  const partnerInput = document.getElementById("current-partner-id");
  const partnerId = partnerInput?.value || "";

  let allOrders = [];
  let currentPage = 1;
  const ITEMS_PER_PAGE = 8;
  let activeTab = 'year';

  let calculatedSales = {
    yearTotal: 0,
    quarters: { q1: 0, q2: 0, q3: 0, q4: 0 }
  };

  const STATUS_MAP = {
    'draft': { label: 'Báo giá', color: 'bg-sky-100 text-sky-800 border-sky-200' },
    'sent': { label: 'Đã gửi báo giá', color: 'bg-sky-100 text-sky-800 border-sky-200' },
    'sale': { label: 'Đã chốt đơn', color: 'bg-emerald-100 text-emerald-800 border-emerald-200' },
    'shipping': { label: 'Đang giao', color: 'bg-purple-100 text-purple-800 border-purple-200' },
    'done': { label: 'Hoàn tất', color: 'bg-slate-100 text-slate-800 border-slate-300' },
    'cancel': { label: 'Đã hủy', color: 'bg-rose-50 text-rose-600 border-rose-200' }
  };

  // Helper Escape HTML chống XSS
  function escapeHtml(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  // Helper Safe Date Parser hỗ trợ cross-browser (Safari/iOS)
  function parseOrderMonth(dateStr) {
    if (!dateStr) return new Date().getMonth() + 1;
    // Chuyển 'YYYY-MM-DD HH:mm:ss' thành 'YYYY-MM-DDTHH:mm:ss'
    const formatted = String(dateStr).replace(" ", "T");
    const d = new Date(formatted);
    return isNaN(d.getTime()) ? (new Date().getMonth() + 1) : (d.getMonth() + 1);
  }

  const btnYear = document.getElementById("tab-btn-year");
  const btnQuarter = document.getElementById("tab-btn-quarter");
  const contentYear = document.getElementById("tab-content-year");
  const contentQuarter = document.getElementById("tab-content-quarter");

  btnYear?.addEventListener("click", () => {
    activeTab = 'year';
    btnYear.className = "tab-btn active flex-1 sm:flex-none text-center px-3 sm:px-4 py-2 rounded-lg sm:rounded-xl text-xs font-bold transition-all duration-200 bg-[#083a3c] text-white shadow-xs cursor-pointer";
    btnQuarter.className = "tab-btn flex-1 sm:flex-none text-center px-3 sm:px-4 py-2 rounded-lg sm:rounded-xl text-xs font-bold transition-all duration-200 text-slate-600 hover:text-slate-900 cursor-pointer";
    contentYear?.classList.remove("hidden");
    contentQuarter?.classList.add("hidden");
    updateMilestoneUI();
  });

  btnQuarter?.addEventListener("click", () => {
    activeTab = 'quarter';
    btnQuarter.className = "tab-btn active flex-1 sm:flex-none text-center px-3 sm:px-4 py-2 rounded-lg sm:rounded-xl text-xs font-bold transition-all duration-200 bg-[#083a3c] text-white shadow-xs cursor-pointer";
    btnYear.className = "tab-btn flex-1 sm:flex-none text-center px-3 sm:px-4 py-2 rounded-lg sm:rounded-xl text-xs font-bold transition-all duration-200 text-slate-600 hover:text-slate-900 cursor-pointer";
    contentQuarter?.classList.remove("hidden");
    contentYear?.classList.add("hidden");
    updateMilestoneUI();
  });

  document.getElementById("quarter-select")?.addEventListener("change", () => {
    if (activeTab === 'quarter') updateMilestoneUI();
  });

  function computeSalesFromOrders() {
    let yearSum = 0;
    const qSums = { q1: 0, q2: 0, q3: 0, q4: 0 };

    allOrders.forEach(ord => {
      // Tính tất cả đơn hàng hợp lệ đã đặt (draft, sent, sale, done), chỉ loại trừ đơn đã hủy
      if (ord.state !== 'cancel') {
        const amount = Number(ord.amount_total) || 0;
        const month = parseOrderMonth(ord.date);

        yearSum += amount;

        if (month >= 1 && month <= 3) qSums.q1 += amount;
        else if (month >= 4 && month <= 6) qSums.q2 += amount;
        else if (month >= 7 && month <= 9) qSums.q3 += amount;
        else if (month >= 10 && month <= 12) qSums.q4 += amount;
      }
    });

    calculatedSales.yearTotal = yearSum;
    calculatedSales.quarters = qSums;

    const currentMonth = new Date().getMonth() + 1;
    const currentQ = currentMonth <= 3 ? 'q1' : currentMonth <= 6 ? 'q2' : currentMonth <= 9 ? 'q3' : 'q4';
    const selectEl = document.getElementById("quarter-select");
    if (selectEl) selectEl.value = currentQ;

    updateMilestoneUI();
  }

  function updateMilestoneUI() {
    if (activeTab === 'year') {
      renderSingleMilestone(
        calculatedSales.yearTotal, 
        YEAR_MILESTONES, 
        'year-current-sales', 
        'year-current-tier', 
        'year-current-bonus',
        'year-progress-fill', 
        'year-milestones-container',
        'year-milestones-container-mobile',
        `Năm ${POLICY_YEAR}`
      );
    } else {
      const selectedQ = document.getElementById("quarter-select")?.value || 'q1';
      const currentSales = calculatedSales.quarters[selectedQ] || 0;
      const qText = selectedQ.toUpperCase();

      renderSingleMilestone(
        currentSales, 
        QUARTER_MILESTONES, 
        'quarter-current-sales', 
        'quarter-current-tier', 
        'quarter-current-bonus',
        'quarter-progress-fill', 
        'quarter-milestones-container',
        'quarter-milestones-container-mobile',
        qText
      );
    }
  }

  function renderSingleMilestone(
    currentSales, 
    milestones,
    salesElId, 
    tierElId, 
    bonusElId,
    fillElId, 
    containerElId,
    containerMobileElId,
    periodName
  ) {
    const salesEl = document.getElementById(salesElId);
    const tierEl = document.getElementById(tierElId);
    const bonusEl = document.getElementById(bonusElId);
    const fillEl = document.getElementById(fillElId);
    const container = document.getElementById(containerElId);
    const containerMobile = document.getElementById(containerMobileElId);

    if (salesEl) salesEl.textContent = currentSales.toLocaleString("vi-VN") + "đ";

    let currentRate = 0;
    let nextMilestone = null;

    for (let i = 0; i < milestones.length; i++) {
      if (currentSales >= milestones[i].target) {
        currentRate = milestones[i].rate;
      } else {
        nextMilestone = milestones[i];
        break;
      }
    }

    if (tierEl) tierEl.textContent = `${currentRate.toFixed(1)}%`;

    const bonusAmount = Math.round(currentSales * (currentRate / 100));
    if (bonusEl) bonusEl.textContent = bonusAmount.toLocaleString("vi-VN") + "đ";

    const mainAlert = document.getElementById("alert-main-text");
    const subAlert = document.getElementById("alert-sub-text");

    if (nextMilestone) {
      const remaining = nextMilestone.target - currentSales;
      if (mainAlert) {
        mainAlert.innerHTML = `Quý đại lý cần đạt thêm <span class="text-[#d82a72] font-black">${remaining.toLocaleString("vi-VN")} đ</span> nữa trong ${escapeHtml(periodName)} để nâng mức chiết khấu lên <span class="text-[#d82a72] font-black">${nextMilestone.rate.toFixed(1)}%</span>!`;
      }
      if (subAlert) {
        subAlert.textContent = `Mốc kế tiếp: ${nextMilestone.target.toLocaleString("vi-VN")}đ`;
      }
    } else {
      if (mainAlert) {
        mainAlert.innerHTML = `🎉 Bạn đã đạt mốc thưởng Doanh số ${escapeHtml(periodName)} cao nhất: <span class="text-emerald-700 font-black">${currentRate.toFixed(1)}%</span>!`;
      }
      if (subAlert) {
        subAlert.textContent = `Cảm ơn sự hợp tác kinh doanh tuyệt vời cùng LaPet.`;
      }
    }

    let progressPercent = 0;
    const stepRatio = milestones.length > 1 ? 100 / (milestones.length - 1) : 100;
    let activeIndex = -1;

    for (let i = 0; i < milestones.length; i++) {
      if (currentSales >= milestones[i].target) {
        activeIndex = i;
      }
    }

    if (activeIndex === -1) {
      progressPercent = milestones.length > 0 ? (currentSales / milestones[0].target) * (stepRatio / 2) : 0;
    } else if (activeIndex === milestones.length - 1) {
      progressPercent = 100;
    } else {
      const baseProgress = activeIndex * stepRatio;
      const currentChunk = currentSales - milestones[activeIndex].target;
      const chunkTarget = milestones[activeIndex + 1].target - milestones[activeIndex].target;
      progressPercent = baseProgress + (currentChunk / chunkTarget) * stepRatio;
    }

    if (fillEl) fillEl.style.width = `${Math.min(Math.max(progressPercent, 0), 100)}%`;

    if (container) {
      container.innerHTML = milestones.map((m) => {
        const isReached = currentSales >= m.target;
        const isCurrentTarget = nextMilestone && nextMilestone.target === m.target;

        return `
          <div class="flex flex-col items-center group cursor-pointer relative">
            <div class="w-10 h-10 rounded-full flex items-center justify-center font-extrabold text-xs transition-all duration-300 z-10 ${
              isReached 
                ? 'bg-[#083a3c] text-white shadow-md ring-4 ring-emerald-100 scale-105' 
                : isCurrentTarget 
                  ? 'bg-white text-[#d82a72] border-2 border-[#d82a72] ring-4 ring-pink-100 animate-bounce' 
                  : 'bg-white text-slate-400 border border-slate-200'
            }">
              ${isReached ? '✓' : `${m.rate}%`}
            </div>

            <div class="text-center mt-2">
              <span class="text-xs font-extrabold block tracking-tight ${isReached ? 'text-[#083a3c]' : 'text-slate-400'}">
                ${escapeHtml(m.label)}
              </span>
            </div>
          </div>
        `;
      }).join("");
    }

    if (containerMobile) {
      containerMobile.innerHTML = milestones.map((m, idx) => {
        const isReached = currentSales >= m.target;
        const isCurrentTarget = nextMilestone && nextMilestone.target === m.target;

        return `
          <div class="p-2.5 rounded-xl border flex items-center justify-between transition ${
            isReached 
              ? 'bg-emerald-50/50 border-emerald-200 text-emerald-950' 
              : isCurrentTarget 
                ? 'bg-rose-50/40 border-rose-300 ring-1 ring-rose-200' 
                : 'bg-slate-50/50 border-slate-100 text-slate-400'
          }">
            <div class="flex items-center gap-3">
              <div class="w-6 h-6 rounded-full flex items-center justify-center font-extrabold text-2xs shrink-0 transition-all ${
                isReached 
                  ? 'bg-[#083a3c] text-white shadow-xs' 
                  : isCurrentTarget 
                    ? 'bg-[#d82a72] text-white animate-pulse' 
                    : 'bg-slate-200 text-slate-400'
              }">
                ${isReached ? '✓' : (idx + 1)}
              </div>

              <div>
                <span class="text-xs font-black block ${isReached ? 'text-[#083a3c]' : isCurrentTarget ? 'text-[#d82a72]' : 'text-slate-600'}">
                  Thưởng ${m.rate}%
                </span>
                <span class="text-2xs text-slate-400 block font-medium">
                  Mốc ${m.target.toLocaleString('vi-VN')}đ
                </span>
              </div>
            </div>

            <div>
              ${isReached 
                ? '<span class="text-2xs font-extrabold text-emerald-600 bg-emerald-100/80 px-2.5 py-0.5 rounded-full">Đã đạt</span>' 
                : isCurrentTarget 
                  ? '<span class="text-2xs font-extrabold text-[#d82a72] bg-rose-100 px-2.5 py-0.5 rounded-full">Mốc tiếp</span>' 
                  : '<span class="text-2xs font-medium text-slate-400">Chưa đạt</span>'
              }
            </div>
          </div>
        `;
      }).join("");
    }
  }

  async function loadOrderDetails(targetId) {
    if (!targetId) return;

    const currentOrderEl = document.getElementById("current-order-id");
    // Hiển thị mã ngắn gọn khi đang tải (không hiện chuỗi WEB-B2B- dài)
    const displayId = (targetId.startsWith('WEB-') || targetId.startsWith('ORD-'))
      ? 'Đang tải...'
      : `#${escapeHtml(targetId)}`;
    if (currentOrderEl) currentOrderEl.textContent = displayId;
    
    const itemsEl = document.getElementById("current-order-items");
    const statusTag = document.getElementById("current-order-status-tag");
    const totalEl = document.getElementById("current-order-total");
    const qtyEl = document.getElementById("current-order-qty");

    if (itemsEl) {
      itemsEl.innerHTML = `
        <div class="text-xs text-slate-500 py-3 flex items-center gap-2">
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></span>
          <span>Đang đồng bộ thông tin đơn hàng với hệ thống...</span>
        </div>
      `;
    }

    let order = null;
    let attempts = 0;
    const isWebRef = targetId.startsWith("WEB-") || targetId.startsWith("ORD-");
    // Mã WEB tạm: thử nhiều lần hơn, với khoảng nghỉ dài hơn (worker cần thời gian xử lý)
    const maxAttempts = isWebRef ? 8 : 2;
    const retryDelay = isWebRef ? 2000 : 1000;

    while (attempts < maxAttempts) {
      try {
        const res = await fetch(`/api/orders/${encodeURIComponent(targetId)}`);
        if (res.ok) {
          const data = await res.json();
          if (data && (data.id || data.order_code)) {
            order = data;
            break;
          }
        }
      } catch (e) {
        console.warn("Lần thử tải chi tiết đơn hàng:", e);
      }

      attempts++;
      if (attempts < maxAttempts) {
        if (itemsEl) {
          const secLeft = Math.ceil(((maxAttempts - attempts) * retryDelay) / 1000);
          itemsEl.innerHTML = `
            <div class="text-xs text-slate-500 py-3 flex items-center gap-2">
              <span class="inline-block w-2.5 h-2.5 rounded-full bg-amber-400 animate-ping"></span>
              <span>Đang đợi hệ thống ERP xác nhận đơn hàng (lần ${attempts}/${maxAttempts})...</span>
            </div>
          `;
        }
        await new Promise(r => setTimeout(r, retryDelay));
      }
    }

    if (!order) {
      // Nếu vẫn không lấy được, thử tìm trong danh sách lịch sử đã load
      if (allOrders.length > 0 && isWebRef) {
        // Chọn đơn mới nhất trong danh sách làm fallback
        order = allOrders[0];
        if (order) {
          console.info('[hoan-tat] Dùng đơn mới nhất từ lịch sử làm fallback cho mã WEB tạm');
        }
      }

      if (!order) {
        if (itemsEl) {
          itemsEl.innerHTML = `<div class="text-xs text-amber-600 py-2">Đơn hàng đang được xử lý. Vui lòng tải lại trang sau vài phút.</div>`;
        }
        if (statusTag) {
          statusTag.className = "px-2.5 py-0.5 rounded-full text-2xs sm:text-xs font-bold border bg-amber-50 text-amber-700 border-amber-200";
          statusTag.textContent = "Đang xử lý";
        }
        if (currentOrderEl) currentOrderEl.textContent = '--';
        return;
      }
    }

    const officialCode = order.order_code || order.id || targetId;
    if (currentOrderEl) currentOrderEl.textContent = `#${escapeHtml(officialCode)}`;

    if (totalEl) totalEl.textContent = (order.amount_total || 0).toLocaleString("vi-VN") + "đ";
    if (qtyEl) qtyEl.textContent = `${order.items?.length || 0} sản phẩm`;

    if (statusTag) {
      const st = STATUS_MAP[order.state] || {
        label: order.state === 'draft' ? 'Báo giá' : (order.state || 'Đang xử lý'),
        color: 'bg-sky-100 text-sky-800 border-sky-200'
      };
      statusTag.className = `px-2.5 py-0.5 rounded-full text-2xs sm:text-xs font-bold border ${st.color}`;
      statusTag.textContent = st.label;
    }

    if (itemsEl && order.items && order.items.length > 0) {
      itemsEl.innerHTML = order.items.map((item) => `
        <div class="py-2 flex justify-between items-center text-xs hover:bg-slate-100/50 px-1 rounded transition">
          <div class="pr-2">
            <p class="font-bold text-slate-800 line-clamp-1">${escapeHtml(item.name)}</p>
            <p class="text-slate-400 text-2xs">SL: ${item.qty} x ${(item.price || 0).toLocaleString('vi-VN')}đ</p>
          </div>
          <span class="font-bold text-slate-900 shrink-0">${((item.qty || 0) * (item.price || 0)).toLocaleString('vi-VN')}đ</span>
        </div>
      `).join("");
    } else if (itemsEl) {
      itemsEl.innerHTML = `<div class="text-xs text-slate-400 py-2">Không có danh sách sản phẩm.</div>`;
    }

    // Nếu mã trên URL là mã Web tạm thời và đã lấy được mã SO Odoo chính thức:
    // Cập nhật URL và reload history để hiển thị mã SO đúng (vd S02400)
    if (officialCode && !officialCode.startsWith('WEB-') && !officialCode.startsWith('ORD-') && targetId !== officialCode) {
      history.replaceState(null, "", `/hoan-tat?order_id=${encodeURIComponent(officialCode)}`);
      activeOrderId = officialCode;
      // Reload lịch sử để cập nhật bảng với mã SO mới
      setTimeout(() => loadOrderHistoryAndInit(false), 500);
    }
  }

  function renderOrderTable() {
    const desktopTbody = document.getElementById("order-history-tbody-desktop");
    const mobileCardsContainer = document.getElementById("order-history-cards-mobile");

    if (allOrders.length === 0) {
      if (desktopTbody) desktopTbody.innerHTML = `<tr><td colspan="6" class="py-8 text-center text-slate-400 text-xs">Chưa có lịch sử đơn hàng nào.</td></tr>`;
      if (mobileCardsContainer) mobileCardsContainer.innerHTML = `<div class="py-8 text-center text-slate-400 text-xs">Chưa có lịch sử đơn hàng nào.</div>`;
      renderPaginationControls(0);
      return;
    }

    const totalItems = allOrders.length;
    const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE);

    if (currentPage > totalPages) currentPage = totalPages;
    if (currentPage < 1) currentPage = 1;

    const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
    const endIndex = Math.min(startIndex + ITEMS_PER_PAGE, totalItems);
    const pageOrders = allOrders.slice(startIndex, endIndex);

    if (desktopTbody) {
      desktopTbody.innerHTML = pageOrders.map((ord) => {
        const st = STATUS_MAP[ord.state] || { label: ord.state, color: 'bg-slate-100 text-slate-700 border-slate-200' };
        const isSelected = String(ord.id) === String(activeOrderId);

        return `
          <tr class="transition border-b border-slate-100 last:border-b-0 ${isSelected ? 'bg-emerald-50/60 font-semibold' : 'hover:bg-slate-50'}">
            <td class="py-3.5 px-4 font-bold text-[#083a3c]">#${escapeHtml(ord.id)}</td>
            <td class="py-3.5 px-4 text-xs text-slate-500">${escapeHtml(ord.date) || '--'}</td>
            <td class="py-3.5 px-4 text-xs">${ord.items_count || 0} sản phẩm</td>
            <td class="py-3.5 px-4 text-right font-bold text-slate-900">${(ord.amount_total || 0).toLocaleString("vi-VN")}đ</td>
            <td class="py-3.5 px-4 text-center">
              <span class="inline-block px-3 py-1 rounded-full text-xs font-bold border ${st.color}">
                ${escapeHtml(st.label)}
              </span>
            </td>
            <td class="py-3.5 px-4 text-center">
              <button 
                data-id="${escapeHtml(ord.id)}" 
                class="btn-select-order px-3 py-1 rounded-lg text-xs font-bold border ${isSelected ? 'bg-[#083a3c] text-white border-[#083a3c]' : 'bg-white border-slate-300 text-slate-700 hover:bg-slate-100'} transition cursor-pointer"
              >
                ${isSelected ? 'Đang xem' : 'Xem chi tiết'}
              </button>
            </td>
          </tr>
        `;
      }).join("");
    }

    if (mobileCardsContainer) {
      mobileCardsContainer.innerHTML = pageOrders.map((ord) => {
        const st = STATUS_MAP[ord.state] || { label: ord.state, color: 'bg-slate-100 text-slate-700 border-slate-200' };
        const isSelected = String(ord.id) === String(activeOrderId);

        return `
          <div class="p-3.5 rounded-xl border transition ${isSelected ? 'bg-emerald-50/60 border-emerald-300 shadow-xs' : 'bg-white border-slate-200'}">
            <div class="flex justify-between items-start mb-2">
              <div>
                <span class="font-black text-sm text-[#083a3c] block">#${escapeHtml(ord.id)}</span>
                <span class="text-2xs text-slate-400 block">${escapeHtml(ord.date) || '--'} • ${ord.items_count || 0} SP</span>
              </div>
              <span class="inline-block px-2.5 py-0.5 rounded-full text-2xs font-bold border ${st.color}">
                ${escapeHtml(st.label)}
              </span>
            </div>

            <div class="flex justify-between items-center pt-2 border-t border-slate-100 mt-2">
              <div>
                <span class="text-3xs text-slate-400 block uppercase font-bold">Tổng tiền</span>
                <span class="font-black text-sm text-slate-900">${(ord.amount_total || 0).toLocaleString("vi-VN")}đ</span>
              </div>
              <button 
                data-id="${escapeHtml(ord.id)}" 
                class="btn-select-order px-3 py-1 rounded-lg text-xs font-bold border ${isSelected ? 'bg-[#083a3c] text-white border-[#083a3c]' : 'bg-slate-50 border-slate-200 text-slate-700'} transition cursor-pointer"
              >
                ${isSelected ? 'Đang xem' : 'Chi tiết'}
              </button>
            </div>
          </div>
        `;
      }).join("");
    }

    document.querySelectorAll(".btn-select-order").forEach(btn => {
      btn.addEventListener("click", (e) => {
        const selectedId = e.currentTarget.getAttribute("data-id");
        if (selectedId) {
          history.pushState(null, "", `/hoan-tat?order_id=${selectedId}`);
          activeOrderId = selectedId;
          loadOrderDetails(activeOrderId);
          renderOrderTable();
          document.getElementById("current-order-section")?.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });

    renderPaginationControls(totalItems);
  }

  function renderPaginationControls(totalItems) {
    const paginationContainer = document.getElementById("order-pagination-container");
    if (!paginationContainer) return;

    if (totalItems === 0) {
      paginationContainer.innerHTML = "";
      return;
    }

    const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE);
    const startIndex = (currentPage - 1) * ITEMS_PER_PAGE + 1;
    const endIndex = Math.min(currentPage * ITEMS_PER_PAGE, totalItems);

    let buttonsHtml = '';
    for (let i = 1; i <= totalPages; i++) {
      const isCurrent = i === currentPage;
      buttonsHtml += `
        <button 
          data-page="${i}"
          class="btn-page px-2.5 py-1 rounded-lg text-xs font-bold transition cursor-pointer ${isCurrent ? 'bg-[#083a3c] text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'}"
        >
          ${i}
        </button>
      `;
    }

    paginationContainer.innerHTML = `
      <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-2xs sm:text-xs">
        <div class="text-slate-500 font-medium text-center sm:text-left">
          Hiển thị <span class="font-bold text-slate-800">${startIndex} - ${endIndex}</span> / <span class="font-bold text-slate-800">${totalItems}</span> đơn
        </div>
        <div class="flex items-center gap-1">
          <button 
            id="btn-prev-page" 
            ${currentPage === 1 ? 'disabled' : ''} 
            class="px-2 py-1 rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-100 disabled:opacity-30 disabled:cursor-not-allowed font-bold transition cursor-pointer text-xs"
          >
            ‹
          </button>
          ${buttonsHtml}
          <button 
            id="btn-next-page" 
            ${currentPage === totalPages ? 'disabled' : ''} 
            class="px-2 py-1 rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-100 disabled:opacity-30 disabled:cursor-not-allowed font-bold transition cursor-pointer text-xs"
          >
            ›
          </button>
        </div>
      </div>
    `;

    document.getElementById("btn-prev-page")?.addEventListener("click", () => {
      if (currentPage > 1) {
        currentPage--;
        renderOrderTable();
      }
    });

    document.getElementById("btn-next-page")?.addEventListener("click", () => {
      if (currentPage < totalPages) {
        currentPage++;
        renderOrderTable();
      }
    });

    document.querySelectorAll(".btn-page").forEach(btn => {
      btn.addEventListener("click", (e) => {
        const page = Number(e.currentTarget.getAttribute("data-page"));
        if (page) {
          currentPage = page;
          renderOrderTable();
        }
      });
    });
  }

  async function loadOrderHistoryAndInit(reloadDetails = true) {
    const desktopTbody = document.getElementById("order-history-tbody-desktop");
    try {
      const res = await fetch('/api/orders/history');
      if (!res.ok) throw new Error();
      allOrders = await res.json();

      if (allOrders.length > 0) {
        // Nếu activeOrderId là mã WEB tạm thời, thử tìm đơn tương ứng trong lịch sử
        // (OCMS CRM có thể đã đồng bộ và lưu mã SO chính thức)
        const isWebRef = activeOrderId && (activeOrderId.startsWith('WEB-') || activeOrderId.startsWith('ORD-'));
        if (!activeOrderId || isWebRef) {
          // Ưu tiên đơn mới nhất trong lịch sử
          activeOrderId = allOrders[0].id;
        }

        renderOrderTable();
        computeSalesFromOrders();
        if (reloadDetails && activeOrderId) {
          loadOrderDetails(activeOrderId);
        }

      } else {
        renderOrderTable();
        updateMilestoneUI();
        // Nếu lịch sử trống nhưng có mã đơn từ URL, thử tải detail (có thể worker chưa sync)
        if (reloadDetails && activeOrderId) {
          loadOrderDetails(activeOrderId);
        }
      }
    } catch {
      if (desktopTbody) desktopTbody.innerHTML = `<tr><td colspan="6" class="py-8 text-center text-red-400 text-xs">Không thể tải danh sách đơn hàng.</td></tr>`;
      updateMilestoneUI();
      if (reloadDetails && activeOrderId) {
        loadOrderDetails(activeOrderId);
      }
    }
  }

  // Khởi động: Load lịch sử trước để lấy mã SO chính thức,
  // sau đó loadOrderDetails với mã đã được chuẩn hóa
  await loadOrderHistoryAndInit(true);
});

</script>
---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Drawer from '@/components/common/Drawer.astro';
import { configService } from '@/services/config.service';

const auth = (Astro.locals as any)?.auth;
const currentPartnerId = auth?.partnerId || '';
const LONGTERM_POLICY = await configService.getLongtermPolicy();

const paymentStatus = Astro.url.searchParams.get('payment');
const vnpTransactionNo = Astro.url.searchParams.get('vnp_TransactionNo');
const paymentErrorCode = Astro.url.searchParams.get('code');
---

<BaseLayout title="Trạng thái đơn hàng & Doanh số - LaPet" hideFooter={true}>
  <input type="hidden" id="current-partner-id" value={currentPartnerId} />

  <!-- WRAPPER: FIT VIEWPORT 100dvh TRÊN DESKTOP, CUỘN TỰ NHIÊN TRÊN MOBILE -->
  <div 
    x-data="{ isHistoryDrawerOpen: false, isMilestonePanelOpen: false }"
    class="bg-[#f7f8fa] font-sans w-full min-h-screen lg:min-h-0 lg:h-[calc(100dvh-5rem)] lg:max-h-[calc(100dvh-5rem)] overflow-y-auto lg:overflow-hidden flex flex-col justify-between py-2 sm:py-2.5 px-3 sm:px-4 lg:px-6 relative"
  >
    
    <!-- 1. TOP BAR: BANNER THÔNG BÁO VNPAY (NẾU CÓ) + BREADCRUMB & TOOLBAR (SHRINK-0) -->
    <header class="shrink-0 space-y-1.5 pb-2 border-b border-slate-200/80">
      
      <!-- THÔNG BÁO KẾT QUẢ THANH TOÁN VNPAY -->
      {paymentStatus === 'success' && (
        <div class="p-2 sm:p-2.5 rounded-xl bg-emerald-50 border border-emerald-200/90 flex items-center justify-between gap-3 shadow-2xs animate-fade-in text-xs">
          <div class="flex items-center gap-2">
            <span class="w-5 h-5 rounded-full bg-emerald-500 text-white flex items-center justify-center font-bold text-xs shrink-0">✓</span>
            <div>
              <span class="font-black text-emerald-950">Thanh toán VNPAY thành công!</span>
              <span class="text-emerald-800 ml-1 hidden sm:inline">
                Đơn hàng đã được tự động xác nhận {vnpTransactionNo ? `(Mã VNPAY: #${vnpTransactionNo})` : ''}.
              </span>
            </div>
          </div>
          <a href="/tai-khoan/don-hang" class="text-3xs sm:text-2xs font-bold text-emerald-800 underline hover:text-emerald-950 shrink-0">Xem đơn</a>
        </div>
      )}

      {paymentStatus === 'failed' && (
        <div class="p-2 sm:p-2.5 rounded-xl bg-rose-50 border border-rose-200/90 flex items-center justify-between gap-3 shadow-2xs animate-fade-in text-xs">
          <div class="flex items-center gap-2">
            <span class="w-5 h-5 rounded-full bg-rose-500 text-white flex items-center justify-center font-bold text-xs shrink-0">✕</span>
            <div>
              <span class="font-black text-rose-950">Giao dịch thanh toán VNPAY chưa hoàn tất</span>
              <span class="text-rose-800 ml-1 hidden sm:inline">
                {paymentErrorCode ? `(Mã phản hồi: ${paymentErrorCode})` : 'Giao dịch đã bị hủy hoặc không thành công.'}
              </span>
            </div>
          </div>
          <span class="text-3xs text-rose-600 font-medium">Vui lòng thử lại</span>
        </div>
      )}

      {paymentStatus === 'invalid_signature' && (
        <div class="p-2 sm:p-2.5 rounded-xl bg-amber-50 border border-amber-200/90 flex items-center gap-2 shadow-2xs animate-fade-in text-xs">
          <span class="w-5 h-5 rounded-full bg-amber-500 text-white flex items-center justify-center font-bold text-xs shrink-0">⚠</span>
          <span class="font-black text-amber-950">Cảnh báo bảo mật:</span>
          <span class="text-amber-800 text-2xs">Chữ ký bảo mật VNPAY không hợp lệ. Vui lòng liên hệ ban quản trị.</span>
        </div>
      )}

      <!-- BREADCRUMB & NÚT THAO TÁC NHANH -->
      <div class="flex items-center justify-between gap-2">
        <nav class="flex items-center gap-1.5 text-2xs sm:text-xs text-slate-500 font-medium truncate">
          <a href="/tai-khoan" class="hover:text-slate-900 transition">Tài khoản</a>
          <span>/</span>
          <a href="/tai-khoan/don-hang" class="hover:text-slate-900 transition">Đơn hàng</a>
          <span>/</span>
          <span class="text-slate-900 font-bold truncate">Chi tiết & Doanh số</span>
        </nav>

        <div class="flex items-center gap-2 shrink-0">
          <!-- NÚT MỞ DRAWER ĐƠN HÀNG GẦN ĐÂY -->
          <button
            type="button"
            id="btn-open-recent-orders"
            @click="isHistoryDrawerOpen = true"
            class="inline-flex items-center gap-1.5 px-2.5 py-1 sm:py-1.5 rounded-lg border border-teal-200 bg-teal-50/70 hover:bg-teal-100/80 text-[#083a3c] text-2xs sm:text-xs font-bold transition shadow-2xs cursor-pointer"
            title="Xem danh sách các đơn hàng gần đây"
          >
            <svg class="w-3.5 h-3.5 text-[#083a3c]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
            <span>Đơn hàng gần đây</span>
            <span id="badge-recent-orders-count" class="bg-[#083a3c] text-white px-1.5 py-0.2 rounded-full text-3xs font-extrabold">--</span>
          </button>

          <!-- NÚT ĐẶT HÀNG MỚI -->
          <a
            href="/dat-hang-nhanh"
            class="inline-flex items-center gap-1 px-3 py-1 sm:py-1.5 rounded-lg bg-orange-600 hover:bg-orange-700 text-white text-2xs sm:text-xs font-bold transition shadow-xs uppercase tracking-wider"
          >
            <span>+ Đặt hàng mới</span>
          </a>
        </div>
      </div>
    </header>

    <!-- 2. MAIN STAGE: CHI TIẾT ĐƠN HÀNG LÀ TRUNG TÂM (FLEX-1 MIN-H-0) -->
    <main 
      id="current-order-section" 
      class="flex-1 min-h-0 flex flex-col bg-white rounded-xl border border-slate-200/90 shadow-2xs p-3 sm:p-3.5 my-2 w-full overflow-hidden"
    >
      <!-- HEADER CHI TIẾT ĐƠN HÀNG (MÃ ĐƠN, TRẠNG THÁI, NGÀY ĐẶT) -->
      <div class="shrink-0 flex flex-wrap items-center justify-between gap-2 pb-2.5 border-b border-slate-100">
        <div class="flex flex-wrap items-center gap-2 sm:gap-3">
          <span class="inline-flex items-center gap-1 bg-teal-50 text-teal-800 px-2 py-0.5 rounded text-3xs font-extrabold border border-teal-200/60">
            <span class="w-1.5 h-1.5 rounded-full bg-teal-600 animate-pulse"></span>
            <span>Chi tiết đơn hàng</span>
          </span>

          <span id="current-order-status-tag" class="px-2 py-0.5 rounded text-3xs font-bold border bg-slate-100 text-slate-600 border-slate-200">
            Đang tải...
          </span>

          <span class="text-slate-300 hidden sm:inline">|</span>

          <h1 class="text-sm sm:text-base font-black text-slate-900 tracking-tight flex items-center gap-1.5">
            <span class="text-slate-500 font-semibold text-xs">Mã đơn:</span>
            <span id="current-order-id" class="font-mono text-[#083a3c] font-black">--</span>
          </h1>

          <span id="current-order-date" class="text-2xs text-slate-500 font-medium hidden sm:inline"></span>
        </div>

        <div class="flex items-center gap-2">
          <span id="current-order-qty" class="text-3xs font-bold text-slate-600 bg-slate-50 px-2 py-0.5 rounded border border-slate-200">
            0 sản phẩm
          </span>
        </div>
      </div>

      <!-- NỘI DUNG 2 CỘT (DESKTOP: 65% TRÁI - 35% PHẢI) -->
      <div class="flex-1 min-h-0 grid grid-cols-1 lg:grid-cols-12 gap-3 pt-2.5 overflow-hidden">
        
        <!-- CỘT TRÁI (65% - 8 COLS): BẢNG SẢN PHẨM CUỘN NỘI BỘ + THANH CÔNG CỤ THAO TÁC / VNPAY -->
        <div class="lg:col-span-8 flex flex-col min-h-0 overflow-hidden space-y-2">
          
          <!-- BẢNG DANH SÁCH SẢN PHẨM: CUỘN NỘI BỘ VỚI STICKY HEADER -->
          <div class="flex-1 min-h-0 rounded-lg border border-slate-200 overflow-hidden bg-white flex flex-col">
            <div class="bg-slate-50/90 px-3 py-1.5 border-b border-slate-200 flex justify-between items-center shrink-0">
              <h3 class="text-2xs font-bold uppercase tracking-wider text-slate-700 flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-[#083a3c]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
                </svg>
                <span>Mặt hàng trong đơn</span>
              </h3>
              <span class="text-3xs text-slate-400">Cuộn danh sách để xem thêm</span>
            </div>

            <!-- SCROLLABLE PRODUCT TABLE CONTAINER -->
            <div class="flex-1 min-h-0 overflow-y-auto scrollbar-thin">
              <table class="w-full text-left text-xs border-collapse">
                <thead class="sticky top-0 bg-slate-50 z-10 shadow-2xs">
                  <tr class="border-b border-slate-200 text-slate-400 font-bold uppercase tracking-wider text-3xs">
                    <th class="py-2 px-3">Sản phẩm</th>
                    <th class="py-2 px-3 text-right w-24">Đơn giá</th>
                    <th class="py-2 px-3 text-center w-16">SL</th>
                    <th class="py-2 px-3 text-right w-28">Thành tiền</th>
                  </tr>
                </thead>
                <tbody id="current-order-items-table" class="divide-y divide-slate-100 text-slate-700">
                  <tr>
                    <td colspan="4" class="py-6 text-center text-slate-400 text-2xs">
                      <div class="inline-flex items-center gap-2">
                        <span class="inline-block w-2.5 h-2.5 rounded-full bg-teal-600 animate-ping"></span>
                        <span>Đang tải chi tiết đơn hàng...</span>
                      </div>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- THANH CÔNG CỤ THAO TÁC / THANH TOÁN VNPAY (SHRINK-0) -->
          <div id="quotation-actions-container" class="shrink-0 space-y-2 p-2.5 rounded-lg bg-slate-50 border border-slate-200/80 hidden">
            <!-- Cổng thanh toán VNPAY Banner & Link -->
            <div id="vnpay-action-box" class="p-2 rounded-lg bg-white border border-blue-200 shadow-2xs space-y-1.5">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <div class="flex items-center gap-2">
                  <div class="w-6 h-6 rounded-md bg-[#005ba6] text-white flex items-center justify-center font-black text-3xs shrink-0 shadow-2xs">
                    VN
                  </div>
                  <div>
                    <h4 class="font-black text-[#005ba6] text-xs leading-none">Thanh toán Cổng VNPAY</h4>
                    <p class="text-3xs text-slate-500 mt-0.5">Mã: <strong id="vnpay-display-order-code" class="text-slate-800">--</strong></p>
                  </div>
                </div>

                <button
                  type="button"
                  id="btn-pay-vnpay"
                  class="px-3 py-1 rounded-lg bg-[#005ba6] hover:bg-[#004785] text-white text-2xs font-black transition flex items-center justify-center gap-1 shadow-xs cursor-pointer"
                >
                  <span>Thanh toán VNPAY</span>
                  <span>→</span>
                </button>
              </div>

              <!-- Link thanh toán trực tiếp để sao chép hoặc chia sẻ -->
              <div class="flex items-center gap-2 pt-1 border-t border-slate-100">
                <input
                  type="text"
                  id="vnpay-link-input"
                  readonly
                  placeholder="Đang tạo link thanh toán..."
                  class="flex-1 bg-slate-50 border border-slate-200 rounded px-2 py-0.5 text-3xs text-slate-700 font-mono select-all focus:outline-none"
                />
                <button
                  type="button"
                  id="btn-copy-payment-link"
                  class="px-2.5 py-0.5 rounded bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 text-3xs font-bold transition cursor-pointer shrink-0"
                >
                  Sao chép
                </button>
              </div>
            </div>

            <!-- Nút chốt đơn, sửa đơn & Hủy đơn (Chỉ hiển thị khi đơn ở trạng thái Đơn nháp) -->
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div class="flex flex-wrap items-center gap-2">
                <button
                  type="button"
                  id="btn-confirm-draft-order"
                  class="px-3 py-1.5 rounded-lg bg-[#083a3c] hover:bg-[#062c2e] text-white text-2xs font-bold transition flex items-center gap-1 cursor-pointer shadow-xs"
                >
                  <span>✓</span>
                  <span>Chốt đơn bán hàng</span>
                </button>
                <button
                  type="button"
                  id="btn-edit-order"
                  class="px-3 py-1.5 rounded-lg bg-white hover:bg-slate-100 text-slate-700 text-2xs font-bold transition flex items-center gap-1 cursor-pointer border border-slate-200 shadow-2xs"
                >
                  <span>✏️</span>
                  <span>Chỉnh sửa thông tin đơn</span>
                </button>
              </div>

              <button
                type="button"
                id="btn-cancel-order"
                class="px-3 py-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-2xs font-bold transition flex items-center gap-1 cursor-pointer"
              >
                <span>✕</span>
                <span>Hủy đơn</span>
              </button>
            </div>
          </div>

        </div>

        <!-- CỘT PHẢI (35% - 4 COLS): CARD NHẬN HÀNG + CARD THANH TOÁN + TỔNG TIỀN CỐ ĐỊNH -->
        <div class="lg:col-span-4 flex flex-col justify-between space-y-2 lg:overflow-y-auto scrollbar-thin">
          
          <!-- THÔNG TIN GIAO HÀNG -->
          <div class="p-2.5 sm:p-3 rounded-lg bg-slate-50/80 border border-slate-200/80 space-y-1.5 text-xs">
            <div class="flex items-center gap-1.5 font-bold text-slate-900 border-b border-slate-200/60 pb-1.5 text-2xs uppercase tracking-wider">
              <svg class="w-3.5 h-3.5 text-[#083a3c]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
              </svg>
              <span>Thông tin nhận hàng</span>
            </div>
            <div class="space-y-1 text-slate-600 text-2xs">
              <div class="flex justify-between items-baseline">
                <span class="text-slate-400">Người nhận:</span>
                <strong id="current-recipient-name" class="text-slate-900 text-right">--</strong>
              </div>
              <div class="flex justify-between items-baseline">
                <span class="text-slate-400">Số ĐT:</span>
                <strong id="current-recipient-phone" class="text-slate-900 text-right font-mono">--</strong>
              </div>
              <div>
                <span class="text-slate-400 block mb-0.5">Địa chỉ giao:</span>
                <span id="current-shipping-address" class="text-slate-800 font-medium block leading-snug line-clamp-2" title="">--</span>
              </div>
              <div>
                <span class="text-slate-400 block mb-0.5">Ghi chú:</span>
                <span id="current-order-note" class="text-slate-600 italic block line-clamp-2">Không có</span>
              </div>
            </div>
          </div>

          <!-- PHƯƠNG THỨC THANH TOÁN -->
          <div class="p-2.5 sm:p-3 rounded-lg bg-slate-50/80 border border-slate-200/80 space-y-1.5 text-xs">
            <div class="flex items-center gap-1.5 font-bold text-slate-900 border-b border-slate-200/60 pb-1.5 text-2xs uppercase tracking-wider">
              <svg class="w-3.5 h-3.5 text-[#083a3c]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/>
              </svg>
              <span>Phương thức thanh toán</span>
            </div>
            <div class="space-y-1">
              <div class="flex items-center justify-between">
                <span id="current-payment-badge" class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-3xs font-black bg-blue-50 text-blue-800 border border-blue-200">
                  VNPAY
                </span>
                <span id="current-payment-status-hint" class="text-3xs font-semibold"></span>
              </div>
              <p id="current-payment-desc" class="text-3xs text-slate-500 leading-snug">
                Cổng thanh toán điện tử VNPAY.
              </p>
            </div>
          </div>

          <!-- TỔNG KẾT TÀI CHÍNH THANH TOÁN -->
          <div class="p-3 rounded-lg bg-[#083a3c]/5 border border-[#083a3c]/15 space-y-1.5 text-xs">
            <div class="flex justify-between items-center text-slate-600 text-2xs">
              <span>Tạm tính tiền hàng:</span>
              <span id="current-order-subtotal" class="font-bold text-slate-800">0đ</span>
            </div>
            <div class="flex justify-between items-center text-slate-600 text-2xs">
              <span>Phí vận chuyển:</span>
              <span class="text-emerald-700 font-bold">Miễn phí</span>
            </div>
            <div class="pt-1.5 border-t border-slate-200 flex justify-between items-baseline">
              <span class="font-extrabold text-slate-900 text-xs">Tổng thanh toán:</span>
              <span id="current-order-total-side" class="font-black text-slate-900 text-base">0đ</span>
            </div>
          </div>

        </div>

      </div>

    </main>

    <!-- 3. COMPACT WIDGET: DOANH SỐ TÍCH LŨY & BẬC THƯỞNG (SHRINK-0, CAO ~65-75px KHI THU GỌN) -->
    <footer class="shrink-0 bg-white rounded-xl border border-slate-200/90 shadow-2xs p-2.5 sm:py-2 sm:px-4 mt-1 transition-all">
      
      <!-- HÀNG THANH TIẾN ĐỘ CHÍNH (COMPACT BAR) -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs">
        
        <!-- CỘT 1: DOANH SỐ TÍCH LŨY & BẬC HIỆN TẠI -->
        <div class="flex items-center gap-2.5 shrink-0">
          <div class="w-2 h-2 rounded-full bg-teal-600 shrink-0"></div>
          <div>
            <div class="flex items-center gap-1.5">
              <span class="text-3xs font-extrabold uppercase tracking-wider text-slate-400">Doanh số:</span>
              <span id="stat-current-sales" class="font-black text-[#083a3c] text-xs sm:text-sm">0đ</span>
              <span class="text-slate-300">|</span>
              <span class="text-3xs font-bold text-slate-400">Bậc:</span>
              <span id="stat-current-tier" class="font-black text-emerald-600 text-xs">0.0%</span>
            </div>
            <p id="stat-sales-period-label" class="text-3xs text-slate-400 font-medium leading-none mt-0.5">
              Tích lũy năm {LONGTERM_POLICY.year}
            </p>
          </div>
        </div>

        <!-- CỘT 2: THANH TIẾN ĐỘ VÀ SỐ TIỀN CÒN THIẾU -->
        <div class="flex-1 max-w-xl mx-0 sm:mx-4 flex flex-col justify-center">
          <div class="flex items-center justify-between text-3xs font-bold text-slate-600 mb-1">
            <span id="alert-main-text" class="truncate pr-2">Đang tính toán tiến độ...</span>
            <span id="stat-progress-sub" class="text-slate-500 shrink-0">Tiến độ: 0%</span>
          </div>
          <!-- Progress bar -->
          <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden border border-slate-200/70 relative">
            <div id="stat-progress-fill" class="h-full bg-gradient-to-r from-teal-500 to-[#083a3c] rounded-full transition-all duration-700" style="width: 0%;"></div>
          </div>
        </div>

        <!-- CỘT 3: CÁC NÚT ĐIỀU KHIỂN & TOGGLE BUNG MỞ MILESTONE -->
        <div class="flex items-center justify-between sm:justify-end gap-2 shrink-0">
          
          <!-- Segmented Switcher Năm / Quý -->
          <div class="inline-flex p-0.5 bg-slate-100 rounded-lg border border-slate-200/60 text-3xs">
            <button 
              id="tab-btn-year" 
              class="tab-btn active px-2 py-0.5 rounded-md font-bold transition-all duration-200 bg-[#083a3c] text-white shadow-2xs cursor-pointer"
            >
              Năm
            </button>
            <button 
              id="tab-btn-quarter" 
              class="tab-btn px-2 py-0.5 rounded-md font-bold transition-all duration-200 text-slate-600 hover:text-slate-900 cursor-pointer"
            >
              Quý
            </button>
          </div>

          <!-- Chọn Quý nếu chọn xem Quý -->
          <div id="quarter-select-wrapper" class="hidden items-center gap-1">
            <select id="quarter-select" class="text-3xs font-bold bg-white border border-slate-300 rounded px-1.5 py-0.5 text-slate-800 focus:outline-none focus:border-[#083a3c] cursor-pointer">
              <option value="q1">Q1</option>
              <option value="q2">Q2</option>
              <option value="q3">Q3</option>
              <option value="q4">Q4</option>
            </select>
          </div>

          <!-- NÚT BUNG MỞ PANEL CHI TIẾT BẬC THƯỞNG -->
          <button
            type="button"
            @click="isMilestonePanelOpen = !isMilestonePanelOpen"
            class="inline-flex items-center gap-1 px-2 py-1 rounded-lg border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-700 text-3xs sm:text-2xs font-bold transition cursor-pointer"
          >
            <span>Chi tiết bậc thưởng</span>
            <svg class="w-3.5 h-3.5 transition-transform duration-200" :class="{ 'rotate-180': isMilestonePanelOpen }" fill="none" stroke="currentColor" viewBox="0 0 24 24">

---
// src/pages/thanh-toan.astro
export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';
import { customerService } from '@/services/customer.service';
import { orderService } from '@/services/order.service';

const auth = Astro.locals.auth;

// Bảo vệ route: Chỉ đại lý đã đăng nhập mới được truy cập trang thanh toán
if (!auth?.isAuthenticated || !auth?.isDealer || !auth?.partnerId) {
  return Astro.redirect('/auth/login?redirect=/thanh-toan');
}

const partnerId = Number(auth.partnerId);
let partner = await customerService.getPartnerById(partnerId);
if (!partner) {
  partner = customerService.getFallbackPartner(partnerId);
}

// Kiểm tra xem URL có param order_code không (khi người dùng truy cập trực tiếp hoặc sau khi thanh toán)
const urlOrderCode = Astro.url.searchParams.get('order_code') || Astro.url.searchParams.get('order_id');
let initialConfirmedOrder: any = null;

if (urlOrderCode) {
  try {
    const fetched = await orderService.getOrderById(urlOrderCode, partnerId);
    if (fetched) {
      initialConfirmedOrder = {
        order_code: fetched.order_code,
        order_id: fetched.order_code,
        amount_total: Number(fetched.amount_total || 0),
        amount_untaxed: Number(fetched.amount_untaxed || 0),
        amount_discount: Number(fetched.amount_discount || 0),
        paid_amount: Number(fetched.paid_amount || 0),
        payment_method: fetched.payment_method,
        payment_status: fetched.payment_status,
        status: fetched.status,
        date_order: fetched.date_order || fetched.created_at,
        created_at: fetched.created_at,
        recipient_name: fetched.shipping_name || fetched.partner_name || '',
        recipient_phone: fetched.partner_phone || '',
        delivery_address: fetched.shipping_address || '',
        notes: fetched.notes || '',
        items: (fetched.items || []).map((it: any) => ({
          id: it.id,
          product_id: it.product_id,
          sku: it.sku,
          name: it.product_name,
          quantity: Number(it.quantity || 1),
          price_unit: Number(it.price_unit || 0),
          price_total: Number(it.price_total || 0),
          image_url: it.image_url || '/images/placeholder-product.svg'
        }))
      };
    }
  } catch (err) {
    console.warn('[Checkout Load Order Error]:', err);
  }
}

const initialPartnerData = {
  partnerId: partnerId,
  name: partner?.name || auth?.partnerName || 'Đại lý LA PET',
  ref: partner?.ref || `DL-${partnerId}`,
  phone: partner?.phone || auth?.partnerPhone || '',
  email: partner?.email || '',
  vat: partner?.vat || '',
  pricelist: partner?.pricelist || 'Bảng giá Đại lý Tiêu chuẩn',
  address: partner?.shipping_address || 'Địa chỉ kho chính LA PET',
  deliveryAddresses: partner?.delivery_addresses || []
};
---

<BaseLayout title="Thanh toán Đơn hàng - LA PET Store" hideFooter={true}>
  <div
    class="max-w-7xl mx-auto px-3 sm:px-4 lg:px-6 pt-3 pb-6 sm:pb-8 lg:min-h-[calc(100dvh-5rem)] flex flex-col justify-start"
    x-data={`{
      partner: ${JSON.stringify(initialPartnerData)},
      cart: [],
      addressMode: 'saved', // 'saved' or 'custom'
      selectedSavedAddressId: '',
      recipientName: ${JSON.stringify(initialPartnerData.name)},
      recipientPhone: ${JSON.stringify(initialPartnerData.phone)},
      recipientEmail: ${JSON.stringify(initialPartnerData.email)},
      customAddress: '',
      saveCustomAddress: true,
      orderNote: '',
      paymentMethod: 'vnpay', // 'vnpay' or 'cod'

      isLoading: true,
      isSubmitting: false,
      isRedirectingToVnpay: false,
      errorMessage: '',
      orderCompleted: ${initialConfirmedOrder ? 'true' : 'false'},
      createdOrder: ${JSON.stringify(initialConfirmedOrder)},
      copiedCode: false,
      serverPromoResult: null,

      // Modal chỉnh sửa đơn hàng
      isEditModalOpen: false,
      editForm: {
        recipient_name: '',
        recipient_phone: '',
        shipping_address: '',
        note: '',
        items: []
      },
      isUpdatingOrder: false,
      editErrorMessage: '',
      editSuccessMessage: '',

      init() {
        if (!this.orderCompleted) {
          this.loadCart();
        } else {
          this.isLoading = false;
        }
        this.loadSavedAddresses();
        window.addEventListener('cart-updated', () => {
          if (!this.orderCompleted) {
            this.loadCart();
          }
        });
      },

      async loadSavedAddresses() {
        try {
          const res = await fetch('/api/customers/addresses');
          if (!res.ok) return;
          const data = await res.json();
          if (data?.success && Array.isArray(data.addresses) && data.addresses.length > 0) {
            this.partner.deliveryAddresses = data.addresses.map((a) => ({
              id: a.id,
              name: a.contact_name || 'Kho nhận hàng',
              street: [a.address, a.city].filter(Boolean).join(', '),
              phone: a.phone || '',
              is_default: Boolean(a.is_default),
            }));
            const def = this.partner.deliveryAddresses.find((a) => a.is_default);
            if (def && !this.selectedSavedAddressId) {
              this.selectedSavedAddressId = String(def.id);
            }
          }
        } catch (err) {
          console.warn('[Checkout Addresses]:', err);
        }
      },

      async syncServerPricing() {
        if (!this.cart || this.cart.length === 0) return;
        try {
          const payloadItems = this.cart.map(item => ({
            odoo_id: Number(item.odoo_id),
            id: Number(item.odoo_id || item.id),
            sku: item.sku,
            qty: Number(item.quantity)
          }));

          const res = await fetch('/api/products/calculate-price', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: payloadItems })
          });

          if (res.ok) {
            const data = await res.json();
            this.serverPromoResult = data;
          }
        } catch (err) {
          console.warn('[Checkout Pricing Sync Fallback to local]:', err);
        }
      },

      loadCart() {
        try {
          const raw = JSON.parse(localStorage.getItem('cart') || '[]');
          if (!Array.isArray(raw) || raw.length === 0) {
            this.cart = [];
          } else {
            this.cart = raw.map(item => {
              const rawOdooId = item.odoo_id !== undefined && item.odoo_id !== null ? item.odoo_id : item.id;
              const odooId = parseInt(rawOdooId, 10);
              const validOdooId = !isNaN(odooId) && odooId > 0 ? odooId : (Number(item.id) || 101);
              const price = Number(item.price || item.retail_price || 0);
              const wholesalePrice = item.wholesale_price ? Number(item.wholesale_price) : Math.round(price * 0.78);
              const quantity = Math.max(1, parseInt(item.quantity || item.qty || 1, 10));

              return {
                ...item,
                id: item.id || validOdooId,
                odoo_id: validOdooId,
                sku: item.sku || ('SKU-' + validOdooId),
                name: item.name || 'Sản phẩm La Pet',
                image: item.image || '/images/placeholder-product.svg',
                price: price,
                wholesale_price: wholesalePrice,
                quantity: quantity
              };
            });
          }
        } catch (e) {
          this.cart = [];
        }
        this.isLoading = false;
        if (this.cart.length > 0) {
          this.syncServerPricing();
        }
      },

      get rawSubtotal() {
        return this.cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
      },

      get wholesaleDiscount() {
        if (this.serverPromoResult && typeof this.serverPromoResult.discount_amount === 'number') {
          return this.serverPromoResult.discount_amount;
        }
        return this.cart.reduce((sum, item) => {
          const unitPrice = item.wholesale_price || Math.round(item.price * 0.78);
          const disc = Math.max(0, item.price - unitPrice);
          return sum + (disc * item.quantity);
        }, 0);
      },

      get finalTotal() {
        if (this.serverPromoResult && typeof this.serverPromoResult.total === 'number') {
          return this.serverPromoResult.total;
        }
        return Math.max(0, this.rawSubtotal - this.wholesaleDiscount);
      },

      get totalQuantity() {
        return this.cart.reduce((sum, item) => sum + item.quantity, 0);
      },

      get deliveryAddressText() {
        if (this.addressMode === 'custom') {
          return this.customAddress.trim() || 'Chưa nhập địa chỉ giao hàng';
        }
        if (this.selectedSavedAddressId) {
          const found = this.partner.deliveryAddresses.find(a => String(a.id) === String(this.selectedSavedAddressId));
          if (found) return found.street || found.name;
        }
        return this.partner.address;
      },

      async payWithVnpay(orderCode, amount) {
        this.isRedirectingToVnpay = true;
        this.errorMessage = '';
        try {
          const res = await fetch('/api/payment/vnpay-create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              order_code: orderCode,
              amount: amount,
              order_info: 'Thanh toan don hang ' + orderCode
            })
          });
          const data = await res.json().catch(() => null);
          if (res.ok && data?.payment_url) {
            window.location.href = data.payment_url;
          } else {
            throw new Error(data?.error || 'Không thể tạo phiên thanh toán VNPAY. Vui lòng thử lại.');
          }
        } catch (err) {
          console.error('[VNPAY Error]:', err);
          this.errorMessage = err.message || 'Lỗi kết nối cổng thanh toán VNPAY.';
        } finally {
          this.isRedirectingToVnpay = false;
        }
      },

      validatePhone(p) {
        const cleaned = (p || '').replace(/[\\s\\-\\.\\(\\)]/g, '');
        let normal = cleaned;
        if (normal.startsWith('+84')) normal = '0' + normal.slice(3);
        else if (normal.startsWith('84') && normal.length === 11) normal = '0' + normal.slice(2);
        return /^(0[35789])[0-9]{8}$/.test(normal);
      },

      getOrCreateClientOrderRef() {
        try {
          const stored = sessionStorage.getItem('lapet_client_order_ref');
          if (stored) return stored;
          const ref = 'CLI-' + Date.now() + '-' + Math.random().toString(36).slice(2, 8).toUpperCase();
          sessionStorage.setItem('lapet_client_order_ref', ref);
          return ref;
        } catch {
          return 'CLI-' + Date.now();
        }
      },

      async handleSubmitOrder() {
        this.errorMessage = '';

        if (this.cart.length === 0) {
          this.errorMessage = 'Giỏ hàng của bạn đang trống. Vui lòng chọn sản phẩm trước khi tạo đơn hàng.';
          return;
        }

        if (!this.recipientName.trim()) {
          this.errorMessage = 'Vui lòng nhập Họ và tên người nhận hàng.';
          return;
        }

        if (!this.validatePhone(this.recipientPhone)) {
          this.errorMessage = 'Số điện thoại người nhận không hợp lệ (vd: 0909 203 166).';
          return;
        }

        if (this.addressMode === 'custom' && !this.customAddress.trim()) {
          this.errorMessage = 'Vui lòng nhập địa chỉ giao hàng chi tiết.';
          return;
        }

        this.isSubmitting = true;

        if (!this.serverPromoResult) {
          await this.syncServerPricing();
        }

        const clientOrderRef = this.getOrCreateClientOrderRef();
        const payloadItems = this.cart.map(item => {
          const serverItem = (this.serverPromoResult?.items || []).find(si => Number(si.id || si.odoo_id) === Number(item.odoo_id));
          const unitPrice = serverItem?.unit_price ?? serverItem?.price_unit ?? Number(item.wholesale_price || Math.round(item.price * 0.78));
          return {
            id: Number(item.odoo_id),
            odoo_id: Number(item.odoo_id),
            sku: String(item.sku || ('SKU-' + item.odoo_id)),
            qty: Number(item.quantity),
            quantity: Number(item.quantity),
            price_unit: Number(unitPrice)
          };
        });

        const isCustom = this.addressMode === 'custom';

        const payload = {
          client_order_ref: clientOrderRef,
          partner_id: Number(this.partner.partnerId),
          partner_name: this.recipientName.trim(),
          partner_phone: this.recipientPhone.trim(),
          partner_email: this.recipientEmail.trim(),
          delivery_address: this.deliveryAddressText,
          payment_method: this.paymentMethod,
          is_custom_address: isCustom,
          shipping_address_id: !isCustom && this.selectedSavedAddressId ? Number(this.selectedSavedAddressId) : undefined,
          custom_address: isCustom ? {
            name: this.recipientName.trim(),
            phone: this.recipientPhone.trim(),
            street: this.customAddress.trim()
          } : undefined,
          note: this.orderNote.trim(),
          items: payloadItems
        };

        try {
          const res = await fetch('/api/orders/create-quotation', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });

          const result = await res.json().catch(() => null);

          if (!res.ok && res.status !== 500) {
            throw new Error(result?.error || result?.message || 'Không thể tạo đơn hàng. Vui lòng thử lại.');
          }

          if (isCustom && this.saveCustomAddress && this.customAddress.trim().length >= 5) {
            fetch('/api/customers/addresses', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                contact_name: this.recipientName.trim(),
                phone: this.recipientPhone.trim(),
                address: this.customAddress.trim(),
                is_default: (this.partner.deliveryAddresses || []).length === 0,
              }),
            }).catch(() => {});
          }

          const orderCode = result?.order_code || result?.order_id || result?.id || clientOrderRef;
          const amountTotal = result?.amount_total || this.finalTotal;
          const orderSnapshotItems = this.cart.map(it => ({
            id: it.id,
            sku: it.sku,
            name: it.name,
            quantity: it.quantity,
            price_unit: it.wholesale_price || Math.round(it.price * 0.78),
            price_total: (it.wholesale_price || Math.round(it.price * 0.78)) * it.quantity,
            image_url: it.image
          }));

          this.createdOrder = {
            order_code: orderCode,
            order_id: orderCode,
            amount_total: amountTotal,
            amount_untaxed: this.rawSubtotal,
            amount_discount: this.wholesaleDiscount,
            payment_method: this.paymentMethod,
            payment_status: 'unpaid',
            status: 'draft',
            recipient_name: this.recipientName.trim(),
            recipient_phone: this.recipientPhone.trim(),
            delivery_address: this.deliveryAddressText,
            notes: this.orderNote.trim(),
            created_at: new Date().toISOString(),
            date_order: new Date().toISOString(),
            items: orderSnapshotItems
          };

          // Nếu chọn VNPAY: Tự động chuyển hướng sang cổng thanh toán VNPAY
          if (this.paymentMethod === 'vnpay') {
            try {
              const vnpayRes = await fetch('/api/payment/vnpay-create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  order_code: orderCode,
                  amount: amountTotal,
                  order_info: 'Thanh toan don hang ' + orderCode
                })
              });
              const vnpayData = await vnpayRes.json().catch(() => null);
              if (vnpayRes.ok && vnpayData?.payment_url) {
                localStorage.removeItem('cart');
                sessionStorage.removeItem('lapet_client_order_ref');
                window.dispatchEvent(new Event('cart-updated'));
                window.dispatchEvent(new CustomEvent('cart-updated'));

                window.location.href = vnpayData.payment_url;
                return;
              } else {
                console.warn('[VNPAY Init Warning]:', vnpayData?.error);
              }
            } catch (vnpErr) {
              console.warn('[VNPAY Redirect Exception]:', vnpErr);
            }
          }

          // Dọn dẹp giỏ hàng và idempotency token
          localStorage.removeItem('cart');
          sessionStorage.removeItem('lapet_client_order_ref');
          window.dispatchEvent(new Event('cart-updated'));
          window.dispatchEvent(new CustomEvent('cart-updated'));

          this.orderCompleted = true;
          window.scrollTo({ top: 0, behavior: 'smooth' });

          // Cập nhật URL trình duyệt để lưu lại order_code mà không reload trang
          const newUrl = new URL(window.location.href);
          newUrl.searchParams.set('order_code', orderCode);
          window.history.replaceState({}, '', newUrl.toString());

        } catch (err) {
          console.error('[Checkout Error]:', err);
          this.errorMessage = err.message || 'Lỗi kết nối khi gửi đơn hàng. Vui lòng thử lại.';
        } finally {
          this.isSubmitting = false;
        }
      },

      copyToClipboard(text, type) {
        if (!navigator.clipboard) return;
        navigator.clipboard.writeText(text).then(() => {
          if (type === 'code') {
            this.copiedCode = true;
            setTimeout(() => { this.copiedCode = false; }, 3000);
          }
        });
      },

      formatVND(num) {
        return (Number(num) || 0).toLocaleString('vi-VN') + 'đ';
      },

      formatDate(d) {
        if (!d) return '';
        try {
          return new Date(d).toLocaleString('vi-VN', {
            year: 'numeric',
            month: '2-digit',
            day: '2-digit',
            hour: '2-digit',
            minute: '2-digit'
          });
        } catch {
          return String(d);
        }
      },

      // --- LOGIC CHỈNH SỬA ĐƠN HÀNG ---
      openEditModal() {
        if (!this.createdOrder) return;
        this.editErrorMessage = '';
        this.editSuccessMessage = '';
        this.editForm = {
          recipient_name: this.createdOrder.recipient_name || '',
          recipient_phone: this.createdOrder.recipient_phone || '',
          shipping_address: this.createdOrder.delivery_address || '',
          note: this.createdOrder.notes || '',
          items: (this.createdOrder.items || []).map(it => ({
            id: it.id,
            product_id: it.product_id,
            sku: it.sku,
            name: it.name || it.product_name,
            quantity: Number(it.quantity || 1),
            price_unit: Number(it.price_unit || 0),
            price_total: Number(it.price_total || 0),
            image_url: it.image_url
          }))
        };
        this.isEditModalOpen = true;
      },

      closeEditModal() {
        this.isEditModalOpen = false;
      },

      updateItemQty(index, delta) {
        const item = this.editForm.items[index];
        if (!item) return;
        const newQty = item.quantity + delta;
        if (newQty <= 0) {
          this.removeItem(index);
          return;
        }
        item.quantity = newQty;
        item.price_total = item.quantity * item.price_unit;
      },

      removeItem(index) {
        if (this.editForm.items.length <= 1) {
          this.editErrorMessage = 'Đơn hàng phải có ít nhất 1 sản phẩm. Nếu không muốn đặt, bạn có thể hủy đơn.';
          return;
        }
        this.editForm.items.splice(index, 1);
      },

      get editSubtotal() {
        return (this.editForm.items || []).reduce((sum, it) => sum + (it.price_unit * it.quantity), 0);
      },

      async handleSaveOrderEdit() {
        this.editErrorMessage = '';
        this.editSuccessMessage = '';

        if (!this.editForm.recipient_name.trim()) {
          this.editErrorMessage = 'Vui lòng nhập tên người nhận hàng.';
          return;
        }

        if (!this.validatePhone(this.editForm.recipient_phone)) {
          this.editErrorMessage = 'Số điện thoại người nhận không hợp lệ.';
          return;
        }

        if (!this.editForm.shipping_address.trim()) {
          this.editErrorMessage = 'Vui lòng nhập địa chỉ giao hàng.';
          return;
        }

        if (!this.editForm.items || this.editForm.items.length === 0) {
          this.editErrorMessage = 'Đơn hàng không có sản phẩm.';
          return;
        }

        this.isUpdatingOrder = true;

        try {
          const payload = {
            shipping_name: this.editForm.recipient_name.trim(),
            recipient_name: this.editForm.recipient_name.trim(),
            recipient_phone: this.editForm.recipient_phone.trim(),
            partner_phone: this.editForm.recipient_phone.trim(),
            shipping_address: this.editForm.shipping_address.trim(),
            notes: this.editForm.note.trim(),
            items: this.editForm.items.map(it => ({
              id: it.id,
              product_id: it.product_id,
              sku: it.sku,
              quantity: it.quantity,
              qty: it.quantity,
              name: it.name
            }))
          };

          const orderId = this.createdOrder.order_code || this.createdOrder.order_id;
          const res = await fetch('/api/orders/' + encodeURIComponent(orderId), {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });

          const data = await res.json().catch(() => null);

          if (!res.ok) {
            throw new Error(data?.error || 'Không thể cập nhật đơn hàng.');
          }

          // Cập nhật lại state của trang xác nhận
          this.createdOrder.recipient_name = this.editForm.recipient_name.trim();
          this.createdOrder.recipient_phone = this.editForm.recipient_phone.trim();
          this.createdOrder.delivery_address = this.editForm.shipping_address.trim();
          this.createdOrder.notes = this.editForm.note.trim();
          this.createdOrder.items = this.editForm.items.map(it => ({
            ...it,
            price_total: it.quantity * it.price_unit
          }));
          this.createdOrder.amount_total = this.editSubtotal;

          this.editSuccessMessage = 'Cập nhật đơn hàng thành công!';
          setTimeout(() => {
            this.closeEditModal();
          }, 800);

        } catch (err) {
          this.editErrorMessage = err.message || 'Lỗi khi lưu chỉnh sửa đơn hàng.';
        } finally {
          this.isUpdatingOrder = false;
        }
      }
    }`}
  >
    <!-- Breadcrumb (Thu nhỏ padding & font) -->
    <nav class="flex items-center gap-1.5 text-2xs font-semibold text-brand-muted mb-2 shrink-0" aria-label="Breadcrumb">
      <a href="/" class="hover:text-brand-primary transition">Trang chủ</a>
      <span>/</span>
      <a href="/gio-hang" class="hover:text-brand-primary transition">Giỏ hàng</a>
      <span>/</span>
      <span class="text-brand-dark">Xác nhận & Thanh toán</span>
    </nav>

    <!-- SUCCESS CONFIRMATION STATE (CHUYÊN NGHIỆP & CÂN ĐỐI) -->
    <template x-if="orderCompleted && createdOrder">
      <div class="flex-1 flex flex-col gap-3 lg:gap-4 animate-fade-in pb-2">
        
        <!-- A. HEADER & HERO TRẠNG THÁI ĐƠN HÀNG (TINH GỌN 1 HÀNG) -->
        <div class="p-3.5 sm:p-4 rounded-xl bg-white border border-brand-border shadow-soft flex flex-wrap items-center justify-between gap-3 shrink-0">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0 border border-emerald-200 shadow-2xs">
              <svg class="w-5 h-5 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <div>
              <div class="flex items-center gap-2 flex-wrap">
                <h1 class="text-base sm:text-lg font-black text-brand-dark tracking-tight">
                  Đặt hàng thành công
                </h1>
                <span class="px-2 py-0.5 rounded-full text-3xs font-extrabold bg-amber-50 text-amber-800 border border-amber-200">
                  Chờ xác nhận
                </span>
              </div>
              <p class="text-2xs text-brand-muted">
                Thời gian đặt: <span class="font-medium text-brand-dark" x-text="formatDate(createdOrder.date_order || createdOrder.created_at)"></span>
              </p>
            </div>
          </div>

          <!-- Mã đơn hàng nổi bật & Sao chép (gọn gàng) -->
          <div class="flex items-center gap-2.5 bg-brand-surface py-1.5 px-3 rounded-xl border border-brand-border shrink-0 ml-auto sm:ml-0">
            <div class="text-right sm:text-left">
              <span class="text-3xs font-bold uppercase tracking-wider text-brand-muted block leading-none">Mã đơn hàng</span>
              <span class="font-mono text-sm sm:text-base font-black text-brand-primary leading-tight" x-text="createdOrder.order_code"></span>
            </div>
            <button
              type="button"
              @click="copyToClipboard(createdOrder.order_code, 'code')"
              class="px-2.5 py-1.5 rounded-lg bg-white hover:bg-brand-sand border border-brand-border text-brand-dark text-2xs font-bold transition flex items-center gap-1 cursor-pointer shadow-2xs"
            >
              <svg class="w-3.5 h-3.5 text-brand-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <span x-text="copiedCode ? '✓ Đã chép' : 'Sao chép'"></span>
            </button>
          </div>
        </div>

        <!-- B & C: THÔNG TIN CHI TIẾT ĐƠN HÀNG & THÔNG TIN GIAO HÀNG (2 CỘT TỰ CO GIÃN THEO CHIỀU CAO) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-3 lg:gap-4 flex-1 min-h-0 items-stretch">
          
          <!-- CỘT TRÁI: DANH SÁCH SẢN PHẨM (8 CỘT LG - CUỘN NỘI BỘ MẢNH) -->
          <div class="lg:col-span-8 bg-white rounded-xl border border-brand-border shadow-soft p-3.5 sm:p-4 flex flex-col min-h-0">
            
            <div class="flex items-center justify-between pb-2 border-b border-brand-border/60 shrink-0">
              <h2 class="text-xs sm:text-sm font-extrabold text-brand-dark flex items-center gap-1.5">
                <svg class="w-4 h-4 text-brand-primary fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                </svg>
                <span>Sản phẩm trong đơn hàng</span>
              </h2>
              <span class="text-2xs font-bold text-brand-muted" x-text="(createdOrder.items || []).length + ' dòng sản phẩm'"></span>
            </div>

            <!-- Bảng danh sách sản phẩm chi tiết (Có flex-1 min-h-0 overflow-y-auto cuộn mượt nội bộ) -->
            <div class="flex-1 min-h-0 overflow-y-auto custom-scrollbar my-2 pr-1">
              <table class="w-full text-left text-xs">
                <thead class="sticky top-0 bg-white z-10">
                  <tr class="border-b border-brand-border/80 text-brand-muted font-bold text-2xs uppercase">
                    <th class="py-1.5 pr-2">Sản phẩm</th>
                    <th class="py-1.5 px-2 text-center">SKU</th>
                    <th class="py-1.5 px-2 text-right">Đơn giá</th>
                    <th class="py-1.5 px-2 text-center">SL</th>
                    <th class="py-1.5 pl-2 text-right">Thành tiền</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-brand-border/40">
                  <template x-for="item in createdOrder.items" :key="item.sku || item.id">
                    <tr class="hover:bg-brand-surface/60 transition">
                      <td class="py-2 pr-2">
                        <div class="flex items-center gap-2">
                          <img
                            :src="item.image_url || '/images/placeholder-product.svg'"
                            :alt="item.name"
                            class="w-9 h-9 rounded-lg object-contain bg-brand-surface border border-brand-border p-0.5 shrink-0"
                            onerror="this.onerror=null; this.src='/images/placeholder-product.svg';"
                          />
                          <div class="min-w-0">
                            <p class="font-bold text-brand-dark text-xs truncate max-w-[200px] sm:max-w-xs" x-text="item.name"></p>
                          </div>
                        </div>
                      </td>
                      <td class="py-2 px-2 text-center font-mono font-bold text-2xs text-brand-muted" x-text="item.sku"></td>
                      <td class="py-2 px-2 text-right text-brand-dark text-2xs" x-text="formatVND(item.price_unit)"></td>
                      <td class="py-2 px-2 text-center font-bold text-brand-dark text-xs" x-text="item.quantity"></td>
                      <td class="py-2 pl-2 text-right font-extrabold text-brand-primary text-xs" x-text="formatVND(item.price_total || (item.price_unit * item.quantity))"></td>
                    </tr>
                  </template>
                </tbody>
              </table>
            </div>

            <!-- Tổng kết tiền hàng (Cố định ở đáy card sản phẩm) -->
            <div class="pt-2 border-t border-brand-border space-y-1.5 shrink-0 max-w-sm ml-auto w-full text-xs">
              <div class="flex justify-between text-brand-muted text-2xs">
                <span>Tổng tiền hàng:</span>
                <span class="font-bold text-brand-dark" x-text="formatVND(createdOrder.amount_untaxed || createdOrder.amount_total)"></span>
              </div>
              <template x-if="createdOrder.amount_discount && Number(createdOrder.amount_discount) > 0">
                <div class="flex justify-between text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 text-2xs">
                  <span>Chiết khấu B2B:</span>
                  <span class="font-bold" x-text="'-' + formatVND(createdOrder.amount_discount)"></span>
                </div>
              </template>
              <div class="flex justify-between text-brand-muted text-2xs">
                <span>Phí vận chuyển:</span>
                <span class="font-bold text-emerald-600">Miễn phí giao hàng B2B</span>
              </div>
              <div class="pt-1.5 border-t border-brand-border flex justify-between items-baseline">
                <span class="text-xs font-black text-brand-dark">Tổng thanh toán:</span>
                <span class="text-base sm:text-lg font-black text-brand-primary" x-text="formatVND(createdOrder.amount_total)"></span>
              </div>
            </div>

          </div>

          <!-- CỘT PHẢI: THÔNG TIN GIAO HÀNG & PHƯƠNG THỨC THANH TOÁN (4 CỘT LG - COMPACT) -->
          <div class="lg:col-span-4 flex flex-col gap-2.5 lg:gap-3 min-h-0 justify-between">
            
            <!-- THÔNG TIN NGƯỜI NHẬN -->
            <div class="bg-white rounded-xl border border-brand-border shadow-soft p-3 sm:p-3.5 space-y-2 shrink-0">
              <div class="flex items-center justify-between pb-1.5 border-b border-brand-border/60">
                <h3 class="text-xs font-extrabold text-brand-dark flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-brand-primary fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                  <span>Thông tin nhận hàng</span>
                </h3>
              </div>
              <div class="text-2xs space-y-1.5 text-brand-text">
                <div class="flex items-center justify-between">
                  <span class="text-brand-muted">Người nhận:</span>
                  <p class="font-bold text-brand-dark" x-text="createdOrder.recipient_name"></p>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-brand-muted">Điện thoại:</span>
                  <p class="font-mono font-bold text-brand-dark" x-text="createdOrder.recipient_phone"></p>
                </div>
                <div>
                  <span class="text-brand-muted block">Địa chỉ giao:</span>
                  <p class="text-brand-dark leading-tight mt-0.5 line-clamp-2" x-text="createdOrder.delivery_address"></p>
                </div>
                <template x-if="createdOrder.notes">
                  <div class="pt-0.5">
                    <span class="text-brand-muted text-3xs">Ghi chú:</span>
                    <p class="text-brand-dark italic bg-brand-surface px-2 py-1 rounded border border-brand-border text-3xs mt-0.5 line-clamp-2" x-text="createdOrder.notes"></p>
                  </div>
                </template>
              </div>
            </div>

            <!-- PHƯƠNG THỨC THANH TOÁN -->
            <div class="bg-white rounded-xl border border-brand-border shadow-soft p-3 sm:p-3.5 space-y-2 shrink-0">
              <div class="flex items-center justify-between pb-1.5 border-b border-brand-border/60">
                <h3 class="text-xs font-extrabold text-brand-dark flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-brand-primary fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
                  </svg>
                  <span>Phương thức thanh toán</span>
                </h3>
                <span
                  class="px-2 py-0.5 rounded-full text-3xs font-bold"
                  :class="createdOrder.payment_status === 'paid' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-slate-100 text-slate-700'"
                  x-text="createdOrder.payment_status === 'paid' ? 'Đã thanh toán' : 'Chờ thanh toán'"
                ></span>
              </div>

              <!-- Chi tiết VNPAY -->
              <template x-if="createdOrder.payment_method === 'vnpay'">
                <div class="space-y-2 text-2xs">
                  <div class="p-2.5 bg-blue-50/70 border border-blue-200 rounded-lg space-y-1.5">
                    <div class="flex items-center justify-between">
                      <span class="font-extrabold text-blue-900 text-xs">Cổng VNPAY</span>
                      <span class="text-3xs font-bold bg-blue-100 text-blue-800 px-1.5 py-0.2 rounded">QR / ATM</span>
                    </div>
                    <p class="text-blue-800 leading-tight">
                      Đơn hàng đã được lưu. Nếu chưa thanh toán, bạn có thể thực hiện thanh toán trực tuyến ngay.
                    </p>
                    <button
                      type="button"
                      @click="payWithVnpay(createdOrder.order_code, createdOrder.amount_total)"
                      :disabled="isRedirectingToVnpay"
                      class="w-full py-1.5 px-2.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-bold text-2xs uppercase tracking-wider transition shadow-2xs flex items-center justify-center gap-1.5 cursor-pointer disabled:opacity-50"
                    >
                      <span x-show="isRedirectingToVnpay" class="w-3 h-3 rounded-full border-2 border-white border-t-transparent animate-spin inline-block"></span>
                      <span x-text="isRedirectingToVnpay ? 'Đang kết nối...' : 'Thanh toán ngay qua VNPAY'"></span>
                    </button>
                  </div>
                </div>
              </template>

              <!-- Chi tiết COD -->
              <template x-if="createdOrder.payment_method === 'cod'">
                <div class="text-2xs">
                  <div class="p-2.5 bg-brand-surface rounded-lg border border-brand-border space-y-0.5">
                    <span class="font-bold text-brand-dark block text-xs">Tiền mặt khi nhận hàng (COD)</span>
                    <p class="text-brand-muted text-3xs">Số tiền cần thanh toán:</p>
                    <p class="text-sm font-black text-brand-primary" x-text="formatVND(createdOrder.amount_total)"></p>
                  </div>
                </div>
              </template>

              <!-- Chi tiết Chuyển khoản ngân hàng -->
              <template x-if="createdOrder.payment_method === 'bank_transfer'">
                <div class="text-2xs">
                  <div class="p-2 bg-brand-surface rounded-lg border border-brand-border space-y-0.5">
                    <span class="font-bold text-brand-dark block">Chuyển khoản B2B</span>
                    <p class="text-3xs text-brand-muted">Nội dung CK: <strong class="text-brand-dark" x-text="createdOrder.order_code"></strong></p>
                  </div>
                </div>
              </template>
            </div>

            <!-- E. CÁC THAO TÁC SAU KHI ĐẶT HÀNG (CỐ ĐỊNH TRONG VIEWPORT) -->
            <div class="bg-white rounded-xl border border-brand-border shadow-soft p-3 sm:p-3.5 space-y-2 shrink-0">
              <span class="text-3xs font-extrabold text-brand-muted block uppercase tracking-wider">Thao tác</span>
              <div class="flex flex-col gap-1.5">
                
                <!-- Nút 1: Chỉnh sửa đơn hàng (chỉ khi draft) -->
                <button
                  type="button"
                  @click="openEditModal()"
                  class="w-full py-2 px-3 rounded-xl border border-brand-primary text-brand-primary hover:bg-brand-primary/5 font-bold text-2xs uppercase tracking-wider transition flex items-center justify-center gap-1.5 cursor-pointer shadow-2xs"
                >
                  <svg class="w-3.5 h-3.5 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                  </svg>
                  <span>Chỉnh sửa đơn hàng</span>
                </button>

                <!-- Nút 2: Xem chi tiết đơn hàng (lịch sử đơn hàng) -->
                <a
                  href="/tai-khoan/don-hang"
                  class="w-full py-2 px-3 rounded-xl bg-brand-primary hover:bg-brand-primary/90 text-white font-bold text-2xs uppercase tracking-wider transition flex items-center justify-center gap-1.5 shadow-2xs text-center"
                >
                  <svg class="w-3.5 h-3.5 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                  </svg>
                  <span>Xem danh sách đơn hàng</span>
                </a>

                <!-- Nút 3: Tiếp tục mua hàng -->
                <a
                  href="/san-pham"
                  class="w-full py-1.5 px-3 rounded-xl border border-brand-border bg-brand-surface hover:bg-brand-sand text-brand-dark font-bold text-2xs uppercase tracking-wider transition text-center"
                >
                  Tiếp tục mua hàng
                </a>
              </div>
            </div>

          </div>

        </div>

        <!-- MODAL CHỈNH SỬA ĐƠN HÀNG -->
        <div
          x-show="isEditModalOpen"
          x-cloak
          class="fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4"
          @keydown.escape.window="closeEditModal()"
        >
          <div
            @click.away="closeEditModal()"
            class="bg-white rounded-3xl border border-brand-border shadow-modal max-w-2xl w-full p-6 sm:p-8 space-y-6 animate-fade-in relative max-h-[90vh] flex flex-col"
          >
            <!-- Modal Header -->
            <div class="flex items-center justify-between pb-4 border-b border-brand-border/80 shrink-0">
              <div>
                <h3 class="text-lg font-black text-brand-dark">Chỉnh sửa đơn hàng <span class="text-brand-primary font-mono" x-text="'#' + createdOrder.order_code"></span></h3>
                <p class="text-xs text-brand-muted mt-0.5">Cập nhật số lượng sản phẩm, người nhận hoặc địa chỉ giao hàng.</p>
              </div>
              <button
                type="button"
                @click="closeEditModal()"
                class="w-8 h-8 rounded-full bg-brand-surface hover:bg-brand-sand text-brand-muted hover:text-brand-dark flex items-center justify-center text-sm font-bold transition cursor-pointer"
              >
                ✕
              </button>
            </div>

            <!-- Modal Messages -->
            <div x-show="editErrorMessage" x-text="editErrorMessage" class="p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-xs font-semibold shrink-0"></div>
            <div x-show="editSuccessMessage" x-text="editSuccessMessage" class="p-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs font-semibold shrink-0"></div>

            <!-- Modal Body (Scrollable) -->
            <div class="space-y-6 overflow-y-auto custom-scrollbar pr-1 flex-1">
              
              <!-- 1. Danh sách sản phẩm & Thay đổi số lượng -->
              <div class="space-y-3">
                <span class="text-xs font-extrabold text-brand-dark block">Danh sách sản phẩm</span>
                <div class="divide-y divide-brand-border/60 border border-brand-border rounded-2xl p-3 bg-brand-surface/40">
                  <template x-for="(item, idx) in editForm.items" :key="item.sku || idx">
                    <div class="py-2.5 first:pt-0 last:pb-0 flex items-center justify-between gap-3 text-xs">
                      <div class="flex-1 min-w-0">
                        <p class="font-bold text-brand-dark truncate" x-text="item.name"></p>
                        <p class="text-2xs text-brand-muted mt-0.5" x-text="'SKU: ' + item.sku + ' • ' + formatVND(item.price_unit)"></p>
                      </div>
                      
                      <!-- Quantity stepper -->
                      <div class="flex items-center gap-1.5 shrink-0">
                        <button
                          type="button"
                          @click="updateItemQty(idx, -1)"
                          class="w-7 h-7 rounded-lg border border-brand-border bg-white hover:bg-brand-sand flex items-center justify-center text-xs font-bold text-brand-dark cursor-pointer transition"
                        >
                          -
                        </button>
                        <span class="w-8 text-center font-bold text-brand-dark" x-text="item.quantity"></span>
                        <button
                          type="button"
                          @click="updateItemQty(idx, 1)"
                          class="w-7 h-7 rounded-lg border border-brand-border bg-white hover:bg-brand-sand flex items-center justify-center text-xs font-bold text-brand-dark cursor-pointer transition"
                        >
                          +
                        </button>
                        <button
                          type="button"
                          @click="removeItem(idx)"
                          title="Xóa sản phẩm"
                          class="w-7 h-7 rounded-lg text-rose-500 hover:bg-rose-50 flex items-center justify-center text-xs font-bold ml-1 cursor-pointer transition"
                        >
                          ✕
                        </button>
                      </div>

                      <span class="font-bold text-brand-dark w-24 text-right shrink-0" x-text="formatVND(item.quantity * item.price_unit)"></span>
                    </div>
                  </template>
                </div>
                
                <div class="flex justify-between items-center text-xs px-1">
                  <span class="text-brand-muted">Tổng tiền tạm tính lại:</span>
                  <span class="text-sm font-black text-brand-primary" x-text="formatVND(editSubtotal)"></span>
                </div>
              </div>

              <!-- 2. Thông tin nhận hàng -->
              <div class="space-y-4 pt-2 border-t border-brand-border/60">
                <span class="text-xs font-extrabold text-brand-dark block">Thông tin giao nhận</span>
                
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label class="block text-2xs font-bold uppercase text-brand-muted mb-1">Tên người nhận</label>
                    <input
                      type="text"
                      x-model="editForm.recipient_name"
                      class="w-full px-3.5 py-2.5 rounded-xl border border-brand-border bg-white text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-brand-primary/30"
                    />
                  </div>
                  <div>
                    <label class="block text-2xs font-bold uppercase text-brand-muted mb-1">Số điện thoại</label>
                    <input
                      type="text"
                      x-model="editForm.recipient_phone"
                      class="w-full px-3.5 py-2.5 rounded-xl border border-brand-border bg-white text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-brand-primary/30"
                    />
                  </div>
                </div>

                <div>
                  <label class="block text-2xs font-bold uppercase text-brand-muted mb-1">Địa chỉ giao hàng</label>
                  <input
                    type="text"
                    x-model="editForm.shipping_address"
                    class="w-full px-3.5 py-2.5 rounded-xl border border-brand-border bg-white text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-brand-primary/30"
                  />
                </div>

                <div>
                  <label class="block text-2xs font-bold uppercase text-brand-muted mb-1">Ghi chú đơn hàng</label>
                  <textarea
                    rows="2"
                    x-model="editForm.note"
                    class="w-full px-3.5 py-2 rounded-xl border border-brand-border bg-white text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-brand-primary/30"
                  ></textarea>
                </div>
              </div>

            </div>

            <!-- Modal Footer -->
            <div class="pt-4 border-t border-brand-border/80 flex items-center justify-end gap-3 shrink-0">
              <button
                type="button"
                @click="closeEditModal()"
                class="px-5 py-2.5 rounded-xl border border-brand-border hover:bg-brand-sand text-xs font-bold text-brand-dark transition cursor-pointer"
              >
                Hủy bỏ
              </button>
              <button
                type="button"
                @click="handleSaveOrderEdit()"
                :disabled="isUpdatingOrder"
                class="px-6 py-2.5 rounded-xl bg-brand-primary hover:bg-brand-primary/90 text-white text-xs font-bold uppercase tracking-wider transition shadow-2xs flex items-center gap-2 cursor-pointer disabled:opacity-50"
              >
                <span x-show="isUpdatingOrder" class="w-3.5 h-3.5 rounded-full border-2 border-white border-t-transparent animate-spin inline-block"></span>
                <span x-text="isUpdatingOrder ? 'Đang lưu...' : 'Xác nhận cập nhật'"></span>
              </button>
            </div>

          </div>
        </div>

      </div>
    </template>

    <!-- CHECKOUT FORM VIEW (TỰ CO GIÃN THEO VIEWPORT TRÊN DESKTOP) -->
    <template x-if="!orderCompleted">
      <div class="flex-1 flex flex-col justify-start pb-2">
        
        <!-- Page Title & Header (Compact) -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-brand-border/60 mb-3.5 shrink-0">
          <div>
            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-3xs font-bold bg-brand-primary/10 text-brand-primary mb-1">
              <svg class="w-3 h-3 text-brand-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M9 8h1m4 0h1m-5 4h1m4 0h1m-5 4h1m4 0h1M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16"/></svg>
              <span>Kênh B2B Đại lý • Mã: <span x-text="partner.ref"></span></span>
            </div>
            <h1 class="text-lg sm:text-xl font-black text-brand-dark tracking-tight leading-tight">
              Xác nhận Đơn hàng & Thanh toán
            </h1>
          </div>

          <a
            href="/gio-hang"
            class="inline-flex items-center gap-1 text-2xs font-bold text-brand-primary hover:text-brand-primary/80 transition"
          >
            ← Quay lại giỏ hàng
          </a>
        </div>

        <!-- Global Error Notification -->
        <div
          x-show="errorMessage"
          x-text="errorMessage"
          x-cloak
          class="mb-3 p-3 bg-rose-50 text-rose-700 text-xs font-semibold rounded-xl border border-rose-200 shrink-0"
        ></div>

        <!-- EMPTY CART WARNING -->
        <div x-show="!isLoading && cart.length === 0" x-cloak class="p-8 text-center bg-white rounded-2xl border border-brand-border space-y-4 shadow-soft">
          <p class="text-brand-muted text-sm font-medium">Giỏ hàng của bạn đang trống. Vui lòng thêm sản phẩm trước khi thanh toán.</p>
          <a
            href="/san-pham"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-brand-primary text-white font-bold text-xs uppercase tracking-wider hover:bg-brand-primary/90 transition shadow-soft"
          >
            Khám phá sản phẩm
          </a>
        </div>

        <!-- CHECKOUT GRID (FORM + SUMMARY: FIT CHIỀU CAO TRÊN DESKTOP) -->
        <form
          x-show="!isLoading && cart.length > 0"
          @submit.prevent="handleSubmitOrder()"
          @keydown.enter="if ($event.target.tagName !== 'TEXTAREA') { $event.preventDefault(); }"
          class="grid grid-cols-1 lg:grid-cols-12 gap-3 lg:gap-4 flex-1 min-h-0 items-stretch"
        >
          
          <!-- LEFT COLUMN: DELIVERY INFO & PAYMENT METHODS (7 COLS - CUỘN NỘI BỘ NẾU MÀN HÌNH THẤP) -->
          <div class="lg:col-span-7 flex flex-col gap-3 min-h-0 overflow-y-auto custom-scrollbar pr-1">
            
            <!-- 1. THÔNG TIN ĐẠI LÝ & NGƯỜI NHẬN -->
            <section class="p-3.5 sm:p-4 rounded-xl bg-white border border-brand-border shadow-soft space-y-3 shrink-0">
              <div class="flex items-center justify-between pb-2 border-b border-brand-border/60">
                <h2 class="text-xs sm:text-sm font-extrabold text-brand-dark flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-brand-primary fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                  </svg>
                  <span>Thông tin Nhận hàng</span>
                </h2>
                <span class="text-3xs font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">
                  Đại lý xác thực
                </span>
              </div>

              <!-- Address Mode Selection Tabs -->
              <div class="flex items-center gap-2">
                <button
                  type="button"
                  @click="addressMode = 'saved'"
                  :class="addressMode === 'saved' ? 'bg-brand-dark text-white shadow-soft' : 'bg-brand-surface text-brand-muted hover:text-brand-dark border border-brand-border'"
                  class="px-3 py-1.5 rounded-lg text-2xs font-bold transition flex items-center gap-1 cursor-pointer"
                >
                  <span>Sổ địa chỉ</span>
                  <span class="text-3xs px-1 py-0.2 rounded-full bg-white/20" x-text="partner.deliveryAddresses.length"></span>
                </button>
                <button
                  type="button"
                  @click="addressMode = 'custom'"
                  :class="addressMode === 'custom' ? 'bg-brand-dark text-white shadow-soft' : 'bg-brand-surface text-brand-muted hover:text-brand-dark border border-brand-border'"
                  class="px-3 py-1.5 rounded-lg text-2xs font-bold transition flex items-center gap-1 cursor-pointer"
                >
                  <span>+ Địa chỉ khác</span>
                </button>
              </div>

              <!-- Recipient Inputs -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                <div>
                  <label class="block text-3xs font-bold uppercase tracking-wider text-brand-muted mb-1">
                    Họ &amp; Tên người nhận <span class="text-rose-500">*</span>
                  </label>
                  <input
                    type="text"
                    x-model="recipientName"
                    required
                    class="w-full px-3 py-2 rounded-lg border border-brand-border bg-brand-surface/50 text-xs font-bold text-brand-dark focus:bg-white focus:outline-none focus:ring-1 focus:ring-brand-primary transition"
                    placeholder="Nguyễn Văn A"
                  />
                </div>
                <div>
                  <label class="block text-3xs font-bold uppercase tracking-wider text-brand-muted mb-1">
                    Số điện thoại nhận hàng <span class="text-rose-500">*</span>
                  </label>
                  <input
                    type="tel"
                    x-model="recipientPhone"
                    required
                    class="w-full px-3 py-2 rounded-lg border border-brand-border bg-brand-surface/50 text-xs font-bold text-brand-dark focus:bg-white focus:outline-none focus:ring-1 focus:ring-brand-primary transition font-mono"
                    placeholder="0909 203 166"
                  />
                </div>
              </div>

              <!-- Mode 1: Saved Addresses dropdown -->
              <div x-show="addressMode === 'saved'" class="space-y-1.5">
                <template x-if="partner.deliveryAddresses && partner.deliveryAddresses.length > 0">
                  <div class="space-y-1.5 max-h-32 overflow-y-auto custom-scrollbar">
                    <template x-for="addr in partner.deliveryAddresses" :key="addr.id">
                      <label
                        :class="String(selectedSavedAddressId) === String(addr.id) ? 'border-brand-primary bg-brand-primary/5 ring-1 ring-brand-primary' : 'border-brand-border bg-white hover:bg-brand-sand'"
                        class="p-2.5 rounded-lg border flex items-start gap-2 cursor-pointer transition block"
                      >
                        <input
                          type="radio"
                          name="saved_addr"
                          :value="String(addr.id)"
                          x-model="selectedSavedAddressId"
                          class="mt-0.5 accent-brand-primary"
                        />
                        <div class="text-2xs space-y-0.5 flex-1 min-w-0">
                          <div class="flex items-center gap-1.5">
                            <span class="font-extrabold text-brand-dark truncate" x-text="addr.name"></span>
                            <span x-show="addr.is_default" class="px-1.5 py-0.2 rounded text-3xs font-extrabold bg-brand-primary/10 text-brand-primary">Mặc định</span>
                          </div>
                          <p class="text-brand-muted truncate" x-text="addr.street"></p>
                        </div>
                      </label>
                    </template>
                  </div>
                </template>
                <template x-if="!partner.deliveryAddresses || partner.deliveryAddresses.length === 0">
                  <div class="p-2.5 rounded-lg bg-brand-sand/50 border border-brand-border text-2xs text-brand-muted">
                    <p>Địa chỉ kho chính: <strong class="text-brand-dark" x-text="partner.address"></strong></p>
                  </div>
                </template>
              </div>

              <!-- Mode 2: Custom Address -->
              <div x-show="addressMode === 'custom'" class="space-y-2">
                <input
                  type="text"
                  x-model="customAddress"
                  class="w-full px-3 py-2 rounded-lg border border-brand-border bg-brand-surface/50 text-xs font-bold text-brand-dark focus:bg-white focus:outline-none focus:ring-1 focus:ring-brand-primary transition"
                  placeholder="Số nhà, Tên đường, Phường/Xã, Quận/Huyện, Tỉnh/Thành phố..."
                />
                <label class="flex items-center gap-1.5 text-2xs text-brand-muted cursor-pointer">
                  <input type="checkbox" x-model="saveCustomAddress" class="rounded accent-brand-primary" />
                  <span>Lưu địa chỉ này vào danh bạ sổ địa chỉ đại lý</span>
                </label>
              </div>

              <!-- Order Note -->
              <div>
                <label class="block text-3xs font-bold uppercase tracking-wider text-brand-muted mb-1">
                  Ghi chú đơn hàng
                </label>
                <input
                  type="text"
                  x-model="orderNote"
                  placeholder="Ví dụ: Giao giờ hành chính, gọi trước 15 phút..."
                  class="w-full px-3 py-1.5 rounded-lg border border-brand-border bg-brand-surface/50 text-xs font-medium text-brand-dark focus:bg-white focus:outline-none focus:ring-1 focus:ring-brand-primary transition"
                />
              </div>

            </section>

            <!-- 2. PHƯƠNG THỨC THANH TOÁN -->
            <section class="p-3.5 sm:p-4 rounded-xl bg-white border border-brand-border shadow-soft space-y-2 shrink-0">
              <div class="flex items-center justify-between pb-1.5 border-b border-brand-border/60">
                <h2 class="text-xs sm:text-sm font-extrabold text-brand-dark flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-brand-primary fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
                  </svg>
                  <span>Phương thức thanh toán</span>
                </h2>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                
                <!-- Option 1: VNPAY -->
                <label
                  :class="paymentMethod === 'vnpay' ? 'border-brand-primary bg-brand-primary/5 ring-1 ring-brand-primary' : 'border-brand-border bg-white hover:bg-brand-sand'"
                  class="p-2.5 rounded-lg border flex items-start gap-2 cursor-pointer transition block"
                >
                  <input type="radio" name="payment_method" value="vnpay" x-model="paymentMethod" class="mt-0.5 accent-brand-primary" />
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-1">
                      <span class="font-black text-xs text-[#005baa]">VNPAY</span>
                      <span class="font-bold text-2xs text-brand-dark truncate">Trực tuyến (QR/ATM)</span>
                    </div>
                    <p class="text-3xs text-brand-muted mt-0.5 leading-tight">Thanh toán bảo mật tức thời qua VNPAY.</p>
                  </div>
                </label>

                <!-- Option 2: COD -->
                <label
                  :class="paymentMethod === 'cod' ? 'border-brand-primary bg-brand-primary/5 ring-1 ring-brand-primary' : 'border-brand-border bg-white hover:bg-brand-sand'"
                  class="p-2.5 rounded-lg border flex items-start gap-2 cursor-pointer transition block"
                >
                  <input type="radio" name="payment_method" value="cod" x-model="paymentMethod" class="mt-0.5 accent-brand-primary" />
                  <div class="flex-1 min-w-0">
                    <span class="font-bold text-xs text-brand-dark block">Tiền mặt (COD)</span>
                    <p class="text-3xs text-brand-muted mt-0.5 leading-tight">Thanh toán khi nhận và kiểm tra hàng.</p>
                  </div>
                </label>

              </div>
            </section>

          </div>

          <!-- RIGHT COLUMN: ORDER SUMMARY & SUBMIT (5 COLS: COMPACT VỪA VẶN MÀN HÌNH) -->
          <aside class="lg:col-span-5 flex flex-col bg-white rounded-xl border border-brand-border shadow-soft p-4 sm:p-5 justify-between">
            
            <div class="flex items-center justify-between pb-2 border-b border-brand-border/60 shrink-0">
              <h2 class="text-xs sm:text-sm font-extrabold text-brand-dark">Chi tiết đơn hàng</h2>
              <span class="text-2xs font-bold text-brand-primary bg-brand-primary/10 px-2 py-0.5 rounded-full" x-text="totalQuantity + ' sản phẩm'"></span>
            </div>

            <!-- Product items mini list (Cuộn nội bộ mảnh) -->
            <div class="divide-y divide-brand-border/50 flex-1 min-h-0 overflow-y-auto custom-scrollbar my-2 pr-1">
              <template x-for="item in cart" :key="item.odoo_id">
                <div class="py-2 first:pt-0 last:pb-0 flex items-center gap-2 text-2xs">
                  <img
                    :src="item.image || '/images/placeholder-product.svg'"
                    :alt="item.name"
                    class="w-8 h-8 rounded-lg object-contain bg-brand-surface border border-brand-border p-0.5 shrink-0"
                    onerror="this.onerror=null; this.src='/images/placeholder-product.svg';"
                  />
                  <div class="flex-1 min-w-0">
                    <p class="font-bold text-brand-dark truncate" x-text="item.name"></p>
                    <p class="text-3xs text-brand-muted" x-text="'SL: ' + item.quantity + ' × ' + formatVND(item.wholesale_price || Math.round(item.price * 0.78))"></p>
                  </div>
                  <span class="font-extrabold text-brand-dark shrink-0" x-text="formatVND((item.wholesale_price || Math.round(item.price * 0.78)) * item.quantity)"></span>
                </div>
              </template>
            </div>

            <!-- Totals Breakdown & Submit Button -->
            <div class="pt-2 border-t border-brand-border/80 space-y-2 shrink-0 text-xs">
              <div class="flex justify-between text-brand-muted text-2xs">
                <span>Tổng tiền niêm yết:</span>
                <span class="font-bold text-brand-dark" x-text="formatVND(rawSubtotal)"></span>
              </div>

              <div class="flex justify-between text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 text-2xs">
                <span class="font-semibold">Chiết khấu Đại lý (-22%):</span>
                <span class="font-black" x-text="'-' + formatVND(wholesaleDiscount)"></span>
              </div>

              <div class="flex justify-between text-brand-muted text-2xs">
                <span>Phí giao hàng:</span>
                <span class="font-bold text-emerald-600">Miễn phí B2B</span>
              </div>

              <div class="pt-1.5 border-t border-brand-border flex justify-between items-baseline">
                <div>
                  <span class="text-xs font-black text-brand-dark block">Tổng thanh toán:</span>
                  <span class="text-3xs text-brand-muted block">(Đã gồm thuế GTGT)</span>
                </div>
                <span class="text-lg sm:text-xl font-black text-brand-primary" x-text="formatVND(finalTotal)"></span>
              </div>

              <!-- Submit Button -->
              <button
                type="button"
                @click="handleSubmitOrder()"
                :disabled="isSubmitting || cart.length === 0"
                class="w-full py-2.5 px-3 rounded-xl bg-brand-primary hover:bg-brand-primary/90 text-white font-black text-xs uppercase tracking-wider shadow-soft transition cursor-pointer disabled:opacity-50 flex items-center justify-center gap-1.5 group"
              >
                <span x-show="isSubmitting" class="w-3.5 h-3.5 rounded-full border-2 border-white border-t-transparent animate-spin inline-block"></span>
                <span x-text="isSubmitting ? 'ĐANG TẠO ĐƠN HÀNG...' : 'XÁC NHẬN ĐẶT HÀNG'"></span>
                <svg x-show="!isSubmitting" class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </button>

              <p class="text-[10px] text-brand-muted text-center leading-tight">
                Nhấn xác nhận để gửi đơn lên hệ sinh thái phân phối B2B của LA PET Store.
              </p>
            </div>

          </aside>

        </form>

      </div>
    </template>

  </div>
</BaseLayout>

---
// src/pages/auth/register.astro
export const prerender = false;

import AuthLayout from '@/layouts/AuthLayout.astro';

// Nếu đã đăng nhập thì tự động chuyển về trang tài khoản
const auth = Astro.locals.auth;
if (auth?.isAuthenticated) {
  return Astro.redirect('/tai-khoan');
}

const queryEmail = Astro.url.searchParams.get('email') || '';
---

<AuthLayout title="Đăng ký Đại lý B2B - LA PET Store">
  <div
    x-data="{
      name: '',
      phone: '',
      password: '',
      confirm_password: '',
      showPassword: false,
      store_name: '',
      business_model: '',
      city: '',
      email: '',
      note: '',
      _honey: '',
      isSubmitting: false,
      errorMessage: '',
      success: false,

      init() {
        try {
          const urlEmail = new URLSearchParams(window.location.search).get('email');
          const sessEmail = sessionStorage.getItem('dealer_reg_email');
          if (urlEmail || sessEmail) {
            this.email = urlEmail || sessEmail;
          }
        } catch (e) {}
      },

      validatePhone(p) {
        const cleaned = (p || '').replace(/[\s\-\.\(\)]/g, '');
        let normal = cleaned;
        if (normal.startsWith('+84')) normal = '0' + normal.slice(3);
        else if (normal.startsWith('84') && normal.length === 11) normal = '0' + normal.slice(2);
        return /^(0[35789])[0-9]{8}$/.test(normal);
      },

      async handleSubmit() {
        this.errorMessage = '';

        if (!this.name.trim() || this.name.trim().length < 2) {
          this.errorMessage = 'Vui lòng nhập Họ và tên người đại diện (tối thiểu 2 ký tự).';
          return;
        }

        if (!this.validatePhone(this.phone)) {
          this.errorMessage = 'Số điện thoại không hợp lệ. Vui lòng nhập số điện thoại Việt Nam (vd: 0909 203 166).';
          return;
        }

        if (!this.password || this.password.length < 6) {
          this.errorMessage = 'Vui lòng nhập Mật khẩu đăng nhập (tối thiểu 6 ký tự).';
          return;
        }

        if (this.password !== this.confirm_password) {
          this.errorMessage = 'Mật khẩu xác nhận không khớp. Vui lòng kiểm tra lại.';
          return;
        }

        if (!this.business_model) {
          this.errorMessage = 'Vui lòng chọn mô hình kinh doanh của bạn.';
          return;
        }

        if (this.email.trim() && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(this.email.trim())) {
          this.errorMessage = 'Địa chỉ email không đúng định dạng.';
          return;
        }

        this.isSubmitting = true;

        try {
          const res = await fetch('/api/dealers/register', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name: this.name.trim(),
              phone: this.phone.trim(),
              password: this.password,
              store_name: this.store_name.trim(),
              business_model: this.business_model,
              city: this.city.trim(),
              email: this.email.trim(),
              note: this.note.trim(),
              _honey: this._honey
            })
          });

          const data = await res.json();

          if (!res.ok || data.success === false) {
            throw new Error(data.error || data.message || 'Đăng ký không thành công. Vui lòng thử lại.');
          }

          try {
            sessionStorage.setItem('last_registered_phone', this.phone.trim());
          } catch (e) {}

          this.success = true;
        } catch (err) {
          this.errorMessage = err.message || 'Không thể kết nối đến máy chủ. Vui lòng thử lại sau.';
        } finally {
          this.isSubmitting = false;
        }
      }
    }"
    class="space-y-6"
  >
    <!-- SUCCESS STATE -->
    <template x-if="success">
      <div class="text-center py-4 space-y-4">
        <div class="w-16 h-16 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto shadow-soft">
          <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </div>
        <div class="space-y-1.5">
          <h2 class="text-xl font-extrabold text-brand-dark">Đăng ký Đại lý thành công!</h2>
          <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
            Cảm ơn quý đối tác đã đăng ký hợp tác cùng LA PET. Tài khoản đại lý của bạn đã sẵn sàng với mật khẩu vừa thiết lập. Bạn có thể đăng nhập ngay để xem báo giá sỉ và đặt hàng.
          </p>
        </div>

        <div class="p-4 rounded-xl bg-brand-sand/60 border border-brand-border text-xs text-brand-muted text-left space-y-2">
          <p class="font-bold text-brand-dark">Hotline hỗ trợ đối tác B2B:</p>
          <p class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-brand-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <span>Điện thoại: <a href="tel:0909203166" class="font-bold text-brand-primary hover:underline">0909 203 166</a> (Zalo B2B)</span>
          </p>
          <p class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-brand-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            <span>Email: <a href="mailto:contact@lapet.vn" class="font-bold text-brand-primary hover:underline">contact@lapet.vn</a></span>
          </p>
        </div>

        <div class="pt-2 flex flex-col sm:flex-row gap-2.5">
          <a
            href="/"
            class="flex-1 py-3 px-4 rounded-xl border border-brand-border bg-white hover:bg-brand-sand text-brand-dark font-bold text-xs uppercase tracking-wider transition text-center"
          >
            Về Trang Chủ
          </a>
          <a
            href="/auth/login"
            class="flex-1 py-3 px-4 rounded-xl bg-brand-primary hover:bg-brand-primary/90 text-white font-bold text-xs uppercase tracking-wider transition text-center shadow-soft"
          >
            Đăng Nhập Ngay
          </a>
        </div>
      </div>
    </template>

    <!-- FORM STATE -->
    <template x-if="!success">
      <div>
        <!-- Heading -->
        <div class="text-center mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-brand-primary/10 text-brand-primary mb-2">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <circle cx="12" cy="14" r="4"/>
              <circle cx="6.5" cy="8.5" r="2.5"/>
              <circle cx="17.5" cy="8.5" r="2.5"/>
              <circle cx="10" cy="4" r="2"/>
              <circle cx="14" cy="4" r="2"/>
            </svg>
            <span>Chính sách chiết khấu đến 22%</span>
          </span>
          <h1 class="text-xl sm:text-2xl font-black text-brand-dark tracking-tight">
            Đăng ký Đại lý B2B
          </h1>
          <p class="text-xs text-brand-muted mt-1 leading-relaxed">
            Hợp tác phân phối thức ăn, cát vệ sinh & phụ kiện thú cưng chính hãng cùng LA PET Store.
          </p>
        </div>

        <!-- Error Notification -->
        <div
          x-show="errorMessage"
          x-text="errorMessage"
          x-cloak
          class="mb-4 p-3 bg-rose-50 text-rose-600 text-xs font-semibold rounded-xl text-center border border-rose-200"
        ></div>

        <!-- Registration Form -->
        <form @submit.prevent="handleSubmit()" class="space-y-4">
          <!-- Honeypot anti-spam field -->
          <div style="display: none !important;" aria-hidden="true">
            <label for="reg-honey">Do not fill this field</label>
            <input
              type="text"
              id="reg-honey"
              name="_honey"
              x-model="_honey"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <!-- Name & Phone -->
          <div>
            <label for="reg-name" class="block text-xs font-bold uppercase tracking-wider text-brand-muted mb-1">
              Họ và tên người đại diện <span class="text-rose-500">*</span>
            </label>
            <input
              type="text"
              id="reg-name"
              x-model="name"
              required
              placeholder="Nguyễn Văn A"
              class="w-full px-3.5 py-2.5 rounded-xl border border-brand-border bg-brand-surface/50 text-sm text-brand-dark focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/10 transition"
            />
          </div>

          <div>
            <label for="reg-phone" class="block text-xs font-bold uppercase tracking-wider text-brand-muted mb-1">
              Số điện thoại liên hệ (Tên đăng nhập) <span class="text-rose-500">*</span>
            </label>
            <input
              type="tel"
              id="reg-phone"
              x-model="phone"
              required
              placeholder="0909 203 166"
              class="w-full px-3.5 py-2.5 rounded-xl border border-brand-border bg-brand-surface/50 text-sm text-brand-dark focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/10 transition"
            />
          </div>

          <!-- Mật khẩu & Xác nhận mật khẩu -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label for="reg-password" class="block text-xs font-bold uppercase tracking-wider text-brand-muted mb-1">
                Mật khẩu đăng nhập <span class="text-rose-500">*</span>
              </label>
              <div class="relative">
                <input
                  :type="showPassword ? 'text' : 'password'"
                  id="reg-password"
                  x-model="password"
                  required
                  minlength="6"
                  placeholder="Tối thiểu 6 ký tự"
                  class="w-full px-3.5 py-2.5 pr-10 rounded-xl border border-brand-border bg-brand-surface/50 text-sm text-brand-dark focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/10 transition"
                />
                <button
                  type="button"
                  @click="showPassword = !showPassword"
                  class="absolute right-2.5 top-1/2 -translate-y-1/2 text-brand-muted hover:text-brand-dark p-1 cursor-pointer transition"
                  :title="showPassword ? 'Ẩn mật khẩu' : 'Hiện mật khẩu'"
                >
                  <svg x-show="!showPassword" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
                    <circle cx="12" cy="12" r="3"/>
                  </svg>
                  <svg x-show="showPassword" x-cloak class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/>
                    <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/>
                    <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/>
                    <line x1="2" x2="22" y1="2" y2="22"/>
                  </svg>
                </button>
              </div>
            </div>

            <div>
              <label for="reg-confirm-password" class="block text-xs font-bold uppercase tracking-wider text-brand-muted mb-1">
                Xác nhận mật khẩu <span class="text-rose-500">*</span>
              </label>
              <div class="relative">
                <input
                  :type="showPassword ? 'text' : 'password'"
                  id="reg-confirm-password"
                  x-model="confirm_password"
                  required
                  minlength="6"
                  placeholder="Nhập lại mật khẩu"
                  class="w-full px-3.5 py-2.5 pr-10 rounded-xl border border-brand-border bg-brand-surface/50 text-sm text-brand-dark focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/10 transition"
                />
              </div>
            </div>
          </div>

          <!-- Store Name & Business Model -->
          <div>
            <label for="reg-store" class="block text-xs font-bold uppercase tracking-wider text-brand-muted mb-1">
              Tên Cửa hàng / Doanh nghiệp
            </label>
            <input
              type="text"
              id="reg-store"
              x-model="store_name"
              placeholder="Cửa hàng Thú cưng Pet Happy"
              class="w-full px-3.5 py-2.5 rounded-xl border border-brand-border bg-brand-surface/50 text-sm text-brand-dark focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/10 transition"
            />
          </div>

          <div>
            <label for="reg-model" class="block text-xs font-bold uppercase tracking-wider text-brand-muted mb-1">
              Mô hình kinh doanh <span class="text-rose-500">*</span>
            </label>
            <select
              id="reg-model"
              x-model="business_model"
              required
              class="w-full px-3.5 py-2.5 rounded-xl border border-brand-border bg-brand-surface/50 text-sm text-brand-dark focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/10 transition"
            >
              <option value="">-- Chọn mô hình kinh doanh --</option>
              <option value="Pet Shop Bán Lẻ">Pet Shop Bán Lẻ</option>
              <option value="Phòng Khám Thú Y / Thú Y">Phòng Khám Thú Y / Bác Sĩ Thú Y</option>
              <option value="Chuỗi Cửa Hàng Thú Cưng">Chuỗi Cửa Hàng Thú Cưng</option>
              <option value="Nhà Phân Phối / Đại Lý Khu Vực">Nhà Phân Phối / Đại Lý Khu Vực</option>
              <option value="Kinh Doanh Online / E-commerce">Kinh Doanh Online / E-commerce</option>
              <option value="Khác">Mô hình Khác</option>
            </select>
          </div>

          <!-- City & Email -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label for="reg-city" class="block text-xs font-bold uppercase tracking-wider text-brand-muted mb-1">
                Tỉnh / Thành phố
              </label>
              <input
                type="text"
                id="reg-city"
                x-model="city"
                placeholder="TP. Hồ Chí Minh"
                class="w-full px-3.5 py-2.5 rounded-xl border border-brand-border bg-brand-surface/50 text-sm text-brand-dark focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/10 transition"
              />
            </div>
            <div>
              <label for="reg-email" class="block text-xs font-bold uppercase tracking-wider text-brand-muted mb-1">
                Email
              </label>
              <input
                type="email"
                id="reg-email"
                x-model="email"
                value={queryEmail}
                placeholder="daily@example.com"
                class="w-full px-3.5 py-2.5 rounded-xl border border-brand-border bg-brand-surface/50 text-sm text-brand-dark focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/10 transition"
              />
            </div>
          </div>

          <!-- Note -->
          <div>
            <label for="reg-note" class="block text-xs font-bold uppercase tracking-wider text-brand-muted mb-1">
              Nhu cầu nhập hàng / Ghi chú
            </label>
            <textarea
              id="reg-note"
              x-model="note"
              rows="2"
              placeholder="Sản phẩm quan tâm (bánh thưởng, cát vệ sinh, que gặm...)"
              class="w-full px-3.5 py-2.5 rounded-xl border border-brand-border bg-brand-surface/50 text-sm text-brand-dark focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/10 transition"
            ></textarea>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            :disabled="isSubmitting"
            class="w-full py-3.5 px-4 rounded-xl bg-brand-primary hover:bg-brand-primary/90 text-white font-bold text-sm uppercase tracking-wider shadow-soft transition cursor-pointer disabled:opacity-50 flex items-center justify-center gap-2"
          >
            <span x-show="isSubmitting" class="w-4 h-4 rounded-full border-2 border-white border-t-transparent animate-spin inline-block"></span>
            <span x-text="isSubmitting ? 'ĐANG GỬI THÔNG TIN...' : 'GỬI ĐĂNG KÝ ĐẠI LÝ'"></span>
          </button>
        </form>

        <!-- Footer Link -->
        <div class="mt-6 pt-4 border-t border-brand-border/60 text-center text-xs text-brand-muted space-y-2">
          <p>
            Đã có tài khoản đại lý?{' '}
            <a href="/auth/login" class="font-bold text-brand-primary hover:underline">
              Đăng nhập ngay
            </a>
          </p>
          <p class="text-[11px] text-brand-muted/80">
            Thông tin của bạn được bảo mật tuyệt đối theo chính sách quyền riêng tư của LA PET.
          </p>
        </div>
      </div>
    </template>
  </div>
</AuthLayout>

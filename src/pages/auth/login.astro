---
// src/pages/auth/login.astro
export const prerender = false;

import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

// Nếu đã đăng nhập thì tự động chuyển về trang chủ
const auth = Astro.locals.auth;
if (auth?.isAuthenticated) {
  return Astro.redirect('/');
}
---

<!DOCTYPE html>
<html lang="vi" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Đăng nhập Đại lý - LA PET Store</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  
  <style>
    [x-cloak] { display: none !important; }
  </style>

  <!-- Script Alpine JS -->
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<body class="bg-[#faf9f6] text-[#083a3c] min-h-screen flex flex-col font-['Inter',sans-serif]">

  <Header />

  <main 
    x-data="{
      step: 1,
      identifier: '',
      otp: '',
      isLoading: false,
      errorMessage: '',
      successMessage: '',
      timer: 60,
      timerInterval: null,

      startTimer() {
        this.timer = 60;
        clearInterval(this.timerInterval);
        this.timerInterval = setInterval(() => {
          if (this.timer > 0) {
            this.timer--;
          } else {
            clearInterval(this.timerInterval);
          }
        }, 1000);
      },

      async handleSendOTP() {
        this.errorMessage = '';
        this.successMessage = '';

        const cleanIdentifier = (this.identifier || '').trim();
        if (!cleanIdentifier || cleanIdentifier.length < 5) {
          this.errorMessage = 'Vui lòng nhập Số điện thoại hoặc Email hợp lệ.';
          return;
        }

        this.isLoading = true;

        try {
          const res = await fetch('/api/auth/send-otp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ identifier: cleanIdentifier }),
          });

          const data = await res.json();

          if (!res.ok) {
            throw new Error(data.error || 'Gửi mã OTP thất bại.');
          }

          this.step = 2;
          this.otp = ''; // Reset OTP cũ khi gửi mã mới
          this.successMessage = data.message || 'Mã OTP đã được gửi thành công.';
          
          if (data.debug_otp) {
            console.log('[DEV DEBUG OTP]:', data.debug_otp);
          }

          this.startTimer();
          
          // Tự động focus vào ô nhập OTP
          this.$nextTick(() => {
            const otpInput = document.getElementById('otp');
            if (otpInput) otpInput.focus();
          });
        } catch (err) {
          this.errorMessage = err.message || 'Không thể kết nối đến máy chủ.';
        } finally {
          this.isLoading = false;
        }
      },

      async handleVerifyOTP() {
        this.errorMessage = '';
        this.successMessage = '';

        // Làm sạch mã OTP (chỉ giữ lại số)
        const cleanOtp = (this.otp || '').toString().replace(/\D/g, '').trim();

        if (!cleanOtp || cleanOtp.length !== 6) {
          this.errorMessage = 'Mã xác nhận phải gồm đúng 6 chữ số.';
          return;
        }

        this.isLoading = true;

        try {
          const res = await fetch('/api/auth/verify-otp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              identifier: this.identifier.trim(),
              otp: cleanOtp
            }),
          });

          const data = await res.json();

          if (!res.ok) {
            throw new Error(data.error || 'Xác thực OTP thất bại.');
          }

          // Đăng nhập thành công -> Điều hướng về trang chủ
          window.location.href = '/';
        } catch (err) {
          this.errorMessage = err.message || 'Không thể xác thực mã OTP.';
          this.isLoading = false;
        }
      },

      resetStep() {
        this.step = 1;
        this.otp = '';
        this.errorMessage = '';
        this.successMessage = '';
        clearInterval(this.timerInterval);
      }
    }"
    class="flex-grow flex items-center justify-center px-4 py-12"
  >
    <div class="w-full max-w-md bg-white rounded-3xl p-6 sm:p-8 shadow-xl border border-slate-100 relative overflow-hidden">
      
      <!-- Logo & Tiêu đề -->
      <div class="text-center mb-8">
        <a href="/" class="inline-block mb-3">
          <img src="/logo.webp" alt="LA PET" class="h-14 w-auto mx-auto object-contain" onerror="this.onerror=null; this.src='/favicon.svg';" />
        </a>
        <h1 class="text-xl sm:text-2xl font-extrabold text-[#083a3c]">Đăng nhập Đại lý</h1>
        <p class="text-xs sm:text-sm text-slate-500 font-medium mt-1" x-text="step === 1 ? 'Nhập Số điện thoại hoặc Email đã đăng ký với LA PET để nhận mã OTP' : 'Mã xác thực OTP đã được gửi tới email của tài khoản ' + identifier"></p>
      </div>

      <!-- Thông báo lỗi -->
      <div 
        x-show="errorMessage" 
        x-text="errorMessage" 
        x-cloak
        class="mb-4 p-3 bg-red-50 text-red-600 text-xs font-semibold rounded-xl text-center border border-red-100"
      ></div>

      <!-- Thông báo thành công -->
      <div 
        x-show="successMessage" 
        x-text="successMessage" 
        x-cloak
        class="mb-4 p-3 bg-emerald-50 text-emerald-700 text-xs font-semibold rounded-xl text-center border border-emerald-100"
      ></div>

      <!-- BƯỚC 1: NHẬP SỐ ĐIỆN THOẠI HOẶC EMAIL -->
      <form x-show="step === 1" @submit.prevent="handleSendOTP()" class="space-y-4">
        <div>
          <label for="identifier" class="block text-xs font-bold uppercase tracking-wider text-[#083a3c]/70 mb-2">Số điện thoại hoặc Email Đại lý</label>
          <input
            type="text"
            id="identifier"
            x-model="identifier"
            required
            placeholder="0909123456 hoặc daily@gmail.com"
            class="w-full px-4 py-3.5 rounded-2xl border border-slate-200 focus:border-[#23c1c6] focus:ring-2 focus:ring-[#23c1c6]/20 outline-none text-sm transition-all"
          />
        </div>

        <button 
          type="submit"
          :disabled="isLoading"
          class="w-full bg-[#083a3c] hover:bg-[#23c1c6] text-white font-bold text-sm py-3.5 px-4 rounded-full transition-all duration-200 flex items-center justify-center gap-2 shadow-md cursor-pointer disabled:opacity-50"
        >
          <span x-show="isLoading" class="animate-spin h-5 w-5 border-2 border-white border-t-transparent rounded-full inline-block"></span>
          <span>Nhận mã OTP qua Email</span>
        </button>
      </form>

      <!-- BƯỚC 2: NHẬP MÃ OTP -->
      <form x-show="step === 2" x-cloak @submit.prevent="handleVerifyOTP()" class="space-y-4">
        <div>
          <label for="otp" class="block text-xs font-bold uppercase tracking-wider text-[#083a3c]/70 mb-2 text-center">Mã xác thực OTP (6 số)</label>
          <input
            type="text"
            inputmode="numeric"
            pattern="[0-9]*"
            id="otp"
            x-model="otp"
            @input="otp = $event.target.value.replace(/\D/g, '')"
            maxlength="6"
            required
            placeholder="• • • • • •"
            class="w-full px-4 py-3 text-center text-2xl font-bold tracking-[0.4em] rounded-2xl border border-slate-200 focus:border-[#23c1c6] focus:ring-2 focus:ring-[#23c1c6]/20 outline-none transition-all"
          />
        </div>

        <button 
          type="submit"
          :disabled="isLoading"
          class="w-full bg-[#083a3c] hover:bg-[#23c1c6] text-white font-bold text-sm py-3.5 px-4 rounded-full transition-all duration-200 flex items-center justify-center gap-2 shadow-md cursor-pointer disabled:opacity-50"
        >
          <span x-show="isLoading" class="animate-spin h-5 w-5 border-2 border-white border-t-transparent rounded-full inline-block"></span>
          <span>Xác nhận Đăng nhập</span>
        </button>

        <div class="flex items-center justify-between text-xs pt-2">
          <button 
            type="button" 
            @click="resetStep()" 
            class="text-slate-500 hover:text-[#23c1c6] font-medium transition-colors"
          >
            ← Đổi thông tin
          </button>
          
          <button 
            type="button" 
            @click="handleSendOTP()" 
            :disabled="timer > 0 || isLoading"
            class="text-[#23c1c6] font-bold disabled:text-slate-400 disabled:cursor-not-allowed hover:underline"
          >
            <span x-text="timer > 0 ? `Gửi lại mã (${timer}s)` : 'Gửi lại mã OTP'"></span>
          </button>
        </div>
      </form>

      <p class="text-[#083a3c]/60 text-xs text-center font-medium mt-6">
        Bằng việc đăng nhập, bạn đồng ý với các điều khoản dành cho Đại lý của LA PET.
      </p>

    </div>
  </main>

  <Footer />

</body>
</html>
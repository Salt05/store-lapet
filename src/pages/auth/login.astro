---
// src/pages/auth/login.astro
export const prerender = false;

import AuthLayout from '@/layouts/AuthLayout.astro';

// Nếu đã đăng nhập thì tự động chuyển hướng
const auth = Astro.locals.auth;
const redirectParam = Astro.url.searchParams.get('redirect') || '/';

if (auth?.isAuthenticated) {
  return Astro.redirect(redirectParam);
}
---

<AuthLayout title="Đăng nhập Đại lý - LA PET Store">
  <div
    x-data={`{
      mode: 'password', // 'password' | 'otp'
      step: 1,
      identifier: '',
      password: '',
      showPassword: false,
      otp: '',
      redirectUrl: ${JSON.stringify(redirectParam)},
      isLoading: false,
      errorMessage: '',
      successMessage: '',
      timer: 60,
      timerInterval: null,

      init() {
        try {
          const prefill = new URLSearchParams(window.location.search).get('identifier') || sessionStorage.getItem('last_registered_phone');
          if (prefill) {
            this.identifier = prefill;
          }
        } catch (e) {}
      },

      switchMode(newMode) {
        this.mode = newMode;
        this.errorMessage = '';
        this.successMessage = '';
        if (newMode === 'otp') {
          this.step = 1;
        }
      },

      async handlePasswordLogin() {
        this.errorMessage = '';
        this.successMessage = '';

        const cleanIdentifier = (this.identifier || '').trim();
        const cleanPassword = (this.password || '').trim();

        if (!cleanIdentifier) {
          this.errorMessage = 'Vui lòng nhập Số điện thoại hoặc Email đại lý.';
          return;
        }

        if (!cleanPassword) {
          this.errorMessage = 'Vui lòng nhập Mật khẩu của bạn.';
          return;
        }

        this.isLoading = true;

        try {
          const res = await fetch('/api/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              identifier: cleanIdentifier,
              password: cleanPassword,
            }),
          });

          const data = await res.json();

          if (!res.ok || !data.success) {
            if (data.requireOtp) {
              this.errorMessage = data.error || 'Tài khoản chưa có mật khẩu.';
            } else {
              throw new Error(data.error || 'Đăng nhập không thành công.');
            }
            return;
          }

          this.successMessage = 'Đăng nhập thành công! Đang chuyển hướng...';
          window.dispatchEvent(new CustomEvent('auth-changed'));
          setTimeout(() => {
            window.location.href = this.redirectUrl || '/';
          }, 300);
        } catch (err) {
          this.errorMessage = err.message || 'Không thể kết nối đến máy chủ.';
        } finally {
          this.isLoading = false;
        }
      },

      startTimer() {
        this.timer = 60;
        clearInterval(this.timerInterval);
        this.timerInterval = setInterval(() => {
          if (this.timer > 0) {
            this.timer--;
          } else {
            clearInterval(this.timerInterval);
          }
        }, 1000);
      },

      async handleSendOTP() {
        this.errorMessage = '';
        this.successMessage = '';

        const cleanIdentifier = (this.identifier || '').trim();
        if (!cleanIdentifier || cleanIdentifier.length < 5) {
          this.errorMessage = 'Vui lòng nhập Số điện thoại hoặc Email hợp lệ.';
          return;
        }

        this.isLoading = true;

        try {
          const res = await fetch('/api/auth/send-otp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ identifier: cleanIdentifier }),
          });

          const data = await res.json();

          if (!res.ok) {
            throw new Error(data.error || 'Gửi mã OTP thất bại.');
          }

          this.step = 2;
          this.otp = '';
          this.successMessage = data.message || 'Mã OTP đã được gửi thành công.';

          this.startTimer();

          this.$nextTick(() => {
            const otpInput = document.getElementById('login-otp');
            if (otpInput) otpInput.focus();
          });
        } catch (err) {
          this.errorMessage = err.message || 'Không thể kết nối đến máy chủ.';
        } finally {
          this.isLoading = false;
        }
      },

      async handleVerifyOTP() {
        this.errorMessage = '';
        this.successMessage = '';

        const cleanOtp = (this.otp || '').toString().replace(/\\D/g, '').trim();

        if (!cleanOtp || cleanOtp.length !== 6) {
          this.errorMessage = 'Mã xác nhận OTP phải gồm đúng 6 chữ số.';
          return;
        }

        this.isLoading = true;

        try {
          const res = await fetch('/api/auth/verify-otp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              identifier: this.identifier.trim(),
              otp: cleanOtp
            }),
          });

          const data = await res.json();

          if (!res.ok) {
            throw new Error(data.error || 'Xác thực OTP không thành công.');
          }

          // Thông báo cho toàn bộ ứng dụng
          window.dispatchEvent(new CustomEvent('auth-changed'));
          window.location.href = this.redirectUrl || '/';
        } catch (err) {
          this.errorMessage = err.message || 'Không thể xác thực mã OTP.';
          this.isLoading = false;
        }
      },

      resetStep() {
        this.step = 1;
        this.otp = '';
        this.errorMessage = '';
        this.successMessage = '';
        clearInterval(this.timerInterval);
      }
    }`}
    class="space-y-6"
  >
    <!-- Header -->
    <div class="text-center">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-brand-primary/10 text-brand-primary mb-2">
        <span>🔐</span>
        <span>Cổng Xác Thực B2B</span>
      </span>
      <h1 class="text-xl sm:text-2xl font-black text-brand-dark tracking-tight">
        Đăng nhập Đại lý
      </h1>
      <p 
        class="text-xs text-brand-muted mt-1 leading-relaxed" 
        x-text="mode === 'password' 
          ? 'Đăng nhập bằng Số điện thoại hoặc Email & Mật khẩu đại lý' 
          : (step === 1 ? 'Nhập Số điện thoại hoặc Email đã đăng ký để nhận mã OTP' : 'Nhập mã 6 chữ số đã được gửi tới ' + identifier)"
      ></p>
    </div>

    <!-- TAB CHUYỂN PHƯƠNG THỨC ĐĂNG NHẬP -->
    <div class="grid grid-cols-2 gap-1.5 p-1 bg-brand-surface rounded-xl border border-brand-border/80">
      <button
        type="button"
        @click="switchMode('password')"
        :class="mode === 'password' ? 'bg-white text-brand-primary shadow-xs font-bold' : 'text-brand-muted hover:text-brand-dark font-medium'"
        class="py-2 px-3 rounded-lg text-xs transition cursor-pointer flex items-center justify-center gap-1.5"
      >
        <span>🔑</span>
        <span>Mật khẩu</span>
      </button>

      <button
        type="button"
        @click="switchMode('otp')"
        :class="mode === 'otp' ? 'bg-white text-brand-primary shadow-xs font-bold' : 'text-brand-muted hover:text-brand-dark font-medium'"
        class="py-2 px-3 rounded-lg text-xs transition cursor-pointer flex items-center justify-center gap-1.5"
      >
        <span>✉️</span>
        <span>Mã OTP</span>
      </button>
    </div>

    <!-- Error Notice -->
    <div
      x-show="errorMessage"
      x-text="errorMessage"
      x-cloak
      class="p-3 bg-rose-50 text-rose-600 text-xs font-semibold rounded-xl text-center border border-rose-200"
    ></div>

    <!-- Success Notice -->
    <div
      x-show="successMessage"
      x-text="successMessage"
      x-cloak
      class="p-3 bg-emerald-50 text-emerald-700 text-xs font-semibold rounded-xl text-center border border-emerald-200"
    ></div>

    <!-- PHƯƠNG THỨC 1: ĐĂNG NHẬP MẬT KHẨU -->
    <form x-show="mode === 'password'" @submit.prevent="handlePasswordLogin()" class="space-y-4">
      <div>
        <label for="login-identifier-pwd" class="block text-xs font-bold uppercase tracking-wider text-brand-muted mb-1.5">
          Số điện thoại hoặc Email Đại lý
        </label>
        <input
          type="text"
          id="login-identifier-pwd"
          x-model="identifier"
          required
          placeholder="0909 203 166 hoặc daily@lapet.vn"
          class="w-full px-3.5 py-3 rounded-xl border border-brand-border bg-brand-surface/50 text-sm text-brand-dark focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/10 transition"
        />
      </div>

      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label for="login-password" class="block text-xs font-bold uppercase tracking-wider text-brand-muted">
            Mật khẩu
          </label>
          <button
            type="button"
            @click="switchMode('otp')"
            class="text-[11px] text-brand-primary hover:underline font-semibold cursor-pointer"
          >
            Quên hoặc chưa có mật khẩu?
          </button>
        </div>

        <div class="relative">
          <input
            :type="showPassword ? 'text' : 'password'"
            id="login-password"
            x-model="password"
            required
            placeholder="••••••••"
            class="w-full px-3.5 py-3 pr-10 rounded-xl border border-brand-border bg-brand-surface/50 text-sm text-brand-dark focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/10 transition"
          />
          <button
            type="button"
            @click="showPassword = !showPassword"
            class="absolute right-3 top-1/2 -translate-y-1/2 text-brand-muted hover:text-brand-dark p-1 cursor-pointer transition text-xs"
            :title="showPassword ? 'Ẩn mật khẩu' : 'Hiện mật khẩu'"
          >
            <span x-show="!showPassword">👁️</span>
            <span x-show="showPassword" x-cloak>🙈</span>
          </button>
        </div>
      </div>

      <button
        type="submit"
        :disabled="isLoading"
        class="w-full py-3.5 px-4 rounded-xl bg-brand-primary hover:bg-brand-primary/90 text-white font-bold text-sm uppercase tracking-wider shadow-soft transition cursor-pointer disabled:opacity-50 flex items-center justify-center gap-2"
      >
        <span x-show="isLoading" class="w-4 h-4 rounded-full border-2 border-white border-t-transparent animate-spin inline-block"></span>
        <span x-text="isLoading ? 'ĐANG ĐĂNG NHẬP...' : 'ĐĂNG NHẬP BẰNG MẬT KHẨU'"></span>
      </button>

      <div class="text-center pt-1">
        <button
          type="button"
          @click="switchMode('otp')"
          class="text-xs text-brand-muted hover:text-brand-primary font-medium transition cursor-pointer"
        >
          Hoặc đăng nhập nhanh bằng mã OTP Email →
        </button>
      </div>
    </form>

    <!-- PHƯƠNG THỨC 2: ĐĂNG NHẬP OTP -->
    <div x-show="mode === 'otp'" x-cloak class="space-y-4">
      <!-- STEP 1: IDENTIFIER -->
      <form x-show="step === 1" @submit.prevent="handleSendOTP()" class="space-y-4">
        <div>
          <label for="login-identifier-otp" class="block text-xs font-bold uppercase tracking-wider text-brand-muted mb-1.5">
            Số điện thoại hoặc Email Đại lý
          </label>
          <input
            type="text"
            id="login-identifier-otp"
            x-model="identifier"
            required
            placeholder="0909 203 166 hoặc daily@lapet.vn"
            class="w-full px-3.5 py-3 rounded-xl border border-brand-border bg-brand-surface/50 text-sm text-brand-dark focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/10 transition"
          />
        </div>

        <button
          type="submit"
          :disabled="isLoading"
          class="w-full py-3.5 px-4 rounded-xl bg-brand-primary hover:bg-brand-primary/90 text-white font-bold text-sm uppercase tracking-wider shadow-soft transition cursor-pointer disabled:opacity-50 flex items-center justify-center gap-2"
        >
          <span x-show="isLoading" class="w-4 h-4 rounded-full border-2 border-white border-t-transparent animate-spin inline-block"></span>
          <span x-text="isLoading ? 'ĐANG GỬI MÃ OTP...' : 'NHẬN MÃ OTP'"></span>
        </button>
      </form>

      <!-- STEP 2: OTP VERIFICATION -->
      <form x-show="step === 2" x-cloak @submit.prevent="handleVerifyOTP()" class="space-y-4">
        <div>
          <label for="login-otp" class="block text-xs font-bold uppercase tracking-wider text-brand-muted mb-1.5 text-center">
            Mã xác thực OTP (6 chữ số)
          </label>
          <input
            type="text"
            inputmode="numeric"
            pattern="[0-9]*"
            id="login-otp"
            x-model="otp"
            @input="otp = $event.target.value.replace(/\\D/g, '')"
            maxlength="6"
            required
            placeholder="• • • • • •"
            class="w-full px-4 py-3 text-center text-2xl font-bold tracking-[0.35em] rounded-xl border border-brand-border bg-brand-surface/50 text-brand-dark focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/10 transition"
          />
        </div>

        <button
          type="submit"
          :disabled="isLoading"
          class="w-full py-3.5 px-4 rounded-xl bg-brand-primary hover:bg-brand-primary/90 text-white font-bold text-sm uppercase tracking-wider shadow-soft transition cursor-pointer disabled:opacity-50 flex items-center justify-center gap-2"
        >
          <span x-show="isLoading" class="w-4 h-4 rounded-full border-2 border-white border-t-transparent animate-spin inline-block"></span>
          <span x-text="isLoading ? 'ĐANG XÁC THỰC...' : 'XÁC NHẬN ĐĂNG NHẬP'"></span>
        </button>

        <div class="flex items-center justify-between text-xs pt-1">
          <button
            type="button"
            @click="resetStep()"
            class="text-brand-muted hover:text-brand-primary font-medium transition cursor-pointer"
          >
            ← Đổi số điện thoại / email
          </button>

          <button
            type="button"
            @click="handleSendOTP()"
            :disabled="timer > 0 || isLoading"
            class="text-brand-primary font-bold disabled:text-brand-muted/50 disabled:cursor-not-allowed hover:underline cursor-pointer"
          >
            <span x-text="timer > 0 ? `Gửi lại mã (${timer}s)` : 'Gửi lại mã OTP'"></span>
          </button>
        </div>
      </form>
    </div>

    <!-- Footer Links -->
    <div class="pt-4 border-t border-brand-border/60 text-center text-xs text-brand-muted space-y-2">
      <p>
        Chưa có tài khoản đại lý?{' '}
        <a href="/auth/register" class="font-bold text-brand-primary hover:underline">
          Đăng ký đại lý B2B ngay
        </a>
      </p>
      <p class="text-[11px] text-brand-muted/80">
        Bằng việc đăng nhập, bạn đồng ý với các Điều khoản & Chính sách bảo mật của LA PET Store.
      </p>
    </div>
  </div>
</AuthLayout>

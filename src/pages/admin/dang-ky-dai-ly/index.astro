---
// src/pages/admin/dang-ky-dai-ly/index.astro
import AdminLayout from '@/layouts/AdminLayout.astro';
import { directusAdmin } from '@/lib/directus';
import { readItems } from '@directus/sdk';

export const prerender = false;

let registrations: any[] = [];
let errorMsg = '';

try {
  const res = await directusAdmin.request(
    readItems('dealer_registrations' as any, {
      sort: ['-created_at', '-id'],
      limit: 100
    })
  );
  registrations = (res || []).map((r: any) => ({
    id: r.id,
    name: r.name || r.full_name || '—',
    phone: r.phone || '',
    store_name: r.store_name || '—',
    business_model: r.business_model || '—',
    city: r.city || r.city_province || '—',
    email: r.email || '',
    note: r.note || r.notes || '',
    status: r.status || 'pending',
    dealer_code: r.dealer_code || r.code || '',
    created_at: r.created_at ? r.created_at.split('T')[0] : (r.date_created ? r.date_created.split('T')[0] : '—')
  }));
} catch (e: any) {
  errorMsg = e.message || 'Lỗi đọc dữ liệu từ Directus';
}
---

<AdminLayout title="Duyệt Hồ Sơ Đăng Ký Đại Lý" activeNav="registrations">
  <div class="space-y-4" x-data={`{
    items: ${JSON.stringify(registrations)},
    filterStatus: 'all',
    searchQuery: '',
    toastMsg: '',
    editingItem: null,
    editNoteText: '',
    copiedPhoneId: null,

    get countTotal() {
      return this.items.length;
    },
    get countPending() {
      return this.items.filter(it => it.status === 'pending').length;
    },
    get countContacted() {
      return this.items.filter(it => it.status === 'contacted').length;
    },
    get countApproved() {
      return this.items.filter(it => it.status === 'approved').length;
    },
    get countRejected() {
      return this.items.filter(it => it.status === 'rejected').length;
    },

    get filteredItems() {
      return this.items.filter(it => {
        const matchStatus = this.filterStatus === 'all' || it.status === this.filterStatus;
        const q = this.searchQuery.trim().toLowerCase();
        const matchSearch = !q ||
          (it.name && it.name.toLowerCase().includes(q)) ||
          (it.phone && it.phone.toLowerCase().includes(q)) ||
          (it.store_name && it.store_name.toLowerCase().includes(q)) ||
          (it.email && it.email.toLowerCase().includes(q)) ||
          (it.dealer_code && it.dealer_code.toLowerCase().includes(q)) ||
          (it.city && it.city.toLowerCase().includes(q));
        return matchStatus && matchSearch;
      });
    },

    showToast(msg) {
      this.toastMsg = msg;
      setTimeout(() => { this.toastMsg = ''; }, 3500);
    },

    cleanPhone(p) {
      if (!p) return '';
      return String(p).replace(/[^0-9]/g, '');
    },

    copyPhone(id, phone) {
      if (!phone) return;
      navigator.clipboard.writeText(phone).then(() => {
        this.copiedPhoneId = id;
        this.showToast('Đã sao chép SĐT: ' + phone);
        setTimeout(() => {
          if (this.copiedPhoneId === id) this.copiedPhoneId = null;
        }, 2000);
      });
    },

    openNoteModal(item) {
      this.editingItem = item;
      this.editNoteText = item.note || '';
    },

    async saveNote() {
      if (!this.editingItem) return;
      try {
        const res = await fetch('/api/admin/dealers/registrations', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: this.editingItem.id, note: this.editNoteText })
        });
        const data = await res.json();
        if (data.success) {
          this.editingItem.note = this.editNoteText;
          this.editingItem = null;
          this.showToast('Đã lưu ghi chú hồ sơ đại lý');
        } else {
          alert('Lỗi: ' + (data.error || 'Không thể lưu ghi chú'));
        }
      } catch (e) {
        alert('Lỗi kết nối máy chủ');
      }
    },

    async approve1Click(item) {
      const displayName = item.store_name !== '—' ? item.store_name : item.name;
      if (!confirm('Xác nhận 1-Click Duyệt & Kích Hoạt tài khoản đại lý cho đối tác \"' + displayName + '\" (' + item.phone + ')?')) {
        return;
      }
      try {
        const res = await fetch('/api/admin/dealers/registrations', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'approve', id: item.id, phone: item.phone })
        });
        const data = await res.json();
        if (data.success) {
          item.status = 'approved';
          item.dealer_code = data.code || data.dealer_code || 'DL-2026-0001';
          this.showToast('Đã duyệt & kích hoạt đại lý: Mã ' + item.dealer_code);
        } else {
          alert('Lỗi: ' + (data.error || 'Duyệt thất bại'));
        }
      } catch (e) {
        alert('Lỗi kết nối máy chủ khi duyệt đại lý');
      }
    },

    async setStatus(id, newStatus) {
      try {
        const res = await fetch('/api/admin/dealers/registrations', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id, status: newStatus })
        });
        const data = await res.json();
        if (data.success) {
          const it = this.items.find(x => x.id === id);
          if (it) {
            it.status = newStatus;
            if (data.dealerCode) it.dealer_code = data.dealerCode;
            if (data.customerId) it.customerId = data.customerId;
          }
          if (newStatus === 'approved' && data.customerSynced) {
            this.showToast('Đã duyệt & kích hoạt hồ sơ đại lý (' + (data.dealerCode || ('ID #' + data.customerId)) + ')');
          } else {
            this.showToast('Đã cập nhật trạng thái hồ sơ');
          }
        } else {
          alert('Lỗi: ' + (data.error || 'Cập nhật thất bại'));
        }
      } catch (e) {
        alert('Lỗi kết nối máy chủ');
      }
    }
  }`}>
    
    <!-- TOAST THÔNG BÁO -->
    <div
      x-show="toastMsg"
      x-cloak
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0 translate-y-2"
      x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="opacity-100 translate-y-0"
      x-transition:leave-end="opacity-0 translate-y-2"
      class="fixed bottom-5 right-5 z-50 px-4 py-2.5 rounded-xl bg-slate-900 text-white text-xs font-bold shadow-xl flex items-center gap-2 border border-slate-700"
    >
      <svg class="w-4 h-4 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
      <span x-text="toastMsg"></span>
    </div>

    <!-- A. THẺ THỐNG KÊ NHANH (KPI METRICS CARDS) -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
      
      <!-- Thẻ 1: Tổng hồ sơ -->
      <div 
        @click="filterStatus = 'all'"
        class="p-3.5 sm:p-4 rounded-xl bg-white border border-slate-200 shadow-2xs hover:border-[#087b80] transition-all cursor-pointer group"
        :class="filterStatus === 'all' ? 'ring-2 ring-[#087b80]/20 border-[#087b80]' : ''"
      >
        <div class="flex items-center justify-between">
          <span class="text-2xs sm:text-xs font-bold text-slate-500 uppercase tracking-wider">Tổng tiếp nhận</span>
          <span class="w-7 h-7 rounded-lg bg-slate-100 text-slate-700 flex items-center justify-center text-xs group-hover:bg-[#087b80]/10 group-hover:text-[#087b80] transition-colors">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </span>
        </div>
        <div class="mt-2 flex items-baseline gap-1.5">
          <span class="text-xl sm:text-2xl font-black text-slate-900" x-text="countTotal"></span>
          <span class="text-3xs text-slate-400 font-medium">hồ sơ</span>
        </div>
      </div>

      <!-- Thẻ 2: Chờ xử lý (Amber nổi bật) -->
      <div 
        @click="filterStatus = 'pending'"
        class="p-3.5 sm:p-4 rounded-xl bg-white border border-slate-200 shadow-2xs hover:border-amber-400 transition-all cursor-pointer group"
        :class="filterStatus === 'pending' ? 'ring-2 ring-amber-400/30 border-amber-400 bg-amber-50/20' : ''"
      >
        <div class="flex items-center justify-between">
          <span class="text-2xs sm:text-xs font-bold text-amber-700 uppercase tracking-wider">Chờ liên hệ</span>
          <span class="w-7 h-7 rounded-lg bg-amber-100 text-amber-700 flex items-center justify-center text-xs">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </span>
        </div>
        <div class="mt-2 flex items-baseline gap-1.5">
          <span class="text-xl sm:text-2xl font-black text-amber-600" x-text="countPending"></span>
          <span class="text-3xs text-amber-600/80 font-bold">cần xử lý ngay</span>
        </div>
      </div>

      <!-- Thẻ 3: Đã liên hệ (Blue/Sky) -->
      <div 
        @click="filterStatus = 'contacted'"
        class="p-3.5 sm:p-4 rounded-xl bg-white border border-slate-200 shadow-2xs hover:border-blue-400 transition-all cursor-pointer group"
        :class="filterStatus === 'contacted' ? 'ring-2 ring-blue-400/30 border-blue-400 bg-blue-50/20' : ''"
      >
        <div class="flex items-center justify-between">
          <span class="text-2xs sm:text-xs font-bold text-blue-700 uppercase tracking-wider">Đang khảo sát</span>
          <span class="w-7 h-7 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center text-xs">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
          </span>
        </div>
        <div class="mt-2 flex items-baseline gap-1.5">
          <span class="text-xl sm:text-2xl font-black text-blue-600" x-text="countContacted"></span>
          <span class="text-3xs text-blue-600/80 font-medium">đã liên hệ</span>
        </div>
      </div>

      <!-- Thẻ 4: Đã duyệt (Emerald) -->
      <div 
        @click="filterStatus = 'approved'"
        class="p-3.5 sm:p-4 rounded-xl bg-white border border-slate-200 shadow-2xs hover:border-emerald-400 transition-all cursor-pointer group"
        :class="filterStatus === 'approved' ? 'ring-2 ring-emerald-400/30 border-emerald-400 bg-emerald-50/20' : ''"
      >
        <div class="flex items-center justify-between">
          <span class="text-2xs sm:text-xs font-bold text-emerald-700 uppercase tracking-wider">Đã kích hoạt</span>
          <span class="w-7 h-7 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center text-xs">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </span>
        </div>
        <div class="mt-2 flex items-baseline gap-1.5">
          <span class="text-xl sm:text-2xl font-black text-emerald-600" x-text="countApproved"></span>
          <span class="text-3xs text-emerald-600/80 font-medium">đại lý chính thức</span>
        </div>
      </div>

    </div>

    <!-- B. THANH CÔNG CỤ & BỘ LỌC NHANH (FILTER TOOLBAR) -->
    <div class="bg-white p-3 sm:p-3.5 rounded-xl border border-slate-200 shadow-2xs flex flex-col md:flex-row md:items-center justify-between gap-3">
      
      <!-- Phía trái: Tab chuyển trạng thái dạng Pill Buttons -->
      <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar pb-1 sm:pb-0">
        
        <button
          type="button"
          @click="filterStatus = 'all'"
          :class="filterStatus === 'all' ? 'bg-[#087b80] text-white shadow-2xs' : 'bg-slate-100 hover:bg-slate-200/80 text-slate-700'"
          class="px-3 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5 whitespace-nowrap cursor-pointer"
        >
          <span>Tất cả</span>
          <span class="text-3xs px-1.5 py-0.2 rounded-full" :class="filterStatus === 'all' ? 'bg-white/20' : 'bg-slate-200'" x-text="countTotal"></span>
        </button>

        <button
          type="button"
          @click="filterStatus = 'pending'"
          :class="filterStatus === 'pending' ? 'bg-amber-600 text-white shadow-2xs' : 'bg-slate-100 hover:bg-slate-200/80 text-slate-700'"
          class="px-3 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5 whitespace-nowrap cursor-pointer relative"
        >
          <span x-show="countPending > 0" class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
          <span>Chờ duyệt</span>
          <span class="text-3xs px-1.5 py-0.2 rounded-full" :class="filterStatus === 'pending' ? 'bg-white/20' : 'bg-amber-100 text-amber-800'" x-text="countPending"></span>
        </button>

        <button
          type="button"
          @click="filterStatus = 'contacted'"
          :class="filterStatus === 'contacted' ? 'bg-blue-600 text-white shadow-2xs' : 'bg-slate-100 hover:bg-slate-200/80 text-slate-700'"
          class="px-3 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5 whitespace-nowrap cursor-pointer"
        >
          <span>Đã liên hệ</span>
          <span class="text-3xs px-1.5 py-0.2 rounded-full" :class="filterStatus === 'contacted' ? 'bg-white/20' : 'bg-blue-100 text-blue-800'" x-text="countContacted"></span>
        </button>

        <button
          type="button"
          @click="filterStatus = 'approved'"
          :class="filterStatus === 'approved' ? 'bg-emerald-600 text-white shadow-2xs' : 'bg-slate-100 hover:bg-slate-200/80 text-slate-700'"
          class="px-3 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5 whitespace-nowrap cursor-pointer"
        >
          <span>Đã duyệt</span>
          <span class="text-3xs px-1.5 py-0.2 rounded-full" :class="filterStatus === 'approved' ? 'bg-white/20' : 'bg-emerald-100 text-emerald-800'" x-text="countApproved"></span>
        </button>

        <button
          type="button"
          @click="filterStatus = 'rejected'"
          :class="filterStatus === 'rejected' ? 'bg-slate-700 text-white shadow-2xs' : 'bg-slate-100 hover:bg-slate-200/80 text-slate-700'"
          class="px-3 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5 whitespace-nowrap cursor-pointer"
        >
          <span>Từ chối</span>
          <span class="text-3xs px-1.5 py-0.2 rounded-full" :class="filterStatus === 'rejected' ? 'bg-white/20' : 'bg-slate-200 text-slate-700'" x-text="countRejected"></span>
        </button>

      </div>

      <!-- Phía phải: Input tìm kiếm & Đếm số lượng hiển thị -->
      <div class="flex items-center gap-2.5 shrink-0">
        <div class="relative w-full sm:w-64">
          <input
            type="text"
            x-model="searchQuery"
            placeholder="Tìm tên, SĐT, shop, tỉnh thành..."
            class="w-full text-xs pl-8 pr-3 py-1.5 rounded-lg border border-slate-200 bg-slate-50/70 focus:bg-white focus:outline-none focus:border-[#087b80] transition"
          />
          <svg class="w-3.5 h-3.5 text-slate-400 absolute left-2.5 top-1/2 -translate-y-1/2 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </div>

        <span class="text-2xs font-bold px-2.5 py-1 bg-slate-100 text-slate-700 rounded-lg whitespace-nowrap shrink-0">
          Hiển thị: <strong class="text-slate-900" x-text="filteredItems.length"></strong>/<span x-text="items.length"></span>
        </span>
      </div>

    </div>

    {errorMsg && (
      <div class="p-3.5 bg-rose-50 border border-rose-200 rounded-xl text-rose-700 text-xs font-semibold">
        {errorMsg}
      </div>
    )}

    <!-- C. BẢNG DANH SÁCH HỒ SƠ (5 CỘT FIT SCREEN - KHÔNG TRÀN NGANG) -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-2xs overflow-hidden">
      <div class="overflow-x-auto w-full">
        <table class="w-full text-left text-xs text-slate-600 border-collapse table-fixed min-w-[760px] lg:min-w-0">
          <thead class="bg-slate-50/80 text-2xs font-extrabold text-slate-500 uppercase tracking-wider border-b border-slate-200/80">
            <tr>
              <th class="py-2.5 px-3.5 w-[30%]">Đối tác &amp; Cửa hàng</th>
              <th class="py-2.5 px-3 w-[20%]">Kênh liên hệ</th>
              <th class="py-2.5 px-3 w-[18%]">Thời gian &amp; Trạng thái</th>
              <th class="py-2.5 px-3 w-[17%]">Ghi chú xét duyệt</th>
              <th class="py-2.5 px-3.5 w-[15%] text-right">Thao tác</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            
            <!-- Empty state -->
            <template x-if="filteredItems.length === 0">
              <tr>
                <td colspan="5" class="py-12 text-center text-slate-400">
                  <div class="w-12 h-12 mx-auto rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mb-2">
                    <svg class="w-6 h-6 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
                      <circle cx="12" cy="12" r="10"></circle><line x1="8" y1="12" x2="16" y2="12"></line>
                    </svg>
                  </div>
                  <p class="text-xs font-bold text-slate-600">Không tìm thấy hồ sơ đăng ký phù hợp</p>
                  <p class="text-3xs text-slate-400 mt-0.5">Thử đổi từ khóa tìm kiếm hoặc chọn bộ lọc trạng thái khác.</p>
                </td>
              </tr>
            </template>

            <!-- Data Rows -->
            <template x-for="item in filteredItems" :key="item.id">
              <tr class="hover:bg-slate-50/80 transition-colors">
                
                <!-- Cột 1: Đối tác & Cửa hàng (~30%) -->
                <td class="py-2.5 px-3.5 align-middle">
                  <div class="space-y-1">
                    <div class="flex items-center gap-1.5 flex-wrap">
                      <span class="font-bold text-slate-900 text-xs truncate max-w-[200px]" :title="item.store_name" x-text="item.store_name"></span>
                      <template x-if="item.dealer_code">
                        <span class="px-1.5 py-0.2 rounded text-3xs font-mono font-bold bg-emerald-50 text-emerald-700 border border-emerald-200" x-text="item.dealer_code"></span>
                      </template>
                    </div>

                    <div class="flex items-center gap-1.5 text-2xs text-slate-500 flex-wrap">
                      <span class="font-medium text-slate-700 truncate max-w-[140px]" :title="item.name" x-text="item.name"></span>
                      <span class="text-slate-300">•</span>
                      <span class="px-1.5 py-0.2 rounded bg-slate-100 text-slate-600 font-semibold text-3xs" x-text="item.business_model"></span>
                    </div>

                    <div class="flex items-center gap-1 text-3xs text-slate-400">
                      <svg class="w-3 h-3 text-slate-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"></path><circle cx="12" cy="10" r="3"></circle>
                      </svg>
                      <span class="truncate" :title="item.city" x-text="item.city"></span>
                    </div>
                  </div>
                </td>

                <!-- Cột 2: Kênh liên hệ (~20%) -->
                <td class="py-2.5 px-3 align-middle">
                  <div class="space-y-1">
                    <div class="flex items-center gap-1.5">
                      <span class="font-mono font-bold text-slate-900 text-xs" x-text="item.phone"></span>
                      
                      <!-- Nút copy phone -->
                      <button
                        type="button"
                        @click="copyPhone(item.id, item.phone)"
                        title="Sao chép số điện thoại"
                        class="p-1 rounded hover:bg-slate-100 text-slate-400 hover:text-slate-700 transition cursor-pointer"
                      >
                        <template x-if="copiedPhoneId === item.id">
                          <svg class="w-3.5 h-3.5 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <polyline points="20 6 9 17 4 12"></polyline>
                          </svg>
                        </template>
                        <template x-if="copiedPhoneId !== item.id">
                          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                          </svg>
                        </template>
                      </button>

                      <!-- Nút mở Zalo nhanh -->
                      <template x-if="cleanPhone(item.phone)">
                        <a
                          :href="'https://zalo.me/' + cleanPhone(item.phone)"
                          target="_blank"
                          rel="noopener noreferrer"
                          title="Mở chat Zalo với đối tác"
                          class="px-1.5 py-0.5 rounded bg-blue-50 hover:bg-blue-100 text-blue-600 text-3xs font-extrabold flex items-center gap-0.5 transition"
                        >
                          <span>Zalo</span>
                          <svg class="w-2.5 h-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line>
                          </svg>
                        </a>
                      </template>
                    </div>

                    <div class="text-3xs text-slate-400 truncate max-w-[180px]" :title="item.email || 'Chưa cung cấp email'" x-text="item.email || 'Chưa có email'"></div>
                  </div>
                </td>

                <!-- Cột 3: Thời gian & Trạng thái (~18%) -->
                <td class="py-2.5 px-3 align-middle">
                  <div class="space-y-1">
                    <div>
                      <span
                        :class="{
                          'bg-amber-50 text-amber-700 border-amber-200': item.status === 'pending',
                          'bg-blue-50 text-blue-700 border-blue-200': item.status === 'contacted',
                          'bg-emerald-50 text-emerald-700 border-emerald-200': item.status === 'approved',
                          'bg-slate-100 text-slate-600 border-slate-200': item.status === 'rejected'
                        }"
                        class="inline-block px-2 py-0.5 rounded-md text-2xs font-extrabold border"
                        x-text="item.status === 'pending' ? 'Chờ liên hệ' : (item.status === 'contacted' ? 'Đã liên hệ' : (item.status === 'approved' ? 'Đã duyệt' : 'Từ chối'))"
                      ></span>
                    </div>

                    <div class="text-3xs text-slate-400 flex items-center gap-1 font-mono">
                      <svg class="w-3 h-3 text-slate-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line>
                      </svg>
                      <span x-text="item.created_at"></span>
                    </div>
                  </div>
                </td>

                <!-- Cột 4: Ghi chú xét duyệt (~17%) -->
                <td class="py-2.5 px-3 align-middle">
                  <div class="flex items-center justify-between gap-1 group/note">
                    <p 
                      class="text-2xs text-slate-600 line-clamp-2 italic"
                      :title="item.note || 'Chưa có ghi chú xét duyệt'" 
                      x-text="item.note || '—'"
                    ></p>
                    <button
                      type="button"
                      @click="openNoteModal(item)"
                      class="shrink-0 p-1 rounded hover:bg-slate-100 text-slate-400 hover:text-[#087b80] transition cursor-pointer"
                      title="Chỉnh sửa ghi chú"
                    >
                      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                      </svg>
                    </button>
                  </div>
                </td>

                <!-- Cột 5: Hành động (Quick Action ~15% - Căn phải) -->
                <td class="py-2.5 px-3.5 text-right align-middle">
                  
                  <!-- Trường hợp 1: Chờ liên hệ hoặc Đang liên hệ -> Nút 1-Click Duyệt + Dropdown phụ -->
                  <template x-if="item.status === 'pending' || item.status === 'contacted'">
                    <div class="flex items-center justify-end gap-1.5 flex-nowrap">
                      <!-- Nút 1-Click Duyệt -->
                      <button
                        type="button"
                        @click="approve1Click(item)"
                        class="px-2.5 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-2xs uppercase tracking-wider transition shadow-2xs flex items-center gap-1 cursor-pointer shrink-0"
                        title="1-Click Duyệt hồ sơ & Tạo tài khoản đại lý ngay"
                      >
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                          <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>Duyệt</span>
                      </button>

                      <!-- Dropdown đổi trạng thái phụ -->
                      <select
                        :value="item.status"
                        @change="setStatus(item.id, $event.target.value)"
                        class="text-3xs font-bold px-1.5 py-1.5 rounded-lg border border-slate-200 bg-slate-50 text-slate-700 focus:outline-none focus:ring-1 focus:ring-[#087b80] cursor-pointer"
                        title="Tùy chọn trạng thái khác"
                      >
                        <option value="pending" disabled>Chờ</option>
                        <option value="contacted">Đã liên hệ</option>
                        <option value="rejected">Từ chối</option>
                      </select>
                    </div>
                  </template>

                  <!-- Trường hợp 2: Đã duyệt -> Badge đại lý chính thức -->
                  <template x-if="item.status === 'approved'">
                    <div class="flex flex-col items-end gap-0.5">
                      <span class="inline-flex items-center gap-1 text-emerald-700 text-2xs font-extrabold bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-200">
                        <svg class="w-3 h-3 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                          <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>Đã kích hoạt</span>
                      </span>
                      <template x-if="item.dealer_code">
                        <span class="font-mono text-3xs font-bold text-slate-500" x-text="item.dealer_code"></span>
                      </template>
                    </div>
                  </template>

                  <!-- Trường hợp 3: Từ chối -> Nút mở lại nếu cần -->
                  <template x-if="item.status === 'rejected'">
                    <div class="flex items-center justify-end gap-1">
                      <span class="text-3xs text-slate-400 font-medium">Đã từ chối</span>
                      <button
                        type="button"
                        @click="setStatus(item.id, 'pending')"
                        class="text-3xs font-bold text-[#087b80] hover:underline cursor-pointer"
                        title="Xem xét lại hồ sơ"
                      >
                        Mở lại
                      </button>
                    </div>
                  </template>

                </td>

              </tr>
            </template>
          </tbody>
        </table>
      </div>
    </div>

    <!-- D. MODAL SỬA GHI CHÚ (TÚT LẠI THÔNG TIN RÕ RÀNG) -->
    <div
      x-show="editingItem !== null"
      x-cloak
      class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4"
    >
      <div 
        class="bg-white rounded-2xl border border-slate-200 shadow-2xl max-w-md w-full p-5 space-y-4 animate-fade-in"
        @click.away="editingItem = null"
      >
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <div>
            <h3 class="text-sm font-black text-slate-800">Ghi chú xét duyệt hồ sơ</h3>
            <p class="text-3xs text-slate-400 mt-0.5">Lưu nhật ký liên hệ, chiết khấu hoặc thông tin khảo sát điểm bán.</p>
          </div>
          <button 
            type="button" 
            @click="editingItem = null" 
            class="w-7 h-7 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-400 hover:text-slate-700 flex items-center justify-center text-xs font-bold transition"
          >
            ✕
          </button>
        </div>

        <!-- Thông tin tóm tắt đối tác đang sửa (tránh nhầm lẫn) -->
        <div class="p-3 bg-slate-50 rounded-xl border border-slate-200/80 text-xs space-y-1">
          <div class="flex items-center justify-between">
            <span class="text-slate-500 text-2xs">Cửa hàng / Đối tác:</span>
            <strong class="text-slate-900 truncate max-w-[200px]" x-text="editingItem?.store_name || editingItem?.name"></strong>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-slate-500 text-2xs">Đại diện &amp; SĐT:</span>
            <span class="font-mono text-slate-700 text-2xs" x-text="(editingItem?.name || '') + ' (' + (editingItem?.phone || '') + ')'"></span>
          </div>
        </div>

        <div>
          <label class="block text-3xs font-extrabold uppercase tracking-wider text-slate-500 mb-1.5">
            Nội dung ghi chú nội bộ
          </label>
          <textarea
            x-model="editNoteText"
            rows="4"
            placeholder="Nhập ghi chú liên hệ Zalo, địa chỉ kho thực tế, hạn mức công nợ hoặc cam kết doanh số..."
            class="w-full rounded-xl border border-slate-200 p-3 text-xs text-slate-700 focus:bg-white focus:outline-none focus:border-[#087b80] focus:ring-1 focus:ring-[#087b80] transition"
          ></textarea>
        </div>

        <div class="flex justify-end gap-2 pt-2 border-t border-slate-100">
          <button
            type="button"
            @click="editingItem = null"
            class="px-4 py-2 rounded-xl border border-slate-200 text-xs font-bold text-slate-600 hover:bg-slate-50 transition cursor-pointer"
          >
            Đóng
          </button>
          <button
            type="button"
            @click="saveNote()"
            class="px-4 py-2 rounded-xl bg-[#087b80] hover:bg-teal-800 text-white text-xs font-bold transition shadow-2xs cursor-pointer"
          >
            Lưu ghi chú
          </button>
        </div>
      </div>
    </div>

  </div>
</AdminLayout>

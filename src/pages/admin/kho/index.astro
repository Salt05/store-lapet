---
// src/pages/admin/kho/index.astro
import AdminLayout from '@/layouts/AdminLayout.astro';
import { inventoryStorageService } from '@/services/inventory-storage.service';

export const prerender = false;

// Initial SSR Data Fetching
let initialItems = [];
let initialReceipts = [];
let initialTransactions = [];
let loadError = '';

try {
  [initialItems, initialReceipts, initialTransactions] = await Promise.all([
    inventoryStorageService.getItems(),
    inventoryStorageService.getReceipts(),
    inventoryStorageService.getTransactions({ limit: 100 }),
  ]);
} catch (e: any) {
  loadError = e.message || 'Lỗi tải dữ liệu kho ban đầu';
}

// Calculate summary stats for initial tab badge
const totalSkus = initialItems.length;

// Extract categories for filter
const categories = Array.from(new Set(initialItems.map((it) => it.category).filter(Boolean)));
---

<AdminLayout title="Quản lý Kho hàng độc lập" activeNav="inventory">
  <style>
    @media print {
      body * {
        visibility: hidden;
      }
      #print-receipt-area,
      #print-receipt-area * {
        visibility: visible;
      }
      #print-receipt-area {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        display: block !important;
        padding: 12mm;
        background: white;
        color: black;
      }
    }
  </style>

  <script is:inline defer src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>

  <div
    class="space-y-6"
    x-data={`{
      currentTab: 'overview',
      loading: false,
      topSkuMetric: 'reserved',
      toast: { show: false, message: '', type: 'success' },

      // Data Lists
      items: ${JSON.stringify(initialItems)},
      receipts: ${JSON.stringify(initialReceipts)},
      transactions: ${JSON.stringify(initialTransactions)},

      // Filter States - Tab 1
      searchQuery: '',
      categoryFilter: 'all',
      statusFilter: 'all',

      // Filter States - Tab 2
      receiptSearch: '',

      // Filter States - Tab 3
      txSkuFilter: '',
      txTypeFilter: 'all',

      // Modal States - Quick Edit Min Stock
      minStockModal: {
        open: false,
        sku: '',
        productName: '',
        currentMin: 0,
        newMin: 0,
        available: 0,
        loading: false
      },

      // Modal States - Create Receipt
      receiptModal: {
        open: false,
        supplierName: '',
        deliverTo: 'Kho Tổng LA PET - TP.HCM',
        notes: '',
        loading: false,
        lines: [
          { sku: '', productName: '', quantity: 1, priceUnit: 0 }
        ]
      },

      // Modal States - Receipt Detail
      detailModal: {
        open: false,
        receipt: null
      },

      showToast(message, type = 'success') {
        this.toast.message = message;
        this.toast.type = type;
        this.toast.show = true;
        setTimeout(() => { this.toast.show = false; }, 3500);
      },

      // Computed Helpers
      get kpis() {
        const total = this.items.length;
        const onHand = this.items.reduce((acc, it) => acc + (Number(it.onHand) || 0), 0);
        const reserved = this.items.reduce((acc, it) => acc + (Number(it.reserved) || 0), 0);
        const available = this.items.reduce((acc, it) => acc + (Number(it.available) || 0), 0);
        const inStock = this.items.filter(it => it.status === 'in_stock').length;
        const lowStock = this.items.filter(it => it.status === 'low_stock').length;
        const outOfStock = this.items.filter(it => it.status === 'out_of_stock').length;
        return { total, onHand, reserved, available, inStock, lowStock, outOfStock };
      },

      init() {
        const waitForChart = () => {
          if (window.Chart) {
            this.$nextTick(() => this.renderCharts());
          } else {
            setTimeout(waitForChart, 60);
          }
        };
        waitForChart();
      },

      setTopSkuMetric(metric) {
        this.topSkuMetric = metric;
        this.renderCharts();
      },

      renderCharts() {
        const ChartLib = window.Chart;
        if (!ChartLib) return;
        const store = (window.__khoCharts = window.__khoCharts || {});
        const self = this;

        // 1. Doughnut: Stock Status Breakdown
        const statusCanvas = document.getElementById('khoStatusChart');
        if (statusCanvas) {
          if (store.status) store.status.destroy();
          const k = this.kpis;
          store.status = new ChartLib(statusCanvas.getContext('2d'), {
            type: 'doughnut',
            data: {
              labels: ['Đủ hàng', 'Sắp hết', 'Hết hàng'],
              datasets: [{
                data: [k.inStock, k.lowStock, k.outOfStock],
                backgroundColor: ['#10b981', '#f59e0b', '#f43f5e'],
                borderColor: '#ffffff',
                borderWidth: 2,
                hoverOffset: 5
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              cutout: '68%',
              onClick: (_evt, elements) => {
                if (!elements.length) return;
                const keys = ['in_stock', 'low_stock', 'out_of_stock'];
                const target = keys[elements[0].index];
                self.statusFilter = self.statusFilter === target ? 'all' : target;
                self.currentTab = 'overview';
              },
              plugins: {
                legend: { display: false },
                tooltip: {
                  backgroundColor: '#0f172a',
                  padding: 10,
                  cornerRadius: 8,
                  callbacks: {
                    label: (ctx) => {
                      const val = Number(ctx.raw || 0);
                      const pct = k.total ? Math.round((val / k.total) * 100) : 0;
                      return ' ' + ctx.label + ': ' + val + ' SKU (' + pct + '%)';
                    }
                  }
                }
              }
            }
          });
        }

        // 2. Horizontal Stacked Bar: Category Distribution
        const catCanvas = document.getElementById('khoCategoryChart');
        if (catCanvas) {
          if (store.category) store.category.destroy();
          const catMap = new Map();
          for (const it of this.items) {
            const name = it.category || 'Chung';
            const entry = catMap.get(name) || { name, in_stock: 0, low_stock: 0, out_of_stock: 0, total: 0 };
            entry[it.status === 'in_stock' ? 'in_stock' : it.status === 'low_stock' ? 'low_stock' : 'out_of_stock'] += 1;
            entry.total += 1;
            catMap.set(name, entry);
          }
          const cats = Array.from(catMap.values()).sort((a, b) => b.total - a.total);
          store.category = new ChartLib(catCanvas.getContext('2d'), {
            type: 'bar',
            data: {
              labels: cats.map(c => c.name),
              datasets: [
                { label: 'Đủ hàng', data: cats.map(c => c.in_stock), backgroundColor: '#10b981', borderRadius: 4, barPercentage: 0.7 },
                { label: 'Sắp hết', data: cats.map(c => c.low_stock), backgroundColor: '#f59e0b', borderRadius: 4, barPercentage: 0.7 },
                { label: 'Hết hàng', data: cats.map(c => c.out_of_stock), backgroundColor: '#f43f5e', borderRadius: 4, barPercentage: 0.7 }
              ]
            },
            options: {
              indexAxis: 'y',
              responsive: true,
              maintainAspectRatio: false,
              onClick: (_evt, elements) => {
                if (!elements.length) return;
                const cat = cats[elements[0].index];
                if (!cat) return;
                self.categoryFilter = self.categoryFilter === cat.name ? 'all' : cat.name;
                self.currentTab = 'overview';
              },
              scales: {
                x: { stacked: true, beginAtZero: true, ticks: { stepSize: 2, font: { size: 10 }, color: '#64748b' }, grid: { color: '#f1f5f9' } },
                y: { stacked: true, ticks: { font: { size: 10, weight: '600' }, color: '#334155' }, grid: { display: false } }
              },
              plugins: {
                legend: { position: 'bottom', labels: { boxWidth: 10, boxHeight: 10, font: { size: 10 }, color: '#475569', padding: 10 } },
                tooltip: { backgroundColor: '#0f172a', padding: 10, cornerRadius: 8 }
              }
            }
          });
        }

        // 3. Top 8 SKUs Bar Chart (Reserved or On Hand)
        const topCanvas = document.getElementById('khoTopSkuChart');
        if (topCanvas) {
          if (store.topSku) store.topSku.destroy();
          const isOnHand = this.topSkuMetric === 'onHand';
          const sorted = [...this.items]
            .sort((a, b) => isOnHand ? (Number(b.onHand) || 0) - (Number(a.onHand) || 0) : (Number(b.reserved) || 0) - (Number(a.reserved) || 0))
            .slice(0, 8);
          store.topSku = new ChartLib(topCanvas.getContext('2d'), {
            type: 'bar',
            data: {
              labels: sorted.map(it => it.sku),
              datasets: [{
                label: isOnHand ? 'Tồn thực tế (On Hand)' : 'Đang giữ chỗ (Reserved)',
                data: sorted.map(it => isOnHand ? Number(it.onHand || 0) : Number(it.reserved || 0)),
                backgroundColor: sorted.map(it => {
                  if (!isOnHand) return '#087b80';
                  return (Number(it.onHand || 0) >= 0) ? '#10b981' : '#f43f5e';
                }),
                borderRadius: 6,
                barPercentage: 0.65
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              onClick: (_evt, elements) => {
                if (!elements.length) return;
                const picked = sorted[elements[0].index];
                if (!picked) return;
                self.searchQuery = self.searchQuery === picked.sku ? '' : picked.sku;
                self.currentTab = 'overview';
              },
              scales: {
                x: { ticks: { font: { size: 10, weight: '700' }, color: '#334155' }, grid: { display: false } },
                y: {
                  beginAtZero: true,
                  ticks: {
                    font: { size: 10 },
                    color: '#64748b',
                    callback: (v) => Number(v) >= 1000 ? (Number(v) / 1000).toFixed(0) + 'k' : v
                  },
                  grid: { color: '#f1f5f9' }
                }
              },
              plugins: {
                legend: { display: false },
                tooltip: {
                  backgroundColor: '#0f172a',
                  padding: 10,
                  cornerRadius: 8,
                  callbacks: {
                    title: (items) => {
                      const it = sorted[items[0].dataIndex];
                      return it ? it.sku + ' — ' + it.productName : '';
                    },
                    label: (ctx) => {
                      const it = sorted[ctx.dataIndex];
                      if (!it) return '';
                      return [
                        ' Tồn thực tế: ' + Number(it.onHand || 0).toLocaleString('vi-VN'),
                        ' Đang giữ chỗ: ' + Number(it.reserved || 0).toLocaleString('vi-VN'),
                        ' Khả dụng: ' + Number(it.available || 0).toLocaleString('vi-VN')
                      ];
                    }
                  }
                }
              }
            }
          });
        }
      },

      get filteredItems() {
        return this.items.filter(item => {
          const q = this.searchQuery.trim().toLowerCase();
          const matchesQ = !q || item.sku.toLowerCase().includes(q) || item.productName.toLowerCase().includes(q);
          const matchesCat = this.categoryFilter === 'all' || item.category === this.categoryFilter;
          const matchesStatus = this.statusFilter === 'all' || item.status === this.statusFilter;
          return matchesQ && matchesCat && matchesStatus;
        });
      },

      get filteredReceipts() {
        return this.receipts.filter(r => {
          const q = this.receiptSearch.trim().toLowerCase();
          return !q || r.code.toLowerCase().includes(q) || r.supplierName.toLowerCase().includes(q);
        });
      },

      get filteredTransactions() {
        return this.transactions.filter(t => {
          const q = this.txSkuFilter.trim().toLowerCase();
          const matchesSku = !q || t.sku.toLowerCase().includes(q) || (t.referenceCode && t.referenceCode.toLowerCase().includes(q));
          const matchesType = this.txTypeFilter === 'all' || t.type === this.txTypeFilter;
          return matchesSku && matchesType;
        });
      },

      // Actions
      async refreshAll() {
        this.loading = true;
        try {
          const [itemsRes, receiptsRes, txsRes] = await Promise.all([
            fetch('/api/admin/inventory/items'),
            fetch('/api/admin/inventory/receipts'),
            fetch('/api/admin/inventory/transactions')
          ]);
          const [itemsData, receiptsData, txsData] = await Promise.all([
            itemsRes.json(),
            receiptsRes.json(),
            txsRes.json()
          ]);
          if (itemsData.success) this.items = itemsData.data || [];
          if (receiptsData.success) this.receipts = receiptsData.data || [];
          if (txsData.success) this.transactions = txsData.data || [];
          this.renderCharts();
          this.showToast('Làm mới dữ liệu kho thành công!');
        } catch (e) {
          this.showToast('Lỗi khi tải lại dữ liệu kho', 'error');
        } finally {
          this.loading = false;
        }
      },

      openEditMinStock(item) {
        this.minStockModal.sku = item.sku;
        this.minStockModal.productName = item.productName;
        this.minStockModal.currentMin = item.minStock;
        this.minStockModal.newMin = item.minStock;
        this.minStockModal.available = item.available;
        this.minStockModal.open = true;
      },

      async saveMinStock() {
        if (this.minStockModal.newMin < 0) {
          alert('Định mức tối thiểu phải >= 0');
          return;
        }
        this.minStockModal.loading = true;
        try {
          const res = await fetch('/api/admin/inventory/items', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              sku: this.minStockModal.sku,
              minStock: Number(this.minStockModal.newMin)
            })
          });
          const data = await res.json();
          if (data.success) {
            const target = this.items.find(it => it.sku === this.minStockModal.sku);
            if (target) {
              target.minStock = data.data.minStock;
              target.status = data.data.status;
              target.statusLabel = data.data.statusLabel;
              this.renderCharts();
            }
            this.showToast('Đã cập nhật định mức tồn cho ' + this.minStockModal.sku);
            this.minStockModal.open = false;
          } else {
            alert('Lỗi: ' + (data.error || 'Không thể lưu định mức'));
          }
        } catch (e) {
          alert('Lỗi kết nối máy chủ khi lưu định mức');
        } finally {
          this.minStockModal.loading = false;
        }
      },

      openCreateReceipt(prefilledSku = '') {
        this.receiptModal.supplierName = '';
        this.receiptModal.deliverTo = 'Kho Tổng LA PET - TP.HCM';
        this.receiptModal.notes = '';
        if (prefilledSku) {
          const found = this.items.find(it => it.sku === prefilledSku);
          this.receiptModal.lines = [
            { sku: prefilledSku, productName: found ? found.productName : '', quantity: 10, priceUnit: 0 }
          ];
        } else {
          this.receiptModal.lines = [
            { sku: '', productName: '', quantity: 1, priceUnit: 0 }
          ];
        }
        this.receiptModal.open = true;
      },

      addLineToReceipt() {
        this.receiptModal.lines.push({ sku: '', productName: '', quantity: 1, priceUnit: 0 });
      },

      removeLineFromReceipt(idx) {
        if (this.receiptModal.lines.length > 1) {
          this.receiptModal.lines.splice(idx, 1);
        } else {
          alert('Phiếu nhập phải có ít nhất 1 dòng mặt hàng');
        }
      },

      onReceiptSkuSelected(idx) {
        const line = this.receiptModal.lines[idx];
        if (!line || !line.sku) return;
        const found = this.items.find(it => it.sku.toLowerCase() === line.sku.toLowerCase());
        if (found && !line.productName) {
          line.productName = found.productName;
        }
      },

      get receiptTotalQty() {
        return this.receiptModal.lines.reduce((acc, l) => acc + (Number(l.quantity) || 0), 0);
      },

      get receiptTotalAmount() {
        return this.receiptModal.lines.reduce((acc, l) => acc + ((Number(l.quantity) || 0) * (Number(l.priceUnit) || 0)), 0);
      },

      async submitReceipt() {
        if (!this.receiptModal.supplierName.trim()) {
          alert('Vui lòng nhập Tên nhà cung cấp');
          return;
        }
        for (const line of this.receiptModal.lines) {
          if (!line.sku.trim()) {
            alert('Vui lòng điền mã SKU cho tất cả các dòng');
            return;
          }
          if (!line.quantity || Number(line.quantity) <= 0) {
            alert('Số lượng nhập của SKU ' + line.sku + ' phải lớn hơn 0');
            return;
          }
        }

        this.receiptModal.loading = true;
        try {
          const payload = {
            supplierName: this.receiptModal.supplierName.trim(),
            deliverTo: this.receiptModal.deliverTo.trim(),
            notes: this.receiptModal.notes.trim(),
            lines: this.receiptModal.lines.map(l => ({
              sku: l.sku.trim(),
              productName: l.productName.trim(),
              quantity: Number(l.quantity),
              priceUnit: Number(l.priceUnit || 0)
            }))
          };

          const res = await fetch('/api/admin/inventory/receipts', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          const data = await res.json();
          if (data.success) {
            this.showToast('Tạo phiếu nhập ' + data.data.code + ' thành công! Đã tăng tồn kho.');
            this.receiptModal.open = false;
            await this.refreshAll();
            this.currentTab = 'receipts';
          } else {
            alert('Lỗi: ' + (data.error || 'Không thể tạo phiếu nhập'));
          }
        } catch (e) {
          alert('Lỗi máy chủ khi tạo phiếu nhập hàng');
        } finally {
          this.receiptModal.loading = false;
        }
      },

      viewReceiptDetail(receipt) {
        this.detailModal.receipt = receipt;
        this.detailModal.open = true;
      },

      formatVND(value) {
        if (!value) return '0 ₫';
        return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(value);
      },

      formatDate(dateStr) {
        if (!dateStr) return '---';
        const d = new Date(dateStr);
        return d.toLocaleDateString('vi-VN', {
          year: 'numeric',
          month: '2-digit',
          day: '2-digit',
          hour: '2-digit',
          minute: '2-digit'
        });
      }
    }`}
  >
    <!-- TOAST NOTIFICATION -->
    <div
      x-show="toast.show"
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0 translate-y-2"
      x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition ease-in duration-200"
      x-transition:leave-start="opacity-100 translate-y-0"
      x-transition:leave-end="opacity-0 translate-y-2"
      class="fixed bottom-6 right-6 z-50 flex items-center gap-3 px-5 py-3 rounded-2xl shadow-xl text-white font-medium text-sm"
      :class="toast.type === 'error' ? 'bg-rose-600' : 'bg-brand-primary'"
      x-cloak
    >
      <span x-text="toast.type === 'error' ? '✕' : '✔'"></span>
      <span x-text="toast.message"></span>
    </div>

    <!-- PAGE HEADER -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-2 border-b border-brand-border">
      <div>
        <div class="flex items-center gap-2.5">
          <div class="w-10 h-10 rounded-2xl bg-brand-dark text-brand-accent flex items-center justify-center shadow-xs">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 8.35V20a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8.35A2 2 0 0 1 3.26 6.5l8-4.8a2 2 0 0 1 2.08 0l8 4.8A2 2 0 0 1 22 8.35Z"></path>
              <path d="M6 18h12"></path>
              <path d="M6 14h12"></path>
              <rect width="4" height="6" x="10" y="16"></rect>
            </svg>
          </div>
          <div>
            <h1 class="text-2xl font-black text-brand-dark tracking-tight">Quản lý Kho Hàng Độc Lập</h1>
            <p class="text-xs text-brand-muted mt-0.5">Kiểm soát tồn kho thực tế, lập phiếu nhập hàng và theo dõi nhật ký biến động kho LA PET</p>
          </div>
        </div>
      </div>

      <div class="flex items-center flex-wrap gap-2.5">
        <button
          @click="refreshAll()"
          class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl border border-brand-border bg-white hover:bg-brand-sand text-brand-text text-xs font-bold transition-all shadow-2xs cursor-pointer"
          :disabled="loading"
        >
          <svg class="w-3.5 h-3.5 text-slate-500" :class="{ 'animate-spin': loading }" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
          </svg>
          <span>Làm mới</span>
        </button>

        <a
          href="/api/admin/inventory/export-excel"
          download
          class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl border border-emerald-300 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 text-xs font-bold transition-all shadow-2xs cursor-pointer"
          title="Xuất báo cáo tồn kho định dạng CSV UTF-8 BOM cho Excel"
        >
          <svg class="w-4 h-4 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
          <span>Xuất Báo Cáo Tồn Kho Excel</span>
        </a>

        <button
          @click="openCreateReceipt()"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-brand-primary hover:bg-brand-dark text-white text-xs font-bold transition-all shadow-xs hover:shadow-md cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          <span>Lập Phiếu Nhập Kho</span>
        </button>
      </div>
    </div>

    <!-- INVENTORY ANALYTICS CHARTS -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
      <!-- Chart 1: Cơ cấu Trạng thái Kho (Doughnut) -->
      <section class="lg:col-span-4 bg-white p-5 rounded-2xl border border-brand-border shadow-2xs flex flex-col justify-between">
        <div class="flex items-start justify-between gap-2 pb-3 border-b border-slate-100">
          <div>
            <h2 class="text-sm font-black text-brand-dark tracking-tight">Cơ Cấu Trạng Thái Kho</h2>
            <p class="text-[11px] text-slate-500 mt-0.5">Nhấn vào trạng thái để lọc nhanh SKU</p>
          </div>
          <span class="px-2.5 py-1 rounded-lg bg-slate-100 text-brand-dark text-xs font-extrabold font-mono" x-text="kpis.total + ' SKU'"></span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 items-center gap-4 my-4">
          <div class="relative h-40 w-full">
            <canvas id="khoStatusChart"></canvas>
            <div class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center">
              <span class="text-2xl font-black text-brand-dark leading-none font-mono" x-text="kpis.total"></span>
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mt-1">SKU</span>
            </div>
          </div>

          <div class="space-y-2 text-xs">
            <button
              type="button"
              @click="statusFilter = statusFilter === 'in_stock' ? 'all' : 'in_stock'; currentTab = 'overview'"
              class="w-full flex items-center justify-between px-3 py-2 rounded-xl border transition-all cursor-pointer"
              :class="statusFilter === 'in_stock' ? 'border-emerald-400 bg-emerald-50/70' : 'border-slate-100 hover:bg-slate-50'"
            >
              <span class="flex items-center gap-2 font-semibold text-slate-700">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                Đủ hàng
              </span>
              <span class="font-mono font-bold text-emerald-700" x-text="kpis.inStock + ' (' + (kpis.total ? Math.round((kpis.inStock / kpis.total) * 100) : 0) + '%)'"></span>
            </button>

            <button
              type="button"
              @click="statusFilter = statusFilter === 'low_stock' ? 'all' : 'low_stock'; currentTab = 'overview'"
              class="w-full flex items-center justify-between px-3 py-2 rounded-xl border transition-all cursor-pointer"
              :class="statusFilter === 'low_stock' ? 'border-amber-400 bg-amber-50/70' : 'border-slate-100 hover:bg-slate-50'"
            >
              <span class="flex items-center gap-2 font-semibold text-slate-700">
                <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
                Sắp hết
              </span>
              <span class="font-mono font-bold text-amber-600" x-text="kpis.lowStock + ' (' + (kpis.total ? Math.round((kpis.lowStock / kpis.total) * 100) : 0) + '%)'"></span>
            </button>

            <button
              type="button"
              @click="statusFilter = statusFilter === 'out_of_stock' ? 'all' : 'out_of_stock'; currentTab = 'overview'"
              class="w-full flex items-center justify-between px-3 py-2 rounded-xl border transition-all cursor-pointer"
              :class="statusFilter === 'out_of_stock' ? 'border-rose-400 bg-rose-50/70' : 'border-slate-100 hover:bg-slate-50'"
            >
              <span class="flex items-center gap-2 font-semibold text-slate-700">
                <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span>
                Hết hàng
              </span>
              <span class="font-mono font-bold text-rose-600" x-text="kpis.outOfStock + ' (' + (kpis.total ? Math.round((kpis.outOfStock / kpis.total) * 100) : 0) + '%)'"></span>
            </button>
          </div>
        </div>

        <div class="pt-3 border-t border-slate-100 grid grid-cols-3 gap-2 text-center text-[11px]">
          <div class="bg-slate-50 rounded-lg py-1.5 px-2">
            <span class="text-slate-400 block">Thực tế</span>
            <span class="font-mono font-bold text-brand-dark" x-text="kpis.onHand.toLocaleString('vi-VN')"></span>
          </div>
          <div class="bg-amber-50/60 rounded-lg py-1.5 px-2">
            <span class="text-amber-600 block">Giữ chỗ</span>
            <span class="font-mono font-bold text-amber-700" x-text="kpis.reserved.toLocaleString('vi-VN')"></span>
          </div>
          <div class="bg-emerald-50/60 rounded-lg py-1.5 px-2">
            <span class="text-emerald-600 block">Khả dụng</span>
            <span class="font-mono font-bold text-emerald-700" x-text="kpis.available.toLocaleString('vi-VN')"></span>
          </div>
        </div>
      </section>

      <!-- Chart 2: Phân bổ theo Ngành hàng (Horizontal Stacked Bar) -->
      <section class="lg:col-span-4 bg-white p-5 rounded-2xl border border-brand-border shadow-2xs flex flex-col">
        <div class="flex items-start justify-between gap-2 pb-3 border-b border-slate-100">
          <div>
            <h2 class="text-sm font-black text-brand-dark tracking-tight">Phân Bổ Theo Ngành Hàng</h2>
            <p class="text-[11px] text-slate-500 mt-0.5">Cơ cấu trạng thái SKU từng nhóm hàng</p>
          </div>
          <button
            type="button"
            x-show="categoryFilter !== 'all'"
            @click="categoryFilter = 'all'"
            class="text-[11px] font-bold text-[#087b80] hover:underline cursor-pointer"
          >
            Bỏ lọc
          </button>
        </div>

        <div class="relative flex-1 min-h-[225px] mt-3">
          <canvas id="khoCategoryChart"></canvas>
        </div>
      </section>

      <!-- Chart 3: Top 8 SKU (Reserved / On Hand Bar Chart) -->
      <section class="lg:col-span-4 bg-white p-5 rounded-2xl border border-brand-border shadow-2xs flex flex-col">
        <div class="flex items-start justify-between gap-2 pb-3 border-b border-slate-100">
          <div>
            <h2 class="text-sm font-black text-brand-dark tracking-tight">Top 8 SKU Theo Sản Lượng</h2>
            <p class="text-[11px] text-slate-500 mt-0.5">Nhấn vào cột để tìm nhanh SKU</p>
          </div>

          <div class="inline-flex rounded-lg bg-slate-100 p-0.5 text-[11px] font-bold shrink-0">
            <button
              type="button"
              @click="setTopSkuMetric('reserved')"
              class="px-2.5 py-1 rounded-md transition-all cursor-pointer"
              :class="topSkuMetric === 'reserved' ? 'bg-white text-[#083a3c] shadow-2xs' : 'text-slate-500 hover:text-slate-700'"
            >
              Giữ chỗ
            </button>
            <button
              type="button"
              @click="setTopSkuMetric('onHand')"
              class="px-2.5 py-1 rounded-md transition-all cursor-pointer"
              :class="topSkuMetric === 'onHand' ? 'bg-white text-[#083a3c] shadow-2xs' : 'text-slate-500 hover:text-slate-700'"
            >
              Thực tế
            </button>
          </div>
        </div>

        <div class="relative flex-1 min-h-[225px] mt-3">
          <canvas id="khoTopSkuChart"></canvas>
        </div>
      </section>
    </div>

    <!-- 3 TABS HEADER NAVIGATION -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-2xs overflow-hidden">
      <div class="flex items-center border-b border-slate-200 px-4 bg-slate-50/50 overflow-x-auto">
        <button
          @click="currentTab = 'overview'"
          class="flex items-center gap-2.5 py-3.5 px-4 text-xs font-bold tracking-tight border-b-2 whitespace-nowrap transition-all cursor-pointer"
          :class="currentTab === 'overview' ? 'border-[#087b80] text-[#083a3c] bg-white font-extrabold' : 'border-transparent text-slate-500 hover:text-slate-800'"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
          </svg>
          <span>Tổng Quan Tồn Kho</span>
          <span
            class="px-2 py-0.5 rounded-full text-[10px]"
            :class="currentTab === 'overview' ? 'bg-[#087b80]/10 text-[#087b80]' : 'bg-slate-200 text-slate-600'"
            x-text="items.length"
          >
            {totalSkus}
          </span>
        </button>

        <button
          @click="currentTab = 'receipts'"
          class="flex items-center gap-2.5 py-3.5 px-4 text-xs font-bold tracking-tight border-b-2 whitespace-nowrap transition-all cursor-pointer"
          :class="currentTab === 'receipts' ? 'border-[#087b80] text-[#083a3c] bg-white font-extrabold' : 'border-transparent text-slate-500 hover:text-slate-800'"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
          <span>Phiếu Nhập Kho (PO)</span>
          <span
            class="px-2 py-0.5 rounded-full text-[10px]"
            :class="currentTab === 'receipts' ? 'bg-[#087b80]/10 text-[#087b80]' : 'bg-slate-200 text-slate-600'"
            x-text="receipts.length"
          >
            {initialReceipts.length}
          </span>
        </button>

        <button
          @click="currentTab = 'transactions'"
          class="flex items-center gap-2.5 py-3.5 px-4 text-xs font-bold tracking-tight border-b-2 whitespace-nowrap transition-all cursor-pointer"
          :class="currentTab === 'transactions' ? 'border-[#087b80] text-[#083a3c] bg-white font-extrabold' : 'border-transparent text-slate-500 hover:text-slate-800'"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span>Lịch Sử Biến Động Kho</span>
          <span
            class="px-2 py-0.5 rounded-full text-[10px]"
            :class="currentTab === 'transactions' ? 'bg-[#087b80]/10 text-[#087b80]' : 'bg-slate-200 text-slate-600'"
            x-text="transactions.length"
          >
            {initialTransactions.length}
          </span>
        </button>
      </div>

      <!-- ========================================================= -->
      <!-- TAB 1: TỔNG QUAN TỒN KHO                                   -->
      <!-- ========================================================= -->
      <div x-show="currentTab === 'overview'" class="p-4 space-y-4">
        <!-- Filter Toolbar -->
        <div class="flex flex-col md:flex-row gap-3 items-stretch md:items-center justify-between">
          <div class="flex flex-col sm:flex-row gap-2.5 flex-1">
            <!-- Search -->
            <div class="relative flex-1">
              <input
                type="text"
                x-model="searchQuery"
                placeholder="Tìm kiếm theo mã SKU, tên sản phẩm..."
                class="w-full pl-9 pr-4 py-2 rounded-xl border border-slate-300 text-xs focus:outline-none focus:ring-2 focus:ring-[#087b80] bg-white"
              />
              <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.3-4.3"></path>
              </svg>
              <button
                x-show="searchQuery"
                @click="searchQuery = ''"
                class="absolute right-3 top-2.5 text-xs text-slate-400 hover:text-slate-600"
              >✕</button>
            </div>

            <!-- Category Filter -->
            <select
              x-model="categoryFilter"
              class="px-3 py-2 rounded-xl border border-slate-300 text-xs focus:outline-none focus:ring-2 focus:ring-[#087b80] bg-white text-slate-700"
            >
              <option value="all">Tất cả ngành hàng</option>
              {categories.map((cat) => (
                <option value={cat}>{cat}</option>
              ))}
            </select>

            <!-- Status Filter -->
            <select
              x-model="statusFilter"
              class="px-3 py-2 rounded-xl border border-slate-300 text-xs focus:outline-none focus:ring-2 focus:ring-[#087b80] bg-white text-slate-700"
            >
              <option value="all">Tất cả trạng thái</option>
              <option value="in_stock">Đủ hàng</option>
              <option value="low_stock">Sắp hết</option>
              <option value="out_of_stock">Hết hàng</option>
            </select>
          </div>

          <div class="text-xs text-slate-500 text-right self-end md:self-center">
            Hiển thị <span class="font-bold text-[#083a3c]" x-text="filteredItems.length"></span> / <span x-text="items.length"></span> mặt hàng
          </div>
        </div>

        <!-- Inventory Items Table -->
        <div class="overflow-x-auto rounded-xl border border-slate-200">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-100/75 text-slate-600 font-bold uppercase text-[11px] border-b border-slate-200">
              <tr>
                <th class="py-3 px-3 w-14">Ảnh</th>
                <th class="py-3 px-3">Mã SKU</th>
                <th class="py-3 px-3 min-w-[200px]">Tên sản phẩm</th>
                <th class="py-3 px-3">Ngành hàng</th>
                <th class="py-3 px-3 text-right">Tồn thực tế<br><span class="text-[9px] text-slate-400 font-normal">On Hand</span></th>
                <th class="py-3 px-3 text-right">Đang giữ<br><span class="text-[9px] text-slate-400 font-normal">Reserved</span></th>
                <th class="py-3 px-3 text-right font-extrabold text-[#087b80]">Tồn khả dụng<br><span class="text-[9px] text-[#087b80]/70 font-normal">Available</span></th>
                <th class="py-3 px-3 text-center">Định mức tối thiểu<br><span class="text-[9px] text-slate-400 font-normal">Min Stock</span></th>
                <th class="py-3 px-3 text-center">Trạng thái kho</th>
                <th class="py-3 px-3 text-right w-28">Thao tác</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 bg-white">
              <template x-for="item in filteredItems" :key="item.id">
                <tr class="hover:bg-slate-50/80 transition-colors">
                  <!-- Image -->
                  <td class="py-2.5 px-3">
                    <div class="w-10 h-10 rounded-lg bg-white overflow-hidden flex items-center justify-center shrink-0 border border-slate-200/60 p-0.5">
                      <template x-if="item.imageUrl">
                        <img
                          :src="item.imageUrl"
                          :alt="item.productName"
                          loading="lazy"
                          onerror="this.onerror=null;this.src='/images/placeholder-product.svg';"
                          class="w-full h-full object-contain"
                        />
                      </template>
                      <template x-if="!item.imageUrl">
                        <svg class="w-5 h-5 text-slate-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                          <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                          <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                          <line x1="12" y1="22.08" x2="12" y2="12"></line>
                        </svg>
                      </template>
                    </div>
                  </td>

                  <!-- SKU -->
                  <td class="py-2.5 px-3 font-mono font-bold text-slate-800" x-text="item.sku"></td>

                  <!-- Product Name -->
                  <td class="py-2.5 px-3 font-medium text-slate-900">
                    <span x-text="item.productName"></span>
                    <span class="block text-[10px] text-slate-400" x-text="item.brand || 'LA PET'"></span>
                  </td>

                  <!-- Category -->
                  <td class="py-2.5 px-3">
                    <span class="px-2 py-0.5 rounded-md bg-slate-100 text-slate-600 text-[10px] font-medium whitespace-nowrap" x-text="item.category || 'Chung'"></span>
                  </td>

                  <!-- On Hand -->
                  <td class="py-2.5 px-3 text-right font-semibold text-slate-800" x-text="item.onHand"></td>

                  <!-- Reserved -->
                  <td class="py-2.5 px-3 text-right font-semibold" :class="item.reserved > 0 ? 'text-amber-600' : 'text-slate-400'" x-text="item.reserved"></td>

                  <!-- Available -->
                  <td class="py-2.5 px-3 text-right font-bold text-sm">
                    <span
                      :class="item.available <= 0 ? 'text-rose-600 font-black' : (item.available <= item.minStock ? 'text-amber-600' : 'text-emerald-700')"
                      x-text="item.available"
                    ></span>
                  </td>

                  <!-- Min Stock -->
                  <td class="py-2.5 px-3 text-center">
                    <button
                      @click="openEditMinStock(item)"
                      class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-amber-50 text-slate-700 hover:text-amber-700 border border-slate-200 text-xs font-bold transition-all cursor-pointer"
                      title="Sửa định mức tồn tối thiểu"
                    >
                      <span x-text="item.minStock"></span>
                      <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
                      </svg>
                    </button>
                  </td>

                  <!-- Status Badge -->
                  <td class="py-2.5 px-3 text-center">
                    <span
                      class="px-2.5 py-1 rounded-full text-[11px] font-bold border inline-block whitespace-nowrap"
                      :class="{
                        'bg-emerald-50 text-emerald-700 border-emerald-200': item.status === 'in_stock',
                        'bg-amber-50 text-amber-700 border-amber-200': item.status === 'low_stock',
                        'bg-rose-50 text-rose-700 border-rose-200': item.status === 'out_of_stock'
                      }"
                      x-text="item.status === 'in_stock' ? 'Đủ hàng' : (item.status === 'low_stock' ? 'Sắp hết' : 'Hết hàng')"
                    ></span>
                  </td>

                  <!-- Actions -->
                  <td class="py-2.5 px-3 text-right">
                    <div class="flex items-center justify-end gap-1.5">
                      <button
                        @click="openCreateReceipt(item.sku)"
                        class="p-1.5 rounded-lg bg-[#087b80]/10 hover:bg-[#087b80] text-[#087b80] hover:text-white transition-colors cursor-pointer"
                        title="Tạo phiếu nhập cho sản phẩm này"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                        </svg>
                      </button>
                      <button
                        @click="openEditMinStock(item)"
                        class="p-1.5 rounded-lg bg-amber-500/10 hover:bg-amber-500 text-amber-700 hover:text-white transition-colors cursor-pointer"
                        title="Sửa định mức tồn tối thiểu"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
                        </svg>
                      </button>
                    </div>
                  </td>
                </tr>
              </template>

              <tr x-show="filteredItems.length === 0">
                <td colspan="10" class="py-8 text-center text-slate-400">
                  Không tìm thấy mặt hàng nào phù hợp với bộ lọc.
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- ========================================================= -->
      <!-- TAB 2: PHIẾU NHẬP KHO (PURCHASE RECEIPTS)                  -->
      <!-- ========================================================= -->
      <div x-show="currentTab === 'receipts'" class="p-4 space-y-4" x-cloak>
        <div class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center justify-between">
            <div class="relative flex-1 max-w-md">
            <input
              type="text"
              x-model="receiptSearch"
              placeholder="Tìm theo mã phiếu PNK, tên nhà cung cấp..."
              class="w-full pl-9 pr-4 py-2 rounded-xl border border-slate-300 text-xs focus:outline-none focus:ring-2 focus:ring-[#087b80] bg-white"
            />
            <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>
          </div>

          <button
            @click="openCreateReceipt()"
            class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-xl bg-[#087b80] hover:bg-[#066367] text-white text-xs font-bold transition-all shadow-xs cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            <span>Tạo Phiếu Nhập Mới</span>
          </button>
        </div>

        <div class="overflow-x-auto rounded-xl border border-slate-200">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-100/75 text-slate-600 font-bold uppercase text-[11px] border-b border-slate-200">
              <tr>
                <th class="py-3 px-4">Mã Phiếu</th>
                <th class="py-3 px-4">Nhà cung cấp</th>
                <th class="py-3 px-4">Địa điểm nhận</th>
                <th class="py-3 px-4">Ngày nhập</th>
                <th class="py-3 px-4 text-center">Số dòng SP</th>
                <th class="py-3 px-4 text-right">Tổng số lượng</th>
                <th class="py-3 px-4 text-right">Tổng giá trị</th>
                <th class="py-3 px-4 text-center">Trạng thái</th>
                <th class="py-3 px-4 text-right">Chi tiết</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 bg-white">
              <template x-for="r in filteredReceipts" :key="r.id">
                <tr class="hover:bg-slate-50/80 transition-colors">
                  <td class="py-3 px-4 font-mono font-bold text-[#087b80]" x-text="r.code"></td>
                  <td class="py-3 px-4 font-medium text-slate-900" x-text="r.supplierName"></td>
                  <td class="py-3 px-4 text-slate-500 text-xs" x-text="r.deliverTo || 'Kho Tổng TP.HCM'"></td>
                  <td class="py-3 px-4 text-slate-600" x-text="r.receiptDate"></td>
                  <td class="py-3 px-4 text-center">
                    <span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-700 font-semibold text-[10px]" x-text="r.lines ? r.lines.length : 0"></span>
                  </td>
                  <td class="py-3 px-4 text-right font-bold text-slate-800" x-text="r.totalQuantity"></td>
                  <td class="py-3 px-4 text-right font-bold text-emerald-700" x-text="formatVND(r.totalAmount)"></td>
                  <td class="py-3 px-4 text-center">
                    <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 inline-block">
                      Hoàn tất
                    </span>
                  </td>
                  <td class="py-3 px-4 text-right">
                    <button
                      @click="viewReceiptDetail(r)"
                      class="px-2.5 py-1 rounded-lg border border-slate-200 hover:bg-slate-100 text-slate-700 text-xs font-semibold transition-colors cursor-pointer"
                    >
                      Xem chi tiết
                    </button>
                  </td>
                </tr>
              </template>

              <tr x-show="filteredReceipts.length === 0">
                <td colspan="9" class="py-8 text-center text-slate-400">
                  Không có phiếu nhập kho nào phù hợp.
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- ========================================================= -->
      <!-- TAB 3: LỊCH SỬ BIẾN ĐỘNG KHO (AUDIT LEDGER)                -->
      <!-- ========================================================= -->
      <div x-show="currentTab === 'transactions'" class="p-4 space-y-4" x-cloak>
        <div class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center justify-between">
          <div class="flex flex-col sm:flex-row gap-2.5 flex-1 max-w-xl">
            <div class="relative flex-1">
              <input
                type="text"
                x-model="txSkuFilter"
                placeholder="Lọc theo mã SKU hoặc mã chứng từ..."
                class="w-full pl-9 pr-4 py-2 rounded-xl border border-slate-300 text-xs focus:outline-none focus:ring-2 focus:ring-[#087b80] bg-white"
              />
              <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.3-4.3"></path>
              </svg>
            </div>

            <select
              x-model="txTypeFilter"
              class="px-3 py-2 rounded-xl border border-slate-300 text-xs focus:outline-none focus:ring-2 focus:ring-[#087b80] bg-white text-slate-700"
            >
              <option value="all">Tất cả loại giao dịch</option>
              <option value="IMPORT">IMPORT (Nhập kho)</option>
              <option value="SALE">SALE (Xuất bán)</option>
              <option value="RESERVE">RESERVE (Giữ hàng)</option>
              <option value="ADJUSTMENT">ADJUSTMENT (Điều chỉnh)</option>
              <option value="INITIAL_STOCK">INITIAL_STOCK (Tồn đầu kỳ)</option>
              <option value="DAMAGE">DAMAGE (Hao hụt/Hỏng)</option>
            </select>
          </div>

          <div class="text-xs text-slate-500 text-right self-end sm:self-center">
            Tổng cộng: <span class="font-bold text-[#083a3c]" x-text="filteredTransactions.length"></span> lượt biến động
          </div>
        </div>

        <div class="overflow-x-auto rounded-xl border border-slate-200">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-100/75 text-slate-600 font-bold uppercase text-[11px] border-b border-slate-200">
              <tr>
                <th class="py-3 px-3">Thời gian</th>
                <th class="py-3 px-3">Mã SKU</th>
                <th class="py-3 px-3 min-w-[180px]">Tên sản phẩm</th>
                <th class="py-3 px-3 text-center">Loại giao dịch</th>
                <th class="py-3 px-3 text-right">Biến động</th>
                <th class="py-3 px-3 text-right">Tồn trước</th>
                <th class="py-3 px-3 text-right">Tồn sau</th>
                <th class="py-3 px-3">Mã chứng từ</th>
                <th class="py-3 px-3">Người thực hiện</th>
                <th class="py-3 px-3">Ghi chú</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 bg-white">
              <template x-for="t in filteredTransactions" :key="t.id">
                <tr class="hover:bg-slate-50/80 transition-colors">
                  <td class="py-2.5 px-3 text-slate-500 font-mono text-[11px]" x-text="formatDate(t.dateCreated || t.performedAt)"></td>
                  <td class="py-2.5 px-3 font-mono font-bold text-slate-800" x-text="t.sku"></td>
                  <td class="py-2.5 px-3 text-slate-700" x-text="t.productName || t.sku"></td>
                  <td class="py-2.5 px-3 text-center">
                    <span
                      class="px-2 py-0.5 rounded-md text-[10px] font-bold border inline-block whitespace-nowrap"
                      :class="{
                        'bg-emerald-50 text-emerald-700 border-emerald-200': t.type === 'IMPORT',
                        'bg-blue-50 text-blue-700 border-blue-200': t.type === 'SALE',
                        'bg-amber-50 text-amber-700 border-amber-200': t.type === 'RESERVE',
                        'bg-purple-50 text-purple-700 border-purple-200': t.type === 'INITIAL_STOCK' || t.type === 'ADJUSTMENT' || t.type === 'ADJUSTMENT_IN' || t.type === 'ADJUSTMENT_OUT',
                        'bg-rose-50 text-rose-700 border-rose-200': t.type === 'DAMAGE'
                      }"
                      x-text="t.type"
                    ></span>
                  </td>
                  <td class="py-2.5 px-3 text-right font-black" :class="t.quantity > 0 ? 'text-emerald-700' : 'text-rose-600'">
                    <span x-text="t.quantity > 0 ? '+' + t.quantity : t.quantity"></span>
                  </td>
                  <td class="py-2.5 px-3 text-right text-slate-500 font-mono" x-text="t.quantityBefore"></td>
                  <td class="py-2.5 px-3 text-right font-bold text-slate-900 font-mono" x-text="t.quantityAfter"></td>
                  <td class="py-2.5 px-3 font-mono font-semibold text-[#087b80]" x-text="t.referenceCode || '---'"></td>
                  <td class="py-2.5 px-3 text-slate-600 text-[11px]" x-text="t.performedBy || 'Quản trị viên'"></td>
                  <td class="py-2.5 px-3 text-slate-500 text-[11px] truncate max-w-[200px]" :title="t.notes || t.reason" x-text="t.notes || t.reason || '---'"></td>
                </tr>
              </template>

              <tr x-show="filteredTransactions.length === 0">
                <td colspan="10" class="py-8 text-center text-slate-400">
                  Không có nhật ký biến động kho nào phù hợp.
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ========================================================= -->
    <!-- MODAL 1: SỬA NHANH ĐỊNH MỨC TỒN TỐI THIỂU (MIN STOCK)     -->
    <!-- ========================================================= -->
    <div
      x-show="minStockModal.open"
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-xs"
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      x-cloak
    >
      <div
        @click.outside="minStockModal.open = false"
        class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200 space-y-4"
      >
        <div class="flex items-center justify-between pb-3 border-b border-slate-200">
          <div class="flex items-center gap-2">
            <span class="w-8 h-8 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
                <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
              </svg>
            </span>
            <h3 class="font-bold text-base text-[#083a3c]">Cài Đặt Định Mức Tồn Tối Thiểu</h3>
          </div>
          <button @click="minStockModal.open = false" class="text-slate-400 hover:text-slate-600 text-lg cursor-pointer">✕</button>
        </div>

        <div class="space-y-3">
          <div>
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Sản phẩm & SKU</span>
            <p class="font-bold text-slate-900 text-sm mt-0.5" x-text="minStockModal.productName"></p>
            <p class="font-mono text-xs text-[#087b80] mt-0.5">SKU: <strong x-text="minStockModal.sku"></strong></p>
          </div>

          <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 text-xs flex justify-between items-center">
            <span class="text-slate-600">Tồn khả dụng hiện tại:</span>
            <span class="font-bold text-sm text-slate-800" x-text="minStockModal.available + ' đơn vị'"></span>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">
              Định mức tồn tối thiểu mới (Min Stock) <span class="text-rose-500">*</span>
            </label>
            <input
              type="number"
              min="0"
              x-model="minStockModal.newMin"
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-[#087b80]"
            />
            <p class="text-[11px] text-slate-400 mt-1">
              Hệ thống sẽ chuyển trạng thái sang <strong>"Sắp hết hàng"</strong> khi Tồn khả dụng nhỏ hơn hoặc bằng định mức này.
            </p>
          </div>
        </div>

        <div class="pt-3 border-t border-slate-200 flex items-center justify-end gap-2.5">
          <button
            type="button"
            @click="minStockModal.open = false"
            class="px-4 py-2 rounded-xl border border-slate-200 text-xs font-bold text-slate-600 hover:bg-slate-50 transition-colors cursor-pointer"
          >
            Hủy
          </button>
          <button
            type="button"
            @click="saveMinStock()"
            class="px-5 py-2 rounded-xl bg-[#087b80] hover:bg-[#066367] text-white text-xs font-bold transition-all shadow-xs cursor-pointer flex items-center gap-2"
            :disabled="minStockModal.loading"
          >
            <svg x-show="minStockModal.loading" class="animate-spin w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span>Lưu Thay Đổi</span>
          </button>
        </div>
      </div>
    </div>

    <!-- ========================================================= -->
    <!-- MODAL 2: TẠO PHIẾU NHẬP KHO MỚI (GOODS RECEIPT)           -->
    <!-- ========================================================= -->
    <div
      x-show="receiptModal.open"
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-xs overflow-y-auto"
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      x-cloak
    >
      <div
        @click.outside="receiptModal.open = false"
        class="bg-white rounded-2xl max-w-2xl w-full p-6 shadow-2xl border border-slate-200 space-y-5 my-8"
      >
        <div class="flex items-center justify-between pb-3 border-b border-slate-200">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-xl bg-[#087b80]/10 text-[#087b80] flex items-center justify-center">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-base text-[#083a3c]">Lập Phiếu Nhập Hàng Mới</h3>
              <p class="text-[11px] text-slate-400">Tăng tồn thực tế On hand và ghi nhận lịch sử biến động kho</p>
            </div>
          </div>
          <button @click="receiptModal.open = false" class="text-slate-400 hover:text-slate-600 text-lg cursor-pointer">✕</button>
        </div>

        <div class="space-y-4">
          <!-- Form Header -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">
                Nhà cung cấp / Nguồn nhập <span class="text-rose-500">*</span>
              </label>
              <input
                type="text"
                x-model="receiptModal.supplierName"
                placeholder="vd: Công ty TNHH Royal Canin Việt Nam"
                class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-xs focus:outline-none focus:ring-2 focus:ring-[#087b80]"
              />
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Kho nhận hàng</label>
              <input
                type="text"
                x-model="receiptModal.deliverTo"
                class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-xs focus:outline-none focus:ring-2 focus:ring-[#087b80]"
              />
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Ghi chú phiếu nhập</label>
            <input
              type="text"
              x-model="receiptModal.notes"
              placeholder="vd: Nhập bổ sung tồn kho đợt cuối tháng"
              class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-xs focus:outline-none focus:ring-2 focus:ring-[#087b80]"
            />
          </div>

          <!-- Line Items List -->
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-slate-700 uppercase tracking-wider">Danh sách mặt hàng nhập</span>
              <button
                type="button"
                @click="addLineToReceipt()"
                class="inline-flex items-center gap-1 text-xs font-bold text-[#087b80] hover:text-[#066367] cursor-pointer"
              >
                + Thêm dòng mặt hàng
              </button>
            </div>

            <div class="border border-slate-200 rounded-xl overflow-hidden">
              <table class="w-full text-xs">
                <thead class="bg-slate-50 border-b border-slate-200 text-slate-600 font-bold text-[11px]">
                  <tr>
                    <th class="py-2.5 px-3 text-left">Mã SKU</th>
                    <th class="py-2.5 px-3 text-left">Tên mặt hàng</th>
                    <th class="py-2.5 px-3 text-right w-24">Số lượng</th>
                    <th class="py-2.5 px-3 text-right w-28">Đơn giá nhập</th>
                    <th class="py-2.5 px-3 text-right w-28">Thành tiền</th>
                    <th class="py-2.5 px-3 w-10 text-center">Xóa</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  <template x-for="(line, idx) in receiptModal.lines" :key="idx">
                    <tr>
                      <!-- SKU input / datalist -->
                      <td class="py-2 px-3">
                        <input
                          type="text"
                          x-model="line.sku"
                          @change="onReceiptSkuSelected(idx)"
                          list="sku-options"
                          placeholder="Nhập SKU..."
                          class="w-full px-2 py-1.5 rounded-lg border border-slate-300 text-xs font-mono font-bold focus:outline-none focus:ring-1 focus:ring-[#087b80]"
                        />
                      </td>

                      <!-- Product Name -->
                      <td class="py-2 px-3">
                        <input
                          type="text"
                          x-model="line.productName"
                          placeholder="Tên sản phẩm..."
                          class="w-full px-2 py-1.5 rounded-lg border border-slate-300 text-xs focus:outline-none focus:ring-1 focus:ring-[#087b80]"
                        />
                      </td>

                      <!-- Quantity -->
                      <td class="py-2 px-3 text-right">
                        <input
                          type="number"
                          min="1"
                          x-model.number="line.quantity"
                          class="w-20 px-2 py-1.5 rounded-lg border border-slate-300 text-xs text-right font-bold focus:outline-none focus:ring-1 focus:ring-[#087b80]"
                        />
                      </td>

                      <!-- Price Unit -->
                      <td class="py-2 px-3 text-right">
                        <input
                          type="number"
                          min="0"
                          step="1000"
                          x-model.number="line.priceUnit"
                          class="w-24 px-2 py-1.5 rounded-lg border border-slate-300 text-xs text-right focus:outline-none focus:ring-1 focus:ring-[#087b80]"
                        />
                      </td>

                      <!-- Subtotal -->
                      <td class="py-2 px-3 text-right font-bold text-slate-800" x-text="formatVND((line.quantity || 0) * (line.priceUnit || 0))"></td>

                      <!-- Delete -->
                      <td class="py-2 px-3 text-center">
                        <button
                          type="button"
                          @click="removeLineFromReceipt(idx)"
                          class="text-slate-400 hover:text-rose-600 transition-colors cursor-pointer"
                        >✕</button>
                      </td>
                    </tr>
                  </template>
                </tbody>
              </table>

              <!-- Datalist for autocomplete -->
              <datalist id="sku-options">
                <template x-for="item in items" :key="item.sku">
                  <option :value="item.sku" x-text="item.productName"></option>
                </template>
              </datalist>
            </div>

            <!-- Receipt Totals Summary -->
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 flex items-center justify-between text-xs font-bold">
              <span class="text-slate-600">Tổng cộng:</span>
              <div class="flex items-center gap-4">
                <span>Số lượng: <span class="text-[#083a3c] text-sm" x-text="receiptTotalQty"></span></span>
                <span>Tổng tiền: <span class="text-emerald-700 text-sm" x-text="formatVND(receiptTotalAmount)"></span></span>
              </div>
            </div>
          </div>
        </div>

        <div class="pt-3 border-t border-slate-200 flex items-center justify-end gap-2.5">
          <button
            type="button"
            @click="receiptModal.open = false"
            class="px-4 py-2 rounded-xl border border-slate-200 text-xs font-bold text-slate-600 hover:bg-slate-50 transition-colors cursor-pointer"
          >
            Hủy
          </button>
          <button
            type="button"
            @click="submitReceipt()"
            class="px-5 py-2 rounded-xl bg-[#087b80] hover:bg-[#066367] text-white text-xs font-bold transition-all shadow-xs cursor-pointer flex items-center gap-2"
            :disabled="receiptModal.loading"
          >
            <svg x-show="receiptModal.loading" class="animate-spin w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span>Xác Nhận Nhập Kho</span>
          </button>
        </div>
      </div>
    </div>

    <!-- ========================================================= -->
    <!-- MODAL 3: XEM CHI TIẾT PHIẾU NHẬP KHO                       -->
    <!-- ========================================================= -->
    <div
      x-show="detailModal.open"
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-xs"
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      x-cloak
    >
      <div
        @click.outside="detailModal.open = false"
        class="bg-white rounded-2xl max-w-xl w-full p-6 shadow-2xl border border-slate-200 space-y-4"
      >
        <template x-if="detailModal.receipt">
          <div>
            <div class="flex items-center justify-between pb-3 border-b border-slate-200">
              <div>
                <span class="text-[11px] font-bold text-slate-400 uppercase">Chi tiết phiếu nhập</span>
                <h3 class="font-extrabold text-base text-[#083a3c] font-mono mt-0.5" x-text="detailModal.receipt.code"></h3>
              </div>
              <button @click="detailModal.open = false" class="text-slate-400 hover:text-slate-600 text-lg cursor-pointer">✕</button>
            </div>

            <div class="space-y-3 mt-4 text-xs">
              <div class="grid grid-cols-2 gap-2 p-3 rounded-xl bg-slate-50 border border-slate-200">
                <div>
                  <span class="text-slate-400 block text-[10px]">Nhà cung cấp:</span>
                  <span class="font-bold text-slate-800" x-text="detailModal.receipt.supplierName"></span>
                </div>
                <div>
                  <span class="text-slate-400 block text-[10px]">Kho giao:</span>
                  <span class="font-bold text-slate-800" x-text="detailModal.receipt.deliverTo || 'Kho Tổng TP.HCM'"></span>
                </div>
                <div class="mt-2">
                  <span class="text-slate-400 block text-[10px]">Ngày nhập:</span>
                  <span class="font-semibold text-slate-700" x-text="detailModal.receipt.receiptDate"></span>
                </div>
                <div class="mt-2">
                  <span class="text-slate-400 block text-[10px]">Trạng thái:</span>
                  <span class="font-bold text-emerald-700">Hoàn tất</span>
                </div>
              </div>

              <!-- Line items -->
              <div class="border border-slate-200 rounded-xl overflow-hidden mt-3">
                <table class="w-full text-xs">
                  <thead class="bg-slate-100 text-slate-600 font-bold text-[11px]">
                    <tr>
                      <th class="py-2 px-3 text-left">Mã SKU</th>
                      <th class="py-2 px-3 text-left">Tên mặt hàng</th>
                      <th class="py-2 px-3 text-right">Số lượng</th>
                      <th class="py-2 px-3 text-right">Đơn giá</th>
                      <th class="py-2 px-3 text-right">Thành tiền</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100">
                    <template x-for="line in (detailModal.receipt.lines || [])" :key="line.sku">
                      <tr>
                        <td class="py-2 px-3 font-mono font-bold text-slate-800" x-text="line.sku"></td>
                        <td class="py-2 px-3 text-slate-700" x-text="line.productName || line.sku"></td>
                        <td class="py-2 px-3 text-right font-bold text-slate-900" x-text="line.quantity"></td>
                        <td class="py-2 px-3 text-right text-slate-600" x-text="formatVND(line.priceUnit)"></td>
                        <td class="py-2 px-3 text-right font-bold text-emerald-700" x-text="formatVND((line.quantity || 0) * (line.priceUnit || 0))"></td>
                      </tr>
                    </template>
                  </tbody>
                </table>
              </div>

              <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 flex justify-between items-center font-bold">
                <span class="text-slate-600">Tổng giá trị phiếu nhập:</span>
                <span class="text-base text-emerald-700" x-text="formatVND(detailModal.receipt.totalAmount)"></span>
              </div>
            </div>

            <div class="pt-3 border-t border-slate-200 flex justify-between items-center mt-4">
              <button
                type="button"
                @click="window.print()"
                class="px-4 py-2 rounded-xl bg-[#087b80] hover:bg-[#066367] text-white text-xs font-bold transition-colors cursor-pointer flex items-center gap-1.5"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="6 9 6 2 18 2 18 9"></polyline>
                  <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                  <rect x="6" y="14" width="12" height="8"></rect>
                </svg>
                <span>Xuất PDF / In Phiếu (A4)</span>
              </button>
              <button
                type="button"
                @click="detailModal.open = false"
                class="px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-xs font-bold text-slate-700 transition-colors cursor-pointer"
              >
                Đóng
              </button>
            </div>
          </div>
        </template>
      </div>
    </div>

    <!-- MẪU IN A4: PHIẾU NHẬP KHO (PRINT-ONLY) -->
    <div id="print-receipt-area" class="hidden">
      <template x-if="detailModal.receipt">
        <div>
          <div class="border-b-2 border-black pb-3 mb-4 flex justify-between items-start">
            <div>
              <p class="text-sm font-black uppercase">CÔNG TY TNHH THƯƠNG MẠI DỊCH VỤ LA PET</p>
              <p class="text-[11px]" x-text="'Kho nhận hàng: ' + (detailModal.receipt.deliverTo || 'Kho Tổng LA PET - TP.HCM')"></p>
            </div>
            <div class="text-right">
              <h2 class="text-base font-black uppercase">PHIẾU NHẬP KHO HÀNG HÓA</h2>
              <p class="text-xs font-mono font-bold" x-text="'Số phiếu: ' + detailModal.receipt.code"></p>
              <p class="text-[11px]" x-text="'Ngày nhập: ' + detailModal.receipt.receiptDate"></p>
            </div>
          </div>

          <div class="border border-black p-2.5 mb-4 text-xs">
            <p>Đơn vị cung cấp / Nguồn nhập: <strong x-text="detailModal.receipt.supplierName"></strong></p>
            <p>Ghi chú nhập kho: <span x-text="detailModal.receipt.notes || 'Nhập hàng đạt chuẩn QC'"></span></p>
          </div>

          <table class="w-full border-collapse border border-black text-xs mb-6">
            <thead>
              <tr class="bg-slate-100 font-bold text-center">
                <th class="border border-black p-1.5 w-10">STT</th>
                <th class="border border-black p-1.5">Mã SKU</th>
                <th class="border border-black p-1.5 text-left">Tên mặt hàng</th>
                <th class="border border-black p-1.5 text-right">Số lượng nhập</th>
                <th class="border border-black p-1.5 text-right">Đơn giá nhập</th>
                <th class="border border-black p-1.5 text-right">Thành tiền</th>
              </tr>
            </thead>
            <tbody>
              <template x-for="(line, idx) in (detailModal.receipt.lines || [])" :key="'pr-' + idx">
                <tr>
                  <td class="border border-black p-1.5 text-center" x-text="idx + 1"></td>
                  <td class="border border-black p-1.5 font-mono font-bold text-center" x-text="line.sku"></td>
                  <td class="border border-black p-1.5" x-text="line.productName || line.sku"></td>
                  <td class="border border-black p-1.5 text-right font-bold" x-text="line.quantity"></td>
                  <td class="border border-black p-1.5 text-right" x-text="formatVND(line.priceUnit)"></td>
                  <td class="border border-black p-1.5 text-right font-bold" x-text="formatVND((line.quantity || 0) * (line.priceUnit || 0))"></td>
                </tr>
              </template>
            </tbody>
            <tfoot>
              <tr class="font-bold bg-slate-50">
                <td colspan="3" class="border border-black p-1.5 text-right uppercase">Tổng cộng phiếu nhập:</td>
                <td class="border border-black p-1.5 text-right" x-text="detailModal.receipt.totalQuantity"></td>
                <td class="border border-black p-1.5"></td>
                <td class="border border-black p-1.5 text-right" x-text="formatVND(detailModal.receipt.totalAmount)"></td>
              </tr>
            </tfoot>
          </table>

          <div class="grid grid-cols-3 text-center text-xs mt-8">
            <div>
              <p class="font-bold uppercase">Người lập phiếu</p>
              <p class="italic text-[10px]">(Ký, ghi rõ họ tên)</p>
            </div>
            <div>
              <p class="font-bold uppercase">Người giao hàng</p>
              <p class="italic text-[10px]">(Ký, ghi rõ họ tên)</p>
            </div>
            <div>
              <p class="font-bold uppercase">Thủ kho nhận hàng</p>
              <p class="italic text-[10px]">(Ký, ghi rõ họ tên)</p>
            </div>
          </div>
        </div>
      </template>
    </div>
  </div>
</AdminLayout>

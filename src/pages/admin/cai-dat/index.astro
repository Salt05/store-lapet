---
// src/pages/admin/cai-dat/index.astro
import AdminLayout from '@/layouts/AdminLayout.astro';
import { configService } from '@/services/config.service';

export const prerender = false;

const baseDiscount = await configService.getBaseDiscountPercent();
const longtermPolicy = await configService.getLongtermPolicy();
const integrations = await configService.getIntegrationsConfig();
const allConfigs = await configService.getAllConfigs();

const defaultCompanyInfo = {
  company_name: 'CÔNG TY TNHH THƯƠNG MẠI DỊCH VỤ LA PET',
  tax_id: '0318123456',
  address: 'Số 123 Đường D2, Phường 25, Quận Bình Thạnh, TP. Hồ Chí Minh',
  hotline: '0909 203 166',
  email: 'contact@lapet.vn',
  website: 'https://lapet.vn',
  representative_name: 'Nguyễn Văn Phát',
  representative_title: 'Giám Đốc Điều Hành',
};

const defaultNotificationConfig = {
  admin_email: 'admin@lapet.vn',
  notify_on_dealer_register: true,
  notify_on_new_order: true,
};

const defaultVnpayConfig = {
  url: 'https://sandbox.vnpayment.vn/paymentv2/vpcpay.html',
  tmn_code: 'BPFUA1FN',
  hash_secret: '••••••••••••••••••••••••••••••••',
  return_url: 'http://localhost:4321/api/payment/vnpay-callback',
};

const defaultSmtpConfig = {
  host: 'smtp.gmail.com',
  port: 587,
  secure: false,
  user: '',
  password: '••••••••••••••••',
  sender_name: 'LA PET B2B Notification System',
  sender_email: '',
};

const companyInfo = { ...defaultCompanyInfo, ...(allConfigs.get('company_info') || {}) };
const notificationConfig = { ...defaultNotificationConfig, ...(allConfigs.get('notification_config') || {}) };
const vnpayConfig = { ...defaultVnpayConfig, ...(allConfigs.get('vnpay_config') || {}) };
const smtpConfig = { ...defaultSmtpConfig, ...(allConfigs.get('smtp_config') || {}) };
---

<AdminLayout title="Cấu hình Dịch vụ & Kết nối Hệ thống (DB)" activeNav="configs">
  <div 
    class="space-y-6" 
    x-data={`{
      activeTab: 'company',
      companyInfo: ${JSON.stringify(companyInfo)},
      notificationConfig: ${JSON.stringify(notificationConfig)},
      vnpayConfig: ${JSON.stringify(vnpayConfig)},
      smtpConfig: ${JSON.stringify(smtpConfig)},
      integrations: ${JSON.stringify(integrations)},
      baseDiscount: ${baseDiscount},
      longtermPolicy: ${JSON.stringify(longtermPolicy)},
      saving: false,
      message: '',
      smtpTestLoading: false,
      smtpTestResult: null,
      testLoading: { directus: false, emailOtp: false },
      testStatus: { directus: null, emailOtp: null },
      adminCurrentPwd: '',
      adminNewPwd: '',
      adminConfirmPwd: '',
      pwdSubmitting: false,
      pwdMsg: '',
      pwdErr: false,

      async changeAdminPassword() {
        this.pwdMsg = '';
        this.pwdErr = false;
        if (!this.adminCurrentPwd) {
          this.pwdMsg = 'Vui lòng nhập mật khẩu hiện tại';
          this.pwdErr = true;
          return;
        }
        if (this.adminNewPwd.length < 6) {
          this.pwdMsg = 'Mật khẩu mới phải từ 6 ký tự trở lên';
          this.pwdErr = true;
          return;
        }
        if (this.adminNewPwd !== this.adminConfirmPwd) {
          this.pwdMsg = 'Xác nhận mật khẩu mới không trùng khớp';
          this.pwdErr = true;
          return;
        }

        this.pwdSubmitting = true;
        try {
          const res = await fetch('/api/admin/auth/change-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              currentPassword: this.adminCurrentPwd,
              newPassword: this.adminNewPwd,
              confirmPassword: this.adminConfirmPwd,
            })
          });
          const data = await res.json();
          if (res.ok && data.success) {
            this.pwdMsg = '✓ ' + (data.message || 'Đổi mật khẩu thành công!');
            this.adminCurrentPwd = '';
            this.adminNewPwd = '';
            this.adminConfirmPwd = '';
          } else {
            this.pwdMsg = data.error || 'Đổi mật khẩu thất bại';
            this.pwdErr = true;
          }
        } catch {
          this.pwdMsg = 'Lỗi kết nối máy chủ';
          this.pwdErr = true;
        } finally {
          this.pwdSubmitting = false;
        }
      },

      async saveCompanyInfo() {
        this.saving = true;
        this.message = '';
        try {
          const res = await fetch('/api/admin/configs', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'save_company_info', value: this.companyInfo })
          });
          const data = await res.json();
          if (data.success) {
            this.message = '✓ ' + (data.message || 'Đã lưu thông tin pháp nhân công ty & email liên hệ!');
          } else {
            alert(data.error || 'Lỗi lưu thông tin');
          }
        } catch {
          alert('Lỗi kết nối máy chủ');
        } finally {
          this.saving = false;
        }
      },

      async saveNotificationConfig() {
        this.saving = true;
        this.message = '';
        try {
          const res = await fetch('/api/admin/configs', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'save_notification_config', value: this.notificationConfig })
          });
          const data = await res.json();
          if (data.success) {
            this.message = '✓ ' + (data.message || 'Đã lưu cấu hình Email Nhận Thông Báo Quản Trị!');
          } else {
            alert(data.error || 'Lỗi lưu cấu hình thông báo');
          }
        } catch {
          alert('Lỗi kết nối máy chủ');
        } finally {
          this.saving = false;
        }
      },

      async saveVnPayConfig() {
        this.saving = true;
        this.message = '';
        try {
          const res = await fetch('/api/admin/configs', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'save_vnpay_config', value: this.vnpayConfig })
          });
          const data = await res.json();
          if (data.success) {
            this.message = '✓ ' + (data.message || 'Đã lưu cấu hình Cổng VNPAY!');
          } else {
            alert(data.error || 'Lỗi lưu cấu hình VNPAY');
          }
        } catch {
          alert('Lỗi kết nối máy chủ');
        } finally {
          this.saving = false;
        }
      },

      async saveSmtpConfig() {
        this.saving = true;
        this.message = '';
        try {
          const res = await fetch('/api/admin/configs', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'save_smtp_config', value: this.smtpConfig })
          });
          const data = await res.json();
          if (data.success) {
            this.message = '✓ ' + (data.message || 'Đã lưu cấu hình máy chủ SMTP!');
          } else {
            alert(data.error || 'Lỗi lưu cấu hình SMTP');
          }
        } catch {
          alert('Lỗi kết nối máy chủ');
        } finally {
          this.saving = false;
        }
      },

      async testSmtp() {
        this.smtpTestLoading = true;
        this.smtpTestResult = null;
        try {
          const target = this.notificationConfig.admin_email || this.companyInfo.email;
          const res = await fetch('/api/admin/configs', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'test_smtp',
              config: this.smtpConfig,
              target_email: target
            })
          });
          const data = await res.json();
          this.smtpTestResult = data;
          if (data.success) {
            this.message = '✓ ' + data.message;
          }
        } catch {
          this.smtpTestResult = { success: false, error: 'Không thể kết nối máy chủ kiểm tra SMTP' };
        } finally {
          this.smtpTestLoading = false;
        }
      },
      // Live Health Monitor State
      healthLoading: false,
      lastChecked: null,
      healthServices: {
        postgres: { status: 'loading', latencyMs: 0, details: '' },
        directus: { status: 'loading', latencyMs: 0, details: '' },
        emailOtp: { status: 'loading', latencyMs: 0, details: '' },
      },

      async checkHealth() {
        this.healthLoading = true;
        try {
          const res = await fetch('/api/admin/health');
          const data = await res.json();
          if (data.success && data.services) {
            this.healthServices = data.services;
            this.lastChecked = new Date().toLocaleTimeString('vi-VN');
          }
        } catch (e) {
          console.error('Lỗi khi thăm dò sức khỏe dịch vụ:', e);
        } finally {
          this.healthLoading = false;
        }
      },

      getLatencyClass(svc) {
        if (!svc || svc.status !== 'healthy') return 'text-rose-700 bg-rose-50 border-rose-200';
        if (svc.latencyMs < 300) return 'text-emerald-700 bg-emerald-50 border-emerald-200';
        if (svc.latencyMs <= 1000) return 'text-amber-700 bg-amber-50 border-amber-200';
        return 'text-orange-700 bg-orange-50 border-orange-200';
      },

      getLatencyText(svc) {
        if (!svc || svc.status === 'loading') return 'Đang đo...';
        if (svc.status !== 'healthy') return 'Không phản hồi';
        return svc.latencyMs + ' ms';
      },

      async saveIntegrations() {
        this.saving = true;
        this.message = '';
        try {
          const res = await fetch('/api/admin/configs', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'save_integrations',
              value: this.integrations
            })
          });
          const data = await res.json();
          if (data.success) {
            this.message = '✓ Đã lưu cấu hình kết nối Directus và Email OTP vào DB thành công!';
            this.checkHealth();
          } else {
            alert('Lỗi: ' + (data.error || 'Lưu thất bại'));
          }
        } catch {
          alert('Lỗi kết nối máy chủ');
        } finally {
          this.saving = false;
        }
      },

      async testDirectus() {
        this.testLoading.directus = true;
        this.testStatus.directus = null;
        try {
          const res = await fetch('/api/admin/configs', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'test_connection',
              service: 'directus',
              config: this.integrations.directus
            })
          });
          const data = await res.json();
          this.testStatus.directus = data;
          this.checkHealth();
        } catch (e) {
          this.testStatus.directus = { success: false, error: 'Không thể gửi yêu cầu kiểm tra' };
        } finally {
          this.testLoading.directus = false;
        }
      },

      async testEmailOtp() {
        this.testLoading.emailOtp = true;
        this.testStatus.emailOtp = null;
        try {
          const res = await fetch('/api/admin/configs', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'test_connection',
              service: 'emailOtp',
              config: { url: this.integrations.emailOtp.url }
            })
          });
          const data = await res.json();
          this.testStatus.emailOtp = data;
          this.checkHealth();
        } catch (e) {
          this.testStatus.emailOtp = { success: false, error: 'Không thể gửi yêu cầu kiểm tra Email OTP' };
        } finally {
          this.testLoading.emailOtp = false;
        }
      },

      async saveBaseDiscount() {
        this.saving = true;
        this.message = '';
        try {
          const res = await fetch('/api/admin/configs', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'save_system_config',
              key: 'base_discount_percent',
              value: Number(this.baseDiscount)
            })
          });
          const data = await res.json();
          if (data.success) {
            this.message = '✓ Đã cập nhật chiết khấu cơ bản (' + this.baseDiscount + '%) thành công vào DB!';
          } else {
            alert(data.error);
          }
        } catch {
          alert('Lỗi lưu cấu hình chiết khấu');
        } finally {
          this.saving = false;
        }
      },

      async saveLongtermPolicy() {
        this.saving = true;
        this.message = '';
        try {
          const res = await fetch('/api/admin/configs', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'save_system_config',
              key: 'longterm_policy',
              value: this.longtermPolicy
            })
          });
          const data = await res.json();
          if (data.success) {
            this.message = '✓ Đã cập nhật chính sách thưởng doanh số tích lũy dài hạn (Năm & Quý) vào DB thành công!';
          } else {
            alert(data.error);
          }
        } catch {
          alert('Lỗi lưu chính sách doanh số dài hạn');
        } finally {
          this.saving = false;
        }
      }
    }`}
    x-init="checkHealth(); setInterval(() => checkHealth(), 30000);"
  >

    <!-- ========================================================================= -->
    <!-- LIVE HEALTH MONITOR WIDGET -->
    <!-- ========================================================================= -->
    <div class="bg-white p-6 rounded-3xl border border-brand-border shadow-xs space-y-5">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 border-b border-brand-sand pb-4">
        <div>
          <div class="flex items-center gap-2.5">
            <span class="relative flex h-3 w-3">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-accent opacity-75"></span>
              <span class="relative inline-flex rounded-full h-3 w-3 bg-brand-primary"></span>
            </span>
            <h2 class="text-base font-black text-brand-dark tracking-tight">
              Bảng Giám Sát Sức Khỏe Dịch Vụ Thời Gian Thực (Live Health Monitor)
            </h2>
          </div>
          <p class="text-xs text-brand-muted mt-1">
            Đo trực tiếp độ trễ phản hồi (latency ms) và trạng thái kết nối mạng của 3 dịch vụ cốt lõi.
            <template x-if="lastChecked">
              <span class="text-brand-primary font-bold ml-1" x-text="'(Cập nhật: ' + lastChecked + ')'"></span>
            </template>
          </p>
        </div>

        <!-- REFRESH BUTTON -->
        <button
          @click="checkHealth()"
          :disabled="healthLoading"
          class="px-4 py-2 bg-slate-100 hover:bg-[#087b80] hover:text-white text-slate-700 font-bold text-xs rounded-xl transition-all cursor-pointer flex items-center gap-2 shrink-0 border border-slate-200 disabled:opacity-50"
          title="Thăm dò lại tất cả 3 dịch vụ"
        >
          <svg
            class="w-4 h-4 transition-transform duration-500"
            :class="healthLoading ? 'animate-spin text-[#23c1c6]' : 'text-slate-600 group-hover:text-white'"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
          </svg>
          <span x-text="healthLoading ? 'Đang kiểm tra...' : 'Kiểm tra lại tất cả'"></span>
        </button>
      </div>

      <!-- 3 SERVICE HEALTH CARDS -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- 1. PostgreSQL Database Card -->
        <div class="p-4 rounded-2xl border border-slate-200 bg-slate-50/60 hover:bg-white hover:border-[#087b80]/40 hover:shadow-xs transition-all flex flex-col justify-between space-y-3">
          <div class="flex items-start justify-between gap-2">
            <div class="flex items-center gap-2.5">
              <div class="w-9 h-9 rounded-xl bg-[#083a3c]/10 text-[#083a3c] flex items-center justify-center">
                <svg class="w-5 h-5 text-[#083a3c]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                  <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                  <path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-extrabold text-sm text-slate-900 leading-tight">PostgreSQL 16</h3>
                <p class="text-2xs text-slate-500 font-medium mt-0.5">Core DB (Đơn, Kho & Đại lý)</p>
              </div>
            </div>

            <!-- Status Badge -->
            <span
              :class="healthServices.postgres.status === 'healthy' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : (healthServices.postgres.status === 'loading' ? 'bg-slate-100 text-slate-500 border-slate-200' : 'bg-rose-50 text-rose-700 border-rose-200')"
              class="px-2.5 py-0.5 rounded-full text-2xs font-extrabold border shrink-0 flex items-center gap-1"
            >
              <span 
                :class="healthServices.postgres.status === 'healthy' ? 'bg-emerald-500' : (healthServices.postgres.status === 'loading' ? 'bg-slate-400' : 'bg-rose-500')"
                class="w-1.5 h-1.5 rounded-full"
              ></span>
              <span x-text="healthServices.postgres.status === 'healthy' ? 'Đang chạy' : (healthServices.postgres.status === 'loading' ? 'Đang đo...' : 'Mất kết nối')"></span>
            </span>
          </div>

          <div class="space-y-1.5 pt-1 border-t border-slate-200/60">
            <div class="flex items-center justify-between text-xs">
              <span class="text-slate-500 font-medium">Độ trễ (Latency):</span>
              <span
                :class="getLatencyClass(healthServices.postgres)"
                class="font-black px-2 py-0.5 rounded-md text-2xs border font-mono"
                x-text="getLatencyText(healthServices.postgres)"
              ></span>
            </div>
            <div class="text-2xs text-slate-600 truncate font-mono" :title="healthServices.postgres.details || healthServices.postgres.error">
              <span class="text-slate-400">Chi tiết:</span>
              <span class="font-medium ml-1" x-text="healthServices.postgres.details || healthServices.postgres.error || 'Chưa có dữ liệu'"></span>
            </div>
          </div>
        </div>

        <!-- 2. Directus CMS Card -->
        <div class="p-4 rounded-2xl border border-slate-200 bg-slate-50/60 hover:bg-white hover:border-[#087b80]/40 hover:shadow-xs transition-all flex flex-col justify-between space-y-3">
          <div class="flex items-start justify-between gap-2">
            <div class="flex items-center gap-2.5">
              <div class="w-9 h-9 rounded-xl bg-[#087b80]/10 text-[#087b80] flex items-center justify-center">
                <svg class="w-5 h-5 text-[#087b80]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                  <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                  <line x1="12" y1="22.08" x2="12" y2="12"></line>
                </svg>
              </div>
              <div>
                <h3 class="font-extrabold text-sm text-slate-900 leading-tight">Directus CMS</h3>
                <p class="text-2xs text-slate-500 font-medium mt-0.5">REST API (Data & Media)</p>
              </div>
            </div>

            <!-- Status Badge -->
            <span
              :class="healthServices.directus.status === 'healthy' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : (healthServices.directus.status === 'loading' ? 'bg-slate-100 text-slate-500 border-slate-200' : 'bg-rose-50 text-rose-700 border-rose-200')"
              class="px-2.5 py-0.5 rounded-full text-2xs font-extrabold border shrink-0 flex items-center gap-1"
            >
              <span 
                :class="healthServices.directus.status === 'healthy' ? 'bg-emerald-500' : (healthServices.directus.status === 'loading' ? 'bg-slate-400' : 'bg-rose-500')"
                class="w-1.5 h-1.5 rounded-full"
              ></span>
              <span x-text="healthServices.directus.status === 'healthy' ? 'Đang chạy' : (healthServices.directus.status === 'loading' ? 'Đang đo...' : 'Mất kết nối')"></span>
            </span>
          </div>

          <div class="space-y-1.5 pt-1 border-t border-slate-200/60">
            <div class="flex items-center justify-between text-xs">
              <span class="text-slate-500 font-medium">Độ trễ (Latency):</span>
              <span
                :class="getLatencyClass(healthServices.directus)"
                class="font-black px-2 py-0.5 rounded-md text-2xs border font-mono"
                x-text="getLatencyText(healthServices.directus)"
              ></span>
            </div>
            <div class="text-2xs text-slate-600 truncate font-mono" :title="healthServices.directus.details || healthServices.directus.error">
              <span class="text-slate-400">Chi tiết:</span>
              <span class="font-medium ml-1" x-text="healthServices.directus.details || healthServices.directus.error || 'Chưa có dữ liệu'"></span>
            </div>
          </div>
        </div>

        <!-- 3. Email OTP Service Card -->
        <div class="p-4 rounded-2xl border border-slate-200 bg-slate-50/60 hover:bg-white hover:border-[#087b80]/40 hover:shadow-xs transition-all flex flex-col justify-between space-y-3">
          <div class="flex items-start justify-between gap-2">
            <div class="flex items-center gap-2.5">
              <div class="w-9 h-9 rounded-xl bg-purple-50 text-purple-700 flex items-center justify-center">
                <svg class="w-5 h-5 text-purple-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-extrabold text-sm text-slate-900 leading-tight">Email OTP Service</h3>
                <p class="text-2xs text-slate-500 font-medium mt-0.5">Microservice (Port 4000)</p>
              </div>
            </div>

            <!-- Status Badge -->
            <span
              :class="healthServices.emailOtp.status === 'healthy' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : (healthServices.emailOtp.status === 'loading' ? 'bg-slate-100 text-slate-500 border-slate-200' : 'bg-rose-50 text-rose-700 border-rose-200')"
              class="px-2.5 py-0.5 rounded-full text-2xs font-extrabold border shrink-0 flex items-center gap-1"
            >
              <span 

            >
              <span x-show="pwdSubmitting" class="w-3.5 h-3.5 rounded-full border-2 border-white border-t-transparent animate-spin inline-block"></span>
              <span x-text="pwdSubmitting ? 'ĐANG LƯU...' : 'LƯU MẬT KHẨU MỚI'"></span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</AdminLayout>

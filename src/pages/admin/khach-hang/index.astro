---
// src/pages/admin/khach-hang/index.astro
import AdminLayout from '@/layouts/AdminLayout.astro';
import { query } from '@/lib/db';
import { directusAdmin } from '@/lib/directus';
import { readItems } from '@directus/sdk';
import { computeDealerTierMetrics } from '@/pages/api/admin/customers/index';

export const prerender = false;

const url = new URL(Astro.request.url);
const currentSearch = url.searchParams.get('q') || '';
const currentStatus = url.searchParams.get('status') || 'all';

let initialCustomers: any[] = [];
let pendingDealersCount = 0;
let totalDealersCount = 0;
let totalActiveCount = 0;
let systemTotalSales = 0;
let systemTotalBonus = 0;
let initialTotalPages = 1;
let loadError = '';

try {
  let registrations: any[] = [];
  try {
    const regRes = await directusAdmin.request(
      readItems('dealer_registrations' as any, {
        fields: ['id', 'name', 'store_name', 'phone', 'email', 'business_model', 'city', 'status'],
        limit: 100,
        sort: ['-created_at', '-id'],
      })
    );
    registrations = regRes || [];
    pendingDealersCount = registrations.filter((r: any) => r.status === 'pending').length;
  } catch (directusErr) {
    console.warn('[Admin Customers SSR] Directus dealer registrations warning:', directusErr);
  }

  const regByPhone = new Map<string, any>();
  const regByEmail = new Map<string, any>();
  for (const r of registrations) {
    if (r.phone) regByPhone.set(r.phone.replace(/\s+/g, ''), r);
    if (r.email) regByEmail.set(r.email.toLowerCase().trim(), r);
  }

  // 1. Thống kê toàn hệ thống (System KPI metrics trên 3000+ đại lý)
  const statsRes = await query(`
    SELECT 
      COUNT(*) as total_dealers,
      COUNT(CASE WHEN c.is_active = TRUE THEN 1 END) as active_dealers,
      COALESCE(SUM(c.cumulative_sales), 0) as total_sales,
      COALESCE(SUM(CASE WHEN c.cumulative_sales >= 100000000 THEN c.cumulative_sales * 0.03 ELSE 0 END), 0) as total_bonus
    FROM customers c
  `);
  if (statsRes.rows[0]) {
    totalDealersCount = Number(statsRes.rows[0].total_dealers || 0);
    totalActiveCount = Number(statsRes.rows[0].active_dealers || 0);
    systemTotalSales = Number(statsRes.rows[0].total_sales || 0);
    systemTotalBonus = Number(statsRes.rows[0].total_bonus || 0);
  }

  // 2. Lấy danh sách đại lý (Ưu tiên theo Doanh số tích lũy giảm dần để làm nổi bật đại lý thực tế)
  const conditions: string[] = ['1=1'];
  const params: any[] = [];
  if (currentStatus === 'active') {
    conditions.push('c.is_active = TRUE');
  } else if (currentStatus === 'inactive' || currentStatus === 'blocked') {
    conditions.push('c.is_active = FALSE');
  }
  if (currentSearch) {
    params.push(`%${currentSearch}%`);
    const idx = params.length;
    conditions.push(`(c.name ILIKE $${idx} OR c.phone ILIKE $${idx} OR c.code ILIKE $${idx} OR c.email ILIKE $${idx})`);
  }

  const whereSql = conditions.join(' AND ');
  const countFilteredRes = await query(`SELECT COUNT(*) as total FROM customers c WHERE ${whereSql}`, params);
  const currentTotal = Number(countFilteredRes.rows[0]?.total || 0);
  initialTotalPages = Math.max(1, Math.ceil(currentTotal / 20));

  const custRes = await query(
    `SELECT 
       c.id, c.code, c.name, c.phone, c.email, c.address, c.city,
       c.tier, c.cumulative_sales, c.is_active,
       COALESCE(SUM(CASE WHEN o.status IN ('confirmed', 'delivered', 'completed', 'sale', 'done') THEN o.amount_total ELSE 0 END), 0) as order_sales,
       COUNT(CASE WHEN o.status IN ('confirmed', 'delivered', 'completed', 'sale', 'done') THEN 1 END) as confirmed_orders_count
     FROM customers c
     LEFT JOIN orders o ON c.id = o.customer_id
     WHERE ${whereSql}
     GROUP BY c.id
     ORDER BY c.cumulative_sales DESC, c.id DESC
     LIMIT 20`,
    params
  );

  initialCustomers = custRes.rows.map((p: any) => {
    const phoneClean = (p.phone || '').replace(/\s+/g, '');
    const emailClean = (p.email || '').toLowerCase().trim();
    const dealerInfo = (phoneClean && regByPhone.get(phoneClean)) || (emailClean && regByEmail.get(emailClean)) || null;
    const totalSales = Math.max(Number(p.cumulative_sales || 0), Number(p.order_sales || 0));
    const tierStats = computeDealerTierMetrics(totalSales);

    return {
      id: p.id,
      name: p.name || 'Chưa đặt tên',
      ref: p.code || `DL-${p.id}`,
      vat: '—',
      phone: p.phone || '—',
      email: p.email || '—',
      street: [p.address, p.city].filter(Boolean).join(', ') || '—',
      city: p.city || '',
      active: p.is_active !== false,
      is_company: true,
      confirmedOrdersCount: Number(p.confirmed_orders_count || 0),
      ...tierStats,
      dealerRegistration: dealerInfo ? {
        id: dealerInfo.id,
        store_name: dealerInfo.store_name || dealerInfo.name || '—',
        business_model: dealerInfo.business_model || '—',
        status: dealerInfo.status || 'pending',
        city: dealerInfo.city || '—',
      } : null,
    };
  });
} catch (e: any) {
  loadError = e.message || 'Lỗi kết nối cơ sở dữ liệu';
}
---

<AdminLayout title="Danh bạ Đại lý B2B & Doanh số tích lũy" activeNav="customers">
  <style>
    @media print {
      body * {
        visibility: hidden;
      }
      #print-cumulative-report,
      #print-cumulative-report * {
        visibility: visible;
      }
      #print-cumulative-report {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        display: block !important;
        padding: 12mm;
        background: #ffffff;
        color: #111827;
      }
      .no-print {
        display: none !important;
      }
    }
  </style>

  <div
    class="space-y-4 sm:space-y-5"
    x-data={`{
      search: ${JSON.stringify(currentSearch)},
      statusFilter: ${JSON.stringify(currentStatus)},
      tierFilter: 'all',
      customers: ${JSON.stringify(initialCustomers)},
      pendingDealersCount: ${pendingDealersCount},
      totalCount: ${totalDealersCount},
      totalActiveCount: ${totalActiveCount},
      systemSales: ${systemTotalSales},
      systemBonus: ${systemTotalBonus},
      page: 1,
      limit: 20,
      totalPages: ${initialTotalPages},
      loading: false,
      selectedCustomer: null,
      drawerOpen: false,
      loadingDetail: false,
      detailError: '',
      partnerModalOpen: false,
      savingPartner: false,
      pwdModalOpen: false,
      pwdCustomer: null,
      newCustomerPwd: '',
      savingCustomerPwd: false,
      pwdSuccessMsg: '',
      pwdErrorMsg: '',

      openChangeCustomerPasswordModal(c) {
        this.pwdCustomer = c;
        this.newCustomerPwd = '';
        this.pwdSuccessMsg = '';
        this.pwdErrorMsg = '';
        this.pwdModalOpen = true;
      },

      generateRandomPassword() {
        const rand = Math.floor(1000 + Math.random() * 9000);
        this.newCustomerPwd = 'Lapet@' + rand;
      },

      async saveCustomerPassword() {
        if (!this.newCustomerPwd || this.newCustomerPwd.trim().length < 6) {
          this.pwdErrorMsg = 'Mật khẩu phải từ 6 ký tự trở lên';
          return;
        }
        this.savingCustomerPwd = true;
        this.pwdErrorMsg = '';
        this.pwdSuccessMsg = '';
        try {
          const res = await fetch('/api/admin/customers/' + this.pwdCustomer.id, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ password: this.newCustomerPwd.trim() }),
          });
          const data = await res.json();
          if (data.success) {
            this.pwdSuccessMsg = '✓ Đã cập nhật mật khẩu mới thành công!';
            if (this.pwdCustomer) this.pwdCustomer.has_password = true;
            if (this.selectedCustomer && this.selectedCustomer.id === this.pwdCustomer.id) {
              this.selectedCustomer.has_password = true;
            }
            const match = this.customers.find(x => x.id === this.pwdCustomer.id);
            if (match) match.has_password = true;
            setTimeout(() => { this.pwdModalOpen = false; }, 1800);
          } else {
            this.pwdErrorMsg = data.error || 'Không thể lưu mật khẩu';
          }
        } catch {
          this.pwdErrorMsg = 'Lỗi kết nối máy chủ';
        } finally {
          this.savingCustomerPwd = false;
        }
      },
      partnerForm: {
        id: null,
        name: '',
        ref: '',
        vat: '',
        phone: '',
        email: '',
        street: '',
        city: '',
        is_company: true,
        active: true
      },

      get filteredCustomers() {
        if (this.tierFilter === 'all') return this.customers;
        return this.customers.filter(c => c.tierCode === this.tierFilter);
      },

      get displayTotalSales() {
        if (this.search || this.statusFilter !== 'all' || this.tierFilter !== 'all') {
          return this.filteredCustomers.reduce((sum, c) => sum + (Number(c.cumulativeSales) || 0), 0);
        }
        return this.systemSales;
      },

      get displayTotalBonus() {
        if (this.search || this.statusFilter !== 'all' || this.tierFilter !== 'all') {
          return this.filteredCustomers.reduce((sum, c) => sum + (Number(c.yearEndBonusAmount) || 0), 0);
        }
        return this.systemBonus;
      },

      get displayTotalCount() {
        if (this.search || this.statusFilter !== 'all' || this.tierFilter !== 'all') {
          return this.filteredCustomers.length;
        }
        return this.totalCount;
      },

      get displayActiveCount() {
        if (this.search || this.statusFilter !== 'all' || this.tierFilter !== 'all') {
          return this.filteredCustomers.filter(c => c.active).length;
        }
        return this.totalActiveCount;
      },

      async fetchCustomers(resetPage = true) {
        if (resetPage) this.page = 1;
        this.loading = true;
        try {
          const params = new URLSearchParams();
          if (this.search) params.set('q', this.search);
          if (this.statusFilter && this.statusFilter !== 'all') params.set('status', this.statusFilter);
          params.set('limit', String(this.limit));
          params.set('page', String(this.page));

          const res = await fetch('/api/admin/customers?' + params.toString());
          const json = await res.json();
          if (json.success && Array.isArray(json.data)) {
            this.customers = json.data;
            this.totalPages = json.totalPages || 1;
            if (this.search || this.statusFilter !== 'all') {
              this.totalCount = json.total || this.customers.length;
            }
          }
        } catch (err) {
          console.error('Lỗi tải danh sách khách hàng:', err);
        } finally {
          this.loading = false;
        }
      },

      changePage(newPage) {
        if (newPage < 1 || newPage > this.totalPages) return;
        this.page = newPage;
        this.fetchCustomers(false);
      },

      openCreateModal() {
        this.partnerForm = {
          id: null,
          name: '',
          ref: 'DL-' + Math.floor(1000 + Math.random() * 9000),
          vat: '',
          phone: '',
          email: '',
          street: '',
          city: 'TP.HCM',
          is_company: true,
          active: true
        };
        this.partnerModalOpen = true;
      },

      openEditModal(c) {
        this.partnerForm = {
          id: c.id,
          name: c.name || '',
          ref: c.ref && c.ref !== '—' ? c.ref : '',
          vat: c.vat && c.vat !== '—' ? c.vat : '',
          phone: c.phone && c.phone !== '—' ? c.phone : '',
          email: c.email && c.email !== '—' ? c.email : '',
          street: c.street && c.street !== '—' ? c.street : '',
          city: c.city && c.city !== '—' ? c.city : '',
          is_company: c.is_company !== false,
          active: c.active !== false
        };
        this.partnerModalOpen = true;
      },

      async savePartner() {
        if (!this.partnerForm.name || !this.partnerForm.name.trim()) {
          alert('Vui lòng nhập tên Đại lý / Cửa hàng');
          return;
        }
        this.savingPartner = true;
        try {
          const isEdit = Boolean(this.partnerForm.id);
          const url = isEdit ? ('/api/admin/customers/' + this.partnerForm.id) : '/api/admin/customers';
          const method = isEdit ? 'PATCH' : 'POST';

          const res = await fetch(url, {
            method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(this.partnerForm)
          });
          const data = await res.json();
          if (data.success) {
            this.partnerModalOpen = false;
            await this.fetchCustomers(false);
            if (isEdit && this.selectedCustomer && this.selectedCustomer.id === this.partnerForm.id) {
              await this.openDetail(this.partnerForm.id);
            }
          } else {
            alert('Lỗi: ' + (data.error || 'Không thể lưu đối tác'));
          }
        } catch (e) {
          alert('Lỗi kết nối máy chủ');
        } finally {
          this.savingPartner = false;
        }
      },

      async togglePartnerActive(c) {
        const nextActive = !c.active;
        try {
          const res = await fetch('/api/admin/customers/' + c.id, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ active: nextActive })
          });
          const data = await res.json();
          if (data.success) {
            c.active = nextActive;
            const row = this.customers.find(x => x.id === c.id);
            if (row) row.active = nextActive;
          } else {
            alert('Lỗi: ' + (data.error || 'Không thể đổi trạng thái'));
          }
        } catch {
          alert('Lỗi kết nối máy chủ');
        }
      },

      exportCumulativeReportCSV() {
        const headers = [
          'Ma Doi Tac (Ref)',
          'Ten Dai Ly',
          'So Dien Thoai',
          'Doanh So Tich Luy Nam (VND)',
          'Hang Dai Ly Hien Tai',
          'Chiet Khau Nhom Khong Ga (%)',
          'Chiet Khau Nhom Quan Ga (%)',
          'Doanh So Can Dat Them (VND)',
          'Thuong Doanh So Nam +3% (VND)'
        ];
        const rows = this.filteredCustomers.map(c => [
          c.ref || ('DL-' + c.id),
          '"' + String(c.name || '').replace(/"/g, '""') + '"',
          c.phone || '',
          c.cumulativeSales || 0,
          '"' + (c.tierName || 'Đại lý Tiêu chuẩn') + '"',
          (c.discountNonChicken || 5) + '%',
          (c.discountChicken || 7) + '%',
          c.nextTierNeeded || 0,
          c.yearEndBonusEligible ? (c.yearEndBonusAmount || 0) : 0
        ]);
        const csvContent = '\\uFEFF' + [headers.join(','), ...rows.map(r => r.join(','))].join('\\n');
        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        const link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = 'Bang_Thong_Ke_Doanh_So_Tich_Luy_Dai_Ly_LAPET.csv';
        link.click();
      },

      async openDetail(id) {
        this.drawerOpen = true;
        this.loadingDetail = true;
        this.detailError = '';
        this.selectedCustomer = null;

        try {
          const res = await fetch('/api/admin/customers/' + id);
          const json = await res.json();
          if (json.success && json.customer) {
            this.selectedCustomer = json.customer;
          } else {
            this.detailError = json.error || 'Không thể lấy thông tin chi tiết';
          }
        } catch (err) {
          this.detailError = 'Lỗi kết nối máy chủ';
        } finally {
          this.loadingDetail = false;
        }
      },

      closeDrawer() {
        this.drawerOpen = false;
      },

      formatCurrency(num) {
        if (!num && num !== 0) return '0 ₫';
        return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(num);
      },

      getTierBadgeClass(tierCode) {
        switch (tierCode) {
          case 'diamond':
            return 'bg-purple-50 text-purple-700 border border-purple-200/80';
          case 'gold':
            return 'bg-amber-50 text-amber-700 border border-amber-200/80';
          case 'silver':
            return 'bg-sky-50 text-sky-700 border border-sky-200/80';
          default:
            return 'bg-slate-100 text-slate-700 border border-slate-200/80';
        }
      },

      getStatusBadgeClass(state) {
        switch (state) {
          case 'sale':
            return 'bg-emerald-100 text-emerald-800';
          case 'done':
            return 'bg-blue-100 text-blue-800';
          case 'cancel':
            return 'bg-rose-100 text-rose-800';
          case 'draft':
          default:
            return 'bg-amber-100 text-amber-800';
        }
      },

      getStatusLabel(state) {
        switch (state) {
          case 'confirmed':
          case 'sale':
            return 'Đơn bán hàng';
          case 'delivered':
            return 'Đã giao';
          case 'completed':
          case 'done':
            return 'Đã hoàn tất';
          case 'cancelled':
          case 'cancel':
            return 'Đã hủy';
          case 'draft':
          case 'sent':
          default:
            return 'Đơn nháp';
        }
      }
    }`}
  >
    <!-- 1. TOP ACTION HEADER -->
    <div class="no-print flex flex-col lg:flex-row justify-between items-start lg:items-center gap-4 bg-white p-4 sm:p-5 rounded-2xl border border-slate-200 shadow-xs">
      <div>
        <h1 class="text-lg sm:text-xl font-black text-slate-900 flex items-center gap-2">
          <svg class="w-6 h-6 text-[#087b80] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
          <span>Danh bạ Đại lý B2B & Doanh số tích lũy</span>
        </h1>
        <p class="text-xs text-slate-500 mt-1">
          Hệ thống quản lý đối tác sỉ, theo dõi tích lũy doanh số năm và chính sách chiết khấu bậc thang tự động.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <!-- Nút Thêm đại lý -->
        <button
          type="button"
          @click="openCreateModal()"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl shadow-xs transition cursor-pointer"
        >
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"/>
            <line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
          <span>Thêm đại lý</span>
        </button>

        <!-- Nút Xuất CSV -->
        <button
          type="button"
          @click="exportCumulativeReportCSV()"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl border border-slate-200 transition cursor-pointer"
        >
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          <span>Xuất CSV</span>
        </button>

        <!-- Nút Xuất PDF Thống kê -->
        <button
          type="button"
          @click="window.print()"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl border border-slate-200 transition cursor-pointer"
        >
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 6 2 18 2 18 9"/>
            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
            <rect width="12" height="8" x="6" y="14"/>
          </svg>
          <span>Xuất PDF A4</span>
        </button>

        <!-- Nút Duyệt hồ sơ mới -->
        <a
          href="/admin/dang-ky-dai-ly"
          class="inline-flex items-center gap-2 px-3.5 py-2 bg-amber-500 hover:bg-amber-600 text-white text-xs font-bold rounded-xl shadow-xs transition-all"
        >
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
            <rect x="8" y="2" width="8" height="4" rx="1" ry="1"/>
            <path d="m9 14 2 2 4-4"/>
          </svg>
          <span>Duyệt hồ sơ mới</span>
          <template x-if="pendingDealersCount > 0">
            <span
              class="px-2 py-0.5 bg-rose-600 text-white text-[10px] font-black rounded-full shadow-xs animate-pulse"
              x-text="pendingDealersCount"
            ></span>
          </template>
        </a>
      </div>
    </div>

    <!-- 2. HÀNG THẺ CHỈ SỐ TỔNG QUAN (4 KPI METRICS CARDS TOÀN HỆ THỐNG) -->
    <div class="no-print grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
      <!-- KPI 1: Đối tác B2B -->
      <div class="bg-white p-3.5 sm:p-4 rounded-2xl border border-slate-200 shadow-xs flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-teal-50 border border-teal-100 text-[#087b80] flex items-center justify-center shrink-0">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="16" height="20" x="4" y="2" rx="2" ry="2"/>
            <path d="M9 22v-4h6v4"/>
            <path d="M8 6h.01"/><path d="M16 6h.01"/>
            <path d="M8 10h.01"/><path d="M16 10h.01"/>
            <path d="M8 14h.01"/><path d="M16 14h.01"/>
          </svg>
        </div>
        <div class="min-w-0">
          <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider truncate">Đối tác B2B</p>
          <p class="text-base sm:text-lg font-black text-slate-900 mt-0.5">
            <span x-text="displayTotalCount.toLocaleString('vi-VN')">0</span>
            <span class="text-xs font-medium text-slate-400 ml-1" x-text="'· ' + displayActiveCount.toLocaleString('vi-VN') + ' hoạt động'"></span>
          </p>
        </div>
      </div>

      <!-- KPI 2: Doanh số toàn hệ thống -->

        <div>
          <p class="font-bold uppercase">Người lập biểu</p>
          <p class="italic text-[10px]">(Ký, ghi rõ họ tên)</p>
        </div>
        <div>
          <p class="font-bold uppercase">Kế toán công nợ B2B</p>
          <p class="italic text-[10px]">(Ký, ghi rõ họ tên)</p>
        </div>
        <div>
          <p class="font-bold uppercase">Ban Giám Đốc phê duyệt</p>
          <p class="italic text-[10px]">(Ký, đóng dấu)</p>
        </div>
      </div>
    </div>

    <!-- MODAL TẠO MỚI / CHỈNH SỬA ĐẠI LÝ B2B -->
    <div
      x-show="partnerModalOpen"
      style="display: none;"
      class="no-print fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-xs flex items-center justify-center p-4"
    >
      <div class="bg-white rounded-2xl border border-slate-200 shadow-2xl max-w-lg w-full p-6 space-y-4" @click.away="partnerModalOpen = false">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <h3 class="text-base font-black text-slate-800" x-text="partnerForm.id ? 'Cập nhật Hồ sơ Đại lý B2B' : 'Thêm mới Đại lý B2B'"></h3>
          <button type="button" @click="partnerModalOpen = false" class="text-slate-400 hover:text-slate-600 font-bold">✕</button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          <div class="sm:col-span-2">
            <label class="font-bold text-slate-700 block mb-1">Tên Đại lý / Pet Shop *</label>
            <input type="text" x-model="partnerForm.name" placeholder="VD: Pet Mart Quận 7" class="w-full px-3 py-2 rounded-xl border border-slate-300" />
          </div>
          <div>
            <label class="font-bold text-slate-700 block mb-1">Mã đối tác (Ref)</label>
            <input type="text" x-model="partnerForm.ref" placeholder="DL-001" class="w-full px-3 py-2 rounded-xl border border-slate-300 font-mono" />
          </div>
          <div>
            <label class="font-bold text-slate-700 block mb-1">Mã số thuế (VAT)</label>
            <input type="text" x-model="partnerForm.vat" placeholder="031xxxxxxx" class="w-full px-3 py-2 rounded-xl border border-slate-300 font-mono" />
          </div>
          <div>
            <label class="font-bold text-slate-700 block mb-1">Số điện thoại nhận OTP</label>
            <input type="text" x-model="partnerForm.phone" placeholder="0909xxxxxx" class="w-full px-3 py-2 rounded-xl border border-slate-300" />
          </div>
          <div>
            <label class="font-bold text-slate-700 block mb-1">Email nhận mã OTP *</label>
            <input type="email" x-model="partnerForm.email" placeholder="daily@petshop.vn" class="w-full px-3 py-2 rounded-xl border border-slate-300" />
          </div>
          <div class="sm:col-span-2">
            <label class="font-bold text-slate-700 block mb-1">Địa chỉ giao hàng chính</label>
            <input type="text" x-model="partnerForm.street" placeholder="Số nhà, tên đường, phường/xã..." class="w-full px-3 py-2 rounded-xl border border-slate-300" />
          </div>
          <div>
            <label class="font-bold text-slate-700 block mb-1">Tỉnh / Thành phố</label>
            <input type="text" x-model="partnerForm.city" placeholder="TP. Hồ Chí Minh" class="w-full px-3 py-2 rounded-xl border border-slate-300" />
          </div>
          <div class="flex items-center gap-4 pt-5">
            <label class="inline-flex items-center gap-1.5 cursor-pointer">
              <input type="checkbox" x-model="partnerForm.is_company" class="rounded border-slate-300" />
              <span class="font-bold text-slate-700">Pháp nhân / Cửa hàng</span>
            </label>
            <label class="inline-flex items-center gap-1.5 cursor-pointer">
              <input type="checkbox" x-model="partnerForm.active" class="rounded border-slate-300" />
              <span class="font-bold text-emerald-700">Đang hoạt động</span>
            </label>
          </div>
        </div>

        <div class="flex justify-end gap-2 pt-3 border-t border-slate-100">
          <button
            type="button"
            @click="partnerModalOpen = false"
            class="px-4 py-2 rounded-xl border border-slate-200 text-xs font-bold text-slate-600 hover:bg-slate-50"
          >
            Hủy
          </button>
          <button
            type="button"
            @click="savePartner()"
            :disabled="savingPartner"
            class="px-5 py-2 rounded-xl bg-[#087b80] hover:bg-[#066367] text-white text-xs font-bold shadow-xs disabled:opacity-50 cursor-pointer"
          >
            <span x-text="savingPartner ? 'Đang lưu dữ liệu...' : 'Lưu hồ sơ đại lý'"></span>
          </button>
        </div>
      </div>
    </div>

    <!-- SLIDE-OVER DRAWER CHI TIẾT KHÁCH HÀNG / ĐẠI LÝ -->
    <div
      x-show="drawerOpen"
      style="display: none;"
      class="no-print fixed inset-0 z-50 overflow-hidden"
      role="dialog"
      aria-modal="true"
    >
      <!-- Backdrop -->
      <div
        x-show="drawerOpen"
        x-transition:enter="ease-out duration-300"
        x-transition:enter-start="opacity-0"
        x-transition:enter-end="opacity-100"
        x-transition:leave="ease-in duration-200"
        x-transition:leave-start="opacity-100"
        x-transition:leave-end="opacity-0"
        @click="closeDrawer()"
        class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs transition-opacity"
      ></div>

      <div class="fixed inset-y-0 right-0 max-w-full flex pl-10">
        <div
          x-show="drawerOpen"
          x-transition:enter="transform transition ease-in-out duration-300"
          x-transition:enter-start="translate-x-full"
          x-transition:enter-end="translate-x-0"
          x-transition:leave="transform transition ease-in-out duration-300"
          x-transition:leave-start="translate-x-0"
          x-transition:leave-end="translate-x-full"
          class="w-screen max-w-2xl bg-white shadow-2xl flex flex-col"
        >
          <!-- Drawer Header -->
          <div class="p-6 bg-gradient-to-r from-[#083a3c] to-[#087b80] text-white flex justify-between items-start">
            <div>
              <div class="flex items-center gap-2">
                <span class="text-xs font-mono font-bold px-2 py-0.5 rounded bg-white/20 text-[#23c1c6] whitespace-nowrap" x-text="selectedCustomer?.ref || 'Mã DL'"></span>
                <span
                  :class="selectedCustomer?.active ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-400/30' : 'bg-slate-500/20 text-slate-300'"
                  class="text-[11px] font-bold px-2 py-0.5 rounded-full"
                  x-text="selectedCustomer?.active ? 'Đang hoạt động' : 'Tạm khóa'"
                ></span>
                <template x-if="selectedCustomer?.salesSummary?.tierName">
                  <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-amber-400/20 text-amber-200 border border-amber-300/30 inline-flex items-center gap-1">
                    <svg class="w-3 h-3 text-amber-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/>
                      <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/>
                      <path d="M4 22h16"/>
                      <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/>
                      <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/>
                      <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>
                    </svg>
                    <span x-text="selectedCustomer.salesSummary.tierName"></span>
                  </span>
                </template>
              </div>
              <h2 class="text-xl font-black mt-2 text-white" x-text="selectedCustomer?.name || 'Chi tiết khách hàng'"></h2>
              <p class="text-xs text-teal-100/80 mt-0.5" x-text="selectedCustomer?.company_name || 'Thông tin chi tiết đối tác B2B'"></p>
            </div>

            <button
              @click="closeDrawer()"
              class="text-white/80 hover:text-white p-1 rounded-lg hover:bg-white/10 transition-colors cursor-pointer text-lg"
              title="Đóng (Esc)"
            >
              ✕
            </button>
          </div>

          <!-- Drawer Body -->
          <div class="flex-1 overflow-y-auto p-6 space-y-6">
            <!-- Loading indicator -->
            <template x-if="loadingDetail">
              <div class="py-20 flex flex-col items-center justify-center gap-3 text-[#087b80]">
                <svg class="animate-spin h-8 w-8 text-[#087b80]" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                </svg>
                <p class="text-xs font-bold text-slate-500">Đang tải thông tin hồ sơ đại lý...</p>
              </div>
            </template>

            <!-- Error message -->
            <template x-if="detailError">
              <div class="p-4 bg-rose-50 border border-rose-200 rounded-xl text-rose-700 text-xs font-bold" x-text="detailError"></div>
            </template>

            <template x-if="!loadingDetail && selectedCustomer">
              <div class="space-y-6">
                <!-- 1. CRM AGGREGATED METRICS -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                  <div class="bg-teal-50/60 p-3.5 rounded-xl border border-teal-100">
                    <p class="text-[11px] font-bold text-[#087b80] uppercase">Doanh số tích lũy</p>
                    <p class="text-sm font-black text-[#083a3c] mt-1" x-text="formatCurrency(selectedCustomer.salesSummary?.totalRevenue)"></p>
                  </div>
                  <div class="bg-teal-50/60 p-3.5 rounded-xl border border-teal-100">
                    <p class="text-[11px] font-bold text-[#087b80] uppercase">Đơn xác nhận</p>
                    <p class="text-sm font-black text-[#083a3c] mt-1" x-text="(selectedCustomer.salesSummary?.totalOrders || 0) + ' đơn'"></p>
                  </div>
                  <div class="bg-teal-50/60 p-3.5 rounded-xl border border-teal-100">
                    <p class="text-[11px] font-bold text-[#087b80] uppercase">Giá trị TB/Đơn</p>
                    <p class="text-sm font-black text-[#083a3c] mt-1" x-text="formatCurrency(selectedCustomer.salesSummary?.aov)"></p>
                  </div>
                  <div class="bg-teal-50/60 p-3.5 rounded-xl border border-teal-100">
                    <p class="text-[11px] font-bold text-[#087b80] uppercase">Mua gần nhất</p>
                    <p class="text-sm font-black text-[#083a3c] mt-1" x-text="selectedCustomer.salesSummary?.lastOrderDate || '—'"></p>
                  </div>
                </div>

                <!-- 1B. BẢNG CHỈ SỐ HẠNG ĐẠI LÝ & THƯỞNG DOANH SỐ NĂM -->
                <div class="border border-amber-200 bg-amber-50/40 rounded-xl p-4 space-y-3">
                  <div class="flex items-center justify-between">
                    <h3 class="text-xs font-black text-amber-950 uppercase tracking-wider flex items-center gap-1.5">
                      <svg class="w-4 h-4 text-amber-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/>
                        <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/>
                        <path d="M4 22h16"/>
                        <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/>
                        <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/>
                        <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>
                      </svg>
                      <span>Chính sách Hạng Đại Lý &amp; Chiết Khấu Bậc Thang</span>
                    </h3>
                    <span
                      :class="getTierBadgeClass(selectedCustomer.salesSummary?.tierCode)"
                      class="px-2.5 py-0.5 rounded-full text-xs font-bold"
                      x-text="selectedCustomer.salesSummary?.tierName || 'Đại lý Tiêu chuẩn'"
                    ></span>
                  </div>
                  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
                    <div class="bg-white p-3 rounded-lg border border-amber-100">
                      <span class="text-slate-500 block">Chiết khấu bậc thang:</span>
                      <p class="font-bold text-slate-900 mt-1" x-text="selectedCustomer.salesSummary?.discountLabel || 'Không gà: 5% | Quấn gà: 7%'"></p>
                    </div>
                    <div class="bg-white p-3 rounded-lg border border-amber-100">
                      <span class="text-slate-500 block">Doanh số cần đạt thêm:</span>
                      <p class="font-bold text-[#087b80] mt-1" x-text="selectedCustomer.salesSummary?.nextTierNeeded > 0 ? ('+ ' + formatCurrency(selectedCustomer.salesSummary.nextTierNeeded)) : 'Đã đạt mốc cao nhất'"></p>
                      <span class="text-[10px] text-slate-400" x-text="'Mục tiêu: ' + (selectedCustomer.salesSummary?.nextTierName || '')"></span>
                    </div>
                    <div class="bg-white p-3 rounded-lg border border-amber-100">
                      <span class="text-slate-500 block">Thưởng doanh số năm (+3%):</span>
                      <p
                        class="font-black mt-1"
                        :class="selectedCustomer.salesSummary?.yearEndBonusEligible ? 'text-emerald-700' : 'text-slate-400'"
                        x-text="selectedCustomer.salesSummary?.yearEndBonusEligible ? ('Đạt: ' + formatCurrency(selectedCustomer.salesSummary.yearEndBonusAmount)) : 'Chưa đạt ngưỡng 100Tr'"
                      ></p>
                    </div>
                  </div>
                </div>

                <!-- 2. DIRECTUS DEALER REGISTRATION BADGE (IF LINKED) -->
                <template x-if="selectedCustomer.dealerRegistration">
                  <div class="bg-emerald-50/70 border border-emerald-200 p-4 rounded-xl">
                    <div class="flex items-center justify-between">
                      <div class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-emerald-800 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <rect width="16" height="20" x="4" y="2" rx="2" ry="2"/>
                          <path d="M9 22v-4h6v4"/>
                          <path d="M8 6h.01"/><path d="M16 6h.01"/>
                          <path d="M8 10h.01"/><path d="M16 10h.01"/>
                          <path d="M8 14h.01"/><path d="M16 14h.01"/>
                        </svg>
                        <span class="text-xs font-black text-emerald-900 uppercase">Hồ sơ đại lý Directus B2B</span>
                      </div>
                      <span
                        class="text-[11px] font-bold px-2 py-0.5 rounded-full capitalize"
                        :class="{
                          'bg-amber-100 text-amber-800': selectedCustomer.dealerRegistration.status === 'pending',
                          'bg-blue-100 text-blue-800': selectedCustomer.dealerRegistration.status === 'contacted',
                          'bg-emerald-100 text-emerald-800': selectedCustomer.dealerRegistration.status === 'approved',
                          'bg-slate-100 text-slate-600': selectedCustomer.dealerRegistration.status === 'rejected'
                        }"
                        x-text="selectedCustomer.dealerRegistration.status === 'approved' ? 'Đã duyệt đại lý' : selectedCustomer.dealerRegistration.status"
                      ></span>
                    </div>
                    <div class="grid grid-cols-2 gap-3 mt-3 text-xs">
                      <div>
                        <span class="text-slate-500">Tên cửa hàng:</span>
                        <p class="font-bold text-slate-800" x-text="selectedCustomer.dealerRegistration.store_name"></p>
                      </div>
                      <div>
                        <span class="text-slate-500">Mô hình kinh doanh:</span>
                        <p class="font-bold text-slate-800" x-text="selectedCustomer.dealerRegistration.business_model"></p>
                      </div>
                      <div>
                        <span class="text-slate-500">Tỉnh / Thành phố:</span>
                        <p class="font-bold text-slate-800" x-text="selectedCustomer.dealerRegistration.city"></p>
                      </div>
                      <div>
                        <span class="text-slate-500">Ngày gửi hồ sơ:</span>
                        <p class="font-bold text-slate-800" x-text="selectedCustomer.dealerRegistration.created_at ? selectedCustomer.dealerRegistration.created_at.split('T')[0] : '—'"></p>
                      </div>
                    </div>
                  </div>
                </template>

                <!-- 3. THÔNG TIN DOANH NGHIỆP & PHÁP LÝ -->
                <div class="border border-slate-200 rounded-xl p-4 bg-slate-50/50 space-y-3">
                  <h3 class="text-xs font-black text-slate-700 uppercase tracking-wider flex items-center gap-1.5">
                    <svg class="w-4 h-4 text-slate-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                      <polyline points="14 2 14 8 20 8"/>
                      <line x1="16" y1="13" x2="8" y2="13"/>
                      <line x1="16" y1="17" x2="8" y2="17"/>
                      <polyline points="10 9 9 9 8 9"/>
                    </svg>
                    <span>Thông tin Doanh nghiệp &amp; Liên hệ</span>
                  </h3>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
                    <div>
                      <span class="text-slate-500">Mã số thuế (VAT):</span>
                      <p class="font-bold text-slate-900 font-mono mt-0.5" x-text="selectedCustomer.vat || '—'"></p>
                    </div>
                    <div>
                      <span class="text-slate-500">Pháp nhân / Công ty:</span>
                      <p class="font-bold text-slate-900 mt-0.5" x-text="selectedCustomer.company_name || 'Cá nhân'"></p>
                    </div>
                    <div>
                      <span class="text-slate-500">Số điện thoại:</span>
                      <p class="mt-0.5">
                        <template x-if="selectedCustomer.phone && selectedCustomer.phone !== '—'">
                          <a :href="'tel:' + selectedCustomer.phone" class="font-bold text-[#087b80] hover:underline inline-flex items-center gap-1">
                            <svg class="w-3 h-3 text-[#087b80]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                            </svg>
                            <span x-text="selectedCustomer.phone"></span>
                          </a>
                        </template>
                        <template x-if="!selectedCustomer.phone || selectedCustomer.phone === '—'">
                          <span class="text-slate-400">—</span>
                        </template>
                      </p>
                    </div>
                    <div>
                      <span class="text-slate-500">Email:</span>
                      <p class="mt-0.5">
                        <template x-if="selectedCustomer.email && selectedCustomer.email !== '—'">
                          <a :href="'mailto:' + selectedCustomer.email" class="font-medium text-slate-800 hover:text-[#087b80] hover:underline" x-text="selectedCustomer.email"></a>
                        </template>
                        <template x-if="!selectedCustomer.email || selectedCustomer.email === '—'">
                          <span class="text-slate-400">—</span>
                        </template>
                      </p>
                    </div>
                    <div class="sm:col-span-2">
                      <span class="text-slate-500">Địa chỉ chính:</span>
                      <p class="font-medium text-slate-800 mt-0.5" x-text="selectedCustomer.street || '—'"></p>
                    </div>
                  </div>
                </div>

                <!-- 4. ĐỊA CHỈ GIAO HÀNG PHỤ (CHILD_IDS) -->
                <div class="border border-slate-200 rounded-xl p-4 space-y-3">
                  <div class="flex items-center justify-between">
                    <h3 class="text-xs font-black text-slate-700 uppercase tracking-wider flex items-center gap-1.5">
                      <svg class="w-4 h-4 text-slate-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="16" height="13" x="1" y="3" rx="2"/>
                        <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                        <circle cx="5.5" cy="18.5" r="2.5"/>
                        <circle cx="18.5" cy="18.5" r="2.5"/>
                      </svg>
                      <span>Địa chỉ giao hàng phụ (Delivery Addresses)</span>
                    </h3>
                    <span class="text-[11px] font-bold text-slate-400" x-text="(selectedCustomer.deliveryAddresses?.length || 0) + ' địa chỉ'"></span>
                  </div>

                  <template x-if="!selectedCustomer.deliveryAddresses || selectedCustomer.deliveryAddresses.length === 0">
                    <p class="text-xs text-slate-400 italic py-2">
                      Chưa thiết lập địa chỉ giao hàng phụ. Hệ thống mặc định giao theo địa chỉ chính.
                    </p>
                  </template>

                  <template x-if="selectedCustomer.deliveryAddresses && selectedCustomer.deliveryAddresses.length > 0">
                    <div class="space-y-2">
                      <template x-for="addr in selectedCustomer.deliveryAddresses" :key="addr.id">
                        <div class="p-2.5 bg-slate-50 rounded-lg text-xs border border-slate-100 flex items-start justify-between gap-2">
                          <div>
                            <p class="font-bold text-slate-800" x-text="addr.name"></p>
                            <p class="text-slate-600 mt-0.5" x-text="addr.address"></p>
                          </div>
                          <span class="font-mono text-[11px] text-[#087b80] whitespace-nowrap" x-text="addr.phone"></span>
                        </div>
                      </template>
                    </div>
                  </template>
                </div>

                <!-- 5. ĐƠN HÀNG GẦN NHẤT (RECENT ORDERS) -->
                <div class="border border-slate-200 rounded-xl p-4 space-y-3">
                  <div class="flex items-center justify-between">
                    <h3 class="text-xs font-black text-slate-700 uppercase tracking-wider flex items-center gap-1.5">
                      <svg class="w-4 h-4 text-slate-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m7.5 4.27 9 5.15"/>
                        <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/>
                        <path d="m3.3 7 8.7 5 8.7-5"/>
                        <path d="M12 22V12"/>
                      </svg>
                      <span>Lịch sử Đơn hàng gần nhất</span>
                    </h3>
                    <a href="/admin/don-hang" class="text-[11px] font-bold text-[#087b80] hover:underline">
                      Xem tất cả đơn →
                    </a>
                  </div>

                  <template x-if="!selectedCustomer.recentOrders || selectedCustomer.recentOrders.length === 0">
                    <p class="text-xs text-slate-400 italic py-2">
                      Khách hàng chưa có lịch sử đơn hàng nào trên hệ thống.
                    </p>
                  </template>

                  <template x-if="selectedCustomer.recentOrders && selectedCustomer.recentOrders.length > 0">
                    <div class="divide-y divide-slate-100 border border-slate-100 rounded-lg overflow-hidden">
                      <template x-for="ord in selectedCustomer.recentOrders" :key="ord.id">
                        <div class="p-3 bg-white hover:bg-slate-50 transition-colors flex items-center justify-between gap-3 text-xs">
                          <div>
                            <div class="flex items-center gap-2">
                              <a
                                :href="'/admin/don-hang/' + ord.id"
                                class="font-mono font-bold text-[#087b80] hover:underline whitespace-nowrap"
                                x-text="ord.name"
                              ></a>
                              <span
                                :class="getStatusBadgeClass(ord.state)"
                                class="px-2 py-0.5 rounded-full text-[10px] font-bold"
                                x-text="getStatusLabel(ord.state)"
                              ></span>
                            </div>
                            <p class="text-[11px] text-slate-400 mt-0.5" x-text="ord.date"></p>
                          </div>
                          <div class="text-right">
                            <p class="font-bold text-slate-900" x-text="formatCurrency(ord.amount)"></p>
                            <a
                              :href="'/admin/don-hang/' + ord.id"
                              class="text-[11px] font-semibold text-[#087b80] hover:underline"
                            >
                              Chi tiết đơn
                            </a>
                          </div>
                        </div>
                      </template>
                    </div>
                  </template>
                </div>
              </div>
            </template>
          </div>

          <!-- Drawer Footer -->
          <div class="p-4 bg-slate-50 border-t border-slate-200 flex flex-wrap justify-between items-center gap-2">
            <div class="flex items-center gap-2">
              <template x-if="selectedCustomer">
                <button
                  type="button"
                  @click="openChangeCustomerPasswordModal(selectedCustomer)"
                  class="px-3.5 py-2 bg-amber-500 hover:bg-amber-600 text-white text-xs font-bold rounded-xl transition cursor-pointer flex items-center gap-1.5 shadow-2xs"
                  title="Đổi mật khẩu cho đại lý này"
                >
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="7.5" cy="15.5" r="5.5"/>
                    <path d="m21 2-9.6 9.6"/>
                    <path d="m15.5 7.5 3 3L22 7l-3-3"/>
                  </svg>
                  <span>Đổi mật khẩu</span>
                </button>
              </template>
              <template x-if="selectedCustomer">
                <button
                  type="button"
                  @click="openEditModal(selectedCustomer)"
                  class="px-3.5 py-2 bg-white border border-slate-300 text-slate-700 hover:bg-slate-100 text-xs font-bold rounded-xl transition cursor-pointer flex items-center gap-1.5"
                >
                  <svg class="w-3.5 h-3.5 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
                    <path d="m15 5 4 4"/>
                  </svg>
                  <span>Sửa thông tin</span>
                </button>
              </template>
              <template x-if="selectedCustomer">
                <button
                  type="button"
                  @click="togglePartnerActive(selectedCustomer)"
                  :class="selectedCustomer.active ? 'border-rose-200 text-rose-700 hover:bg-rose-50' : 'border-emerald-200 text-emerald-700 hover:bg-emerald-50'"
                  class="px-3.5 py-2 bg-white border text-xs font-bold rounded-xl transition cursor-pointer flex items-center gap-1.5"
                >
                  <template x-if="selectedCustomer.active">
                    <svg class="w-3.5 h-3.5 text-rose-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                      <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                  </template>
                  <template x-if="!selectedCustomer.active">
                    <svg class="w-3.5 h-3.5 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                      <path d="M7 11V7a5 5 0 0 1 9.9-1"/>
                    </svg>
                  </template>
                  <span x-text="selectedCustomer.active ? 'Tạm khóa đại lý' : 'Mở khóa đại lý'"></span>
                </button>
              </template>
            </div>

            <button
              @click="closeDrawer()"
              class="px-5 py-2 bg-[#087b80] hover:bg-[#066367] text-white text-xs font-bold rounded-xl shadow-xs transition cursor-pointer"
            >
              Đóng chi tiết
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- MODAL ĐỔI MẬT KHẨU CHO KHÁCH HÀNG / ĐẠI LÝ -->
    <div
      x-show="pwdModalOpen"
      x-cloak
      class="no-print fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4"
    >
      <div 
        @click.outside="pwdModalOpen = false" 
        class="bg-white rounded-2xl max-w-md w-full shadow-2xl border border-slate-200 overflow-hidden"
      >
        <div class="p-5 bg-gradient-to-r from-slate-900 to-slate-800 text-white flex justify-between items-center">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-amber-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="7.5" cy="15.5" r="5.5"/>
              <path d="m21 2-9.6 9.6"/>
              <path d="m15.5 7.5 3 3L22 7l-3-3"/>
            </svg>
            <div>
              <h3 class="text-sm font-bold text-white">Đổi Mật Khẩu Đại Lý</h3>
              <p class="text-xs text-slate-300 mt-0.5" x-text="pwdCustomer ? (pwdCustomer.name + ' (' + pwdCustomer.ref + ')') : ''"></p>
            </div>
          </div>
          <button @click="pwdModalOpen = false" class="text-slate-400 hover:text-white text-lg p-1 cursor-pointer">✕</button>
        </div>

        <form @submit.prevent="saveCustomerPassword()" class="p-5 space-y-4">
          <div x-show="pwdErrorMsg" x-text="pwdErrorMsg" class="p-3 bg-rose-50 text-rose-600 text-xs font-semibold rounded-xl border border-rose-200"></div>
          <div x-show="pwdSuccessMsg" x-text="pwdSuccessMsg" class="p-3 bg-emerald-50 text-emerald-700 text-xs font-semibold rounded-xl border border-emerald-200"></div>

          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">
                Mật khẩu mới
              </label>
              <button 
                type="button" 
                @click="generateRandomPassword()" 
                class="text-xs text-[#087b80] hover:underline font-bold cursor-pointer inline-flex items-center gap-1"
              >
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5" fill="currentColor"/>
                  <circle cx="15.5" cy="8.5" r="1.5" fill="currentColor"/>
                  <circle cx="15.5" cy="15.5" r="1.5" fill="currentColor"/>
                  <circle cx="8.5" cy="15.5" r="1.5" fill="currentColor"/>
                  <circle cx="12" cy="12" r="1.5" fill="currentColor"/>
                </svg>
                <span>Tạo ngẫu nhiên</span>
              </button>
            </div>
            <input
              type="text"
              x-model="newCustomerPwd"
              required
              minlength="6"
              placeholder="Nhập tối thiểu 6 ký tự..."
              class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm font-mono text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#087b80]"
            />
            <p class="text-[11px] text-slate-400 mt-1">Đại lý sẽ sử dụng mật khẩu này cùng SĐT/Email để đăng nhập vào B2B Portal.</p>
          </div>

          <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100">
            <button
              type="button"
              @click="pwdModalOpen = false"
              class="px-4 py-2 rounded-xl border border-slate-300 text-xs font-bold text-slate-600 hover:bg-slate-50 transition cursor-pointer"
            >
              Hủy
            </button>
            <button
              type="submit"
              :disabled="savingCustomerPwd"
              class="px-5 py-2 rounded-xl bg-amber-500 hover:bg-amber-600 text-white text-xs font-bold transition shadow-xs cursor-pointer disabled:opacity-50"
            >
              <span x-text="savingCustomerPwd ? 'Đang lưu...' : 'Lưu mật khẩu mới'"></span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</AdminLayout>

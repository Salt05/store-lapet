---
// src/pages/admin/san-pham/index.astro
import AdminLayout from '@/layouts/AdminLayout.astro';
import { query } from '@/lib/db';
import { configService } from '@/services/config.service';
import fs from 'node:fs';
import path from 'node:path';

export const prerender = false;

// Directus fileId mapping by cleaned SKU/Title
const DIRECTUS_FILE_MAP: Record<string, string> = {
  B03: '15d23b13-0a2c-4e80-a917-855fd75ef333',
  B06: '7e1bedf6-7eb9-4011-92a0-1e84df4e1268',
  C10: '18650f72-99c9-4b1d-be31-211da87a9907',
  C101: '350c79bc-1a93-45f8-bf2d-5f1b01baf4ee',
  C11: '07710f1f-98fe-48d5-97b0-d3dc86277d64',
  C14: '2096c8a5-6aeb-483c-bfc7-426136779dcd',
  C141: '103b12d5-9c9f-406f-80bd-605e15e420ee',
  C17: '037dea7d-972c-4768-ac5a-01ca2567e357',
  C22: '0fbfeacc-3659-423e-af1c-2de49466f150',
  C24: '12d42077-0b1a-4120-ae03-9c04518650e5',
  C28: '191c5212-3b83-412a-986f-56a540f3c1b1',
  C33: '1d207c4c-6766-4e64-b427-2ed50d0b6e99',
  C34: '42d8d11d-a1af-49bb-b89e-3c6c057381c8',
  C35: '762cc054-daea-41cc-997f-b1eb99f389de',
  C36: '1d9ef5d0-bcb0-44b9-852a-bc4f126d42b4',
  C37: '54e98b96-ef71-46b8-b2e4-e3dfaf23f64e',
  C38: '7e4f2f3b-7fdb-4eff-b40b-31c4d225f18f',
  C39: '196348cf-5123-4771-af10-d495e8c99187',
  C41: '31b314b6-42e8-4310-839b-7eaffb05c7a8',
  C42: '0a63134f-dd60-4501-b5ef-4f3b6cfedd77',
  D01: '0a53635f-b5f9-40bc-ba9a-eb41caab9559',
  D02: '4872dc22-0d8d-461f-9f1d-a86cfce7b501',
  D03: '220221f1-0c01-40f1-a5e1-d81bb7135f72',
  DB01: '9970b143-572d-4bce-bc68-bebe171b6b8d',
  DB02: '516710c6-108b-466f-9fe5-7acf5648b20b',
  DB03: '90834ed0-0412-4908-b74d-78a6d35b8488',
  DB04: '6f35dd0b-0471-4221-8b94-6dd7a7ad6c40',
  DB05: '22390602-0ef5-410b-93d9-d5396b7aaa51',
  DB06: '20706eb2-956b-4110-b83a-cd301ec1b2f4',
  E01: '36fba323-2e1e-4147-87af-f8e8c5fa1ff5',
  E02: '0a840709-7836-4873-9356-16f4c47a4902',
  E03: '35baab0a-29ef-4a37-a9d4-618d96ec82f7',
  E04: '7e0165f8-8406-4e17-a97e-91f49771255c',
  E05: '96401677-4e76-4456-89fc-4a78234c53c7',
  E06: '3313789f-e7fd-4983-ad18-999d104b362e',
  TL: '0f2bae35-c4ec-4e2e-b580-21c1341812e0',
  TL01: 'd7cf215f-605a-44dc-8c38-f921cc11eeba',
  TL02: 'd7cf215f-605a-44dc-8c38-f921cc11eeba',
  TL03: 'd7cf215f-605a-44dc-8c38-f921cc11eeba',
  TL04: 'd7cf215f-605a-44dc-8c38-f921cc11eeba',
  TLT: '1d8b4e35-a493-4617-bd19-9a36f61a1c2c',
  TLT01: '2bcba05b-40b5-48e3-bdf0-08f1d2591191',
  TLT02: '2bcba05b-40b5-48e3-bdf0-08f1d2591191',
  TLT03: '2bcba05b-40b5-48e3-bdf0-08f1d2591191',
  TLT04: '2bcba05b-40b5-48e3-bdf0-08f1d2591191',
  ZC: '5d75afe3-c4a8-49cc-9815-6bf4b13fc863',
};

// Check local static webp files available in public/
let localWebpSet = new Set<string>();
try {
  const pubDir = path.join(process.cwd(), 'public');
  if (fs.existsSync(pubDir)) {
    const list = fs.readdirSync(pubDir).filter((f) => f.endsWith('.webp'));
    localWebpSet = new Set(list.map((f) => f.toLowerCase()));
  }
} catch {}

function resolveImageUrl(imageUrl?: string | null, sku?: string | null): string {
  const cleanImg = imageUrl ? String(imageUrl).trim() : '';
  if (cleanImg && !cleanImg.includes('placeholder')) return cleanImg;

  const rawSku = sku ? String(sku).trim() : '';
  const cleanSku = rawSku.replace(/[\s_-]+/g, '').toUpperCase();
  const lowerSku = rawSku.toLowerCase();

  // 1. Check exact local webp file
  if (localWebpSet.has(`${lowerSku}.webp`)) {
    return `/${lowerSku}.webp`;
  }
  if (localWebpSet.has(`${cleanSku.toLowerCase()}.webp`)) {
    return `/${cleanSku.toLowerCase()}.webp`;
  }

  // 2. Check Directus files proxy
  if (cleanSku && DIRECTUS_FILE_MAP[cleanSku]) {
    return `/api/v1/directus/assets/${DIRECTUS_FILE_MAP[cleanSku]}`;
  }

  // Fallback placeholder
  return '/images/placeholder-product.svg';
}

function formatVndServer(amount: number): string {
  return `${new Intl.NumberFormat('vi-VN').format(Math.round(amount || 0))} ₫`;
}

function formatCompactVnd(amount: number): string {
  if (amount >= 1_000_000_000) return `${(amount / 1_000_000_000).toFixed(2).replace('.', ',')} tỷ ₫`;
  if (amount >= 1_000_000) return `${(amount / 1_000_000).toFixed(1).replace('.', ',')} tr ₫`;
  return formatVndServer(amount);
}

let initialProducts: any[] = [];
let categoriesList: any[] = [];
let baseDiscountPercent = 22;
let errorMsg = '';

let salesTotals = { totalOrders: 0, totalUnits: 0, totalRevenue: 0 };
let topSellingProducts: Array<{
  sku: string;
  name: string;
  orderCount: number;
  qty: number;
  revenue: number;
  sharePercent: number;
  available: number | null;
  minStock: number;
}> = [];
let categoryStats: Array<{
  categoryId: string | number;
  name: string;
  totalCount: number;
  publishedCount: number;
  avgWholesalePrice: number;
  totalStock: number;
  revenue: number;
}> = [];
let inventorySummary = { totalSkus: 0, totalAvailable: 0, lowStockCount: 0, outOfStockCount: 0, unlinkedProductsCount: 0 };
let inventoryAlerts: Array<{
  sku: string;
  name: string;
  onHand: number;
  reserved: number;
  available: number | null;
  minStock: number;
  alertType: 'out' | 'low' | 'unlinked';
}> = [];
let catalogHealth = {
  total: 0,
  withImage: 0,
  withCategory: 0,
  withInventory: 0,
  validPricing: 0,
  published: 0,
  draft: 0,
  archived: 0,
  avgWholesalePrice: 0,
  avgDiscountPercent: 22,
};

try {
  baseDiscountPercent = await configService.getBaseDiscountPercent().catch(() => 22);

  // 1 & 2. Truy vấn đồng thời Sản phẩm, Tồn kho và Doanh số thực tế từ PostgreSQL
  const [pgProductsRes, invRes, skuSalesRes, totalsRes] = await Promise.all([
    query(`
      SELECT
        p.id, p.sku, p.name, p.slug, p.price, p.wholesale_price,
        p.unit, p.weight, p.category, p.image_url, p.status,
        p.is_active, p.sold_quantity
      FROM products p
      ORDER BY p.id ASC
    `),
    query(`SELECT product_id, UPPER(sku) AS sku_upper, sku, on_hand, reserved, available, min_stock FROM inventory_items`).catch(() => ({ rows: [] })),
    query(`
      SELECT
        UPPER(oi.sku) AS sku_upper,
        MAX(oi.sku) AS sku,
        MAX(oi.product_name) AS product_name,
        COUNT(DISTINCT oi.order_id)::int AS order_count,
        COALESCE(SUM(oi.quantity), 0)::int AS total_qty,
        COALESCE(SUM(oi.price_total), 0)::numeric AS total_revenue
      FROM order_items oi
      JOIN orders o ON oi.order_id = o.id
      WHERE o.status IN ('confirmed', 'delivered', 'completed', 'sale', 'done')
        AND oi.sku IS NOT NULL AND oi.sku <> ''
      GROUP BY UPPER(oi.sku)
      ORDER BY total_revenue DESC, total_qty DESC
    `).catch(() => ({ rows: [] })),
    query(`
      SELECT
        COUNT(DISTINCT o.id)::int AS total_orders,
        COALESCE(SUM(oi.quantity), 0)::int AS total_units,
        COALESCE(SUM(oi.price_total), 0)::numeric AS total_revenue
      FROM order_items oi
      JOIN orders o ON oi.order_id = o.id
      WHERE o.status IN ('confirmed', 'delivered', 'completed', 'sale', 'done')
    `).catch(() => ({ rows: [] })),
  ]);

  const invBySku = new Map<string, { sku: string; onHand: number; reserved: number; available: number; minStock: number }>();
  for (const r of invRes.rows) {
    const key = String(r.sku_upper || '').trim();
    if (!key) continue;
    invBySku.set(key, {
      sku: r.sku,
      onHand: Number(r.on_hand || 0),
      reserved: Number(r.reserved || 0),
      available: Number(r.available || 0),
      minStock: Number(r.min_stock ?? 10),
    });
  }

  const categorySet = new Set<string>();
  initialProducts = pgProductsRes.rows.map((p: any) => {
    const catName = p.category ? String(p.category).trim() : '';
    if (catName) categorySet.add(catName);
    const skuKey = p.sku ? String(p.sku).trim().toUpperCase() : '';
    const inv = skuKey ? invBySku.get(skuKey) : undefined;
    const price = Number(p.price) || 0;
    const wholesalePrice = Number(p.wholesale_price) || Math.round(price * (1 - baseDiscountPercent / 100));

    return {
      id: p.id,
      name: p.name || 'Sản phẩm LA PET',
      slug: p.slug || String(p.id),
      sku: p.sku || '—',
      price,
      wholesale_price: wholesalePrice,
      status: p.status || 'published',
      sold_quantity: Number(p.sold_quantity) || 0,
      specification: p.unit || (p.weight ? `${p.weight}g` : '—'),
      weight: p.weight ? Number(p.weight) : null,
      category_id: catName || null,
      category_slug: catName || null,
      category_name: catName || 'Chưa phân loại',
      image: p.image_url || null,
      image_url: resolveImageUrl(p.image_url, p.sku),
      stock_available: inv ? inv.available : null,
    };
  });

  categoriesList = Array.from(categorySet)
    .sort((a, b) => a.localeCompare(b, 'vi'))
    .map((name) => ({ id: name, name, slug: name }));

  const salesBySku = new Map<string, { sku: string; productName: string; orderCount: number; qty: number; revenue: number }>();
  for (const r of skuSalesRes.rows) {
    const key = String(r.sku_upper || '').trim();
    if (!key) continue;
    salesBySku.set(key, {
      sku: r.sku,
      productName: r.product_name || r.sku,
      orderCount: Number(r.order_count || 0),
      qty: Number(r.total_qty || 0),
      revenue: Number(r.total_revenue || 0),
    });
  }

  if (totalsRes.rows.length > 0) {
    salesTotals = {
      totalOrders: Number(totalsRes.rows[0].total_orders || 0),
      totalUnits: Number(totalsRes.rows[0].total_units || 0),
      totalRevenue: Number(totalsRes.rows[0].total_revenue || 0),
    };
  }

  const productsBySku = new Map<string, any>();
  for (const p of initialProducts) {
    if (p.sku && p.sku !== '—') {
      productsBySku.set(String(p.sku).trim().toUpperCase(), p);
    }
  }

  // Top 7 sản phẩm doanh thu cao nhất
  const topRows = skuSalesRes.rows.slice(0, 7);
  const top1Revenue = topRows.length > 0 ? Math.max(1, Number(topRows[0].total_revenue || 0)) : 1;
  topSellingProducts = topRows.map((r: any) => {
    const skuKey = String(r.sku_upper || '').trim();
    const inv = invBySku.get(skuKey);
    const dProd = productsBySku.get(skuKey);
    const revenue = Number(r.total_revenue || 0);
    return {
      sku: r.sku,
      name: dProd?.name || r.product_name || r.sku,
      orderCount: Number(r.order_count || 0),
      qty: Number(r.total_qty || 0),
      revenue,
      sharePercent: Math.round((revenue / top1Revenue) * 100),
      available: inv ? inv.available : null,
      minStock: inv ? inv.minStock : 10,
    };
  });

  // Phân tích theo Ngành hàng (PostgreSQL Products + Sales & Stock)
  const catAgg = new Map<string, {
    categoryId: string | number;
    name: string;
    totalCount: number;
    publishedCount: number;
    wholesaleSum: number;
    totalStock: number;
    revenue: number;
  }>();

  for (const p of initialProducts) {
    const key = p.category_id ? String(p.category_id) : 'uncategorized';
    const existing = catAgg.get(key) || {
      categoryId: p.category_id ?? 'all',
      name: p.category_name || 'Chưa phân loại',
      totalCount: 0,
      publishedCount: 0,
      wholesaleSum: 0,
      totalStock: 0,
      revenue: 0,
    };
    const skuKey = p.sku && p.sku !== '—' ? String(p.sku).trim().toUpperCase() : '';
    const inv = skuKey ? invBySku.get(skuKey) : null;
    const sale = skuKey ? salesBySku.get(skuKey) : null;

    existing.totalCount += 1;
    if (p.status === 'published') existing.publishedCount += 1;
    existing.wholesaleSum += Number(p.wholesale_price || 0);
    existing.totalStock += inv ? inv.available : 0;
    existing.revenue += sale ? sale.revenue : 0;
    catAgg.set(key, existing);
  }

  categoryStats = Array.from(catAgg.values())
    .map((c) => ({
      categoryId: c.categoryId,
      name: c.name,
      totalCount: c.totalCount,
      publishedCount: c.publishedCount,
      avgWholesalePrice: c.totalCount > 0 ? Math.round(c.wholesaleSum / c.totalCount) : 0,
      totalStock: c.totalStock,
      revenue: c.revenue,
    }))
    .sort((a, b) => b.revenue - a.revenue || b.totalCount - a.totalCount);

  // Cảnh báo Tồn kho & Đồng bộ kho
  const lowAndOutAlerts: typeof inventoryAlerts = [];
  let totalAvailable = 0;
  let lowStockCount = 0;
  let outOfStockCount = 0;
  for (const [skuKey, inv] of invBySku.entries()) {
    totalAvailable += inv.available;
    if (inv.available <= 0) {
      outOfStockCount += 1;
      lowAndOutAlerts.push({
        sku: inv.sku,
        name: productsBySku.get(skuKey)?.name || 'Sản phẩm trong kho PG',
        onHand: inv.onHand,
        reserved: inv.reserved,
        available: inv.available,
        minStock: inv.minStock,
        alertType: 'out',
      });
    } else if (inv.available <= inv.minStock) {
      lowStockCount += 1;
      lowAndOutAlerts.push({
        sku: inv.sku,
        name: productsBySku.get(skuKey)?.name || 'Sản phẩm trong kho PG',
        onHand: inv.onHand,
        reserved: inv.reserved,
        available: inv.available,
        minStock: inv.minStock,
        alertType: 'low',
      });
    }
  }

  const unlinkedAlerts: typeof inventoryAlerts = [];
  for (const p of initialProducts) {
    const skuKey = p.sku && p.sku !== '—' ? String(p.sku).trim().toUpperCase() : '';
    if (!skuKey || !invBySku.has(skuKey)) {
      unlinkedAlerts.push({
        sku: p.sku,
        name: p.name,
        onHand: 0,
        reserved: 0,
        available: null,
        minStock: 0,
        alertType: 'unlinked',
      });
    }
  }

  inventorySummary = {
    totalSkus: invBySku.size,
    totalAvailable,
    lowStockCount,
    outOfStockCount,
    unlinkedProductsCount: unlinkedAlerts.length,
  };
  inventoryAlerts = [...lowAndOutAlerts, ...unlinkedAlerts].slice(0, 6);

  // Chất lượng Dữ liệu Catalog (PostgreSQL)
  let wholesaleSum = 0;
  let discountSum = 0;
  let discountCount = 0;
  for (const p of initialProducts) {
    const skuKey = p.sku && p.sku !== '—' ? String(p.sku).trim().toUpperCase() : '';
    catalogHealth.total += 1;
    if (p.image) catalogHealth.withImage += 1;
    if (p.category_id) catalogHealth.withCategory += 1;
    if (skuKey && invBySku.has(skuKey)) catalogHealth.withInventory += 1;
    if (p.wholesale_price > 0 && p.price > 0 && p.wholesale_price < p.price) {
      catalogHealth.validPricing += 1;
      discountSum += (1 - p.wholesale_price / p.price) * 100;
      discountCount += 1;
    }
    if (p.status === 'published') catalogHealth.published += 1;
    else if (p.status === 'draft') catalogHealth.draft += 1;
    else if (p.status === 'archived') catalogHealth.archived += 1;
    wholesaleSum += Number(p.wholesale_price || 0);
  }
  catalogHealth.avgWholesalePrice = catalogHealth.total > 0 ? Math.round(wholesaleSum / catalogHealth.total) : 0;
  catalogHealth.avgDiscountPercent = discountCount > 0 ? Math.round(discountSum / discountCount) : baseDiscountPercent;
} catch (e: any) {
  errorMsg = e.message || 'Lỗi đọc sản phẩm PostgreSQL';
}
---

<AdminLayout title="Quản lý Sản phẩm" activeNav="products">
  <script is:inline defer src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>

  <script is:inline define:vars={{ initialProducts, categoriesList, baseDiscountPercent, topSellingProducts, categoryStats, salesTotals }}>
    window.__ADMIN_PRODUCTS__ = initialProducts || [];
    window.__ADMIN_CATEGORIES__ = categoriesList || [];
    window.__BASE_DISCOUNT_PERCENT__ = Number(baseDiscountPercent) || 22;
    window.__TOP_SELLING_PRODUCTS__ = topSellingProducts || [];
    window.__CATEGORY_STATS__ = categoryStats || [];
    window.__SALES_TOTALS__ = salesTotals || { totalOrders: 0, totalUnits: 0, totalRevenue: 0 };

    window.productsManager = function productsManager() {
      return {
        products: window.__ADMIN_PRODUCTS__ || [],
        categories: window.__ADMIN_CATEGORIES__ || [],
        baseDiscountPercent: window.__BASE_DISCOUNT_PERCENT__ || 22,
        searchQuery: '',
        selectedCategory: 'all',
        selectedStatus: 'all',
        filterWarning: 'all', // 'all' | 'price' | 'out_of_stock'
        currentPage: 1,
        pageSize: 20,
        showAnalytics: false,
        editModalOpen: false,
        editingProduct: {
          id: null,
          name: '',
          sku: '',
          specification: '',
          price: 0,
          wholesale_price: 0,
          status: 'published',
        },
        saving: false,
        toast: { show: false, message: '', type: 'success' },
        chartTopMetric: 'revenue', // 'revenue' | 'qty'

        toggleAnalytics() {
          this.showAnalytics = !this.showAnalytics;
          if (this.showAnalytics) {
            this.$nextTick(() => this.renderCharts());
          }
        },

        setChartTopMetric(metric) {
          this.chartTopMetric = metric;
          this.renderCharts();
        },

        renderCharts() {
          const ChartLib = window.Chart;
          if (!ChartLib) {
            setTimeout(() => this.renderCharts(), 100);
            return;
          }
          const store = (window.__productCharts = window.__productCharts || {});
          const self = this;
          const topList = window.__TOP_SELLING_PRODUCTS__ || [];
          const catList = (window.__CATEGORY_STATS__ || []).filter(c => c.categoryId !== 'all');

          // 1. Biểu đồ Top sản phẩm (Horizontal Bar Chart)
          const topCanvas = document.getElementById('topProductsChart');
          if (topCanvas) {
            if (store.topProducts) store.topProducts.destroy();
            const isRev = this.chartTopMetric === 'revenue';
            const sortedTop = [...topList].sort((a, b) => isRev ? (b.revenue - a.revenue) : (b.qty - a.qty)).slice(0, 7);

            store.topProducts = new ChartLib(topCanvas.getContext('2d'), {
              type: 'bar',
              data: {
                labels: sortedTop.map(it => (it.sku ? '[' + it.sku + '] ' : '') + (it.name.length > 20 ? it.name.slice(0, 18) + '...' : it.name)),
                datasets: [{
                  label: isRev ? 'Doanh thu (VNĐ)' : 'Số lượng bán',
                  data: sortedTop.map(it => isRev ? it.revenue : it.qty),
                  backgroundColor: isRev ? '#087b80' : '#0d9488',
                  borderRadius: 6,
                  barPercentage: 0.65
                }]
              },
              options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                onClick: (_evt, elements) => {
                  if (!elements.length) return;
                  const item = sortedTop[elements[0].index];
                  if (!item) return;
                  self.searchQuery = item.sku || item.name;
                  self.currentPage = 1;
                },
                scales: {
                  x: {
                    beginAtZero: true,
                    ticks: {
                      font: { size: 10 },
                      color: '#64748b',
                      callback: (val) => {
                        if (isRev) {
                          if (val >= 1e9) return (val / 1e9).toFixed(1) + ' tỷ';
                          if (val >= 1e6) return (val / 1e6).toFixed(0) + ' tr';
                          return val;
                        }
                        return Number(val).toLocaleString('vi-VN');
                      }
                    },
                    grid: { color: '#f1f5f9' }
                  },
                  y: {
                    ticks: { font: { size: 10, weight: '600' }, color: '#1e293b' },
                    grid: { display: false }
                  }
                },
                plugins: {
                  legend: { display: false },
                  tooltip: {
                    backgroundColor: '#0f172a',
                    padding: 10,
                    cornerRadius: 8,
                    callbacks: {
                      title: (ctx) => {
                        const item = sortedTop[ctx[0].index];
                        return item ? `[${item.sku}] ${item.name}` : '';
                      },
                      label: (ctx) => {
                        const item = sortedTop[ctx.dataIndex];
                        if (isRev) {
                          return [
                            ` Doanh thu: ${new Intl.NumberFormat('vi-VN').format(item.revenue)} ₫`,
                            ` Đã chốt: ${item.qty.toLocaleString('vi-VN')} sp (${item.orderCount} đơn)`
                          ];
                        }
                        return [
                          ` Số lượng bán: ${item.qty.toLocaleString('vi-VN')} sp`,
                          ` Doanh thu: ${new Intl.NumberFormat('vi-VN').format(item.revenue)} ₫`
                        ];
                      }
                    }
                  }
                }
              }
            });
          }

          // 2. Biểu đồ Tỷ trọng Doanh thu theo Ngành hàng (Doughnut Chart)
          const catCanvas = document.getElementById('categoryPieChart');
          if (catCanvas) {
            if (store.categoryPie) store.categoryPie.destroy();
            const validCats = [...catList].sort((a, b) => b.revenue - a.revenue);
            const palette = [
              '#087b80', '#0ea5e9', '#3b82f6', '#6366f1', '#8b5cf6',
              '#ec4899', '#f43f5e', '#f97316', '#eab308', '#10b981', '#64748b'
            ];
            const totalCatRev = validCats.reduce((acc, c) => acc + (Number(c.revenue) || 0), 0) || 1;

            store.categoryPie = new ChartLib(catCanvas.getContext('2d'), {
              type: 'doughnut',
              data: {
                labels: validCats.map(c => c.name),
                datasets: [{
                  data: validCats.map(c => c.revenue),
                  backgroundColor: palette.slice(0, validCats.length),
                  borderColor: '#ffffff',
                  borderWidth: 2,
                  hoverOffset: 6
                }]
              },
              options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '66%',
                onClick: (_evt, elements) => {
                  if (!elements.length) return;
                  const cat = validCats[elements[0].index];
                  if (!cat) return;
                  self.selectedCategory = self.selectedCategory === String(cat.categoryId) ? 'all' : String(cat.categoryId);
                  self.currentPage = 1;
                },
                plugins: {
                  legend: {
                    position: 'right',
                    labels: {
                      boxWidth: 10,
                      boxHeight: 10,
                      font: { size: 10, weight: '500' },
                      color: '#475569',
                      padding: 8,
                      generateLabels: (chart) => {
                        const original = ChartLib.overrides.doughnut.plugins.legend.labels.generateLabels(chart);
                        return original.map((item, idx) => {
                          const c = validCats[idx];
                          const pct = c ? Math.round((c.revenue / totalCatRev) * 100) : 0;
                          item.text = `${c.name} (${pct}%)`;
                          return item;
                        });
                      }
                    }
                  },
                  tooltip: {
                    backgroundColor: '#0f172a',
                    padding: 10,
                    cornerRadius: 8,
                    callbacks: {
                      label: (ctx) => {
                        const c = validCats[ctx.dataIndex];
                        const pct = Math.round((c.revenue / totalCatRev) * 100);
                        return ` ${new Intl.NumberFormat('vi-VN').format(c.revenue)} ₫ (${pct}%) · ${c.publishedCount} SP`;
                      }
                    }
                  }
                }
              }
            });
          }
        },

        showToast(message, type = 'success') {
          this.toast = { show: true, message, type };
          setTimeout(() => {
            this.toast.show = false;
          }, 4000);
        },

        get counts() {
          const list = this.products || [];
          return {
            total: list.length,
            published: list.filter((p) => p.status === 'published').length,
            draft: list.filter((p) => p.status === 'draft').length,
            archived: list.filter((p) => p.status === 'archived').length,
            priceReview: list.filter((p) => !(p.wholesale_price > 0 && p.price > 0 && p.wholesale_price < p.price)).length,
            outOfStock: list.filter((p) => p.stock_available !== null && p.stock_available <= 0).length,
          };
        },

        get filteredProducts() {
          const q = (this.searchQuery || '').toLowerCase().trim();
          const cat = this.selectedCategory;
          const status = this.selectedStatus;
          const warning = this.filterWarning;

          return (this.products || []).filter((p) => {
            const matchSearch =
              !q ||
              (p.name && p.name.toLowerCase().includes(q)) ||
              (p.sku && p.sku.toLowerCase().includes(q));

            const matchStatus = status === 'all' || p.status === status;

            const matchCategory =
              cat === 'all' ||
              String(p.category_id ?? p.category) === String(cat) ||
              p.category_slug === cat;

            let matchWarning = true;
            if (warning === 'price') {
              matchWarning = !(p.wholesale_price > 0 && p.price > 0 && p.wholesale_price < p.price);
            } else if (warning === 'out_of_stock') {
              matchWarning = p.stock_available !== null && p.stock_available <= 0;
            }

            return matchSearch && matchStatus && matchCategory && matchWarning;
          });
        },

        get totalPages() {
          return Math.max(1, Math.ceil(this.filteredProducts.length / this.pageSize));
        },

        get paginatedProducts() {
          const start = (this.currentPage - 1) * this.pageSize;
          return this.filteredProducts.slice(start, start + this.pageSize);
        },

        setFilterWarning(type) {
          this.filterWarning = this.filterWarning === type ? 'all' : type;
          this.currentPage = 1;
        },

        goToPage(page) {
          if (page >= 1 && page <= this.totalPages) {
            this.currentPage = page;
          }
        },

        openEdit(p) {
          this.editingProduct = {
            id: p.id,
            name: p.name,
            sku: p.sku,
            specification: p.specification && p.specification !== '—' ? p.specification : '15 que/túi',
            price: p.price,
            wholesale_price: p.wholesale_price,
            status: p.status || 'published',
          };
          this.editModalOpen = true;
        },

        autoCalcWholesale() {
          const price = Number(this.editingProduct.price) || 0;
          const ratio = Math.max(0, Math.min(100, Number(this.baseDiscountPercent) || 22)) / 100;
          this.editingProduct.wholesale_price = Math.round(price * (1 - ratio));
        },

        async saveEdit() {
          this.saving = true;
          try {
            const res = await fetch('/api/admin/products', {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                id: this.editingProduct.id,
                name: this.editingProduct.name,
                specification: this.editingProduct.specification,
                price: Number(this.editingProduct.price),
                wholesale_price: Number(this.editingProduct.wholesale_price),
                status: this.editingProduct.status,
              }),
            });
            const data = await res.json();
            if (data.success) {
              const idx = this.products.findIndex((p) => p.id === this.editingProduct.id);
              if (idx !== -1) {
                this.products[idx].name = this.editingProduct.name;
                this.products[idx].specification = this.editingProduct.specification || '—';
                this.products[idx].price = Number(this.editingProduct.price);
                this.products[idx].wholesale_price = Number(this.editingProduct.wholesale_price);
                this.products[idx].status = this.editingProduct.status;
              }
              this.editModalOpen = false;
              this.showToast('Cập nhật sản phẩm thành công!');
            } else {
              alert('Lỗi: ' + (data.error || 'Cập nhật thất bại'));
            }
          } catch (err) {
            alert('Lỗi kết nối máy chủ');
          } finally {
            this.saving = false;
          }
        },

        async quickUpdateStatus(id, newStatus) {
          try {
            const res = await fetch('/api/admin/products', {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id, status: newStatus }),
            });
            const data = await res.json();
            if (data.success) {
              const idx = this.products.findIndex((p) => p.id === id);
              if (idx !== -1) {
                this.products[idx].status = newStatus;
              }
              this.showToast('Đã đổi trạng thái sản phẩm');
            }
          } catch (err) {
            alert('Lỗi khi đổi trạng thái');
          }
        },

        formatVnd(num) {
          return new Intl.NumberFormat('vi-VN').format(num || 0) + ' ₫';
        },
      };
    };
  </script>


            class="px-3 py-2 rounded-xl text-xs font-bold border transition-all flex items-center gap-1.5 cursor-pointer"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
            </svg>
            <span>Hết hàng</span>
            <span class="px-1.5 py-0.2 rounded-full text-[10px]" :class="filterWarning === 'out_of_stock' ? 'bg-white/20 text-white' : 'bg-rose-200/80 text-rose-900'" x-text="counts.outOfStock"></span>
          </button>
        </div>
      </div>

      <!-- Status Tabs & Pagination summary -->
      <div class="flex items-center justify-between border-t border-slate-100 pt-3 flex-wrap gap-2">
        <div class="flex items-center gap-1.5 p-1 bg-slate-100/80 rounded-xl overflow-x-auto max-w-full">
          <button
            type="button"
            @click="selectedStatus = 'all'; currentPage = 1;"
            :class="selectedStatus === 'all' ? 'bg-[#083a3c] text-white shadow-xs' : 'text-slate-600 hover:text-slate-900'"
            class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all whitespace-nowrap cursor-pointer"
          >
            Tất cả (<span x-text="counts.total"></span>)
          </button>
          <button
            type="button"
            @click="selectedStatus = 'published'; currentPage = 1;"
            :class="selectedStatus === 'published' ? 'bg-[#083a3c] text-white shadow-xs' : 'text-slate-600 hover:text-slate-900'"
            class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all whitespace-nowrap cursor-pointer"
          >
            Đang bán (<span x-text="counts.published"></span>)
          </button>
          <button
            type="button"
            @click="selectedStatus = 'draft'; currentPage = 1;"
            :class="selectedStatus === 'draft' ? 'bg-[#083a3c] text-white shadow-xs' : 'text-slate-600 hover:text-slate-900'"
            class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all whitespace-nowrap cursor-pointer"
          >
            Bản nháp (<span x-text="counts.draft"></span>)
          </button>
          <button
            type="button"
            @click="selectedStatus = 'archived'; currentPage = 1;"
            :class="selectedStatus === 'archived' ? 'bg-[#083a3c] text-white shadow-xs' : 'text-slate-600 hover:text-slate-900'"
            class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all whitespace-nowrap cursor-pointer"
          >
            Lưu trữ (<span x-text="counts.archived"></span>)
          </button>
        </div>

        <div class="text-xs text-slate-500 font-medium flex items-center gap-2">
          <span>Tìm thấy <strong class="text-slate-800" x-text="filteredProducts.length"></strong> sản phẩm</span>
          <span class="text-slate-300">|</span>
          <span>Trang <strong class="text-slate-800" x-text="currentPage"></strong> / <span x-text="totalPages"></span></span>
        </div>
      </div>
    </div>

    <!-- PRODUCTS TABLE (DESKTOP) -->
    <div class="hidden lg:block bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-600">
          <thead class="bg-slate-50/80 text-xs font-bold text-slate-500 uppercase tracking-wider border-b border-slate-100 whitespace-nowrap">
            <tr>
              <th class="py-3 px-4">Sản phẩm &amp; SKU</th>
              <th class="py-3 px-4 w-52">Ngành hàng / Đóng gói</th>
              <th class="py-3 px-4 text-center w-36">Tồn kho</th>
              <th class="py-3 px-4 text-right w-36">Giá sỉ B2B</th>
              <th class="py-3 px-4 text-center w-36">Trạng thái</th>
              <th class="py-3 px-4 text-center w-20">Thao tác</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <template x-if="paginatedProducts.length === 0">
              <tr>
                <td colspan="6" class="py-12 text-center text-slate-400">
                  <div class="w-12 h-12 mx-auto mb-2 text-slate-300 flex items-center justify-center">
                    <svg class="w-10 h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m7.5 4.27 9 5.15"/>
                      <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/>
                      <path d="m3.3 7 8.7 5 8.7-5"/>
                      <path d="M12 22V12"/>
                    </svg>
                  </div>
                  <div class="font-medium text-slate-600">Không tìm thấy sản phẩm nào phù hợp</div>
                  <div class="text-xs text-slate-400 mt-1">Thử thay đổi từ khóa tìm kiếm hoặc bỏ bớt các bộ lọc</div>
                </td>
              </tr>
            </template>

            <template x-for="p in paginatedProducts" :key="p.id">
              <tr class="hover:bg-slate-50/80 transition-colors">
                <!-- 1: PRODUCT INFO (Image 44x44 + Name + SKU) -->
                <td class="py-3 px-4">
                  <div class="flex items-center gap-3">
                    <div class="w-11 h-11 rounded-xl border border-slate-200 bg-white overflow-hidden flex items-center justify-center shrink-0 shadow-2xs">
                      <img
                        :src="p.image_url"
                        :alt="p.name"
                        class="w-full h-full object-contain p-1"
                        loading="lazy"
                        @error="$el.style.display='none'; $el.nextElementSibling.style.display='flex';"
                      />
                      <div style="display: none;" class="w-full h-full items-center justify-center text-slate-300 bg-slate-50">
                        <svg class="w-5 h-5 text-slate-300" viewBox="0 0 24 24" fill="currentColor">
                          <circle cx="12" cy="14" r="4"/>
                          <circle cx="6.5" cy="8.5" r="2.5"/>
                          <circle cx="17.5" cy="8.5" r="2.5"/>
                          <circle cx="10" cy="4" r="2"/>
                          <circle cx="14" cy="4" r="2"/>
                        </svg>
                      </div>
                    </div>
                    <div class="min-w-0 max-w-sm">
                      <div class="font-bold text-slate-900 text-sm hover:text-[#087b80] transition-colors leading-snug truncate" :title="p.name" x-text="p.name"></div>
                      <div class="flex items-center gap-2 mt-1">
                        <button
                          type="button"
                          @click="searchQuery = p.sku; currentPage = 1;"
                          class="font-mono font-bold text-[11px] text-[#087b80] bg-teal-50 hover:bg-teal-100 px-1.5 py-0.5 rounded border border-teal-200/50 cursor-pointer"
                          x-text="p.sku"
                          title="Lọc nhanh SKU"
                        ></button>
                        <template x-if="!(p.wholesale_price > 0 && p.price > 0 && p.wholesale_price < p.price)">
                          <span class="px-1.5 py-0.2 rounded bg-amber-50 text-amber-700 text-[10px] font-bold border border-amber-200/60 inline-flex items-center gap-1" title="Giá sỉ chưa hợp lệ">
                            <svg class="w-2.5 h-2.5 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
                              <line x1="12" y1="9" x2="12" y2="13"/>
                              <line x1="12" y1="17" x2="12.01" y2="17"/>
                            </svg>
                            <span>Soát giá</span>
                          </span>
                        </template>
                      </div>
                    </div>
                  </div>
                </td>

                <!-- 2: CATEGORY & UNIT -->
                <td class="py-3 px-4 whitespace-nowrap">
                  <div class="font-semibold text-xs text-slate-700 truncate" x-text="p.category_name"></div>
                  <div class="text-[11px] text-slate-400 mt-0.5 truncate" x-text="p.specification"></div>
                </td>

                <!-- 3: INVENTORY (Number only; Red badge when <= 0) -->
                <td class="py-3 px-4 text-center whitespace-nowrap">
                  <template x-if="p.stock_available === null">
                    <span class="text-xs text-slate-400">—</span>
                  </template>
                  <template x-if="p.stock_available !== null && p.stock_available <= 0">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-rose-50 text-rose-700 font-bold text-xs border border-rose-200/60 whitespace-nowrap">
                      Hết hàng (0)
                    </span>
                  </template>
                  <template x-if="p.stock_available !== null && p.stock_available > 0">
                    <span class="font-mono text-xs font-bold text-slate-800" x-text="p.stock_available.toLocaleString('vi-VN')"></span>
                  </template>
                </td>

                <!-- 4: WHOLESALE B2B ONLY (#087b80 BOLD) -->
                <td class="py-3 px-4 text-right whitespace-nowrap">
                  <span class="font-black text-[#087b80] text-sm" x-text="formatVnd(p.wholesale_price)"></span>
                </td>

                <!-- 5: STATUS DROPDOWN -->
                <td class="py-3 px-4 text-center whitespace-nowrap">
                  <select
                    :value="p.status || 'published'"
                    @change="quickUpdateStatus(p.id, $event.target.value)"
                    :class="{
                      'bg-emerald-50 text-emerald-700 border-emerald-200': p.status === 'published',
                      'bg-amber-50 text-amber-700 border-amber-200': p.status === 'draft',
                      'bg-slate-100 text-slate-600 border-slate-200': p.status === 'archived'
                    }"
                    class="text-xs font-bold px-2.5 py-1 rounded-lg border cursor-pointer focus:outline-none transition-colors"
                  >
                    <option value="published">Đang bán</option>
                    <option value="draft">Bản nháp</option>
                    <option value="archived">Lưu trữ / Ẩn</option>
                  </select>
                </td>

                <!-- 6: ACTIONS -->
                <td class="py-3 px-4 text-center whitespace-nowrap">
                  <button
                    type="button"
                    @click="openEdit(p)"
                    class="px-2.5 py-1 rounded-lg text-xs font-bold text-[#087b80] bg-teal-50 hover:bg-teal-100 border border-teal-200/60 transition-colors cursor-pointer"
                  >
                    Sửa
                  </button>
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>

      <!-- DESKTOP PAGINATION FOOTER -->
      <div class="p-4 border-t border-slate-100 bg-slate-50/50 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
        <div class="text-slate-500 font-medium">
          Hiển thị
          <strong class="text-slate-800" x-text="filteredProducts.length === 0 ? 0 : (currentPage - 1) * pageSize + 1"></strong>
          -
          <strong class="text-slate-800" x-text="Math.min(currentPage * pageSize, filteredProducts.length)"></strong>
          trong tổng số
          <strong class="text-slate-800" x-text="filteredProducts.length"></strong> sản phẩm
        </div>

        <div class="flex items-center gap-2">
          <!-- Page size selector -->
          <div class="flex items-center gap-1.5 mr-2">
            <span class="text-slate-500">Hiển thị:</span>
            <select
              x-model.number="pageSize"
              @change="currentPage = 1"
              class="px-2 py-1 bg-white border border-slate-200 rounded-lg font-bold text-slate-700 text-xs cursor-pointer focus:outline-none"
            >
              <option :value="20">20 / trang</option>
              <option :value="50">50 / trang</option>
              <option :value="100">100 / trang</option>
            </select>
          </div>

          <!-- Pagination buttons -->
          <div class="flex items-center gap-1">
            <button
              type="button"
              @click="goToPage(1)"
              :disabled="currentPage === 1"
              class="px-2 py-1 rounded-lg border border-slate-200 bg-white hover:bg-slate-100 disabled:opacity-40 disabled:cursor-not-allowed font-bold text-slate-700 cursor-pointer"
              title="Trang đầu"
            >
              « Đầu
            </button>
            <button
              type="button"
              @click="goToPage(currentPage - 1)"
              :disabled="currentPage === 1"
              class="px-2.5 py-1 rounded-lg border border-slate-200 bg-white hover:bg-slate-100 disabled:opacity-40 disabled:cursor-not-allowed font-bold text-slate-700 cursor-pointer"
              title="Trang trước"
            >
              ‹
            </button>

            <span class="px-3 py-1 font-bold text-slate-700 bg-white border border-slate-200 rounded-lg">
              <span class="text-[#087b80]" x-text="currentPage"></span> / <span x-text="totalPages"></span>
            </span>

            <button
              type="button"
              @click="goToPage(currentPage + 1)"
              :disabled="currentPage === totalPages"
              class="px-2.5 py-1 rounded-lg border border-slate-200 bg-white hover:bg-slate-100 disabled:opacity-40 disabled:cursor-not-allowed font-bold text-slate-700 cursor-pointer"
              title="Trang sau"
            >
              ›
            </button>
            <button
              type="button"
              @click="goToPage(totalPages)"
              :disabled="currentPage === totalPages"
              class="px-2 py-1 rounded-lg border border-slate-200 bg-white hover:bg-slate-100 disabled:opacity-40 disabled:cursor-not-allowed font-bold text-slate-700 cursor-pointer"
              title="Trang cuối"
            >
              Cuối »
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- PRODUCTS CARDS (MOBILE RESPONSIVE) -->
    <div class="block lg:hidden space-y-3">
      <template x-if="paginatedProducts.length === 0">
        <div class="bg-white p-8 rounded-2xl border border-slate-200 text-center text-slate-400">
          Không tìm thấy sản phẩm nào phù hợp
        </div>
      </template>

      <template x-for="p in paginatedProducts" :key="p.id">
        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs space-y-3">
          <div class="flex items-start gap-3">
            <div class="w-14 h-14 rounded-xl border border-slate-200 bg-slate-50 overflow-hidden flex items-center justify-center shrink-0">
              <img :src="p.image_url" :alt="p.name" class="w-full h-full object-cover" loading="lazy" />
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2">
                <span class="font-mono font-bold text-xs text-[#087b80] bg-teal-50 px-2 py-0.5 rounded" x-text="p.sku"></span>
                <span class="text-xs text-slate-500 font-mono" x-text="p.stock_available !== null ? 'Kho: ' + p.stock_available : ''"></span>
              </div>
              <h3 class="font-bold text-slate-900 text-sm mt-1 leading-snug truncate" x-text="p.name"></h3>
              <div class="text-xs text-slate-500 mt-0.5" x-text="p.category_name"></div>
            </div>
          </div>

          <div class="pt-2 border-t border-slate-100 text-xs">
            <span class="text-slate-400 block">Giá sỉ B2B:</span>
            <strong class="text-[#087b80] font-black text-sm" x-text="formatVnd(p.wholesale_price)"></strong>
          </div>

          <div class="flex items-center justify-between pt-2 border-t border-slate-100">
            <select
              :value="p.status || 'published'"
              @change="quickUpdateStatus(p.id, $event.target.value)"
              class="text-xs font-bold px-2 py-1 rounded-lg border border-slate-200 bg-white"
            >
              <option value="published">Đang bán</option>
              <option value="draft">Bản nháp</option>
              <option value="archived">Lưu trữ</option>
            </select>

            <button
              type="button"
              @click="openEdit(p)"
              class="px-3 py-1 rounded-lg text-xs font-bold text-white bg-[#087b80] hover:bg-[#066367]"
            >
              Chỉnh sửa
            </button>
          </div>
        </div>
      </template>

      <!-- MOBILE PAGINATION -->
      <div x-show="totalPages > 1" class="p-3 bg-white rounded-xl border border-slate-200 flex items-center justify-between text-xs">
        <button
          type="button"
          @click="goToPage(currentPage - 1)"
          :disabled="currentPage === 1"
          class="px-3 py-1.5 rounded-lg border border-slate-200 font-bold disabled:opacity-40"
        >
          ‹ Trước
        </button>
        <span class="font-bold text-slate-700">Trang <span class="text-[#087b80]" x-text="currentPage"></span> / <span x-text="totalPages"></span></span>
        <button
          type="button"
          @click="goToPage(currentPage + 1)"
          :disabled="currentPage === totalPages"
          class="px-3 py-1.5 rounded-lg border border-slate-200 font-bold disabled:opacity-40"
        >
          Sau ›
        </button>
      </div>
    </div>

    <!-- QUICK EDIT MODAL -->
    <div
      x-show="editModalOpen"
      x-cloak
      style="display: none;"
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-xs"
      @keydown.escape.window="editModalOpen = false"
    >
      <div
        class="bg-white rounded-3xl border border-slate-200 shadow-2xl w-full max-w-lg overflow-hidden transform transition-all"
        @click.away="editModalOpen = false"
      >
        <!-- Modal Header -->
        <div class="p-5 border-b border-slate-100 bg-slate-50 flex items-center justify-between">
          <div>
            <h2 class="text-lg font-black text-[#083a3c]">Chỉnh sửa nhanh sản phẩm</h2>
            <p class="text-xs text-slate-500 font-medium">Cập nhật thông tin, giá bán và trạng thái sản phẩm (PostgreSQL)</p>
          </div>
          <button
            type="button"
            @click="editModalOpen = false"
            class="text-slate-400 hover:text-slate-700 text-lg font-bold p-1 cursor-pointer"
          >
            ✕
          </button>
        </div>

        <!-- Modal Body -->
        <div class="p-6 space-y-4">
          <!-- Product Info summary -->
          <div class="p-3 bg-teal-50/60 rounded-xl border border-teal-100">
            <div class="font-bold text-slate-900 text-sm" x-text="editingProduct.name"></div>
            <div class="text-xs text-slate-500 font-mono mt-0.5">SKU: <strong class="text-[#087b80]" x-text="editingProduct.sku"></strong></div>
          </div>

          <!-- Name & Specification inputs -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">
                Tên sản phẩm
              </label>
              <input
                type="text"
                x-model="editingProduct.name"
                class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-xs font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-[#087b80]"
              />
            </div>
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">
                Quy cách đóng gói
              </label>
              <input
                type="text"
                x-model="editingProduct.specification"
                placeholder="VD: 15 que/túi - 90g"
                class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-xs font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-[#087b80]"
              />
            </div>
          </div>

          <!-- Price MRP input -->
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">
              Giá niêm yết (MRP) (VNĐ)
            </label>
            <input
              type="number"
              x-model.number="editingProduct.price"
              @input="autoCalcWholesale()"
              class="w-full px-4 py-2.5 rounded-xl border border-slate-300 font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-[#087b80]"
            />
            <span class="text-[11px] text-slate-400 mt-1 block">Giá bán lẻ tham khảo hiển thị trên website</span>
          </div>

          <!-- Wholesale price input -->
          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="block text-xs font-bold uppercase tracking-wider text-[#087b80]">
                Giá sỉ đại lý B2B (VNĐ)
              </label>
              <button
                type="button"
                @click="autoCalcWholesale()"
                class="text-[11px] font-bold text-[#087b80] hover:underline cursor-pointer"
              >
                Tự động tính (-<span x-text="baseDiscountPercent"></span>%)
              </button>
            </div>
            <input
              type="number"
              x-model.number="editingProduct.wholesale_price"
              class="w-full px-4 py-2.5 rounded-xl border border-slate-300 font-bold text-[#087b80] focus:outline-none focus:ring-2 focus:ring-[#087b80]"
            />
            <span class="text-[11px] text-slate-400 mt-1 block">Giá áp dụng cho các đại lý đã duyệt tài khoản</span>
          </div>

          <!-- Status selection -->
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">
              Trạng thái sản phẩm
            </label>
            <div class="grid grid-cols-3 gap-2">
              <label
                :class="editingProduct.status === 'published' ? 'border-[#087b80] bg-teal-50 text-[#087b80] font-bold' : 'border-slate-200 text-slate-600'"
                class="flex items-center justify-center gap-1.5 p-2.5 rounded-xl border text-xs cursor-pointer transition-all text-center"
              >
                <input type="radio" value="published" x-model="editingProduct.status" class="sr-only" />
                <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block"></span>
                <span>Đang bán</span>
              </label>

              <label
                :class="editingProduct.status === 'draft' ? 'border-amber-500 bg-amber-50 text-amber-700 font-bold' : 'border-slate-200 text-slate-600'"
                class="flex items-center justify-center gap-1.5 p-2.5 rounded-xl border text-xs cursor-pointer transition-all text-center"
              >
                <input type="radio" value="draft" x-model="editingProduct.status" class="sr-only" />
                <span class="w-2 h-2 rounded-full bg-amber-500 inline-block"></span>
                <span>Bản nháp</span>
              </label>

              <label
                :class="editingProduct.status === 'archived' ? 'border-slate-500 bg-slate-100 text-slate-700 font-bold' : 'border-slate-200 text-slate-600'"
                class="flex items-center justify-center gap-1.5 p-2.5 rounded-xl border text-xs cursor-pointer transition-all text-center"
              >
                <input type="radio" value="archived" x-model="editingProduct.status" class="sr-only" />
                <svg class="w-3.5 h-3.5 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="5" x="2" y="3" rx="1"/>
                  <path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/>
                  <path d="M10 12h4"/>
                </svg>
                <span>Lưu trữ</span>
              </label>
            </div>
          </div>
        </div>

        <!-- Modal Footer -->
        <div class="p-5 border-t border-slate-100 bg-slate-50 flex items-center justify-end gap-3">
          <button
            type="button"
            @click="editModalOpen = false"
            class="px-4 py-2 rounded-xl text-sm font-bold text-slate-600 hover:text-slate-900 cursor-pointer"
          >
            Hủy bỏ
          </button>
          <button
            type="button"
            @click="saveEdit()"
            :disabled="saving"
            class="px-5 py-2.5 rounded-xl text-sm font-bold text-white bg-[#087b80] hover:bg-[#066367] transition-all disabled:opacity-60 cursor-pointer shadow-xs"
          >
            <span x-text="saving ? 'Đang lưu...' : 'Lưu thay đổi'"></span>
          </button>
        </div>
      </div>
    </div>

    <!-- FLOATING TOAST -->
    <div
      x-show="toast.show"
      x-cloak
      style="display: none;"
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0 translate-y-2"
      x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition ease-in duration-200"
      x-transition:leave-start="opacity-100 translate-y-0"
      x-transition:leave-end="opacity-0 translate-y-2"
      class="fixed bottom-6 right-6 z-50 bg-[#083a3c] text-white px-5 py-3 rounded-2xl shadow-xl flex items-center gap-3 border border-[#0d4f52]"
    >
      <svg class="w-5 h-5 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
      <span class="text-sm font-bold" x-text="toast.message"></span>
    </div>
  </div>
</AdminLayout>

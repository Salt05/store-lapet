---
// src/pages/san-pham/[slug].astro
export const prerender = false;

// Anti-cache header for live dealer/cookie authorization
Astro.response.headers.set('Cache-Control', 'private, no-store');

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import Badge from '../../components/common/Badge.astro';
import Button from '../../components/common/Button.astro';
import ProductGallery from '../../components/product/ProductGallery.astro';
import ProductCard from '../../components/product/ProductCard.astro';
import {
  getProductBySlug,
  getProductGroups,
  getRelatedProducts,
  assetUrl,
  formatVnd,
  PLACEHOLDER_IMAGE,
  getDirectusUrl,
  enrichWithPostgresData,
} from '../../lib/catalog';

const { slug = '' } = Astro.params;
const auth = Astro.locals.auth;
const isAuthenticated = Boolean(auth?.isAuthenticated);
const isDealer = auth?.isDealer === true;

// 1. Fetch Product Detail
let product = await getProductBySlug(slug);

// Fallback fetch if product is in draft status or directusGet with published filter didn't find it
if (!product && slug) {
  try {
    const directusUrl = getDirectusUrl();
    if (directusUrl) {
      const res = await fetch(
        `${directusUrl}/items/products?limit=1&filter[slug][_eq]=${encodeURIComponent(slug)}&fields=id,odoo_id,sku,name,slug,price,wholesale_price,sold_quantity,weight,specification,ingredients,description,target,preservation,nutritional_info,images.directus_files_id,product_groups.product_groups_id`
      );
      if (res.ok) {
        const json = await res.json();
        const raw = json?.data?.[0];
        if (raw) {
          const extractFileId = (img: any) => {
            if (!img) return null;
            if (typeof img === 'string') return img;
            if (typeof img.directus_files_id === 'string') return img.directus_files_id;
            if (img.directus_files_id?.id) return img.directus_files_id.id;
            return null;
          };
          const extractGroupId = (g: any) => {
            if (!g) return null;
            if (typeof g === 'number') return g;
            const r = g.product_groups_id;
            if (r && typeof r === 'object') return Number(r.id) || null;
            return Number(r) || null;
          };
          product = {
            id: Number(raw.id),
            odoo_id: raw.odoo_id ? parseInt(String(raw.odoo_id), 10) : null,
            sku: raw.sku || '',
            name: raw.name || 'Sản phẩm LA PET',
            slug: raw.slug || String(raw.id),
            price: Number(raw.price) || 0,
            wholesale_price: Number(raw.wholesale_price) || 0,
            sold_quantity: Number(raw.sold_quantity) || 0,
            weight: raw.weight || null,
            specification: raw.specification || null,
            ingredients: raw.ingredients || null,
            description: raw.description || null,
            target: raw.target || null,
            preservation: raw.preservation || null,
            nutritional_info: raw.nutritional_info || null,
            imageIds: Array.isArray(raw.images) ? raw.images.map(extractFileId).filter(Boolean) : [],
            groupIds: Array.isArray(raw.product_groups) ? raw.product_groups.map(extractGroupId).filter((x: any) => x !== null) : [],
          };
        }
      }
    }
  } catch (err) {
    console.error('Directus fallback query failed:', err);
  }
}

if (product) {
  await enrichWithPostgresData([product]);
} else {
  Astro.response.status = 404;
}

// 2. Fetch Supporting Data
const [groups, related] = product
  ? await Promise.all([
      getProductGroups({ includeEmpty: true }),
      getRelatedProducts(product, 4),
    ])
  : [[], []];

const productGroups = product ? groups.filter((g) => product.groupIds.includes(g.id)) : [];
const primaryGroup = productGroups[0] ?? null;

// 3. Pricing Calculation (-22% dealer wholesale rule)
const retailPrice = product ? Number(product.price) || 0 : 0;
const wholesalePrice = product
  ? (Number(product.wholesale_price) > 0 ? Number(product.wholesale_price) : Math.round(retailPrice * 0.78))
  : 0;
const activePrice = isDealer ? wholesalePrice : retailPrice;
const discountPercent = retailPrice > 0 ? Math.round((1 - wholesalePrice / retailPrice) * 100) : 22;

// 4. Gallery Images
const galleryImages = product
  ? (product.imageIds && product.imageIds.length > 0 ? product.imageIds : [null]).map((id) => ({
      full: id ? assetUrl(id, { width: 1000, height: 1000, fit: 'contain', quality: 90, format: 'webp' }) : PLACEHOLDER_IMAGE,
      thumb: id ? assetUrl(id, { width: 200, height: 200, fit: 'contain', quality: 80, format: 'webp' }) : PLACEHOLDER_IMAGE,
      alt: product.name,
    }))
  : [{ full: PLACEHOLDER_IMAGE, thumb: PLACEHOLDER_IMAGE, alt: 'Sản phẩm không tồn tại' }];

// 5. Text & Specification Parsers
function parseDescription(text: string | null) {
  if (!text) return [];
  return text
    .split(/\n\s*\n/)
    .map((block) => block.split('\n').map((l) => l.trim()).filter(Boolean))
    .filter((lines) => lines.length > 0)
    .map((lines) => (lines.length > 1 ? { heading: lines[0], body: lines.slice(1).join(' ') } : { heading: null, body: lines[0] }));
}

function parseNutrition(text: string | null) {
  if (!text) return [];
  return text
    .split('\n')
    .map((l) => l.trim())
    .filter(Boolean)
    .map((line) => {
      const m = line.match(/^(.*?)\s*\((min|max)\)\s*(.+)$/i);
      if (m) return { name: m[1], kind: m[2].toLowerCase() === 'min' ? 'Tối thiểu' : 'Tối đa', value: m[3] };
      const m2 = line.match(/^(.*?)[\s:]+([\d.,]+\s*%?.*)$/);
      return m2 ? { name: m2[1], kind: '', value: m2[2] } : { name: line, kind: '', value: '' };
    });
}

const descriptionBlocks = parseDescription(product?.description ?? null);
const nutritionRows = parseNutrition(product?.nutritional_info ?? null);

const specRows = product
  ? [
      { label: 'Mã SKU', value: product.sku },
      { label: 'Khối lượng tịnh', value: product.weight },
      { label: 'Quy cách đóng gói', value: product.specification },
      { label: 'Nhóm sản phẩm', value: productGroups.map((g) => g.name).join(', ') },
      { label: 'Đối tượng sử dụng', value: product.target },
      { label: 'Bảo quản', value: product.preservation },
    ].filter((r) => r.value)
  : [];

// 6. Breadcrumb Hierarchy (Home -> Sản phẩm -> Danh mục -> Tên sản phẩm)
const breadcrumbItems = product
  ? [
      { label: 'Sản phẩm', href: '/san-pham' },
      ...(primaryGroup ? [{ label: primaryGroup.name, href: `/san-pham?category=${primaryGroup.slug}` }] : []),
      { label: product.name, current: true },
    ]
  : [
      { label: 'Sản phẩm', href: '/san-pham' },
      { label: 'Không tìm thấy sản phẩm', current: true },
    ];

// 7. Cart Item Payload
const cartPayload = product
  ? {
      odoo_id: product.odoo_id,
      product_id: String(product.id),
      sku: product.sku || '',
      name: product.name,
      price: activePrice,
      retail_price: retailPrice,
      wholesale_price: wholesalePrice,
      quantity: 1,
      image: galleryImages[0]?.thumb || PLACEHOLDER_IMAGE,
      slug: product.slug,
    }
  : null;
---

<BaseLayout
  title={product ? `${product.name} - LA PET Store` : 'Không tìm thấy sản phẩm - LA PET Store'}
  description={product?.description ? product.description.slice(0, 160) : 'Chi tiết sản phẩm thú cưng cao cấp LA PET'}
  image={galleryImages[0]?.full}
>
  {!product && (
    <main class="max-w-4xl mx-auto px-4 py-16 sm:py-24 text-center">
      <div class="w-20 h-20 mx-auto mb-6 rounded-full bg-brand-surface flex items-center justify-center text-brand-muted border border-brand-border">
        <svg class="w-10 h-10 stroke-current fill-none stroke-1.5" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-brand-dark mb-2">
        Không tìm thấy sản phẩm
      </h1>
      <p class="text-sm text-brand-muted max-w-md mx-auto mb-8">
        Sản phẩm này có thể đã ngừng kinh doanh hoặc đường dẫn không chính xác. Quý khách vui lòng xem các sản phẩm khác.
      </p>
      <div class="flex items-center justify-center gap-3">
        <a
          href="/san-pham"
          class="inline-flex items-center justify-center h-11 px-6 text-sm font-bold text-white bg-brand-primary hover:bg-brand-dark rounded-xl shadow-soft hover:shadow-card transition-all"
        >
          Quay lại danh mục sản phẩm
        </a>
        <a
          href="/"
          class="inline-flex items-center justify-center h-11 px-6 text-sm font-bold text-brand-dark bg-white border border-brand-border hover:bg-brand-surface rounded-xl shadow-soft transition-all"
        >
          Trang chủ
        </a>
      </div>
    </main>
  )}

  {product && (
    <main
      class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10"
      x-data={`{
        quantity: 1,
        isAdding: false,
        activeTab: 'mo-ta',
        addToCart(andCheckout = false) {
          if (this.isAdding) return;
          this.isAdding = true;
          const baseItem = ${JSON.stringify(cartPayload)};
          if (!baseItem) return;
          const qty = Math.max(1, parseInt(this.quantity, 10) || 1);
          const item = { ...baseItem, quantity: qty };
          try {
            const cart = JSON.parse(localStorage.getItem('cart') || '[]');
            const idx = cart.findIndex(c => (item.odoo_id && c.odoo_id === item.odoo_id) || c.product_id === item.product_id || (c.slug && c.slug === item.slug));
            if (idx >= 0) {
              cart[idx].quantity = (cart[idx].quantity || 1) + item.quantity;
            } else {
              cart.push(item);
            }
            localStorage.setItem('cart', JSON.stringify(cart));
            window.dispatchEvent(new CustomEvent('cart-updated', { 
              detail: { 
                item, 
                totalCount: cart.reduce((t, i) => t + (i.quantity || 1), 0) 
              } 
            }));
            if (andCheckout) {
              window.location.href = '/thanh-toan';
            }
          } catch (err) {
            console.error('Cart error:', err);
          } finally {
            setTimeout(() => { this.isAdding = false; }, 400);
          }
        }
      }`}
    >
      <!-- Hierarchical Breadcrumb -->
      <Breadcrumb items={breadcrumbItems} class="mb-6 sm:mb-8" />

      <!-- TWO COLUMN PRODUCT HERO SECTION -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start mb-12 lg:mb-16">
        
        <!-- LEFT COLUMN: PRODUCT GALLERY (5 cols on desktop) -->
        <div class="lg:col-span-5 w-full">
          <ProductGallery
            images={galleryImages}
            productName={product.name}
            class="sticky top-24"
          />
        </div>

        <!-- RIGHT COLUMN: PRODUCT DETAILS & ACTIONS (7 cols on desktop) -->
        <div class="lg:col-span-7 flex flex-col space-y-6">
          
          <!-- Category, Brand & Stock Badges -->
          <div class="flex flex-wrap items-center gap-2">
            {primaryGroup && (
              <Badge variant="brand" size="sm">
                {primaryGroup.name}
              </Badge>
            )}
            <Badge variant="accent" size="sm" pill={true}>
              Sỉ -{discountPercent}%
            </Badge>
            <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              Còn hàng tại kho
            </span>
          </div>

          <!-- Product Title & SKU -->
          <div>
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-brand-dark tracking-tight leading-tight">
              {product.name}
            </h1>
            <div class="flex items-center gap-4 text-xs font-medium text-brand-muted mt-2">
              {product.sku && <span>SKU: <strong class="text-brand-dark font-mono">{product.sku}</strong></span>}
              <span>Thương hiệu: <strong class="text-brand-primary">LA PET</strong></span>
              {product.sold_quantity > 0 && (
                <span>Đã bán: <strong class="text-brand-dark">{product.sold_quantity.toLocaleString('vi-VN')}</strong></span>
              )}
            </div>
          </div>

          <!-- WHOLESALE PRICING BLOCK -->
          <div class="p-4 sm:p-5 rounded-2xl bg-brand-surface border border-brand-border/80 shadow-soft">
            <div>
              <span class="text-xs font-bold text-brand-primary uppercase tracking-wide block mb-1">
                Giá sỉ đại lý (-{discountPercent}%):
              </span>
              <div class="flex items-baseline gap-3">
                <span class="text-2xl sm:text-3xl lg:text-4xl font-black text-brand-dark tracking-tight">
                  {formatVnd(wholesalePrice)}
                </span>
                {retailPrice > wholesalePrice && (
                  <span class="text-base sm:text-lg text-brand-muted line-through font-mono">
                    {formatVnd(retailPrice)}
                  </span>
                )}
                <Badge variant="gold" size="sm" pill={true}>
                  Chiết khấu cao
                </Badge>
              </div>
            </div>

            <!-- Dealer Status Info Banner -->
            {!isDealer && (
              <div class="mt-4 pt-3 border-t border-brand-border/60 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs">
                <span class="text-brand-muted">
                  Bạn là cửa hàng Pet Shop hoặc Nhà thuốc thú y?
                </span>
                <a href="/lien-he#partner-registration" class="font-bold text-brand-primary hover:text-brand-dark hover:underline flex items-center gap-1">
                  Đăng ký đại lý B2B nhận giá sỉ →
                </a>
              </div>
            )}
          </div>

          <!-- QUANTITY SELECTOR & CALL-TO-ACTION BUTTONS -->
          <div class="space-y-4 pt-2">
            <!-- Quantity row -->
            <div class="flex items-center gap-4">
              <span class="text-sm font-bold text-brand-dark">Số lượng:</span>
              <div class="inline-flex items-center bg-white border border-brand-border rounded-xl shadow-2xs overflow-hidden">
                <button
                  type="button"
                  class="w-10 h-10 flex items-center justify-center text-brand-muted hover:text-brand-dark hover:bg-brand-surface font-bold text-base transition-colors cursor-pointer"
                  aria-label="Giảm số lượng"
                  @click="quantity = Math.max(1, quantity - 1)"
                >
                  −
                </button>
                <input
                  type="number"
                  min="1"
                  max="999"
                  x-model.number="quantity"
                  class="w-14 h-10 text-center font-bold text-sm text-brand-dark focus:outline-none border-x border-brand-border/60"
                  aria-label="Số lượng sản phẩm"
                />
                <button
                  type="button"
                  class="w-10 h-10 flex items-center justify-center text-brand-muted hover:text-brand-dark hover:bg-brand-surface font-bold text-base transition-colors cursor-pointer"
                  aria-label="Tăng số lượng"
                  @click="quantity = quantity + 1"
                >
                  +
                </button>
              </div>
            </div>

            <!-- Action Buttons Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
              <!-- Add To Cart -->
              <button
                type="button"
                class="w-full h-12 px-6 rounded-xl font-bold text-sm text-brand-primary bg-brand-primary/10 hover:bg-brand-primary hover:text-white border border-brand-primary/30 shadow-soft hover:shadow-card transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer active:scale-[0.98]"
                @click="addToCart(false)"
              >
                <svg class="w-5 h-5 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
                  <circle cx="9" cy="21" r="1"></circle>
                  <circle cx="20" cy="21" r="1"></circle>
                  <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
                <span>Thêm vào giỏ hàng</span>
              </button>

              <!-- Buy Now (Direct to checkout) -->
              <button
                type="button"
                class="w-full h-12 px-6 rounded-xl font-bold text-sm text-white bg-brand-primary hover:bg-brand-dark shadow-soft hover:shadow-card transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer active:scale-[0.98]"
                @click="addToCart(true)"
              >
                <svg class="w-5 h-5 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>Mua ngay</span>
              </button>
            </div>
          </div>

          <!-- TRUST COMMITMENTS -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-4 border-t border-brand-border/60">
            <div class="flex items-center gap-2.5 p-3 rounded-xl bg-white border border-brand-border/60 text-xs">
              <svg class="w-5 h-5 text-brand-primary stroke-current fill-none stroke-2 shrink-0" viewBox="0 0 24 24">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
              <span class="font-medium text-brand-dark leading-tight">100% thức ăn dinh dưỡng chính hãng</span>
            </div>
            <div class="flex items-center gap-2.5 p-3 rounded-xl bg-white border border-brand-border/60 text-xs">
              <svg class="w-5 h-5 text-brand-primary stroke-current fill-none stroke-2 shrink-0" viewBox="0 0 24 24">
                <polyline points="1 4 1 10 7 10"></polyline>
                <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
              </svg>
              <span class="font-medium text-brand-dark leading-tight">Đổi trả minh bạch trong 7 ngày</span>
            </div>
            <div class="flex items-center gap-2.5 p-3 rounded-xl bg-white border border-brand-border/60 text-xs">
              <svg class="w-5 h-5 text-brand-primary stroke-current fill-none stroke-2 shrink-0" viewBox="0 0 24 24">
                <rect x="1" y="3" width="15" height="13"></rect>
                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                <circle cx="5.5" cy="18.5" r="2.5"></circle>
                <circle cx="18.5" cy="18.5" r="2.5"></circle>
              </svg>
              <span class="font-medium text-brand-dark leading-tight">Giao hàng nhanh toàn quốc</span>
            </div>
          </div>

        </div>
      </div>

      <!-- PRODUCT TABS: MÔ TẢ, THÀNH PHẦN DINH DƯỠNG, QUY CÁCH -->
      <section class="mt-8 mb-16 bg-white rounded-2xl border border-brand-border/80 shadow-soft overflow-hidden">
        <!-- Tabs Header -->
        <div class="flex border-b border-brand-border/80 bg-brand-surface/40 overflow-x-auto scrollbar-thin">
          <button
            type="button"
            class="px-6 py-4 text-sm font-bold border-b-2 transition-all cursor-pointer whitespace-nowrap"
            :class="activeTab === 'mo-ta' ? 'border-brand-primary text-brand-primary bg-white' : 'border-transparent text-brand-muted hover:text-brand-dark'"
            @click="activeTab = 'mo-ta'"
          >
            Mô tả sản phẩm
          </button>
          <button
            type="button"
            class="px-6 py-4 text-sm font-bold border-b-2 transition-all cursor-pointer whitespace-nowrap"
            :class="activeTab === 'dinh-duong' ? 'border-brand-primary text-brand-primary bg-white' : 'border-transparent text-brand-muted hover:text-brand-dark'"
            @click="activeTab = 'dinh-duong'"
          >
            Thành phần & Dinh dưỡng
          </button>
          <button
            type="button"
            class="px-6 py-4 text-sm font-bold border-b-2 transition-all cursor-pointer whitespace-nowrap"
            :class="activeTab === 'quy-cach' ? 'border-brand-primary text-brand-primary bg-white' : 'border-transparent text-brand-muted hover:text-brand-dark'"
            @click="activeTab = 'quy-cach'"
          >
            Quy cách đóng gói
          </button>
        </div>

        <!-- Tab 1: Mô tả sản phẩm -->
        <div x-show="activeTab === 'mo-ta'" class="p-6 sm:p-8 space-y-4">
          {descriptionBlocks.length > 0 ? (
            descriptionBlocks.map((block) => (
              <div>
                {block.heading && (
                  <h3 class="text-base font-bold text-brand-dark mb-1.5">{block.heading}</h3>
                )}
                <p class="text-sm text-brand-text leading-relaxed">{block.body}</p>
              </div>
            ))
          ) : (
            <p class="text-sm text-brand-muted leading-relaxed">
              {product.description || 'Sản phẩm thức ăn và dinh dưỡng cao cấp dành cho thú cưng sản xuất theo tiêu chuẩn kiểm định nghiêm ngặt từ LA PET Store.'}
            </p>
          )}
        </div>

        <!-- Tab 2: Thành phần & Dinh dưỡng -->
        <div x-cloak x-show="activeTab === 'dinh-duong'" class="p-6 sm:p-8 space-y-6">
          {product.ingredients && (
            <div>
              <h3 class="text-sm font-bold uppercase tracking-wider text-brand-muted mb-2">Thành phần nguyên liệu</h3>
              <p class="text-sm text-brand-text leading-relaxed bg-brand-surface p-4 rounded-xl border border-brand-border/60">
                {product.ingredients}
              </p>
            </div>
          )}

          {nutritionRows.length > 0 && (
            <div>
              <h3 class="text-sm font-bold uppercase tracking-wider text-brand-muted mb-3">Chỉ tiêu dinh dưỡng</h3>
              <div class="overflow-hidden rounded-xl border border-brand-border/60">
                <table class="w-full text-left text-xs sm:text-sm">
                  <thead class="bg-brand-surface border-b border-brand-border/60">
                    <tr>
                      <th class="py-2.5 px-4 font-bold text-brand-dark">Chỉ tiêu</th>
                      <th class="py-2.5 px-4 font-bold text-brand-dark">Đặc tính</th>
                      <th class="py-2.5 px-4 font-bold text-brand-dark text-right">Hàm lượng</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-brand-border/40">
                    {nutritionRows.map((row) => (
                      <tr class="hover:bg-brand-surface/30">
                        <td class="py-2.5 px-4 font-medium text-brand-dark">{row.name}</td>
                        <td class="py-2.5 px-4 text-brand-muted">{row.kind || 'Tiêu chuẩn'}</td>
                        <td class="py-2.5 px-4 font-bold text-brand-primary text-right">{row.value}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          )}

          {!product.ingredients && nutritionRows.length === 0 && (
            <p class="text-sm text-brand-muted">Đang cập nhật bảng chỉ tiêu dinh dưỡng chi tiết từ nhà sản xuất.</p>
          )}
        </div>

        <!-- Tab 3: Quy cách & Bảo quản -->
        <div x-cloak x-show="activeTab === 'quy-cach'" class="p-6 sm:p-8">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {specRows.map((row) => (
              <div class="p-4 rounded-xl bg-brand-surface border border-brand-border/60 flex flex-col justify-between">
                <span class="text-xs text-brand-muted font-medium mb-1">{row.label}</span>
                <span class="text-sm font-bold text-brand-dark">{row.value}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- RELATED PRODUCTS SECTION -->
      {related && related.length > 0 && (
        <section class="mt-12 sm:mt-16 pt-8 border-t border-brand-border/80">
          <div class="flex items-center justify-between mb-6">
            <div>
              <h2 class="text-xl sm:text-2xl font-extrabold text-brand-dark tracking-tight">
                Sản phẩm liên quan
              </h2>
              <p class="text-xs sm:text-sm text-brand-muted mt-0.5">
                Các sản phẩm cùng danh mục được các đại lý quan tâm nhiều nhất
              </p>
            </div>
            <a
              href="/san-pham"
              class="text-xs sm:text-sm font-bold text-brand-primary hover:text-brand-dark hover:underline transition-colors hidden sm:inline-block"
            >
              Xem tất cả →
            </a>
          </div>

          <!-- Related Products Grid -->
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4 md:gap-5">
            {related.map((relProduct) => (
              <ProductCard
                product={relProduct}
                isDealer={isDealer}
                isLoggedIn={isAuthenticated}
              />
            ))}
          </div>
        </section>
      )}
    </main>
  )}
</BaseLayout>

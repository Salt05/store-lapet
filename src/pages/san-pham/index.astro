---
// src/pages/san-pham/index.astro
export const prerender = false;

// Anti-cache header for live cookie/dealer state evaluation
Astro.response.headers.set(
  'Cache-Control',
  'no-store, no-cache, must-revalidate, proxy-revalidate'
);

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import Badge from '../../components/common/Badge.astro';
import ProductCard from '../../components/product/ProductCard.astro';
import ProductGrid from '../../components/product/ProductGrid.astro';
import ProductFilter from '../../components/product/ProductFilter.astro';
import { getDirectusUrl, getPublicDirectusUrl, assetUrl, getProductGroups, enrichWithPostgresData } from '../../lib/catalog';

const DIRECTUS_URL = getDirectusUrl();
const PUBLIC_DIRECTUS_URL = getPublicDirectusUrl();

// 1. Auth & Dealer Status Check
const auth = Astro.locals.auth;
const isAuthenticated = Boolean(auth?.isAuthenticated);
const isDealer = Boolean(auth?.isDealer || auth?.user?.partner_id);

// 2. Fetch Data from Directus
let products: any[] = [];
let productGroups: { id: string | number; slug: string; name: string; productCount?: number }[] = [];
let fetchError = false;

try {
  const [resGroups, resProducts] = await Promise.all([
    fetch(`${DIRECTUS_URL}/items/product_groups?limit=-1&fields=id,name,slug&sort=id`),
    fetch(
      `${DIRECTUS_URL}/items/products?limit=-1&filter[status][_eq]=published&fields=id,odoo_id,sku,name,slug,price,wholesale_price,sold_quantity,status,images.directus_files_id,product_groups.*,group.*,groups.*,categories.*,category.*`
    )
  ]);

  if (resGroups.ok) {
    const jsonGroups = await resGroups.json();
    if (Array.isArray(jsonGroups.data)) {
      productGroups = jsonGroups.data.map((g: any) => ({
        id: g.id,
        slug: g.slug || `group-${g.id}`,
        name: g.name || g.title || `Nhóm ${g.id}`,
        productCount: 0,
      }));
    }
  }

  if (resProducts.ok) {
    const jsonProducts = await resProducts.json();
    const rawProducts = jsonProducts.data || [];

    const uniqueMap = new Map();
    rawProducts.forEach((item: any) => {
      // Ensure only status = 'published' products are displayed
      const isPublished = !item.status || item.status === 'published';
      if (item && item.id && isPublished && !uniqueMap.has(item.id)) {
        uniqueMap.set(item.id, item);
      }
    });
    products = Array.from(uniqueMap.values());
    // Đồng bộ giá chuẩn và tồn kho từ PostgreSQL
    products = await enrichWithPostgresData(products);
    products = products.filter((p: any) => p.is_active !== false);
  } else {
    fetchError = true;
  }
} catch (error) {
  console.error('❌ Lỗi kết nối Directus trên trang /san-pham:', error);
  fetchError = true;
}

// Fallback if groups query failed
if (productGroups.length === 0) {
  const libGroups = await getProductGroups({ includeEmpty: true });
  if (libGroups.length > 0) {
    productGroups = libGroups.map((g) => ({
      id: g.id,
      slug: g.slug,
      name: g.name,
      productCount: g.productCount,
    }));
  }
}

// 3. Helper Functions for Group Membership
function isProductInGroup(product: any, group: { id: string | number; slug: string }): boolean {
  if (!product) return false;

  const possibleFields = [
    product.product_groups,
    product.group,
    product.groups,
    product.categories,
    product.category
  ];

  for (const field of possibleFields) {
    if (!field) continue;

    if (Array.isArray(field)) {
      for (const item of field) {
        if (!item) continue;
        if (item === group.id || item === group.slug) return true;
        
        if (typeof item === 'object') {
          const target = item.product_groups_id || item.group_id || item.id || item;
          if (target === group.id || target.slug === group.slug || target.id === group.id) {
            return true;
          }
        }
      }
    }

    if (typeof field === 'object' && field !== null) {
      const target = field.product_groups_id || field.group_id || field;
      if (
        target === group.id ||
        target.id === group.id ||
        target.slug === group.slug
      ) {
        return true;
      }
    }

    if (field === group.id || field === group.slug) {
      return true;
    }
  }

  return false;
}

// Calculate productCount per group
productGroups.forEach((g) => {
  g.productCount = products.filter((p) => isProductInGroup(p, g)).length;
});

// 4. URL Filter & Search Parameters
const searchParam = (Astro.url.searchParams.get('q') || '').trim();
const categoryParam = Astro.url.searchParams.get('category') || 'all';
const priceParam = Astro.url.searchParams.get('price') || 'all';
const brandParam = Astro.url.searchParams.get('brand') || 'all';
const sortParam = Astro.url.searchParams.get('sort') || 'default';
const pageParam = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10) || 1);

// 5. Apply Multi-faceted Filtering
let filteredProducts = [...products];

// Search Keyword Filter (safe lowercase comparison)
if (searchParam) {
  const queryLower = searchParam.toLowerCase();
  filteredProducts = filteredProducts.filter((p) => {
    const nameMatch = (p.name || '').toLowerCase().includes(queryLower);
    const skuMatch = (p.sku || '').toLowerCase().includes(queryLower);
    const slugMatch = (p.slug || '').toLowerCase().includes(queryLower);
    return nameMatch || skuMatch || slugMatch;
  });
}

// Category / Group Filter
if (categoryParam && categoryParam !== 'all') {
  const targetGroup = productGroups.find((g) => g.slug === categoryParam);
  if (targetGroup) {
    filteredProducts = filteredProducts.filter((p) => isProductInGroup(p, targetGroup));
  } else {
    // If slug not in groups, check direct field match
    filteredProducts = filteredProducts.filter((p) => isProductInGroup(p, { id: categoryParam, slug: categoryParam }));
  }
}

// Price Range Filter
if (priceParam && priceParam !== 'all') {
  filteredProducts = filteredProducts.filter((p) => {
    const price = Number(p.price) || 0;
    if (priceParam === '0-50000') return price < 50000;
    if (priceParam === '50000-100000') return price >= 50000 && price <= 100000;
    if (priceParam === '100000-200000') return price >= 100000 && price <= 200000;
    if (priceParam === '200000-up') return price > 200000;
    return true;
  });
}

// Brand Filter
if (brandParam && brandParam !== 'all') {
  const brandLower = brandParam.toLowerCase();
  filteredProducts = filteredProducts.filter((p) => {
    const b = (p.brand || 'LA PET').toLowerCase();
    return b.includes(brandLower);
  });
}

// 6. Apply Sorting
if (sortParam === 'sold-desc') {
  filteredProducts.sort((a, b) => (Number(b.sold_quantity) || 0) - (Number(a.sold_quantity) || 0));
} else if (sortParam === 'price-asc') {
  filteredProducts.sort((a, b) => (Number(a.price) || 0) - (Number(b.price) || 0));
} else if (sortParam === 'price-desc') {
  filteredProducts.sort((a, b) => (Number(b.price) || 0) - (Number(a.price) || 0));
} else if (sortParam === 'newest') {
  filteredProducts.sort((a, b) => Number(b.id) - Number(a.id));
}

// 7. Pagination
const PAGE_SIZE = 12;
const totalFiltered = filteredProducts.length;
const totalPages = Math.max(1, Math.ceil(totalFiltered / PAGE_SIZE));
const safeCurrentPage = Math.min(pageParam, totalPages);
const startIndex = (safeCurrentPage - 1) * PAGE_SIZE;
const paginatedProducts = filteredProducts.slice(startIndex, startIndex + PAGE_SIZE);

// Helper for building pagination URLs
function getPageUrl(pageNumber: number) {
  const url = new URL(Astro.url);
  url.searchParams.set('page', String(pageNumber));
  return url.pathname + url.search;
}

const currentCategoryName = categoryParam !== 'all'
  ? productGroups.find((g) => g.slug === categoryParam)?.name || categoryParam
  : null;

const breadcrumbItems = currentCategoryName
  ? [
      { label: 'Sản phẩm', href: '/san-pham' },
      { label: currentCategoryName, current: true }
    ]
  : [{ label: 'Sản phẩm', current: true }];
---

<BaseLayout
  title={currentCategoryName ? `${currentCategoryName} - Sản phẩm LA PET` : 'Tất cả sản phẩm - LA PET Store'}
  description="Danh mục sản phẩm thú cưng cao cấp LA PET. Thức ăn dinh dưỡng, bánh thưởng, tã lót và phụ kiện chăm sóc chất lượng cao với chiết khấu sỉ đại lý tới 22%."
>
  <div x-data="{ isFilterDrawerOpen: false }">
    <!-- HERO HEADER & BREADCRUMB -->
    <section class="bg-brand-sand/50 border-b border-brand-border/60 py-5 sm:py-7">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <Breadcrumb items={breadcrumbItems} class="mb-3" />
        
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
          <div>
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-brand-dark tracking-tight">
              {currentCategoryName ? currentCategoryName : 'Tất cả sản phẩm'}
            </h1>
            <p class="text-xs sm:text-sm text-brand-muted mt-1.5 max-w-2xl leading-relaxed">
              Khám phá các dòng sản phẩm chất lượng cao của LA PET dành cho thú cưng với tiêu chuẩn dinh dưỡng quốc tế và chính sách giá sỉ B2B đại lý hấp dẫn.
            </p>
          </div>

          {searchParam && (
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-white border border-brand-border text-xs text-brand-dark shadow-soft">
              <span>Tìm kiếm:</span>
              <span class="font-bold text-brand-primary truncate max-w-[150px]">{searchParam}</span>
              <a href="/san-pham" class="text-brand-muted hover:text-brand-dark ml-1 font-bold" title="Xóa tìm kiếm">✕</a>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- MAIN CATALOG CONTAINER -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
      
      <!-- TOOLBAR: COUNT, QUICK CATEGORY, SORT & MOBILE FILTER BUTTON -->
      <div class="bg-white rounded-2xl border border-brand-border/80 p-3 sm:p-4 mb-6 sm:mb-8 shadow-soft flex flex-wrap items-center justify-between gap-3">
        <!-- Count and Active State -->
        <div class="flex items-center gap-2">
          <!-- Mobile Filter Drawer Toggle Button -->
          <button
            type="button"
            class="lg:hidden inline-flex items-center gap-1.5 px-3 py-2 text-xs font-bold text-brand-dark bg-brand-surface hover:bg-brand-sand border border-brand-border rounded-xl transition-colors cursor-pointer shadow-2xs"
            @click="isFilterDrawerOpen = true"
            aria-label="Mở bộ lọc sản phẩm"
          >
            <svg class="w-4 h-4 text-brand-primary stroke-current fill-none stroke-2" viewBox="0 0 24 24">
              <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
            </svg>
            <span>Bộ lọc</span>
            {(categoryParam !== 'all' || priceParam !== 'all' || brandParam !== 'all') && (
              <span class="w-2 h-2 rounded-full bg-brand-primary"></span>
            )}
          </button>

          <span class="text-xs sm:text-sm font-semibold text-brand-muted">
            Hiển thị <span id="visible-count" class="font-bold text-brand-dark">{totalFiltered}</span> sản phẩm
          </span>
        </div>

        <!-- Right Controls: Category Dropdown & Sorting Dropdown -->
        <div class="flex flex-wrap items-center gap-2 sm:gap-3 ml-auto">
          <!-- Category Quick Dropdown -->
          <div class="flex items-center gap-1.5 text-xs">
            <label for="category-quick-select" class="font-semibold text-brand-muted hidden sm:inline-block">Danh mục:</label>
            <select
              id="category-quick-select"
              class="bg-brand-surface border border-brand-border rounded-xl px-2.5 py-1.5 text-xs font-bold text-brand-dark focus:outline-none focus:ring-2 focus:ring-brand-primary/40 cursor-pointer shadow-2xs"
              onchange="window.location.href = this.value;"
            >
              <option value="/san-pham" selected={categoryParam === 'all'}>Tất cả ({products.length})</option>
              {productGroups.map((group) => (
                <option
                  value={`/san-pham?category=${group.slug}`}
                  selected={categoryParam === group.slug}
                >
                  {group.name} {group.productCount ? `(${group.productCount})` : ''}
                </option>
              ))}
            </select>
          </div>

          <!-- Sort Select -->
          <div class="flex items-center gap-1.5 text-xs">
            <label for="sort-select" class="font-semibold text-brand-muted hidden sm:inline-block">Sắp xếp:</label>
            <select
              id="sort-select"
              class="bg-brand-surface border border-brand-border rounded-xl px-2.5 py-1.5 text-xs font-bold text-brand-dark focus:outline-none focus:ring-2 focus:ring-brand-primary/40 cursor-pointer shadow-2xs"
              onchange="
                const url = new URL(window.location.href);
                url.searchParams.set('sort', this.value);
                url.searchParams.delete('page');
                window.location.href = url.pathname + url.search;
              "
            >
              <option value="default" selected={sortParam === 'default'}>Mặc định</option>
              <option value="sold-desc" selected={sortParam === 'sold-desc'}>Bán chạy nhất</option>
              <option value="price-asc" selected={sortParam === 'price-asc'}>Giá: Thấp đến Cao</option>
              <option value="price-desc" selected={sortParam === 'price-desc'}>Giá: Cao đến Thấp</option>
              <option value="newest" selected={sortParam === 'newest'}>Mới nhất</option>
            </select>
          </div>
        </div>
      </div>

      <!-- MAIN LAYOUT: SIDEBAR + PRODUCT GRID -->
      <div class="flex flex-col lg:flex-row gap-6 lg:gap-8 items-start">
        
        <!-- SIDEBAR / DRAWER COMPONENT -->
        <ProductFilter
          groups={productGroups}
          currentCategory={categoryParam}
          currentPrice={priceParam}
          currentBrand={brandParam}
          currentSearch={searchParam}
          totalCount={products.length}
        />

        <!-- PRODUCT GRID & PAGINATION -->
        <div class="flex-1 w-full min-w-0">
          {fetchError && (
            <div class="bg-amber-50 border border-amber-200 text-amber-800 p-4 rounded-2xl mb-6 text-xs sm:text-sm font-medium flex items-center justify-between">
              <span>Hệ thống đang kết nối kho dữ liệu phụ. Danh mục vẫn hiển thị ổn định.</span>
              <a href="/san-pham" class="underline font-bold text-amber-900 ml-2">Tải lại</a>
            </div>
          )}

          <!-- The Responsive Product Grid -->
          <ProductGrid
            products={paginatedProducts}
            isDealer={isDealer}
            isLoggedIn={isAuthenticated}
            columns={4}
            emptyTitle="Không tìm thấy sản phẩm phù hợp"
            emptyMessage={
              searchParam
                ? `Không có sản phẩm nào khớp với từ khóa "${searchParam}". Vui lòng thử tìm từ khóa khác.`
                : 'Hiện không có sản phẩm nào trong tiêu chí lọc đã chọn.'
            }
          />

          <!-- PAGINATION CONTROLS -->
          {totalPages > 1 && (
            <nav aria-label="Pagination" class="flex items-center justify-center gap-1.5 sm:gap-2 mt-10 pt-6 border-t border-brand-border/60">
              <!-- Previous Button -->
              <a
                href={safeCurrentPage > 1 ? getPageUrl(safeCurrentPage - 1) : '#'}
                class={`inline-flex items-center justify-center h-10 px-3.5 rounded-xl border text-xs sm:text-sm font-bold transition-all ${
                  safeCurrentPage > 1
                    ? 'border-brand-border bg-white text-brand-dark hover:bg-brand-surface shadow-soft'
                    : 'border-brand-border/40 bg-brand-surface/40 text-brand-muted/50 pointer-events-none'
                }`}
                aria-disabled={safeCurrentPage <= 1}
              >
                ← Trước
              </a>

              <!-- Page Number Buttons -->
              {Array.from({ length: totalPages }, (_, i) => i + 1).map((pageNum) => {
                const isCurrent = pageNum === safeCurrentPage;
                return (
                  <a
                    href={getPageUrl(pageNum)}
                    class={`inline-flex items-center justify-center w-10 h-10 rounded-xl text-xs sm:text-sm font-bold transition-all ${
                      isCurrent
                        ? 'bg-brand-primary text-white shadow-soft'
                        : 'bg-white border border-brand-border text-brand-dark hover:bg-brand-surface'
                    }`}
                    aria-current={isCurrent ? 'page' : undefined}
                  >
                    {pageNum}
                  </a>
                );
              })}

              <!-- Next Button -->
              <a
                href={safeCurrentPage < totalPages ? getPageUrl(safeCurrentPage + 1) : '#'}
                class={`inline-flex items-center justify-center h-10 px-3.5 rounded-xl border text-xs sm:text-sm font-bold transition-all ${
                  safeCurrentPage < totalPages
                    ? 'border-brand-border bg-white text-brand-dark hover:bg-brand-surface shadow-soft'
                    : 'border-brand-border/40 bg-brand-surface/40 text-brand-muted/50 pointer-events-none'
                }`}
                aria-disabled={safeCurrentPage >= totalPages}
              >
                Sau →
              </a>
            </nav>
          )}
        </div>
      </div>
    </main>
  </div>
</BaseLayout>
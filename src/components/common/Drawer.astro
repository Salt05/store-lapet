---
// src/components/common/Drawer.astro
export interface Props {
  id: string;
  model?: string;
  title?: string;
  side?: 'right' | 'left' | 'bottom';
  width?: string;
  closeOnBackdrop?: boolean;
  closeOnEscape?: boolean;
  showCloseButton?: boolean;
  class?: string;
  footerShow?: string;
  [key: string]: any;
}

const {
  id,
  model = 'isDrawerOpen',
  title,
  side = 'right',
  width = 'max-w-md',
  closeOnBackdrop = true,
  closeOnEscape = true,
  showCloseButton = true,
  class: className = '',
  footerShow,
  ...rest
} = Astro.props;

const hasHeader = title || Astro.slots.has('header');
const hasFooter = Astro.slots.has('footer');

// Transition classes by side
let enterStart = 'translate-x-full';
let enterEnd = 'translate-x-0';
let leaveStart = 'translate-x-0';
let leaveEnd = 'translate-x-full';
let positionContainer = 'fixed inset-y-0 right-0 pl-10 flex';
let borderClass = 'border-l';

if (side === 'left') {
  enterStart = '-translate-x-full';
  enterEnd = 'translate-x-0';
  leaveStart = 'translate-x-0';
  leaveEnd = '-translate-x-full';
  positionContainer = 'fixed inset-y-0 left-0 pr-10 flex';
  borderClass = 'border-r';
} else if (side === 'bottom') {
  enterStart = 'translate-y-full';
  enterEnd = 'translate-y-0';
  leaveStart = 'translate-y-0';
  leaveEnd = 'translate-y-full';
  positionContainer = 'fixed inset-x-0 bottom-0 flex';
  borderClass = 'border-t';
}

const heightClass = side === 'bottom' ? 'max-h-[90vh]' : 'h-full';
---

<template x-teleport="body">
  <div
    x-cloak
    x-show={model}
    id={id}
    class="fixed inset-0 z-50 overflow-hidden"
    role="dialog"
    aria-modal="true"
    aria-labelledby={title ? `${id}-title` : undefined}
    x-on:keydown.escape.window={closeOnEscape ? `${model} = false` : undefined}
    {...rest}
  >
    <!-- Backdrop -->
    <div
      x-show={model}
      x-transition:enter="ease-out duration-300"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="ease-in duration-200"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      x-on:click={closeOnBackdrop ? `${model} = false` : undefined}
      class="fixed inset-0 bg-brand-dark/60 backdrop-blur-sm transition-opacity"
      aria-hidden="true"
    ></div>

    <!-- Drawer Container -->
    <div class={positionContainer}>
      <div
        x-show={model}
        x-transition:enter="transform transition ease-in-out duration-300"
        x-transition:enter-start={enterStart}
        x-transition:enter-end={enterEnd}
        x-transition:leave="transform transition ease-in-out duration-300"
        x-transition:leave-start={leaveStart}
        x-transition:leave-end={leaveEnd}
        class={`${heightClass} w-screen ${width} bg-white shadow-drawer ${borderClass} border-brand-border flex flex-col ${className}`}
      >
        <!-- Header -->
        {hasHeader && (
          <div class="flex items-center justify-between px-5 py-4 border-b border-brand-border/70 bg-brand-surface/70 shrink-0">
            {Astro.slots.has('header') ? (
              <slot name="header" />
            ) : (
              <h3 id={`${id}-title`} class="text-base sm:text-lg font-bold text-brand-dark leading-snug">
                {title}
              </h3>
            )}

            {showCloseButton && (
              <button
                type="button"
                x-on:click={`${model} = false`}
                class="rounded-lg p-1.5 text-brand-muted hover:text-brand-dark hover:bg-black/5 transition-colors cursor-pointer focus:outline-none focus:ring-2 focus:ring-brand-primary/30"
                aria-label="Đóng bảng"
              >
                <svg class="h-5 w-5 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            )}
          </div>
        )}

        <!-- Body / Scrollable Content -->
        <div class="flex-1 overflow-y-auto p-5 text-sm text-brand-text">
          <slot />
        </div>

        <!-- Footer -->
        {hasFooter && (
          <div 
            x-show={footerShow}
            class="border-t border-brand-border/70 p-4 bg-brand-surface/40 shrink-0"
          >
            <slot name="footer" />
          </div>
        )}
      </div>
    </div>
  </div>
</template>

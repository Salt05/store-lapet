---
// src/components/common/Button.astro
export interface Props {
  variant?: 'primary' | 'secondary' | 'accent' | 'outline' | 'ghost' | 'gold' | 'danger';
  size?: 'sm' | 'md' | 'lg' | 'icon';
  type?: 'button' | 'submit' | 'reset';
  href?: string;
  target?: string;
  rel?: string;
  disabled?: boolean;
  loading?: boolean;
  fullWidth?: boolean;
  class?: string;
  id?: string;
  title?: string;
  [key: string]: any;
}

const {
  variant = 'primary',
  size = 'md',
  type = 'button',
  href,
  target,
  rel,
  disabled = false,
  loading = false,
  fullWidth = false,
  class: className = '',
  id,
  title,
  ...rest
} = Astro.props;

// Base Styles
const baseStyles = 'inline-flex items-center justify-center font-sans tracking-wide transition-all duration-200 cursor-pointer select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary/50 focus-visible:ring-offset-1 disabled:opacity-50 disabled:cursor-not-allowed disabled:pointer-events-none active:scale-[0.98]';

// Variant Styles
const variantStyles: Record<string, string> = {
  primary: 'bg-brand-primary hover:bg-brand-dark text-white font-bold shadow-soft hover:shadow-card',
  accent: 'bg-brand-accent hover:bg-brand-accent-hover text-brand-dark font-extrabold shadow-soft hover:shadow-card',
  secondary: 'bg-brand-sand hover:bg-brand-sand-hover text-brand-dark font-semibold border border-brand-border',
  outline: 'bg-transparent hover:bg-brand-primary/10 text-brand-primary border border-brand-primary font-bold',
  ghost: 'bg-transparent hover:bg-black/5 text-brand-dark font-medium',
  gold: 'bg-brand-gold hover:bg-amber-600 text-white font-bold shadow-soft hover:shadow-card',
  danger: 'bg-rose-600 hover:bg-rose-700 text-white font-bold shadow-soft hover:shadow-card',
};

// Size Styles
const sizeStyles: Record<string, string> = {
  sm: 'h-8 px-3 text-xs rounded-md gap-1.5',
  md: 'h-10 px-4 text-sm rounded-md gap-2',
  lg: 'h-12 px-6 text-base rounded-lg gap-2.5',
  icon: 'w-10 h-10 p-2 rounded-md justify-center',
};

const widthStyle = fullWidth ? 'w-full' : '';
const combinedClasses = [
  baseStyles,
  variantStyles[variant] || variantStyles.primary,
  sizeStyles[size] || sizeStyles.md,
  widthStyle,
  className
].filter(Boolean).join(' ');
---

{href ? (
  <a
    href={disabled ? undefined : href}
    target={target}
    rel={target === '_blank' && !rel ? 'noopener noreferrer' : rel}
    class={combinedClasses}
    id={id}
    title={title}
    aria-disabled={disabled ? 'true' : undefined}
    tabindex={disabled ? -1 : undefined}
    {...rest}
  >
    {loading && (
      <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-current" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
    )}
    <slot />
  </a>
) : (
  <button
    type={type}
    disabled={disabled || loading}
    class={combinedClasses}
    id={id}
    title={title}
    aria-busy={loading ? 'true' : undefined}
    {...rest}
  >
    {loading && (
      <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-current" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
    )}
    <slot />
  </button>
)}

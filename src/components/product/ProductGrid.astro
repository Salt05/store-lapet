---
// src/components/product/ProductGrid.astro
import ProductCard from './ProductCard.astro';

export interface Props {
  products: any[];
  isDealer?: boolean;
  isLoggedIn?: boolean;
  columns?: 2 | 3 | 4;
  class?: string;
  emptyTitle?: string;
  emptyMessage?: string;
}

const {
  products = [],
  isDealer = false,
  isLoggedIn,
  columns = 4,
  class: className = '',
  emptyTitle = 'Không tìm thấy sản phẩm nào',
  emptyMessage = 'Vui lòng thử tìm kiếm với từ khóa khác hoặc chọn lại nhóm danh mục.',
} = Astro.props;

const colClasses = {
  2: 'grid-cols-1 sm:grid-cols-2',
  3: 'grid-cols-2 sm:grid-cols-2 md:grid-cols-3',
  4: 'grid-cols-2 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4',
};

const selectedColClass = colClasses[columns] || colClasses[4];
---

{products.length === 0 ? (
  <div class="w-full bg-white rounded-2xl border border-brand-border/80 p-8 sm:p-12 text-center my-6 shadow-soft">
    <div class="w-16 h-16 sm:w-20 sm:h-20 mx-auto mb-4 rounded-full bg-brand-surface flex items-center justify-center text-brand-muted border border-brand-border/60">
      <svg class="w-8 h-8 sm:w-10 sm:h-10 stroke-current fill-none stroke-1.5" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        <line x1="8" y1="11" x2="14" y2="11"></line>
      </svg>
    </div>
    <h3 class="text-base sm:text-lg font-bold text-brand-dark mb-1">
      {emptyTitle}
    </h3>
    <p class="text-xs sm:text-sm text-brand-muted max-w-md mx-auto mb-5 leading-relaxed">
      {emptyMessage}
    </p>
    <a
      href="/san-pham"
      class="inline-flex items-center justify-center h-10 px-5 text-xs sm:text-sm font-bold text-white bg-brand-primary hover:bg-brand-dark rounded-xl shadow-soft hover:shadow-card transition-all duration-200"
    >
      Xem tất cả sản phẩm
    </a>
  </div>
) : (
  <div
    class={`product-grid grid ${selectedColClass} gap-3 sm:gap-4 md:gap-5 ${className}`}
    id="product-grid"
    data-count={products.length}
  >
    {products.map((product) => (
      <ProductCard
        product={product}
        isDealer={isDealer}
        isLoggedIn={isLoggedIn}
      />
    ))}
  </div>
)}

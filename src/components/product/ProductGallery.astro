---
// src/components/product/ProductGallery.astro
import { PLACEHOLDER_IMAGE } from '../../lib/catalog';

export interface GalleryItem {
  full: string;
  thumb: string;
  alt?: string;
}

export interface Props {
  images?: GalleryItem[];
  productName?: string;
  class?: string;
}

const {
  images: propImages = [],
  productName = 'Sản phẩm LA PET',
  class: className = '',
} = Astro.props;

// Ensure at least one image is available
const normalizedImages: GalleryItem[] = propImages && propImages.length > 0
  ? propImages
  : [{ full: PLACEHOLDER_IMAGE, thumb: PLACEHOLDER_IMAGE, alt: productName }];

const primaryImage = normalizedImages[0];
---

<div
  class={`product-gallery flex flex-col gap-4 ${className}`}
  x-data={`{
    activeIndex: 0,
    isZoomOpen: false,
    images: ${JSON.stringify(normalizedImages)},
    setActive(idx) {
      if (idx >= 0 && idx < this.images.length) {
        this.activeIndex = idx;
      }
    }
  }`}
>
  <!-- Main Active Image -->
  <div class="relative aspect-square w-full rounded-2xl bg-white border border-brand-border/80 p-4 sm:p-8 flex items-center justify-center overflow-hidden shadow-soft group">
    <!-- Active Main Image -->
    <img
      src={primaryImage.full}
      :src="images[activeIndex].full"
      alt={productName}
      :alt="images[activeIndex].alt || ''"
      class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-105 cursor-zoom-in"
      onerror="this.onerror=null; this.src='/images/placeholder-product.svg';"
      @click="isZoomOpen = true"
      loading="eager"
    />

    <!-- Zoom Preview Icon Badge -->
    <button
      type="button"
      class="absolute bottom-3 right-3 p-2 rounded-xl bg-white/90 hover:bg-white text-brand-dark hover:text-brand-primary shadow-soft border border-brand-border/60 transition-all opacity-80 group-hover:opacity-100 cursor-pointer"
      title="Phóng to ảnh"
      aria-label="Phóng to ảnh sản phẩm"
      @click="isZoomOpen = true"
    >
      <svg class="w-4.5 h-4.5 stroke-current fill-none stroke-2" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        <line x1="11" y1="8" x2="11" y2="14"></line>
        <line x1="8" y1="11" x2="14" y2="11"></line>
      </svg>
    </button>
  </div>

  <!-- Thumbnails Row -->
  {normalizedImages.length > 1 && (
    <div class="flex items-center gap-2.5 overflow-x-auto pb-1.5 scrollbar-thin">
      {normalizedImages.map((img, idx) => (
        <button
          type="button"
          class={`relative w-16 h-16 sm:w-20 sm:h-20 rounded-xl bg-white border p-1.5 overflow-hidden transition-all shrink-0 cursor-pointer ${
            idx === 0 ? 'border-brand-primary ring-2 ring-brand-primary/20' : 'border-brand-border hover:border-brand-primary/60'
          }`}
          :class={`activeIndex === ${idx} ? 'border-brand-primary ring-2 ring-brand-primary/20' : 'border-brand-border hover:border-brand-primary/60'`}
          @click={`setActive(${idx})`}
          title={`Ảnh ${idx + 1}`}
        >
          <img
            src={img.thumb}
            alt={`${productName} thumbnail ${idx + 1}`}
            class="w-full h-full object-contain"
            onerror="this.onerror=null; this.src='/images/placeholder-product.svg';"
            loading="lazy"
          />
        </button>
      ))}
    </div>
  )}

  <!-- Full-screen Zoom Modal -->
  <div
    x-cloak
    x-show="isZoomOpen"
    x-transition:enter="ease-out duration-300"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="ease-in duration-200"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-brand-dark/80 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    @keydown.escape.window="isZoomOpen = false"
  >
    <!-- Modal Container -->
    <div
      class="relative max-w-4xl w-full max-h-[90vh] bg-white rounded-2xl p-4 sm:p-8 flex flex-col items-center justify-center shadow-modal border border-brand-border"
      @click.outside="isZoomOpen = false"
    >
      <!-- Close Button -->
      <button
        type="button"
        class="absolute top-4 right-4 p-2 rounded-xl bg-brand-surface text-brand-dark hover:bg-brand-sand transition-colors cursor-pointer"
        aria-label="Đóng phóng to"
        @click="isZoomOpen = false"
      >
        <svg class="w-5 h-5 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <!-- Zoomed Image -->
      <div class="w-full max-h-[75vh] flex items-center justify-center p-2">
        <img
          :src="images[activeIndex].full"
          src={primaryImage.full}
          alt={productName}
          class="max-w-full max-h-[70vh] object-contain"
          onerror="this.onerror=null; this.src='/images/placeholder-product.svg';"
        />
      </div>

      <!-- Navigation Arrows if multiple -->
      <template x-if="images.length > 1">
        <div class="flex items-center justify-between w-full mt-4 pt-4 border-t border-brand-border/60">
          <button
            type="button"
            class="px-4 py-2 text-xs font-bold text-brand-dark bg-brand-surface hover:bg-brand-sand rounded-xl border border-brand-border transition-colors cursor-pointer"
            @click="activeIndex = (activeIndex - 1 + images.length) % images.length"
          >
            ← Ảnh trước
          </button>
          <span class="text-xs font-semibold text-brand-muted" x-text="`${activeIndex + 1} / ${images.length}`"></span>
          <button
            type="button"
            class="px-4 py-2 text-xs font-bold text-brand-dark bg-brand-surface hover:bg-brand-sand rounded-xl border border-brand-border transition-colors cursor-pointer"
            @click="activeIndex = (activeIndex + 1) % images.length"
          >
            Ảnh sau →
          </button>
        </div>
      </template>
    </div>
  </div>
</div>

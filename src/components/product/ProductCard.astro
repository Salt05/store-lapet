---
// src/components/product/ProductCard.astro
import { assetUrl, formatVnd, PLACEHOLDER_IMAGE } from '../../lib/catalog';
import Badge from '../common/Badge.astro';

export interface Props {
  product: any;
  isDealer?: boolean;
  isLoggedIn?: boolean;
  class?: string;
  categoryName?: string;
}

const {
  product,
  isDealer = false,
  isLoggedIn: propIsLoggedIn,
  class: className = '',
  categoryName: propCategoryName,
} = Astro.props;

const auth = Astro.locals.auth;
const isLoggedIn = propIsLoggedIn !== undefined ? propIsLoggedIn : Boolean(auth?.isAuthenticated);

if (!product) {
  return;
}

// 1. Odoo ID (Integer strict preservation)
function parseOdooId(val: any): number | null {
  if (val === null || val === undefined || val === '') return null;
  const parsed = parseInt(String(val), 10);
  return Number.isNaN(parsed) ? null : parsed;
}

const odooId = parseOdooId(product.odoo_id);
const productId = String(product.id ?? '');
const sku = String(product.sku || '');
const name = String(product.name || 'Sản phẩm LA PET');
const slug = String(product.slug || product.id || '');
const brand = String(product.brand || 'LA PET');

// 2. Image resolution with fallback
function resolveProductImage(p: any): string {
  if (!p) return PLACEHOLDER_IMAGE;

  // Direct image property
  if (p.image && typeof p.image === 'string') {
    if (p.image.startsWith('http://') || p.image.startsWith('https://') || p.image.startsWith('/')) {
      return p.image;
    }
    return assetUrl(p.image, { width: 400, height: 400, fit: 'contain', quality: 80, format: 'webp' });
  }

  // imageIds array (from catalog normalizeProduct)
  if (Array.isArray(p.imageIds) && p.imageIds.length > 0 && p.imageIds[0]) {
    return assetUrl(p.imageIds[0], { width: 400, height: 400, fit: 'contain', quality: 80, format: 'webp' });
  }

  // images array (from Directus raw)
  if (Array.isArray(p.images) && p.images.length > 0) {
    const first = p.images[0];
    const fileId = typeof first === 'string' ? first : (first?.directus_files_id?.id || first?.directus_files_id || first?.id);
    if (fileId) {
      return assetUrl(fileId, { width: 400, height: 400, fit: 'contain', quality: 80, format: 'webp' });
    }
  }

  return PLACEHOLDER_IMAGE;
}

const productImage = resolveProductImage(product);

// 3. Category / Group Name
function resolveCategoryName(p: any): string {
  if (propCategoryName) return propCategoryName;
  if (p.category_name) return p.category_name;
  if (p.category && typeof p.category === 'object' && p.category.name) return p.category.name;
  if (Array.isArray(p.product_groups) && p.product_groups[0]?.name) return p.product_groups[0].name;
  if (p.group && typeof p.group === 'object' && p.group.name) return p.group.name;
  return 'Thức ăn dinh dưỡng';
}

const categoryName = resolveCategoryName(product);

// 4. Pricing
const retailPrice = Number(product.price) || 0;
const wholesalePrice = Number(product.wholesale_price) > 0 && Number(product.wholesale_price) < retailPrice
  ? Number(product.wholesale_price)
  : Math.round(retailPrice * 0.78);

const activePrice = wholesalePrice;

// 5. Serialized payload for global cart
const cartItemPayload = {
  id: product.id || odooId,
  odoo_id: odooId,
  product_id: productId,
  sku,
  name,
  price: wholesalePrice,
  retail_price: retailPrice,
  wholesale_price: wholesalePrice,
  quantity: 1,
  image: productImage,
  slug,
};

const payloadJson = JSON.stringify(cartItemPayload);
---

<div
  class={`product-card group relative flex flex-col justify-between bg-white rounded-2xl border border-slate-200/80 p-3.5 sm:p-4 hover:shadow-card hover:-translate-y-1 transition-all duration-200 ${className}`}
  data-product-id={productId}
  data-odoo-id={odooId ?? ''}
  data-slug={slug}
>
  <div>
    <!-- Product Image: Portrait aspect ratio (3/4) matching vertical pouch packaging -->
    <div class="relative aspect-[3/4] w-full rounded-xl overflow-hidden bg-[#F8FAFC] border border-slate-100 p-3 mb-3 flex items-center justify-center group-hover:bg-[#F1F5F9] transition-colors">
      <a href={`/san-pham/${slug}`} class="w-full h-full flex items-center justify-center" title={name}>
        <img
          src={productImage}
          alt={name}
          loading="lazy"
          class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300 drop-shadow-sm"
          onerror="this.onerror=null; this.src='/images/placeholder-product.svg';"
        />
      </a>
    </div>

    <!-- Product Title -->
    <a href={`/san-pham/${slug}`} class="block mb-2 group-hover:text-[#EA580C] transition-colors">
      <h3 class="font-bold text-xs sm:text-sm text-[#07394D] line-clamp-2 leading-snug min-h-[2.5rem]">
        {name}
      </h3>
    </a>
  </div>

  <!-- Bottom Pricing & Action Section -->
  <div class="mt-2 pt-2.5 border-t border-slate-100">
    <div class="flex flex-col gap-2.5">
      <!-- Wholesale Price Highlight -->
      <div class="flex items-baseline justify-between">
        <span class="text-sm sm:text-base font-black text-[#07394D] font-mono tabular-nums">
          Giá sỉ: {formatVnd(wholesalePrice)}
        </span>
        {retailPrice > wholesalePrice && (
          <span class="text-xs text-slate-400 line-through font-mono tabular-nums">
            {formatVnd(retailPrice)}
          </span>
        )}
      </div>

      <!-- Add to Cart Button -->
      <button
        type="button"
        class="add-to-cart-btn w-full py-2 px-3 rounded-xl bg-white hover:bg-[#07394D] text-[#07394D] hover:text-white border border-[#07394D] text-xs font-bold transition-all duration-200 cursor-pointer flex items-center justify-center gap-1.5 active:scale-98 shadow-xs"
        onclick={`window.addToLapetCart && window.addToLapetCart(this, ${JSON.stringify(payloadJson)})`}
        data-item={payloadJson}
      >
        <span>+ Thêm vào đơn</span>
      </button>
    </div>
  </div>
</div>

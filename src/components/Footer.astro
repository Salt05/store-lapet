---
// src/components/Footer.astro
import { Image } from 'astro:assets';
import logoBrand from '../assets/images/brand/logo.webp';
import { configService } from '@/services/config.service';

const allConfigs = await configService.getAllConfigs();
const companyInfo = allConfigs.get('company_info') || {};
const hotline = companyInfo.hotline || '0909 203 166';
const contactEmail = companyInfo.email || 'contact@lapet.vn';
const companyAddress = companyInfo.address || 'Tổng kho LA PET, TP. Hồ Chí Minh';

// Danh mục sản phẩm chính
const productCategories = [
  { name: 'Bánh thưởng thú cưng', href: '/san-pham?category=banh-thuong' },
  { name: 'Tã lót cho thú cưng', href: '/san-pham?category=ta-cho-thu-cung' },
  { name: 'Cát vệ sinh cao cấp', href: '/san-pham?category=cat-ve-sinh' },
  { name: 'Tất cả sản phẩm', href: '/san-pham' },
];

// Liên kết Về chúng tôi
const aboutLinks = [
  { name: 'Giới thiệu LA PET', href: '/ve-lapet' },
  { name: 'Sứ mệnh dinh dưỡng', href: '/ve-lapet#tam-nhin-su-menh' },
  { name: 'Đối tác & Đại lý', href: '/ve-lapet#khach-hang-doi-tac' },
  { name: 'Chính sách đại lý B2B', href: '/lien-he#partner-registration' },
  { name: 'Liên hệ hợp tác', href: '/lien-he' },
];
---

<footer class="w-full bg-brand-dark text-white pt-10 sm:pt-14 pb-8 relative overflow-hidden font-sans border-t border-brand-primary/20">
  
  <!-- ================= 4-COLUMN FOOTER LINKS ================= -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-10 pb-10 border-b border-white/10 relative z-10 items-start">
    
    <!-- CỘT 1: THÔNG TIN THƯƠNG HIỆU (4 Cột lg) -->
    <div class="space-y-4 lg:col-span-4">
      <div class="h-10 sm:h-12 flex items-center justify-start">
        <a href="/" class="block" aria-label="Trang chủ La Pet">
          <Image 
            src={logoBrand} 
            alt="LA PET Logo" 
            width={160} 
            height={50} 
            format="webp"
            class="h-9 sm:h-11 w-auto object-contain brightness-0 invert" 
          />
        </a>
      </div>
      
      <p class="text-xs sm:text-sm text-white/80 leading-relaxed max-w-sm">
        Thương hiệu sản phẩm thú cưng cao cấp LA PET. Cung cấp bánh thưởng dinh dưỡng, tã lót và cát vệ sinh an toàn, đạt chuẩn chất lượng quốc tế cho chó mèo.
      </p>

      <div class="space-y-2 text-xs sm:text-sm text-white/90">
        <p class="flex items-center gap-2">
          <span class="text-brand-accent font-bold">Hotline:</span>
          <a href={`tel:${hotline.replace(/\s+/g, '')}`} class="font-bold hover:text-brand-accent transition-colors">{hotline}</a>
        </p>
        <p class="flex items-center gap-2">
          <span class="text-brand-accent font-bold">Email:</span>
          <a href={`mailto:${contactEmail}`} class="hover:text-brand-accent transition-colors">{contactEmail}</a>
        </p>
        <p class="flex items-start gap-2">
          <span class="text-brand-accent font-bold shrink-0">Kho hàng:</span>
          <span>{companyAddress}</span>
        </p>
      </div>

      <!-- Mạng xã hội -->
      <div class="flex items-center gap-2.5 pt-2">
        <a 
          href="https://www.facebook.com/lapetvietnam/" 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-8 h-8 rounded-full bg-white/10 hover:bg-brand-accent text-white hover:text-brand-dark flex items-center justify-center transition-all p-1.5"
          aria-label="Facebook LA PET"
        >
          <svg class="w-full h-full fill-current" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>
        <a 
          href="https://www.tiktok.com/@lapetvietnam" 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-8 h-8 rounded-full bg-white/10 hover:bg-brand-accent text-white hover:text-brand-dark flex items-center justify-center transition-all p-1.5"
          aria-label="TikTok LA PET"
        >
          <svg class="w-full h-full fill-current" viewBox="0 0 24 24">
            <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02.77-.04 1.54-.04 2.31-.01.8-.02 1.61-.03 2.41-.83-.22-1.74-.12-2.5.28-.86.43-1.5 1.25-1.73 2.18-.28 1.02-.03 2.15.63 2.97.7.88 1.83 1.38 2.94 1.32 1.12-.02 2.17-.57 2.77-1.52.54-.83.74-1.84.72-2.83.02-4.8.01-9.6.01-14.4z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- CỘT 2: DANH MỤC SẢN PHẨM (2.5 Cột lg) -->
    <div class="space-y-3 lg:col-span-3">
      <h4 class="text-sm font-bold uppercase tracking-wider text-brand-accent">
        Danh mục sản phẩm
      </h4>
      <ul class="space-y-2 text-xs sm:text-sm text-white/80">
        {productCategories.map((item) => (
          <li>
            <a href={item.href} class="hover:text-white hover:underline transition-colors block py-0.5">
              {item.name}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- CỘT 3: VỀ CHÚNG TÔI (2.5 Cột lg) -->
    <div class="space-y-3 lg:col-span-2">
      <h4 class="text-sm font-bold uppercase tracking-wider text-brand-accent">
        Về chúng tôi
      </h4>
      <ul class="space-y-2 text-xs sm:text-sm text-white/80">
        {aboutLinks.map((item) => (
          <li>
            <a href={item.href} class="hover:text-white hover:underline transition-colors block py-0.5">
              {item.name}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- CỘT 4: PHƯƠNG THỨC THANH TOÁN & BẢO CHỨNG (3 Cột lg) -->
    <div class="space-y-3 lg:col-span-3">
      <h4 class="text-sm font-bold uppercase tracking-wider text-brand-accent">
        Thanh toán &amp; Uy tín
      </h4>
      <p class="text-xs text-white/70 leading-relaxed">
        Hỗ trợ thanh toán bảo mật và tiện lợi cho khách hàng sỉ &amp; lẻ toàn quốc:
      </p>
      
      <!-- Payment Badges -->
      <div class="flex flex-wrap gap-2 pt-1">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white/10 border border-white/15 text-[11px] font-bold text-white">
          <span class="text-brand-accent">✦</span> VNPAY (ATM / QR / Visa)
        </span>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white/10 border border-white/15 text-[11px] font-bold text-white">
          <span class="text-brand-accent">✦</span> COD (Nhận hàng)
        </span>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white/10 border border-white/15 text-[11px] font-bold text-white">
          <span class="text-brand-accent">✦</span> Chuyển khoản 24/7
        </span>
      </div>

      <!-- Trust Badges -->
      <div class="pt-2 text-xs text-white/80 space-y-1.5">
        <div class="flex items-center gap-2">
          <span class="text-emerald-400 font-bold">✓</span>
          <span>100% Sản phẩm chính hãng LA PET</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-emerald-400 font-bold">✓</span>
          <span>Đổi trả sản phẩm lỗi trong 7 ngày</span>
        </div>
      </div>
    </div>

  </div>

  <!-- COPYRIGHT -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 flex flex-col sm:flex-row justify-between items-center gap-2 text-xs text-white/60">
    <p>&copy; 2026 LA PET Vietnam. Tất cả quyền được bảo lưu.</p>
    <p class="flex items-center gap-3">
      <a href="/ve-lapet" class="hover:text-white transition-colors">Điều khoản dịch vụ</a>
      <span>·</span>
      <a href="/lien-he" class="hover:text-white transition-colors">Chính sách bảo mật</a>
    </p>
  </div>

</footer>
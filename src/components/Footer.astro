---
// src/components/Footer.astro
import { Image } from 'astro:assets';
import logoBrand from '../assets/images/brand/logo.webp';

// Danh sách thông tin liên hệ
const contactItems = [
  {
    icon: '/images/icons/contact/phone.webp',
    alt: 'Hotline',
    content: 'Hotline: <strong class="text-white font-bold">0909 203 166</strong>',
    href: 'tel:0909203166',
  },
  {
    icon: '/images/icons/contact/mail.webp',
    alt: 'Email',
    content: 'Email: <a href="mailto:contact@lapetvietnam.com" class="hover:underline break-all">contact@lapetvietnam.com</a>',
    href: null,
  },
  {
    icon: '/images/icons/contact/clock.webp',
    alt: 'Thời gian',
    content: 'Thời gian: 8:00 - 17:00 <br/><span class="text-white/80 text-sm">(Thứ 2 - Thứ 7)</span>',
    href: null,
  },
];

// Các nhóm liên kết Footer
const footerNav = [
  {
    title: 'VỀ LA PET',
    href: '/ve-lapet',
    links: [
      { name: 'Về LA PET', href: '/ve-lapet#gioi-thieu' },
      { name: 'Tầm nhìn & sứ mệnh', href: '/ve-lapet#tam-nhin-su-menh' },
      { name: 'Khách hàng của LA PET', href: '/ve-lapet#khach-hang-doi-tac' },
    ],
  },
  {
    title: 'NHÀ MÁY',
    href: '/nha-may-chat-luong',
    links: [
      { name: 'Tham quan nhà máy', href: '/nha-may-chat-luong#tham-quan-nha-may' },
      { name: 'Quy trình sản xuất', href: '/nha-may-chat-luong#quy-trinh-san-xuat' },
      { name: 'Kiểm định chất lượng', href: '/nha-may-chat-luong#kiem-dinh-chat-luong' },
    ],
  },
  {
    title: 'SẢN PHẨM',
    href: '/san-pham',
    links: [
      { name: 'Bánh thưởng', href: '/san-pham?category=banh-thuong' },
      { name: 'Tả cho thú cưng', href: '/san-pham?category=ta-cho-thu-cung' },
      { name: 'Cát vệ sinh', href: '/san-pham?category=cat-ve-sinh' },
      { name: 'Tin tức', href: '/tin-tuc' },
    ],
  },
];
---

<footer class="w-full bg-[#087b80] text-white pt-10 md:pt-12 pb-7 relative overflow-hidden font-sans">
  
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-x-8 lg:gap-x-10 gap-y-10 pb-10 md:pb-12 border-b border-white/20 relative z-10 items-start">
    
    <!-- CỘT 1: LOGO & MẠNG XÃ HỘI -->
    <div class="space-y-5 sm:col-span-2 lg:col-span-3">
      <div class="h-14 md:h-16 flex items-center justify-start">
        <a href="/" class="block h-full">
          <Image 
            src={logoBrand} 
            alt="LA PET Logo" 
            width={180} 
            height={70} 
            format="webp"
            class="h-full w-auto object-contain brightness-0 invert" 
          />
        </a>
      </div>
      
      <p class="text-sm md:text-base text-white/95 leading-relaxed font-normal max-w-sm">
        LA PET mang đến những sản phẩm chất lượng, an toàn và dinh dưỡng cho thú cưng.
      </p>
      
      <!-- Danh sách Mạng Xã Hội (Sử dụng SVG trực tiếp đảm bảo không bao giờ lỗi ảnh) -->
      <div class="flex items-center gap-3 pt-1">
        <!-- Facebook -->
        <a 
          href="https://www.facebook.com/lapetvietnam/" 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-9 h-9 rounded-full bg-white text-[#087b80] flex items-center justify-center hover:bg-white/90 transition-all hover:-translate-y-0.5 shadow-sm p-2"
          aria-label="Facebook"
        >
          <svg class="w-full h-full fill-current" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>

        <!-- TikTok -->
        <a 
          href="https://www.tiktok.com/@lapetvietnam" 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-9 h-9 rounded-full bg-white text-[#087b80] flex items-center justify-center hover:bg-white/90 transition-all hover:-translate-y-0.5 shadow-sm p-2"
          aria-label="TikTok"
        >
          <svg class="w-full h-full fill-current" viewBox="0 0 24 24">
            <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02.77-.04 1.54-.04 2.31-.01.8-.02 1.61-.03 2.41-.83-.22-1.74-.12-2.5.28-.86.43-1.5 1.25-1.73 2.18-.28 1.02-.03 2.15.63 2.97.7.88 1.83 1.38 2.94 1.32 1.12-.02 2.17-.57 2.77-1.52.54-.83.74-1.84.72-2.83.02-4.8.01-9.6.01-14.4z"/>
          </svg>
        </a>

        <!-- YouTube -->
        <a 
          href="#" 
          class="w-9 h-9 rounded-full bg-white text-[#087b80] flex items-center justify-center hover:bg-white/90 transition-all hover:-translate-y-0.5 shadow-sm p-2"
          aria-label="YouTube"
        >
          <svg class="w-full h-full fill-current" viewBox="0 0 24 24">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
        </a>

        <!-- Instagram -->
        <a 
          href="#" 
          class="w-9 h-9 rounded-full bg-white text-[#087b80] flex items-center justify-center hover:bg-white/90 transition-all hover:-translate-y-0.5 shadow-sm p-2"
          aria-label="Instagram"
        >
          <svg class="w-full h-full fill-current" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- CỘT 2: THÔNG TIN LIÊN HỆ -->
    <div class="space-y-4 min-w-0 lg:col-span-3">
      <h3 class="text-base md:text-lg font-bold uppercase tracking-wider leading-tight">
        <a href="/lien-he" class="hover:underline transition-all">LIÊN HỆ</a>
      </h3>
      <ul class="space-y-3.5 text-sm md:text-base text-white/90 font-normal leading-relaxed">
        {contactItems.map((item) => (
          <li class="flex items-start gap-2.5">
            <img 
              src={item.icon} 
              alt={item.alt} 
              class="w-4 h-4 object-contain shrink-0 mt-1 brightness-0 invert" 
            />
            <div class="min-w-0">
              {item.href ? (
                <a href={item.href} class="hover:underline"><Fragment set:html={item.content} /></a>
              ) : (
                <Fragment set:html={item.content} />
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>

    <!-- CỘT 3, 4, 5: DANH MỤC LIÊN KẾT -->
    {footerNav.map((section) => (
      <div class="space-y-4 lg:col-span-2">
        <h3 class="text-base md:text-lg font-bold uppercase tracking-wider leading-tight">
          <a href={section.href} class="hover:underline transition-all">{section.title}</a>
        </h3>
        <ul class="space-y-2.5 text-sm md:text-base text-white/85 font-normal leading-relaxed">
          {section.links.map((link) => (
            <li>
              <a href={link.href} class="hover:text-white hover:underline transition-colors">{link.name}</a>
            </li>
          ))}
        </ul>
      </div>
    ))}

  </div>

  <!-- BẢN QUYỀN (COPYRIGHT) -->
  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 pt-6 flex flex-col md:flex-row justify-between items-center relative z-10 text-sm text-white/80 font-normal">
    <div class="w-full text-center">
      &copy; 2026 LA PET. All rights reserved.
    </div>
  </div>

</footer>
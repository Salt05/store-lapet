---
// src/components/Header.astro
import { Image } from 'astro:assets';
import logoBrand from '../assets/images/brand/logo.webp';
import { getProductGroups } from '../lib/catalog';
import Drawer from './common/Drawer.astro';

// 1. Single source of truth for Auth
const auth = Astro.locals.auth;

const isServerLoggedIn = auth?.isAuthenticated === true;
const isDealer = auth?.isDealer === true;

const partnerId = auth?.partnerId ?? null;
const partnerName = auth?.partnerName ?? null;
const partnerPhone = auth?.partnerPhone ?? null;

const serverDisplayName =
  partnerName ||
  partnerPhone ||
  (partnerId ? `Đại lý ${partnerId}` : '');

// 2. Navigation Links
const navLinks = [
  { name: 'Danh Mục Sản Phẩm', href: '/san-pham', isMega: true },
  { name: 'Quick Order Matrix', href: '/dat-hang-nhanh' },
  { name: 'Chính Sách B2B', href: '/lien-he#partner-registration' },
  { name: 'Về Chúng Tôi', href: '/ve-lapet' },
];

// Fallback categories if Directus is offline
const fallbackMegaMenuItems = [
  {
    name: 'Bánh thưởng thú cưng',
    slug: 'banh-thuong',
    href: '/san-pham?category=banh-thuong',
    image: '/e03.webp',
    fallbackImg: '/images/placeholder-product.svg',
    count: null as number | null,
  },
  {
    name: 'Tã lót & Vệ sinh',
    slug: 'ta-cho-thu-cung',
    href: '/san-pham?category=ta-cho-thu-cung',
    image: '/tlt.webp',
    fallbackImg: '/images/placeholder-product.svg',
    count: null as number | null,
  },
  {
    name: 'Cát vệ sinh cao cấp',
    slug: 'cat-ve-sinh',
    href: '/san-pham?category=cat-ve-sinh',
    image: '/zc.webp',
    fallbackImg: '/images/placeholder-product.svg',
    count: null as number | null,
  }
];

// 3. Dynamic Categories from Directus
const dynamicGroups = await getProductGroups();
const megaMenuItems = dynamicGroups.length > 0
  ? dynamicGroups.map((g) => ({
      name: g.name,
      slug: g.slug,
      href: `/san-pham?category=${g.slug}`,
      image: g.thumbnail || '/images/placeholder-product.svg',
      fallbackImg: '/images/placeholder-product.svg',
      count: g.productCount as number | null,
    }))
  : fallbackMegaMenuItems;
---

<header 
  x-data={`{ 
    isCartOpen: false,
    isMobileMenuOpen: false,
    isMobileCategoryOpen: true,
    isUserDropdownOpen: false,
    isCategoryDropdownOpen: false,

    // Auth State from SSR
    isLoggedIn: ${isServerLoggedIn}, 
    isDealer: ${isDealer},
    partnerId: ${partnerId !== null ? JSON.stringify(partnerId) : 'null'},
    userName: ${JSON.stringify(serverDisplayName)},

    searchQuery: '',
    selectedCategory: '',
    cartCount: 0,
    cartItems: [],
    showToast: false,
    toastMessage: 'Đã cập nhật giỏ hàng!',

    async init() {
      this.loadCart();

      if (typeof window.syncCartPrices === 'function') {
        await window.syncCartPrices();
      }

      window.addEventListener('cart-updated', () => {
        this.loadCart();
        this.triggerToast();
      });

      window.addEventListener('auth-changed', () => {
        window.location.reload();
      });
    },

    loadCart() {
      try {
        this.cartItems = JSON.parse(localStorage.getItem('cart') || '[]');
        this.cartCount = this.cartItems.reduce((total, item) => total + (item.quantity || 1), 0);
      } catch (e) {
        this.cartItems = [];
        this.cartCount = 0;
      }
    },

    updateQuantity(index, delta) {
      if (this.cartItems[index]) {
        this.cartItems[index].quantity = (this.cartItems[index].quantity || 1) + delta;
        if (this.cartItems[index].quantity <= 0) {
          this.cartItems.splice(index, 1);
        }
        this.saveAndNotify();
      }
    },

    removeItem(index) {
      this.cartItems.splice(index, 1);
      this.saveAndNotify();
    },

    saveAndNotify() {
      localStorage.setItem('cart', JSON.stringify(this.cartItems));
      window.dispatchEvent(new CustomEvent('cart-updated'));
    },

    get totalPrice() {
      return this.cartItems.reduce((sum, item) => sum + (item.price || 0) * (item.quantity || 1), 0);
    },

    triggerToast() {
      this.showToast = true;
      setTimeout(() => { this.showToast = false; }, 3000);
    },

    async logout() {
      if (!confirm('Bạn có chắc chắn muốn đăng xuất?')) return;

      try {
        await fetch('/api/auth/logout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
        });

        document.cookie = 'partner_id=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
        document.cookie = 'partner_name=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
        document.cookie = 'session_id=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
        localStorage.removeItem('auth_token');
        localStorage.removeItem('user_info');
        localStorage.removeItem('user');

        window.location.href = '/auth/login';
      } catch (e) {
        console.error('Logout error:', e);
        alert('Có lỗi xảy ra khi đăng xuất');
      }
    }
  }`}
  class="w-full font-sans sticky top-0 z-40 bg-white text-[#07394D] border-b border-gray-100 shadow-xs transition-all"
>
  <!-- TOP BAR: Logo LA PET, Search pill, Utilities (Login, Wishlist, Cart) -->
  <div class="max-w-[1140px] mx-auto px-4 sm:px-6 h-20 flex items-center justify-between gap-4 sm:gap-6">
    
    <!-- LEFT: Mobile Menu Button + LA PET Logo -->
    <div class="flex items-center gap-3 sm:gap-4 shrink-0">
      <!-- Mobile Drawer Trigger Button -->
      <button 
        @click="isMobileMenuOpen = true"
        type="button"
        class="lg:hidden p-1.5 text-gray-700 hover:text-[#07394D] hover:bg-gray-100 rounded-lg transition-colors cursor-pointer focus:outline-none shrink-0"
        aria-label="Mở danh mục điều hướng"
      >
        <svg class="w-6 h-6 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>

      <!-- Brand Logo LA PET -->
      <a href="/" class="inline-flex items-center shrink-0 group" aria-label="LA PET Trang chủ">
        <span class="text-2xl sm:text-3xl font-black tracking-tight text-[#07394D] group-hover:text-[#EA580C] transition-colors">
          LA PET
        </span>
      </a>
    </div>

    <!-- MIDDLE: Search Bar with Categories Dropdown -->
    <div class="flex-1 max-w-[560px] hidden sm:block">
      <form action="/san-pham" method="get" class="w-full m-0" @submit="searchQuery = searchQuery.trim()">
        <div class="flex items-center border border-gray-200 rounded-full pl-4 pr-1.5 py-1.5 bg-white focus-within:border-[#07394D] transition-colors shadow-2xs relative">
          
          <!-- Category Select / Dropdown Trigger -->
          <div class="relative shrink-0">
            <button 
              type="button" 
              @click="isCategoryDropdownOpen = !isCategoryDropdownOpen" 
              @click.outside="isCategoryDropdownOpen = false"
              class="flex items-center gap-1.5 text-xs font-semibold text-gray-700 hover:text-[#07394D] pr-3 border-r border-gray-200 cursor-pointer"
            >
              <span x-text="selectedCategory || 'Tất cả danh mục'">Tất cả danh mục</span>
              <svg class="w-3.5 h-3.5 text-gray-400 transition-transform duration-150" :class="{ 'rotate-180': isCategoryDropdownOpen }" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>

            <!-- Categories Dropdown List -->
            <div 
              x-show="isCategoryDropdownOpen" 
              x-transition:enter="transition ease-out duration-100" 
              x-transition:enter-start="opacity-0 scale-95" 
              x-transition:enter-end="opacity-100 scale-100" 
              x-transition:leave="transition ease-in duration-75" 
              x-transition:leave-start="opacity-100 scale-100" 
              x-transition:leave-end="opacity-0 scale-95" 
              class="absolute left-0 top-full mt-2 w-56 bg-white rounded-xl shadow-lg border border-gray-100 py-1.5 z-50 text-xs font-medium"
              x-cloak
            >
              <a 
                href="/san-pham" 
                @click="selectedCategory = ''; isCategoryDropdownOpen = false"
                class="block px-3.5 py-2 text-gray-700 hover:bg-gray-50 hover:text-[#07394D]"
              >
                Tất cả danh mục
              </a>
              {megaMenuItems.map((cat) => (
                <a 
                  href={`/san-pham?category=${cat.slug}`} 
                  @click={`selectedCategory = '${cat.name}'; isCategoryDropdownOpen = false`}
                  class="block px-3.5 py-2 text-gray-700 hover:bg-gray-50 hover:text-[#07394D] truncate"
                >
                  {cat.name}
                </a>
              ))}
            </div>
          </div>

          <!-- Hidden category input for form submit -->
          <input type="hidden" name="category" :value="selectedCategory ? megaMenuItems.find(m => m.name === selectedCategory)?.slug || '' : ''" />

          <!-- Search Input -->
          <input 
            type="text" 
            name="q" 
            x-model="searchQuery" 
            placeholder="Tìm theo mã SKU, tên bánh thưởng, que gặm..." 
            class="flex-1 px-3 text-xs text-gray-800 placeholder-gray-400 bg-transparent focus:outline-none font-medium min-w-0" 
          />

          <!-- Dark Navy Round Search Button -->
          <button 
            type="submit" 
            class="w-8 h-8 rounded-full bg-[#07394D] hover:bg-[#052937] text-white flex items-center justify-center transition-colors shrink-0 cursor-pointer shadow-2xs"
            aria-label="Tìm kiếm"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
          </button>

        </div>
      </form>
    </div>

    <!-- RIGHT UTILITIES: Login/SignUp, Wishlist, Cart with Counter -->
    <div class="flex items-center gap-5 sm:gap-6 text-xs font-semibold text-[#07394D] shrink-0">
      
      <!-- Login / Sign Up State -->
      <div class="relative flex items-center">
        <!-- Guest State -->
        <template x-if="!isLoggedIn">
          <a 
            href="/auth/login" 
            class="flex items-center gap-1.5 hover:text-[#0E6C8C] transition-colors cursor-pointer"
            aria-label="Đăng nhập hoặc Đăng ký"
          >
            <svg class="w-4 h-4 text-gray-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
            <span class="hidden sm:inline">Đăng nhập</span>
          </a>
        </template>

        <!-- Logged In State -->
        <template x-if="isLoggedIn">
          <div class="relative">
            <button 
              @click="isUserDropdownOpen = !isUserDropdownOpen" 
              @click.outside="isUserDropdownOpen = false"
              type="button"
              class="flex items-center gap-1.5 hover:text-[#0E6C8C] transition-colors cursor-pointer max-w-[150px] truncate"
            >
              <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
              <span class="truncate" x-text="userName || 'Tài khoản'"></span>
              <svg class="w-3.5 h-3.5 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>

            <!-- User Menu Dropdown -->
            <div 
              x-show="isUserDropdownOpen"
              x-transition:enter="transition ease-out duration-100"
              x-transition:enter-start="opacity-0 scale-95"
              x-transition:enter-end="opacity-100 scale-100"
              x-transition:leave="transition ease-in duration-75"
              x-transition:leave-start="opacity-100 scale-100"
              x-transition:leave-end="opacity-0 scale-95"
              class="absolute right-0 mt-2 w-56 bg-white rounded-xl shadow-lg py-2 text-slate-800 z-50 border border-gray-100 font-medium"
              x-cloak
            >
              <div class="px-4 py-2 border-b border-gray-100">
                <p class="text-[10px] text-gray-500 font-bold uppercase tracking-wider" x-text="isDealer ? 'Tài khoản Đại lý B2B' : 'Khách hàng'"></p>
                <p class="text-sm font-bold text-gray-900 truncate" x-text="userName"></p>
              </div>
              <div class="py-1 text-xs">
                <a href="/tai-khoan" class="block px-4 py-2 hover:bg-gray-50 hover:text-[#07394D]">Hồ sơ &amp; Đơn hàng</a>
                <template x-if="isDealer">
                  <a href="/dat-hang-nhanh" class="block px-4 py-2 hover:bg-gray-50 hover:text-[#07394D]">Đặt hàng nhanh B2B</a>
                </template>
                <a href="/lien-he#partner-registration" class="block px-4 py-2 hover:bg-gray-50 hover:text-[#07394D]">Chính sách Đại lý</a>
              </div>
              <div class="border-t border-gray-100 my-1"></div>
              <button @click="logout()" class="w-full text-left px-4 py-2 text-xs font-bold text-rose-600 hover:bg-rose-50 cursor-pointer">
                Đăng xuất
              </button>
            </div>
          </div>
        </template>
      </div>

      <!-- Wishlist Heart Icon -->
      <a 
        href="/tai-khoan" 
        class="text-gray-700 hover:text-rose-500 transition-colors p-1"
        title="Danh sách yêu thích"
        aria-label="Wishlist"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
        </svg>
      </a>

      <!-- Cart Icon with Circular Badge matching mockup (bag icon + circle counter) -->
      <button 
        @click="isCartOpen = true" 
        type="button"
        class="relative p-1 text-gray-800 hover:text-[#07394D] transition-colors cursor-pointer flex items-center shrink-0 focus:outline-none" 
        title="Giỏ hàng"
        aria-label="Giỏ hàng"
      >
        <svg class="w-4 h-4 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
        </svg>
        <span 
          x-show="cartCount > 0"
          x-text="cartCount" 
          class="absolute -top-2 -right-2.5 bg-[#07394D] text-white text-[10px] font-bold rounded-full w-4 h-4 flex items-center justify-center shadow-xs"
        >0</span>
      </button>

    </div>

  </div>

  <!-- NAVIGATION BAR (Second Row: Các mục điều hướng tinh gọn, không trùng lặp) -->
  <div class="border-t border-gray-100">
    <div class="max-w-[1140px] mx-auto px-4 sm:px-6 h-11 flex items-center justify-between text-xs font-semibold text-gray-700">
      
      <!-- Left Essential Links (Mỗi mục 1 chức năng riêng biệt) -->
      <div class="flex items-center gap-6 sm:gap-8 py-1">
        <!-- 1. Danh mục sản phẩm (Mega Menu chi tiết tất cả dòng hàng) -->
        <div class="relative group shrink-0">
          <a href="/san-pham" class="flex items-center gap-1 hover:text-[#07394D] text-[#07394D] py-1 cursor-pointer">
            <span>Danh Mục Sản Phẩm</span>
            <svg class="w-3 h-3 text-gray-400 group-hover:rotate-180 transition-transform duration-150" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </a>

          <!-- Mega Dropdown -->
          <div class="absolute left-0 top-full pt-2 opacity-0 invisible translate-y-2 group-hover:translate-y-0 group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div class="w-[520px] bg-white rounded-2xl shadow-xl border border-gray-100 p-4 text-slate-800">
              <div class="flex items-center justify-between pb-2 mb-2 border-b border-gray-100">
                <p class="text-[11px] font-bold uppercase tracking-wider text-[#07394D]">Các dòng sản phẩm LA PET</p>
                <a href="/san-pham" class="text-xs font-semibold text-[#07394D] hover:underline">Xem tất cả &rarr;</a>
              </div>
              <div class="grid grid-cols-3 gap-2.5">
                {megaMenuItems.map((item) => (
                  <a 
                    href={item.href} 
                    class="flex flex-col items-center text-center p-2.5 rounded-xl hover:bg-gray-50 border border-transparent hover:border-gray-100 transition-all group/item"
                  >
                    <div class="w-12 h-12 rounded-lg bg-gray-50 p-1.5 mb-1.5 flex items-center justify-center">
                      <img 
                        src={item.image} 
                        alt={item.name} 
                        loading="lazy" 
                        class="max-w-full max-h-full object-contain group-hover/item:scale-110 transition-transform duration-200"
                        onerror={`this.onerror=null;this.src='${item.fallbackImg}';`}
                      />
                    </div>
                    <span class="text-[11px] font-bold text-gray-800 group-hover/item:text-[#07394D] line-clamp-2 leading-tight">
                      {item.name}
                    </span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- 2. Đặt Hàng Nhanh B2B (Ma trận chọn SKU + chiết khấu sỉ) -->
        <a href="/dat-hang-nhanh" class="hover:text-rose-600 text-rose-500 font-bold shrink-0 flex items-center gap-1.5">
          <span>Đặt Hàng Nhanh</span>
          <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-rose-50 text-rose-600 font-extrabold">-22%</span>
        </a>

        <!-- 3. Chính Sách B2B & Đại Lý (Form đăng ký & chính sách chiết khấu) -->
        <a href="/lien-he#partner-registration" class="hover:text-[#07394D] text-gray-700 shrink-0">
          Chính Sách Đại Lý
        </a>

        <!-- 4. Về LA PET (Câu chuyện thương hiệu, chứng nhận) -->
        <a href="/ve-lapet" class="hover:text-[#07394D] text-gray-700 shrink-0">
          Về Chúng Tôi
        </a>
      </div>

      <!-- Right Contact Hotline -->
      <div class="hidden md:flex items-center gap-1.5 shrink-0 text-gray-600">
        <span class="text-[11px]">Hotline B2B:</span>
        <a href="tel:0909203166" class="hover:text-[#07394D] text-[#07394D] font-bold">0909 203 166</a>
      </div>

    </div>
  </div>

  <!-- MOBILE NAVIGATION DRAWER (Using Drawer primitive) -->
  <Drawer 
    id="mobile-navigation-drawer" 
    model="isMobileMenuOpen" 
    side="left" 
    title="Danh Mục & Điều Hướng" 
    width="max-w-[320px] sm:max-w-sm"
  >
    <div class="space-y-4">
      
      <!-- Mobile Search Form -->
      <form action="/san-pham" method="get" class="w-full" @submit="isMobileMenuOpen = false">
        <div class="relative flex items-center bg-brand-surface rounded-xl border border-brand-border px-3 py-2">
          <svg class="w-4 h-4 text-brand-muted shrink-0 stroke-current fill-none stroke-2 mr-2" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input 
            type="text" 
            name="q" 
            placeholder="Tìm sản phẩm..." 
            class="w-full text-xs text-brand-text placeholder-brand-muted focus:outline-none bg-transparent font-medium" 
          />
        </div>
      </form>

      <!-- User Auth Section in Mobile Drawer -->
      <div class="p-3.5 rounded-xl bg-brand-surface border border-brand-border">
        <template x-if="!isLoggedIn">
          <a 
            href="/auth/login" 
            @click="isMobileMenuOpen = false"
            class="flex items-center gap-3 text-brand-dark font-bold text-sm hover:text-brand-primary"
          >
            <div class="w-8 h-8 rounded-lg bg-brand-primary text-white flex items-center justify-center">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"/>
              </svg>
            </div>
            <span>Đăng nhập Đại lý / Khách hàng</span>
          </a>
        </template>

        <template x-if="isLoggedIn">
          <div class="space-y-2">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-lg bg-brand-primary text-white flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                </svg>
              </div>
              <div class="min-w-0 flex-1">
                <p class="font-bold text-xs text-brand-dark truncate" x-text="userName"></p>
                <span class="inline-block text-[10px] font-bold px-1.5 py-0.5 rounded bg-brand-primary/10 text-brand-primary" x-text="isDealer ? 'ĐẠI LÝ B2B' : 'KHÁCH HÀNG'"></span>
              </div>
            </div>
            <div class="pt-2 flex flex-col gap-1 text-xs font-semibold text-brand-muted border-t border-brand-border/60">
              <a href="/tai-khoan" @click="isMobileMenuOpen = false" class="py-1 hover:text-brand-dark">Tài khoản & Đơn hàng</a>
              <button @click="logout()" class="py-1 text-rose-600 hover:text-rose-700 text-left font-bold cursor-pointer">Đăng xuất</button>
            </div>
          </div>
        </template>
      </div>

      <!-- Navigation Links in Drawer -->
      <nav class="space-y-1 font-bold text-sm text-brand-dark">
        <!-- Products Accordion -->
        <div class="space-y-1">
          <button 
            @click="isMobileCategoryOpen = !isMobileCategoryOpen" 
            type="button"
            class="w-full flex items-center justify-between py-2.5 px-3 rounded-xl hover:bg-brand-surface text-brand-dark transition-colors"
          >
            <span>Sản phẩm</span>
            <svg :class="isMobileCategoryOpen ? 'rotate-180' : ''" class="w-4 h-4 stroke-current fill-none stroke-2 transition-transform duration-200" viewBox="0 0 24 24">
              <path d="M6 9l6 6 6-6"></path>
            </svg>
          </button>
          
          <div x-show="isMobileCategoryOpen" class="pl-3 space-y-1">
            <a 
              href="/san-pham" 
              @click="isMobileMenuOpen = false"
              class="flex items-center gap-2.5 py-2 px-3 rounded-lg text-xs font-bold text-brand-primary hover:bg-brand-surface transition-colors"
            >
              <span class="w-5 h-5 rounded bg-brand-primary/10 flex items-center justify-center">✦</span>
              <span>Tất cả sản phẩm</span>
            </a>
            {megaMenuItems.map((item) => (
              <a 
                href={item.href} 
                @click="isMobileMenuOpen = false"
                class="flex items-center gap-2.5 py-2 px-3 rounded-lg text-xs font-semibold text-brand-muted hover:text-brand-dark hover:bg-brand-surface transition-colors"
              >
                <img 
                  src={item.image} 
                  alt={item.name} 
                  class="w-5 h-5 object-contain"
                  onerror={`this.onerror=null;this.src='${item.fallbackImg}';`}
                />
                <span class="flex-1 truncate">{item.name}</span>
                {item.count !== null && <span class="text-[10px] text-brand-muted">{item.count}</span>}
              </a>
            ))}
          </div>
        </div>

        <a href="/ve-lapet" @click="isMobileMenuOpen = false" class="block py-2.5 px-3 rounded-xl hover:bg-brand-surface text-brand-dark transition-colors">Về LA PET</a>
        <a href="/lien-he#partner-registration" @click="isMobileMenuOpen = false" class="block py-2.5 px-3 rounded-xl hover:bg-brand-surface text-brand-dark transition-colors">Đại lý B2B</a>
        <a href="/lien-he" @click="isMobileMenuOpen = false" class="block py-2.5 px-3 rounded-xl hover:bg-brand-surface text-brand-dark transition-colors">Liên hệ</a>
      </nav>

      <!-- Support Hotline Box -->
      <div class="mt-6 p-4 rounded-xl bg-brand-surface border border-brand-border text-center">
        <p class="text-xs text-brand-muted font-medium">Hỗ trợ tư vấn đại lý</p>
        <a href="tel:0909203166" class="mt-1 block text-base font-black text-brand-primary hover:underline">0909 203 166</a>
        <p class="text-[11px] text-brand-muted mt-0.5">8:00 - 17:00 (Thứ 2 - Thứ 7)</p>
      </div>

    </div>
  </Drawer>

  <!-- CART SLIDE-OUT DRAWER (Using Drawer primitive) -->
  <Drawer 
    id="header-cart-drawer" 
    model="isCartOpen" 
    side="right" 
    title="Giỏ Hàng Của Bạn" 
    width="max-w-md"
    footerShow="cartItems.length > 0"
  >
    <!-- Empty Cart -->
    <template x-if="cartItems.length === 0">
      <div class="py-12 flex flex-col items-center justify-center text-center px-4">
        <div class="w-16 h-16 rounded-full bg-brand-sand flex items-center justify-center text-brand-muted mb-3">
          <svg class="w-8 h-8 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
            <path d="M3 6h18"></path>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
        </div>
        <h4 class="text-sm font-bold text-brand-dark">Giỏ hàng đang trống</h4>
        <p class="text-xs text-brand-muted mt-1 max-w-xs">Hãy khám phá các dòng sản phẩm bánh thưởng và dinh dưỡng chất lượng của LA PET.</p>
        <a 
          href="/san-pham" 
          @click="isCartOpen = false" 
          class="mt-4 inline-flex items-center justify-center px-5 py-2.5 rounded-xl bg-brand-primary text-white text-xs font-bold uppercase tracking-wider hover:bg-brand-dark transition-colors shadow-soft"
        >
          Xem danh mục sản phẩm
        </a>
      </div>
    </template>

    <!-- Cart Items List -->
    <div x-show="cartItems.length > 0" class="space-y-3">
      <template x-for="(item, index) in cartItems" :key="item.odoo_id || item.id || index">
        <div class="flex gap-3 p-3 rounded-xl bg-brand-surface/70 border border-brand-border/70 items-center">
          <img 
            :src="item.image || '/images/placeholder-product.svg'" 
            :alt="item.name" 
            class="w-16 h-16 object-contain rounded-lg bg-white p-1 border border-brand-border shrink-0" 
            onerror="this.onerror=null;this.src='/images/placeholder-product.svg';"
          />
          <div class="flex-1 min-w-0">
            <h5 class="text-xs font-bold text-brand-dark line-clamp-2 leading-snug" x-text="item.name"></h5>
            <p class="text-xs font-extrabold text-brand-primary mt-1">
              <span x-text="(item.price || 0).toLocaleString('vi-VN')"></span>đ
            </p>
            <div class="flex items-center justify-between mt-2">
              <div class="inline-flex items-center border border-brand-border rounded-lg bg-white overflow-hidden">
                <button 
                  @click="updateQuantity(index, -1)" 
                  class="px-2 py-0.5 text-xs text-brand-muted hover:bg-brand-sand transition-colors font-bold cursor-pointer"
                  aria-label="Giảm số lượng"
                >-</button>
                <span class="px-2.5 py-0.5 text-xs font-bold text-brand-dark" x-text="item.quantity || 1"></span>
                <button 
                  @click="updateQuantity(index, 1)" 
                  class="px-2 py-0.5 text-xs text-brand-muted hover:bg-brand-sand transition-colors font-bold cursor-pointer"
                  aria-label="Tăng số lượng"
                >+</button>
              </div>
              <button 
                @click="removeItem(index)" 
                class="text-xs text-rose-600 hover:text-rose-800 font-medium transition-colors cursor-pointer"
              >
                Xóa
              </button>
            </div>
          </div>
        </div>
      </template>
    </div>

    <!-- Drawer Footer -->
    <div slot="footer" class="space-y-3">
      <div class="flex items-center justify-between text-sm">
        <span class="text-brand-muted font-medium">Tạm tính:</span>
        <span class="text-base font-black text-brand-dark">
          <span><span x-text="totalPrice.toLocaleString('vi-VN')"></span>đ</span>
        </span>
      </div>
      <div class="grid grid-cols-2 gap-2.5">
        <a 
          href="/gio-hang" 
          @click="isCartOpen = false" 
          class="inline-flex items-center justify-center py-2.5 px-3 rounded-xl border border-brand-border bg-white text-brand-dark hover:bg-brand-sand font-bold text-xs uppercase tracking-wider text-center transition-colors"
        >
          Giỏ hàng
        </a>
        <template x-if="isLoggedIn">
          <a 
            href="/thanh-toan" 
            @click="isCartOpen = false" 
            class="inline-flex items-center justify-center py-2.5 px-3 rounded-xl bg-brand-primary text-white hover:bg-brand-dark font-bold text-xs uppercase tracking-wider text-center transition-colors shadow-soft"
          >
            Thanh toán
          </a>
        </template>
        <template x-if="!isLoggedIn">
          <a 
            href="/auth/login" 
            @click="isCartOpen = false" 
            class="inline-flex items-center justify-center py-2.5 px-3 rounded-xl bg-brand-primary text-white hover:bg-brand-dark font-bold text-xs uppercase tracking-wider text-center transition-colors shadow-soft"
          >
            Đăng nhập
          </a>
        </template>
      </div>
    </div>
  </Drawer>

  <!-- TOAST NOTIFICATION -->
  <div 
    x-show="showToast" 
    x-transition:enter="transition ease-out duration-300 transform" 
    x-transition:enter-start="translate-y-5 opacity-0 scale-95" 
    x-transition:enter-end="translate-y-0 opacity-100 scale-100" 
    x-transition:leave="transition ease-in duration-200 transform" 
    x-transition:leave-start="translate-y-0 opacity-100 scale-100" 
    x-transition:leave-end="translate-y-5 opacity-0 scale-95" 
    class="fixed bottom-6 right-6 z-[99] bg-brand-dark text-white px-4 py-3 rounded-xl shadow-modal flex items-center gap-3 border border-brand-accent/30" 
    x-cloak
  >
    <div class="w-6 h-6 rounded-full bg-brand-accent text-brand-dark flex items-center justify-center shrink-0 font-bold text-xs">
      ✓
    </div>
    <div class="text-xs">
      <p class="font-bold text-brand-accent">Thông báo</p>
      <p class="font-medium text-white/90" x-text="toastMessage"></p>
    </div>
  </div>

</header>

<script>
  import { syncCartPrices } from '@/utils/cartPriceSync';
  (window as any).syncCartPrices = syncCartPrices;
</script>
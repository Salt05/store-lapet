---
// src/layouts/AuthLayout.astro
import { Image } from 'astro:assets';
import logoBrand from '../assets/images/brand/logo.webp';
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Xác thực tài khoản - LA PET' } = Astro.props;
---

<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <style>
      [x-cloak] { display: none !important; }
    </style>
  </head>
  <body class="bg-[#087b80] font-['Inter',sans-serif] min-h-screen flex flex-col items-center justify-center p-4 antialiased">
    
    <div class="mb-6">
      <a href="/" class="inline-block transition-transform hover:scale-105">
        <Image 
          src={logoBrand} 
          alt="LA PET Store Logo" 
          width={200} 
          height={70} 
          format="webp" 
          class="h-14 w-auto object-contain"
        />
      </a>
    </div>

    <main class="w-full max-w-md bg-white rounded-3xl p-6 sm:p-8 shadow-2xl border border-slate-100">
      <slot />
    </main>

    <footer class="mt-8 text-center text-xs text-white/80 font-medium">
      <p>&copy; {new Date().getFullYear()} LA PET Store. All rights reserved.</p>
    </footer>

  </body>
</html>
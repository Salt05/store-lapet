---
// src/layouts/AccountLayout.astro
import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
  activeTab?: 'profile' | 'orders' | 'sales' | 'agent';
}

const { title = 'Tài khoản cá nhân - LA PET', activeTab = 'profile' } = Astro.props;

const menuItems = [
  { id: 'profile', name: 'Thông tin tài khoản', href: '/tai-khoan', icon: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z' },
  { id: 'orders', name: 'Đơn hàng của tôi', href: '/tai-khoan/don-hang', icon: 'M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z' },
  { id: 'sales', name: 'Doanh số & Mức thưởng', href: '/hoan-tat', icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z' }
];
---

<BaseLayout title={title}>
  <div class="max-w-7xl mx-auto py-6 sm:py-8 px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8">
      
      <!-- Sidebar Menu (Cân đối 3/12 trên Desktop, không chiếm diện tích quá mức) -->
      <aside class="lg:col-span-3">
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200/80 sticky top-24 space-y-4">
          <div class="pb-3 border-b border-slate-100 flex items-center justify-between">
            <h2 class="text-xs font-bold text-slate-400 uppercase tracking-wider">
              Trung tâm Đại lý
            </h2>
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-3xs font-extrabold bg-teal-50 text-teal-700 border border-teal-200/60">
              B2B Portal
            </span>
          </div>

          <nav class="space-y-1">
            {menuItems.map(item => (
              <a
                href={item.href}
                class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all ${
                  activeTab === item.id 
                    ? 'bg-[#083a3c] text-white shadow-xs' 
                    : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900'
                }`}
              >
                <svg class="w-4 h-4 fill-none stroke-current stroke-2 shrink-0" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d={item.icon}></path>
                </svg>
                <span>{item.name}</span>
              </a>
            ))}
          </nav>

          <div class="pt-3 border-t border-slate-100">
            <a
              href="/dat-hang-nhanh"
              class="w-full inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl bg-orange-600 hover:bg-orange-700 text-white text-xs font-bold transition shadow-xs"
            >
              <svg class="w-3.5 h-3.5 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path>
              </svg>
              <span>Đặt hàng nhanh</span>
            </a>
          </div>
        </div>
      </aside>

      <!-- Nội dung chi tiết của trang (9/12 trên Desktop) -->
      <section class="lg:col-span-9 bg-white rounded-2xl p-5 sm:p-7 shadow-sm border border-slate-200/80 min-h-[500px]">
        <slot />
      </section>

    </div>
  </div>
</BaseLayout>
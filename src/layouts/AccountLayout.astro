---
// src/layouts/AccountLayout.astro
import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
  activeTab?: 'profile' | 'orders' | 'agent';
}

const { title = 'Tài khoản cá nhân - LA PET', activeTab = 'profile' } = Astro.props;

const menuItems = [
  { id: 'profile', name: 'Thông tin tài khoản', href: '/tai-khoan', icon: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z' },
  { id: 'orders', name: 'Đơn hàng của tôi', href: '/tai-khoan/don-hang', icon: 'M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z' },
  { id: 'agent', name: 'Khu vực Đại lý (B2B)', href: '/dai-ly/dashboard', icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4' }
];
---

<BaseLayout title={title}>
  <div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      
      <!-- Sidebar Menu -->
      <aside class="lg:col-span-1 bg-white rounded-3xl p-6 shadow-sm border border-slate-100 h-fit">
        <h2 class="text-lg font-bold text-[#083a3c] mb-4 pb-3 border-b border-slate-100">
          Quản lý tài khoản
        </h2>
        <nav class="space-y-1">
          {menuItems.map(item => (
            <a
              href={item.href}
              class={`flex items-center gap-3 px-4 py-3 rounded-2xl text-sm font-bold transition-all ${
                activeTab === item.id 
                  ? 'bg-[#087b80] text-white shadow-sm' 
                  : 'text-slate-600 hover:bg-slate-50 hover:text-[#083a3c]'
              }`}
            >
              <svg class="w-5 h-5 fill-none stroke-current stroke-2 shrink-0" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d={item.icon}></path>
              </svg>
              <span>{item.name}</span>
            </a>
          ))}
        </nav>
      </aside>

      <!-- Nội dung chi tiết của trang -->
      <section class="lg:col-span-3 bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-100">
        <slot />
      </section>

    </div>
  </div>
</BaseLayout>
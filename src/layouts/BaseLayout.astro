---
// src/layouts/BaseLayout.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = 'LA PET - Thương Hiệu Sản Phẩm Thú Cưng Cao Cấp', 
  description = 'Chuyên cung cấp các sản phẩm phụ kiện, bánh thưởng, tã lót và cát vệ sinh chất lượng cao cho thú cưng.' 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Alpine.js Plugins (Phải load trước Core) -->
    <script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/collapse@3.x.x/dist/cdn.min.js"></script>
    
    <!-- Alpine.js Core -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    
    <style>
      [x-cloak] { display: none !important; }
    </style>
  </head>
  <body class="bg-[#f9f8f6] text-slate-800 font-['Inter',sans-serif] min-h-screen flex flex-col antialiased selection:bg-[#23c1c6] selection:text-[#083a3c]">
    
    <!-- Header Component -->
    <Header />

    <!-- Main Content Slot -->
    <main class="flex-1 w-full">
      <slot />
    </main>

    <!-- Footer Component -->
    <Footer />

  </body>
</html>
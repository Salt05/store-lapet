# Cổng chạy dịch vụ
PORT=4000

# Cấu hình CSDL PostgreSQL để đọc cấu hình SMTP & Email Admin từ bảng app_settings
DATABASE_URL=postgresql://crmuser:zalocrm_secure_password@127.0.0.1:5433/zalocrm

# Thời gian hiệu lực của mã OTP (tính theo giây, mặc định 300s = 5 phút)
OTP_EXPIRY_SECONDS=300

# Thời gian chờ giữa 2 lần gửi mã (Cooldown, tính theo giây, mặc định 60s)
OTP_COOLDOWN_SECONDS=60

# Số lần tối đa được nhập sai mã trước khi bị khóa (mặc định 5 lần)
OTP_MAX_ATTEMPTS=5

# Cấu hình Redis (Tùy chọn: Nếu để trống hoặc Redis không chạy, hệ thống sẽ tự động chuyển sang lưu trên RAM/Memory)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

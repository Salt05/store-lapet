# Cổng chạy dịch vụ
PORT=4000

# Cấu hình máy chủ gửi mail SMTP (Mặc định dùng Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# Mật khẩu ứng dụng 16 ký tự của Google (không phải mật khẩu đăng nhập cá nhân)
# Tạo tại: https://myaccount.google.com/apppasswords
SMTP_PASS=your_16_char_app_password
SMTP_FROM="Hệ Thống Xác Thực <your_email@gmail.com>"

# Thời gian hiệu lực của mã OTP (tính theo giây, mặc định 300s = 5 phút)
OTP_EXPIRY_SECONDS=300

# Thời gian chờ giữa 2 lần gửi mã (Cooldown, tính theo giây, mặc định 60s)
OTP_COOLDOWN_SECONDS=60

# Số lần tối đa được nhập sai mã trước khi bị khóa (mặc định 5 lần)
OTP_MAX_ATTEMPTS=5

# Cấu hình Redis (Tùy chọn: Nếu để trống hoặc Redis không chạy, hệ thống sẽ tự động chuyển sang lưu trên RAM/Memory)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
